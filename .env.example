# Server
PORT=3000
SESSION_SECRET=change_this_session_secret

# Email (유료 API 없이 sendmail 또는 사내 웹훅 사용)
EMAIL_FROM=no-reply@example.com
# EMAIL_SENDMAIL_BIN=/usr/sbin/sendmail
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=
# EMAIL_OUTBOX_DIR=./uploads/mail-outbox

# Papago API credential setup (둘 중 한 세트만 사용)
# 1) NCP API Gateway 키를 쓸 때 (권장)
PAPAGO_CLIENT_ID=your_ncp_api_key_id
PAPAGO_CLIENT_SECRET=your_ncp_api_key

# 2) Naver OpenAPI 키를 쓸 때
# NAVER_CLIENT_ID=your_naver_client_id
# NAVER_CLIENT_SECRET=your_naver_client_secret

# Figma Sync (local dev)
# Prefer setting FIGMA_key via your shell / GitHub Secrets.
FIGMA_key=
FIGMA_FILE_KEY=
# Optional: only export frames starting with this prefix
FIGMA_EXPORT_PREFIX=@export 
