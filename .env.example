# Server
PORT=3000
SESSION_SECRET=change_this_session_secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=company_user
DB_PASSWORD=change_this_db_password
DB_NAME=company_site

# Email (Gmail SMTP)
# Gmail 계정 → 보안 → 2단계 인증 → 앱 비밀번호 생성 (16자리)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=yourmail@gmail.com
EMAIL_TO=admin@yoursite.com

# Base URL (카카오페이 결제 콜백용)
BASE_URL=https://yourdomain.com

# Kakao Pay
# KAKAO_ADMIN_KEY=
# KAKAO_CID=TC0ONETIME

# Papago 번역 API (선택)
# PAPAGO_CLIENT_ID=
# PAPAGO_CLIENT_SECRET=
