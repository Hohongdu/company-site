# Server
PORT=3000
SESSION_SECRET=change_this_session_secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=company_user
DB_PASS=change_this_db_password
# DB_PASSWORD=change_this_db_password  ← 이전 이름 (db.js가 DB_PASS 또는 DB_PASSWORD 둘 다 허용)
DB_NAME=company_site

# Email 드라이버 선택: smtp | ncp | none (기본값: smtp)
EMAIL_DRIVER=smtp
# 관리자 수신 이메일 (문의 알림, 테스트 메일 수신)
ADMIN_EMAIL=admin@yoursite.com

# Email — SMTP (Gmail 등)
# Gmail: 보안 → 2단계 인증 → 앱 비밀번호 생성 (16자리)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=yourmail@gmail.com

# Email — NCP Outbound Mailer (EMAIL_DRIVER=ncp 일 때 사용)
# https://console.ncloud.com → AI·Application Service → Cloud Outbound Mailer
# NCP_EMAIL_ACCESS_KEY=
# NCP_EMAIL_SECRET_KEY=
# NCP_EMAIL_SENDER=verified@yoursite.com
# NCP_EMAIL_SENDER_NAME=ENERMADE

# Base URL (카카오페이 결제 콜백용)
BASE_URL=https://yourdomain.com

# Kakao Pay
# KAKAO_ADMIN_KEY=
# KAKAO_CID=TC0ONETIME

# 파일 전송 다운로드 토큰 서명 시크릿 (필수 — 미설정 시 프로덕션 서버 시작 거부)
FILE_TRANSFER_TOKEN_SECRET=change_this_file_transfer_secret

# Papago 번역 API (선택)
# PAPAGO_CLIENT_ID=
# PAPAGO_CLIENT_SECRET=
