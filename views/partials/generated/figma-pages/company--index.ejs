<% /* Refined implementation mapped from @export Home/* */ %>
<div class="figma-page figma-page-company-index figma-page--company" data-figma-page="company/index">
  <section class="figma-section figma-home-hero" data-figma-node-id="7:3" data-figma-source="@export Home/Hero">
    <div class="figma-hero-grid">
      <div>
        <span class="figma-eyebrow">Company Main</span>
        <h2>Precision ceramic manufacturing with predictable delivery</h2>
        <p>Use this Figma-linked block to keep your homepage message aligned with your latest capability and lead-time story.</p>

        <div class="figma-chip-row">
          <span class="figma-chip">Engineering Support</span>
          <span class="figma-chip">Prototype to Mass</span>
          <span class="figma-chip">B2B Supply</span>
        </div>

        <div class="figma-hero-actions">
          <a class="figma-btn figma-btn-primary" href="/contact">Request Quote</a>
          <a class="figma-btn figma-btn-ghost" href="/shop">View Catalog</a>
        </div>
      </div>

      <aside class="figma-hero-panel" aria-label="Company highlights">
        <div class="figma-hero-stat">
          <strong>20+ years</strong>
          <span>Production and quality operation experience</span>
        </div>
        <div class="figma-hero-stat">
          <strong>Fast response</strong>
          <span>Lead-time and quote updates with clear status</span>
        </div>
        <ul class="figma-hero-list">
          <li>Spec review before production kickoff</li>
          <li>Repeatable process checkpoints</li>
          <li>Priority handling for urgent requests</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="figma-section figma-home-features" data-figma-node-id="7:2" data-figma-source="@export Home/Features">
    <header class="figma-section-head">
      <h3>Delivery-oriented capabilities</h3>
      <p>Connected to Figma <code>Home/Features</code></p>
    </header>

    <div class="figma-feature-grid">
      <article class="figma-feature-card">
        <span class="kicker">Process</span>
        <h4>Production consistency</h4>
        <p>Stable output through standardized process and quality gates.</p>
      </article>
      <article class="figma-feature-card">
        <span class="kicker">Engineering</span>
        <h4>Spec flexibility</h4>
        <p>Adjust shape, tolerance, and throughput for project fit.</p>
      </article>
      <article class="figma-feature-card">
        <span class="kicker">Partnership</span>
        <h4>Practical communication</h4>
        <p>Fast updates for schedule change, PO revision, and shipment planning.</p>
      </article>
    </div>
  </section>

  <section class="figma-section figma-home-footer" data-figma-node-id="2:2" data-figma-source="@export Home/Footer">
    <div>
      <h4>Ready to start a production conversation?</h4>
      <p>Share your required quantity and specification to receive a build-ready plan.</p>
      <p class="figma-micro">Mapped from Figma export: <code>Home/Footer</code></p>
    </div>
    <a class="figma-btn figma-btn-light" href="/contact">Talk to Us</a>
  </section>
</div>
