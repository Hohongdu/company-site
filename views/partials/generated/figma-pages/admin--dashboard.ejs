<% /* Refined implementation mapped from @export Home/* */ %>
<%
const statsSafe = (typeof stats !== 'undefined' && stats) ? stats : {};
const totalProducts = Number(statsSafe.totalProducts || 0);
const totalCategories = Number(statsSafe.totalCategories || 0);
const totalOrders = Number(statsSafe.totalOrders || 0);
const totalInquiries = Number(statsSafe.totalInquiries || 0);
const openInquiries = Number(statsSafe.openInquiries || statsSafe.totalInquiries || 0);
%>
<div class="figma-page figma-page-admin-dashboard figma-page--admin" data-figma-page="admin/dashboard">
  <section class="figma-section figma-home-hero" data-figma-node-id="7:3" data-figma-source="@export Home/Hero">
    <div class="figma-hero-grid">
      <div>
        <span class="figma-eyebrow">Admin Dashboard</span>
        <h2>Operate catalog, orders, and support from one command surface</h2>
        <p>Use this Figma-controlled block to keep daily priorities visible for operators and managers.</p>

        <div class="figma-chip-row">
          <span class="figma-chip">Products: <%= totalProducts %></span>
          <span class="figma-chip">Categories: <%= totalCategories %></span>
          <span class="figma-chip">Orders: <%= totalOrders %></span>
          <span class="figma-chip">Inquiries: <%= totalInquiries %></span>
        </div>

        <div class="figma-hero-actions">
          <a class="figma-btn figma-btn-primary" href="/admin/products/new">Add Product</a>
          <a class="figma-btn figma-btn-ghost" href="/admin/orders">Open Orders</a>
        </div>
      </div>

      <aside class="figma-hero-panel" aria-label="Admin quick metrics">
        <div class="figma-hero-stat">
          <strong><%= totalProducts %></strong>
          <span>Total products currently maintained</span>
        </div>
        <div class="figma-hero-stat">
          <strong><%= openInquiries %></strong>
          <span>Inquiry load to monitor for response SLA</span>
        </div>
        <ul class="figma-hero-list">
          <li>Catalog quality and stock visibility checks</li>
          <li>Order flow handoff from payment to shipping</li>
          <li>Support queue handling with status continuity</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="figma-section figma-home-features" data-figma-node-id="7:2" data-figma-source="@export Home/Features">
    <header class="figma-section-head">
      <h3>Operational focus blocks</h3>
      <p>Connected to Figma <code>Home/Features</code></p>
    </header>

    <div class="figma-feature-grid">
      <article class="figma-feature-card">
        <span class="kicker">Catalog</span>
        <h4>Data quality control</h4>
        <p>Keep product, category, and import flow consistent across the storefront.</p>
      </article>
      <article class="figma-feature-card">
        <span class="kicker">Orders</span>
        <h4>Processing velocity</h4>
        <p>Track incoming volume and move orders across payment and fulfillment stages.</p>
      </article>
      <article class="figma-feature-card">
        <span class="kicker">Support</span>
        <h4>Response reliability</h4>
        <p>Maintain inquiry turnaround speed while preserving full response history.</p>
      </article>
    </div>
  </section>

  <section class="figma-section figma-home-footer" data-figma-node-id="2:2" data-figma-source="@export Home/Footer">
    <div>
      <h4>Jump directly to management actions</h4>
      <p>Move from this summary to catalog, order, and inquiry controls in one click.</p>
      <p class="figma-micro">Current snapshot: <%= totalOrders %> orders, <%= totalInquiries %> inquiries</p>
    </div>
    <a class="figma-btn figma-btn-light" href="/admin/products">Manage Catalog</a>
  </section>
</div>
