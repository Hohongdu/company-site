<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">우리 회사</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- 왼쪽: 일반 메뉴 -->
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">홈</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath === '/about' ? 'active' : '' %>" href="/about">회사 소개</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath.startsWith('/shop') ? 'active' : '' %>" href="/shop/products">상품몰</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath === '/shop/cart' ? 'active' : '' %>" href="/shop/cart">장바구니</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>" href="/contact">문의하기</a>
                </li>
            </ul>

            <!-- 오른쪽: 로그인/회원가입 -->
            <div class="d-flex align-items-center">
