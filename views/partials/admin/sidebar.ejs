<aside class="admin-sidebar">
    <div class="admin-brand">
        <span class="dot"></span>
        <div>
            <div class="title">ADMIN PANEL</div>
            <div style="font-size:12px;color:rgba(255,255,255,.6)">관리자 전용</div>
        </div>
    </div>

    <div class="admin-user">
        <% if (user) { %>
            <div class="name">
                <%= user.name %>
            </div>
            <div class="role">관리자</div>
            <% } else { %>
                <div class="name">Guest</div>
                <div class="role">로그인이 필요합니다</div>
                <% } %>
    </div>

    <nav class="admin-nav">
        <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">
            <span>대시보드</span><small>Home</small>
        </a>

        <a href="/admin/products" class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">
            <span>상품 관리</span><small>Products</small>
        </a>

        <a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">
            <span>카테고리</span><small>Categories</small>
        </a>

        <a href="/admin/products/import"
            class="<%= currentPath.startsWith('/admin/products/import') ? 'active' : '' %>">
            <span>엑셀 업로드</span><small>Import</small>
        </a>

        <hr style="border-color:rgba(255,255,255,.08)">

        <a href="/" target="_blank">
            <span>회사로</span><small>Company</small>
        </a>

        <a href="/shop" target="_blank">
            <span>상품몰로</span><small>Shop</small>
        </a>

        <a href="/auth/logout">
            <span>로그아웃</span><small>Logout</small>
        </a>
    </nav>
</aside>