<header class="admin-topbar">
    <div class="wrap">
        <div>
            <p class="admin-page-title mb-0">
                <%= title || 'Admin' %>
            </p>
            <% if (subtitle) { %>
                <small class="admin-page-subtitle">
                    <%= subtitle %>
                </small>
                <% } %>
        </div>

        <div class="admin-actions">
            <a class="btn btn-outline-secondary btn-sm btn-admin-outline" href="/" target="_blank">회사</a>
            <a class="btn btn-outline-secondary btn-sm btn-admin-outline" href="/shop" target="_blank">상품몰</a>
            <a class="btn btn-outline-danger btn-sm btn-admin-outline" href="/auth/logout">로그아웃</a>
        </div>
    </div>
</header>
