<% var p=currentPath || '' ; var isShopHome=(p==='/shop' || p==='/shop/' ); var isShopProducts=isShopHome ||
    p.indexOf('/shop/products')===0; var isShopCart=p.indexOf('/shop/cart')===0; var
    isLogin=p.indexOf('/auth/login')===0; var isRegister=p.indexOf('/auth/register')===0; var q=(typeof query
    !=='undefined' && query) ? query : '' ; %>

    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/shop/products">SHOP</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#shopNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="shopNav">
                <!-- 검색 -->
                <form class="d-flex ms-lg-3 me-lg-auto my-2 my-lg-0" action="/shop/products" method="get"
                    style="max-width:520px; width:100%;">
                    <input class="form-control me-2" type="search" name="q" placeholder="상품 검색 (코드/이름/규격)"
                        value="<%= q %>">
                    <button class="btn btn-outline-dark" type="submit">검색</button>
                </form>

                <!-- 오른쪽 메뉴 -->
                <ul class="navbar-nav ms-lg-3 align-items-lg-center">
                    <!-- 장바구니 -->
                    <li class="nav-item me-2">
                        <% if (user && user.is_admin) { %>
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-dark btn-sm" href="/admin">관리자</a>
                    </li>
                    <% } %>

                        <a class="btn btn-outline-secondary btn-sm" href="/">회사로</a>

                        <a class="btn btn-sm position-relative <%= isShopCart ? 'btn-dark' : 'btn-outline-dark' %>"
                            href="/shop/cart">
                            장바구니
                            <% if ((cartCount || 0)> 0) { %>
                                <span
                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    <%= cartCount %>
                                </span>
                                <% } %>
                        </a>
                        </li>

                        <!-- 상품보기 -->
                        <li class="nav-item me-2">
                            <a class="btn btn-sm <%= isShopProducts ? 'btn-dark' : 'btn-outline-dark' %>"
                                href="/shop/products">
                                상품보기
                            </a>
                        </li>

                        <% if (user) { %>
                            <li class="nav-item me-2">
                                <span class="small text-muted">
                                    <strong>
                                        <%= user.name %>
                                    </strong> 님
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm" href="/auth/logout">로그아웃</a>
                            </li>
                            <% } else { %>
                                <li class="nav-item me-2">
                                    <a class="btn btn-sm <%= isLogin ? 'btn-dark' : 'btn-outline-secondary' %>"
                                        href="/auth/login">
                                        로그인
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-sm <%= isRegister ? 'btn-dark' : 'btn-primary' %>"
                                        href="/auth/register">
                                        회원가입
                                    </a>
                                </li>
                                <% } %>
                </ul>
            </div>
        </div>
    </nav>