<%- include('../layouts/company-top', { title: '비밀번호 찾기', active: '' }) %>

<section class="auth-wrap">
  <div class="auth-card">
    <div class="auth-card-head">
      <div class="auth-logo-mark">EN</div>
      <h1 class="auth-card-title">비밀번호 찾기</h1>
      <p class="auth-card-sub">가입 시 사용한 이메일로 재설정 링크를 보내드립니다</p>
    </div>

    <div class="auth-card-body">
      <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert"><%= success %></div>
      <% } %>

      <form action="/auth/forgot" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="forgot-email">이메일</label>
          <input
            type="email"
            id="forgot-email"
            name="email"
            class="form-control"
            placeholder="가입 시 사용한 이메일을 입력하세요"
            autocomplete="email"
            required
          >
        </div>

        <button type="submit" class="btn btn-primary w-100">재설정 링크 발송</button>
      </form>

      <div class="auth-divider">또는</div>

      <a href="/auth/login" class="btn btn-outline w-100">로그인 페이지로 이동</a>
    </div>

    <div class="auth-footer">
      <a href="/auth/login">← 로그인으로 돌아가기</a>
    </div>
  </div>
</div>

<%- include('../layouts/company-bottom') %>
