<%- include('../layouts/company-top', { title: '아이디 · 비밀번호 찾기' , active: '' }) %>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="text-center mb-4">
                        <span class="badge rounded-pill text-bg-primary mb-2">계정 도움말</span>
                        <h1 class="h3 fw-bold mb-2">아이디 · 비밀번호 찾기</h1>
                        <p class="text-muted mb-0">가입 이메일로 임시 비밀번호를 받아 로그인할 수 있습니다.</p>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <% if (message) { %>
                                <div class="alert alert-info" role="alert"><%= message %></div>
                            <% } %>

                            <form method="post" action="/auth/forgot" class="d-flex flex-column gap-3">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div>
                                    <label for="forgotEmail" class="form-label">가입 이메일</label>
                                    <input id="forgotEmail" name="email" type="email" class="form-control" placeholder="you@example.com" required>
                                </div>
                                <button type="submit" class="btn btn-primary">임시 비밀번호 발급</button>
                            </form>

                            <hr class="my-4">
                            <ul class="text-muted small mb-3">
                                <li>가입된 이메일이 맞다면 임시 비밀번호가 전송됩니다.</li>
                                <li>이메일 전송은 서버 설정(SMTP/웹훅)에 따라 동작합니다.</li>
                            </ul>

                            <div class="d-flex flex-column flex-sm-row gap-2">
                                <a href="/contact" class="btn btn-outline-secondary">문의하기</a>
                                <a href="/auth/login" class="btn btn-outline-dark">로그인 페이지로</a>
                            </div>
                        </div>
                    </div>

                    <p class="text-center text-muted mt-4 mb-0">
                        아직 회원이 아니신가요?
                        <a href="/auth/register" class="text-decoration-none fw-semibold">회원가입 하기</a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <%- include('../layouts/company-bottom') %>
