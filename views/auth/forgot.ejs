<%- include('../layouts/company-top', { title: '비밀번호 찾기', active: '' }) %>

<section class="em-auth-wrap">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="em-auth-card">
          <div class="em-auth-header">
            <div class="em-auth-brand">ENERMADE</div>
            <h1 class="em-auth-title">비밀번호 찾기</h1>
            <p class="em-auth-sub">가입 이메일로 임시 비밀번호를 받아 로그인할 수 있습니다</p>
          </div>
          <div class="em-auth-body">
            <% if (message) { %>
              <div class="alert alert-<%= messageType === 'success' ? 'success' : (messageType === 'error' ? 'danger' : 'info') %> mb-3" role="alert">
                <%= message %>
              </div>
            <% } %>

            <form method="POST" action="/auth/forgot" class="d-grid gap-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <label class="form-label" for="forgotEmail">가입 이메일</label>
                <input type="email" id="forgotEmail" name="email" class="form-control"
                  placeholder="you@example.com" required>
              </div>
              <button type="submit" class="btn btn-dark">임시 비밀번호 발급</button>
            </form>

            <hr class="divider my-4">

            <ul class="text-em-muted small mb-4 ps-3">
              <li class="mb-1">가입된 이메일이 맞다면 임시 비밀번호가 전송됩니다.</li>
              <li>이메일 전송은 서버 설정(SMTP)에 따라 동작합니다.</li>
            </ul>

            <div class="d-flex gap-2 flex-wrap">
              <a href="/auth/login" class="btn btn-outline-dark btn-sm">로그인 페이지로</a>
              <a href="/auth/register" class="btn btn-outline-secondary btn-sm">회원가입 하기</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../layouts/company-bottom') %>
