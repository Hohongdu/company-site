<%- include('../layouts/company-top', { title: '회원가입', active: '' }) %>

<section class="auth-wrap">
  <div class="auth-card">
    <div class="auth-card-head">
      <div class="auth-logo-mark">EN</div>
      <h1 class="auth-card-title">회원가입</h1>
      <p class="auth-card-sub">ENERMADE 계정을 만들어 보세요</p>
    </div>

    <div class="auth-card-body">
      <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>

      <form action="/auth/register" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="reg-name">이름</label>
          <input
            type="text"
            id="reg-name"
            name="name"
            class="form-control"
            placeholder="이름을 입력하세요"
            value="<%= (typeof form !== 'undefined' && form && form.name) ? form.name : '' %>"
            autocomplete="name"
            required
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="reg-email">이메일</label>
          <input
            type="email"
            id="reg-email"
            name="email"
            class="form-control"
            placeholder="example@email.com"
            value="<%= (typeof form !== 'undefined' && form && form.email) ? form.email : '' %>"
            autocomplete="email"
            required
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="reg-pw">비밀번호</label>
          <input
            type="password"
            id="reg-pw"
            name="password"
            class="form-control"
            placeholder="비밀번호를 입력하세요"
            autocomplete="new-password"
            required
          >
          <small style="display:block; margin-top:.375rem; font-size:.8125rem; color:var(--c-muted, #6b7280);">영문, 숫자 포함 8자 이상을 권장합니다</small>
        </div>

        <div class="form-group">
          <label class="form-label" for="reg-pw2">비밀번호 확인</label>
          <input
            type="password"
            id="reg-pw2"
            name="passwordConfirm"
            class="form-control"
            placeholder="비밀번호를 다시 입력하세요"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="form-group">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="terms" name="terms" value="1" required>
            <label class="form-check-label" for="terms">
              <a href="/company/terms" target="_blank" style="color:#2563eb;">이용약관</a> 및
              <a href="/company/privacy" target="_blank" style="color:#2563eb;">개인정보처리방침</a>에 동의합니다
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100">회원가입</button>
      </form>
    </div>

    <div class="auth-footer">
      이미 계정이 있으신가요? <a href="/auth/login">로그인</a>
    </div>
  </div>
</section>

<%- include('../layouts/company-bottom') %>
