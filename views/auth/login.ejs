<%- include('../layouts/company-top', { title: '로그인' , active: '' }) %>
    <form action="/admin/products/import" method="post" enctype="multipart/form-data" class="d-grid gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <section class="py-5 bg-light">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-5">
                        <div class="text-center mb-4">
                            <span class="badge rounded-pill text-bg-primary mb-2">우리 회사 계정</span>
                            <h1 class="h3 fw-bold mb-2">로그인</h1>
                            <p class="text-muted mb-0">회사 소식과 상품몰 이용을 위한 통합 계정으로 로그인하세요.</p>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <form method="POST" action="/auth/login" class="d-grid gap-3">
                                    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>">
                                    <div>
                                        <label class="form-label">이메일</label>
                                        <input type="email" name="email" class="form-control"
                                            placeholder="example@company.com" required>
                                    </div>

                                    <div>
                                        <label class="form-label">비밀번호</label>
                                        <input type="password" name="password" class="form-control"
                                            placeholder="비밀번호를 입력하세요" required>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg">
                                        로그인
                                    </button>
                                </form>
                            </div>
                        </div>

                        <p class="text-center text-muted mt-4 mb-0">
                            아직 회원이 아니신가요?
                            <a href="/auth/register" class="text-decoration-none fw-semibold">회원가입 하기</a>
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </form>

    <%- include('../layouts/company-bottom') %>