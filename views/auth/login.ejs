<%- include('../layouts/company-top', { title: '로그인', active: '' }) %>

<section class="auth-wrap">
  <div class="auth-card">
    <div class="auth-card-head">
      <div class="auth-logo-mark">EN</div>
      <h1 class="auth-card-title">로그인</h1>
      <p class="auth-card-sub">ENERMADE에 오신 것을 환영합니다</p>
    </div>

    <div class="auth-card-body">
      <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success" role="alert"><%= message %></div>
      <% } %>

      <form action="/auth/login" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="<%= returnTo || '/' %>">

        <div class="form-group">
          <label class="form-label" for="login-email">이메일</label>
          <input
            type="email"
            id="login-email"
            name="email"
            class="form-control"
            placeholder="example@email.com"
            autocomplete="email"
            required
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="login-pw">비밀번호</label>
          <input
            type="password"
            id="login-pw"
            name="password"
            class="form-control"
            placeholder="비밀번호를 입력하세요"
            autocomplete="current-password"
            required
          >
        </div>

        <div class="form-group" style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
          <div class="form-check" style="margin-bottom:0;">
            <input class="form-check-input" type="checkbox" id="remember" name="remember" value="1">
            <label class="form-check-label" for="remember">로그인 상태 유지</label>
          </div>
          <a href="/auth/forgot" style="font-size:.875rem; color:#2563eb; text-decoration:none; font-weight:600;">비밀번호 찾기</a>
        </div>

        <button type="submit" class="btn btn-primary w-100">로그인</button>
      </form>
    </div>

    <div class="auth-footer">
      계정이 없으신가요? <a href="/auth/register">회원가입</a>
    </div>
  </div>
</section>

<%- include('../layouts/company-bottom') %>
