<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>로그인 - 우리 회사</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header') %>

        <main class="py-5">
            <div class="container" style="max-width: 480px;">
                <h1 class="h3 mb-4 text-center">로그인</h1>

                <form method="POST" action="/login">
                    <div class="mb-3">
                        <label class="form-label">이메일</label>
                        <input type="email" name="email" class="form-control" placeholder="example@company.com"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">비밀번호</label>
                        <input type="password" name="password" class="form-control" placeholder="비밀번호를 입력하세요" required>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        로그인
                    </button>

                    <p class="text-center mb-0">
                        아직 회원이 아니신가요?
                        <a href="/register">회원가입 하기</a>
                    </p>
                </form>
            </div>
        </main>

        <%- include('partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>