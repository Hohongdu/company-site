<%- include('../layouts/company-top', { title: '로그인', active: '' }) %>

<div class="auth-page">
  <div style="width:100%;max-width:440px;margin:0 auto;">
    <a href="/" class="auth-logo" style="margin-bottom:32px;">ENER<span>MADE</span></a>

    <div class="auth-card">
      <div class="auth-title">다시 오셨군요</div>
      <p class="auth-sub">계정으로 로그인하여 더 많은 서비스를 이용하세요</p>

      <% if (locals.error) { %>
        <div class="alert alert-danger mb-3" role="alert"><%= error %></div>
      <% } %>
      <% if (typeof query !== 'undefined' && query && query.csrf === '1') { %>
        <div class="alert alert-warning mb-3" role="alert">
          세션이 만료됐습니다. 페이지를 새로고침하고 다시 로그인해 주세요.
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="d-grid gap-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="<%= returnTo || '' %>">

        <div>
          <label class="form-label" for="login-email">이메일</label>
          <input type="email" id="login-email" name="email" class="form-control"
            placeholder="example@company.com" autocomplete="email" required>
        </div>

        <div>
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label mb-0" for="login-pw">비밀번호</label>
            <a href="/auth/forgot" style="font-size:12px;font-weight:600;color:var(--c-accent);">비밀번호 찾기</a>
          </div>
          <input type="password" id="login-pw" name="password" class="form-control"
            placeholder="비밀번호를 입력하세요" autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn btn-primary w-100" style="padding:12px;">로그인</button>
        <a class="btn btn-outline-secondary w-100 btn-sm" href="/shop/orders/guest">비회원 주문 조회</a>
      </form>

      <hr class="my-4">
      <p class="auth-footer">
        아직 회원이 아니신가요?
        <a href="/auth/register">회원가입 하기 →</a>
      </p>
    </div>
  </div>
</div>

<%- include('../layouts/company-bottom') %>
