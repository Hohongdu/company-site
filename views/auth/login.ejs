<%- include('../layouts/company-top', { title: '로그인', active: '' }) %>

<section class="em-auth-wrap">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="em-auth-card">
          <div class="em-auth-header">
            <div class="em-auth-brand">ENERMADE</div>
            <h1 class="em-auth-title">로그인</h1>
            <p class="em-auth-sub">회사 소식과 상품몰을 한 계정으로 이용하세요</p>
          </div>
          <div class="em-auth-body">
            <% if (locals.error) { %>
              <div class="alert alert-danger mb-3" role="alert"><%= error %></div>
            <% } %>
            <% if (typeof query !== 'undefined' && query && query.csrf === '1') { %>
              <div class="alert alert-warning mb-3" role="alert">
                세션이 만료됐습니다. 페이지를 새로고침하고 다시 로그인해 주세요.
              </div>
            <% } %>
            <form method="POST" action="/auth/login">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="<%= returnTo || '' %>">

              <div class="mb-3">
                <label class="form-label" for="login-email">이메일</label>
                <input type="email" id="login-email" name="email" class="form-control"
                  placeholder="example@company.com" autocomplete="email" required>
              </div>

              <div class="mb-2">
                <label class="form-label" for="login-pw">비밀번호</label>
                <input type="password" id="login-pw" name="password" class="form-control"
                  placeholder="비밀번호를 입력하세요" autocomplete="current-password" required>
              </div>

              <div class="d-flex justify-content-end mb-3">
                <a href="/auth/forgot" class="small text-em-blue">비밀번호를 잊으셨나요?</a>
              </div>

              <button type="submit" class="btn btn-dark w-100 mb-2">로그인</button>
              <a class="btn btn-outline-secondary w-100 btn-sm" href="/shop/orders/guest">비회원 주문 조회</a>
            </form>

            <hr class="divider my-4">
            <p class="text-center text-em-muted small mb-0">
              아직 회원이 아니신가요?
              <a href="/auth/register" class="fw-bold text-navy">회원가입 하기 →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../layouts/company-bottom') %>
