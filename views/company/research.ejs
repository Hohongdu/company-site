          </div>
          <div class="col-6">
            <div style="background:var(--c-bg-2);border:1px solid var(--c-border);border-radius:var(--r-xl);padding:24px;">
              <div style="font-family:var(--font-head);font-size:2rem;font-weight:800;color:var(--c-accent);line-height:1;margin-bottom:6px;">10<sup style="font-size:60%;font-weight:700;">+</sup></div>
              <div style="font-size:13px;color:var(--c-muted);font-weight:600;">산학연 협력</div>
