<%- include('../layouts/company-top', { title: notice.title, active: 'notices' }) %>

<section class="section">
    <div class="container-wide">
        <div class="card-soft">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <h3 class="mb-0"><%= notice.title %></h3>
                <span class="text-muted small"><%= new Date(notice.created_at).toLocaleDateString() %></span>
            </div>
            <div class="text-muted small mt-2">조회수 <%= notice.views || 0 %></div>
            <hr class="my-3">
            <div style="white-space:pre-wrap;"><%= notice.content %></div>
        </div>

        <div class="mt-3">
            <a class="btn-outline2" href="/notices">목록으로</a>
        </div>
    </div>
</section>

<%- include('../layouts/company-bottom') %>
