<%- include('../layouts/company-top', { title: '고객 지원', active: 'contact' }) %>

<div class="page-banner">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">홈</a></li>
        <li class="breadcrumb-item active">고객 지원</li>
      </ol>
    </nav>
    <h1>고객 지원</h1>
    <p>문의 내용을 남겨주시면 전문 담당자가 신속하게 답변드립니다</p>
  </div>
</div>

<section class="sec-py">
  <div class="container">
    <div class="row g-5">

      <!-- Form -->
      <div class="col-12 col-lg-7">
        <div style="background:var(--c-bg-2);border:1px solid var(--c-border);border-radius:var(--r-xl);padding:36px;">
          <span class="sec-label" style="margin-bottom:12px;">견적 및 기술 문의</span>
          <h2 style="font-size:1.4rem;font-weight:700;margin-bottom:6px;color:var(--c-text);">무엇을 도와드릴까요?</h2>
          <p class="txt-muted" style="font-size:13px;margin-bottom:28px;">모든 항목을 입력하신 후 문의 보내기를 눌러주세요.</p>

          <form id="inquiryForm" class="d-grid gap-3">
            <div class="row g-3">
              <div class="col-12 col-sm-6">
                <label class="form-label" for="inq-name">이름 <span style="color:var(--c-danger)">*</span></label>
                <input id="inq-name" name="name" class="form-control" required maxlength="50" placeholder="성함을 입력해주세요">
              </div>
              <div class="col-12 col-sm-6">
                <label class="form-label" for="inq-email">이메일 <span style="color:var(--c-danger)">*</span></label>
                <input id="inq-email" name="email" type="email" class="form-control" required placeholder="example@company.com">
              </div>
            </div>
            <div>
              <label class="form-label" for="inq-msg">문의 내용 <span style="color:var(--c-danger)">*</span></label>
              <textarea id="inq-msg" name="message" class="form-control" rows="6" required
                placeholder="제품명, 소재, 규격, 수량 등 구체적으로 작성해 주시면 더 빠른 답변이 가능합니다."></textarea>
            </div>
            <div>
              <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                문의 보내기
              </button>
            </div>
          </form>
          <div id="resultBox" class="alert mt-3 d-none" role="alert"></div>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="col-12 col-lg-5">
        <div class="contact-info-card">
          <h3>연락처 안내</h3>

          <div class="contact-info-item">
            <div class="contact-info-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.13 1 .37 1.97.72 2.9a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.18-1.18a2 2 0 012.11-.45c.93.35 1.9.6 2.9.72A2 2 0 0122 14.92v2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <div class="contact-info-item__label">전화</div>
              <div class="contact-info-item__value"><%= company.phone %></div>
            </div>
          </div>

          <div class="contact-info-item">
            <div class="contact-info-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 6l-10 7L2 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <div class="contact-info-item__label">이메일</div>
              <div class="contact-info-item__value"><%= company.email %></div>
            </div>
          </div>

          <div class="contact-info-item">
            <div class="contact-info-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <div class="contact-info-item__label">주소</div>
              <div class="contact-info-item__value"><%= company.address %></div>
            </div>
          </div>

          <ul class="contact-notice list-unstyled mb-0">
            <li>문의 등록 후 관리자가 대시보드에서 답변합니다.</li>
            <li>필요 시 이메일로 답변과 파일 링크를 전송할 수 있습니다.</li>
            <li>평균 답변 시간: 영업일 기준 1~2일 이내</li>
            <li>긴급 문의는 전화로 연락 주시면 즉시 대응합니다.</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  const form = document.getElementById('inquiryForm');
  const resultBox = document.getElementById('resultBox');
  const submitBtn = form?.querySelector('button[type="submit"]');
  const originalBtnHtml = submitBtn?.innerHTML;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    resultBox.className = 'alert mt-3 d-none';

    const payload = Object.fromEntries(new FormData(form).entries());

    // 로딩 상태
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<svg class="spin-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" style="display:inline;animation:spin .7s linear infinite;margin-right:6px;"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-dasharray="31" stroke-dashoffset="8"/></svg>전송 중...`;
    }

    try {
      const res = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: payload.name, email: payload.email, message: payload.message }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        resultBox.textContent = '문의가 접수되었습니다. 빠른 시일 내에 답변드리겠습니다.';
        resultBox.className = 'alert alert-success mt-3';
        form.reset();
      } else {
        resultBox.textContent = data.message || '문의 전송에 실패했습니다. 잠시 후 다시 시도해주세요.';
        resultBox.className = 'alert alert-danger mt-3';
      }
    } catch (err) {
      resultBox.textContent = '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요.';
      resultBox.className = 'alert alert-danger mt-3';
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    }
  });
})();
</script>
<style>
@keyframes spin { to { transform: rotate(360deg); } }
.spin-icon { display:inline-block; }
</style>

<%- include('../layouts/company-bottom') %>
