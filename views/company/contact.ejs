<%- include('../layouts/company-top', { title: '문의하기' , active: 'contact' }) %>

    <section class="py-5">
        <div class="container">
            <h2 class="fw-bold mb-3">문의하기</h2>
            <p class="text-muted mb-4">연락 주시면 빠르게 답변드릴게요.</p>

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="company-card p-4">
                        <form>
                            <div class="mb-3">
                                <label class="form-label small text-muted">이름</label>
                                <input class="form-control" placeholder="성함을 입력해주세요">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small text-muted">이메일</label>
                                <input class="form-control" placeholder="example@company.com">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small text-muted">문의 내용</label>
                                <textarea class="form-control" rows="4" placeholder="문의하실 내용을 적어주세요"></textarea>
                            </div>
                            <button type="button" class="btn btn-primary">문의 보내기</button>
                        </form>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="company-card p-4 h-100">
                        <h6 class="fw-semibold mb-2">연락처 & 위치</h6>
                        <div class="text-muted small">
                            전화: 010-0000-0000<br />
                            이메일: contact@company.com<br />
                            주소: 천안/아산 어딘가
                        </div>

                        <div class="mt-4">
                            <a href="/shop" class="btn btn-outline-primary btn-sm">상품몰 가기</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../layouts/company-bottom') %><%- include('../layouts/company-top', { title: '문의하기 - CERAMIC PRO' ,
            active: 'contact' }) %>

            <section class="section" id="contact">
                <div class="container-wide">
                    <h2 class="section-title">문의하기</h2>
                    <p class="section-sub">제품 문의, 견적 요청 등 언제든지 연락주세요</p>

                    <div class="contact-grid">
                        <div>
                            <h3 class="contact-title">연락처 정보</h3>
                            <div class="kv">
                                <div><a href="tel:02-1234-0000">전화</a></div>
                                <div>02-1234-xxxx</div>
                                <div><a href="mailto:info@ceramicpro.com">이메일</a></div>
                                <div>info@ceramicpro.com</div>
                                <div><span style="color:var(--accent); font-weight:800;">팩스</span></div>
                                <div>02-1234-xxxx</div>
                                <div><span style="color:var(--accent); font-weight:800;">주소</span></div>
                                <div>
                                    서울특별시 강남구 테헤란로 123<br />
                                    세라믹프로 빌딩 5층
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="contact-title">운영 시간</h3>
                            <div class="hours">
                                <div class="row2">
                                    <div class="label">평일</div>
                                    <div class="val">오전 9:00 - 오후 6:00</div>
                                </div>
                                <div class="row2">
                                    <div class="label">토요일</div>
                                    <div class="val">오전 9:00 - 오후 1:00</div>
                                </div>
                                <div class="row2">
                                    <div class="label">일요일 및 공휴일</div>
                                    <div class="val">휴무</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <%- include('../layouts/company-bottom') %>