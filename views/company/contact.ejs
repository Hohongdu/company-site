<%- include('../layouts/company-top', { title: '문의하기', active: 'contact' }) %>

<div class="page-banner">
  <div class="container">
    <p class="page-banner-eyebrow">CONTACT US</p>
    <h1 class="page-banner-title">문의하기</h1>
    <p class="page-banner-sub">궁금하신 사항이나 제품 관련 문의를 남겨주시면 빠르게 답변 드리겠습니다.</p>
  </div>
</div>

<!-- Contact Section -->
<section class="contact-section">
  <div class="container">
    <div class="contact-grid">

      <!-- Form Card -->
      <div class="contact-form-card">
        <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--c-ink); margin-bottom: 0.5rem;">온라인 문의</h2>
        <p style="color: var(--c-muted); font-size: 0.95rem; margin-bottom: 1.75rem;">아래 양식을 작성하시면 담당자가 확인 후 연락드립니다.</p>

        <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          문의가 성공적으로 접수되었습니다. 빠른 시일 내에 답변 드리겠습니다.
        </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <%= error %>
        </div>
        <% } %>

        <form id="contactForm" method="POST" action="/contact">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="name">이름 <span style="color: var(--c-blue);">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                placeholder="홍길동"
                value="<%= (typeof form !== 'undefined' && form && form.name) ? form.name : '' %>"
                required
              >
            </div>
            <div class="form-group">
              <label class="form-label" for="email">이메일 <span style="color: var(--c-blue);">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-control"
                placeholder="example@company.com"
                value="<%= (typeof form !== 'undefined' && form && form.email) ? form.email : '' %>"
                required
              >
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="phone">연락처</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-control"
                placeholder="010-0000-0000"
                value="<%= (typeof form !== 'undefined' && form && form.phone) ? form.phone : '' %>"
              >
            </div>
            <div class="form-group">
              <label class="form-label" for="subject">문의 제목 <span style="color: var(--c-blue);">*</span></label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="form-control"
                placeholder="문의 제목을 입력하세요"
                value="<%= (typeof form !== 'undefined' && form && form.subject) ? form.subject : '' %>"
                required
              >
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="message">문의 내용 <span style="color: var(--c-blue);">*</span></label>
            <textarea
              id="message"
              name="message"
              class="form-control"
              rows="6"
              placeholder="문의하실 내용을 자세히 입력해 주세요."
              style="height: auto; resize: vertical;"
              required
            ><%= (typeof form !== 'undefined' && form && form.message) ? form.message : '' %></textarea>
          </div>

          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="agreePrivacy" required>
            <label class="form-check-label" for="agreePrivacy" style="color: var(--c-text); font-size: 0.9rem;">
              개인정보 수집 및 이용에 동의합니다. <span style="color: var(--c-blue);">*</span>
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">문의 보내기</button>
        </form>
      </div>

      <!-- Info Card -->
      <div class="contact-info-card">
        <h2 style="font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">연락처 정보</h2>
        <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem; margin-bottom: 2rem;">직접 방문하시거나 아래 연락처로 문의하실 수 있습니다.</p>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <div class="contact-info-label">주소</div>
            <div class="contact-info-value">서울특별시 강남구 테헤란로 123<br>에너메이드 빌딩 7층</div>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.59 4.9 2 2 0 0 1 3.56 2.72h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.41a16 16 0 0 0 6.29 6.29l.87-.87a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.72 17z"></path>
            </svg>
          </div>
          <div>
            <div class="contact-info-label">전화</div>
            <div class="contact-info-value">02-1234-5678</div>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div>
            <div class="contact-info-label">이메일</div>
            <div class="contact-info-value">info@enermade.co.kr</div>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div>
            <div class="contact-info-label">운영 시간</div>
            <div class="contact-info-value">월~금 09:00 ~ 18:00<br><span style="color: rgba(255,255,255,0.45); font-size: 0.85rem;">토·일·공휴일 휴무</span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  var form = document.getElementById('contactForm');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    var btn = form.querySelector('[type="submit"]');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '전송 중...';
    }
    // Standard form submit — let the server handle it
  });
})();
</script>

<%- include('../layouts/company-bottom') %>
