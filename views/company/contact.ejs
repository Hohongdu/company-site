<%- include('../layouts/company-top', { title: '문의하기' , active: 'contact' }) %>

<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-3">문의하기</h2>
        <p class="text-muted mb-4">문의 내용만 작성해주시면 관리자가 확인 후 답변드립니다.</p>

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="company-card p-4">
                    <form id="inquiryForm">
                        <div class="mb-3">
                            <label class="form-label small text-muted">이름</label>
                            <input name="name" class="form-control" required maxlength="50" placeholder="성함을 입력해주세요">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">이메일</label>
                            <input name="email" type="email" class="form-control" required placeholder="example@company.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">문의 내용</label>
                            <textarea name="message" class="form-control" rows="5" required placeholder="문의하실 내용을 적어주세요"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">문의 보내기</button>
                    </form>
                    <pre id="resultBox" class="mt-3 p-3 bg-light small rounded d-none"></pre>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="company-card p-4 h-100">
                    <h6 class="fw-semibold mb-2">안내</h6>
                    <ul class="small text-muted mb-0">
                        <li>문의 등록 후 관리자가 대시보드에서 답변합니다.</li>
                        <li>관리자는 필요 시 이메일로 답변과 파일 링크를 전송할 수 있습니다.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('inquiryForm');
    const resultBox = document.getElementById('resultBox');
    const contactEmail = '<%= contactEmail %>';

    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        resultBox.classList.add('d-none');

        const payload = Object.fromEntries(new FormData(form).entries());
        const subject = `[Website Inquiry] ${payload.name || 'Customer'}`;
        const body = [
            'New inquiry from website.',
            '',
            `Name: ${payload.name || ''}`,
            `Email: ${payload.email || ''}`,
            '',
            '[Message]',
            payload.message || '',
        ].join('\n');

        if (!contactEmail) {
            resultBox.textContent = 'Contact email is not configured.';
            resultBox.classList.remove('d-none');
            return;
        }

        const mailtoUrl = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        window.location.href = mailtoUrl;

        resultBox.textContent = 'Your mail app has opened. Please press send to finish.';
        resultBox.classList.remove('d-none');
        form.reset();
    });
</script>

<%- include('../layouts/company-bottom') %>
