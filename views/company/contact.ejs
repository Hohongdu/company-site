<%- include('../layouts/company-top', { title: '문의하기' , active: 'contact' }) %>

<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-3">문의하기 / 파일 전송</h2>
        <p class="text-muted mb-4">무료 이메일 웹훅 기반으로 보안 토큰 링크를 발송합니다.</p>

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="company-card p-4">
                    <form id="fileTransferForm" enctype="multipart/form-data">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">보내는 사람 이름</label>
                                <input name="senderName" class="form-control" required placeholder="홍길동">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">보내는 사람 이메일</label>
                                <input name="senderEmail" type="email" class="form-control" required placeholder="me@example.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">받는 사람 이메일</label>
                                <input name="recipientEmail" type="email" class="form-control" required placeholder="friend@example.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">만료 시간(시간 단위, 최대 168)</label>
                                <input name="expiresHours" type="number" class="form-control" min="1" max="168" value="24">
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">파일</label>
                                <input name="file" type="file" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">메시지</label>
                                <textarea name="message" class="form-control" rows="4" placeholder="받는 사람에게 전달할 내용을 적어주세요"></textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">보안 링크 이메일 보내기</button>
                    </form>
                    <pre id="resultBox" class="mt-3 p-3 bg-light small rounded d-none"></pre>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="company-card p-4 h-100">
                    <h6 class="fw-semibold mb-2">동작 방식</h6>
                    <ul class="small text-muted mb-0">
                        <li>첨부파일을 서버에 저장하고 토큰 기반 다운로드 링크를 생성합니다.</li>
                        <li>링크 만료 시간을 설정해 유출 위험을 줄입니다.</li>
                        <li>이메일 웹훅 미설정 시에도 링크는 생성되어 수동 공유할 수 있습니다.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('fileTransferForm');
    const resultBox = document.getElementById('resultBox');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        resultBox.classList.add('d-none');

        const formData = new FormData(form);
        try {
            const res = await fetch('/api/file-transfer', { method: 'POST', body: formData });
            const data = await res.json();
            resultBox.textContent = JSON.stringify(data, null, 2);
            resultBox.classList.remove('d-none');
        } catch (err) {
            resultBox.textContent = `요청 실패: ${err.message}`;
            resultBox.classList.remove('d-none');
        }
    });
</script>

<%- include('../layouts/company-bottom') %>
