<%- include('../layouts/company-top', { title: '공지사항', active: 'notices' }) %>

<!-- Page Banner -->
<div class="page-banner">
  <div class="container">
    <p class="page-banner-eyebrow">NOTICES</p>
    <h1 class="page-banner-title">공지사항</h1>
    <p class="page-banner-sub">에너메이드의 새로운 소식과 중요 공지를 확인하세요.</p>
  </div>
</div>

<!-- Notices Section -->
<section class="notices-section">
  <div class="container">

    <% if (typeof notices !== 'undefined' && notices && notices.length > 0) { %>
    <div class="notice-list">
      <% notices.forEach(function(n, idx) { %>
      <a href="/notices/<%= n.id %>" class="notice-item">
        <span class="notice-num"><%= (typeof page !== 'undefined' ? (page - 1) : 0) * 15 + idx + 1 %></span>
        <span class="notice-title"><%= n.title %></span>
        <span class="notice-meta">
          <%= new Date(n.created_at).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }) %>
        </span>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="notice-empty">
      <p>등록된 공지사항이 없습니다.</p>
    </div>
    <% } %>

    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <nav class="mt-5 d-flex justify-content-center" aria-label="공지사항 페이지 네비게이션">
      <ul class="pagination gap-1">
        <% if (page > 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= page - 1 %>" aria-label="이전 페이지">
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>
        <% } %>

        <% for (var i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
        <% } %>

        <% if (page < totalPages) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= page + 1 %>" aria-label="다음 페이지">
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
        <% } %>
      </ul>
    </nav>
    <% } %>

  </div>
</section>

<%- include('../layouts/company-bottom') %>
