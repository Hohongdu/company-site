<%- include('../layouts/company-top', { title: 'ENERMADE', active: 'home' }) %>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="row align-items-center gy-5" style="min-height:88vh;">
      <div class="col-12 col-lg-6 py-5">
        <p class="hero__eyebrow">세라믹 가공 솔루션 전문기업</p>
        <h1 class="hero__title">
          다양한 소재<br>
          <em>무한한 가능성</em>
        </h1>
        <p class="hero__sub">고객 맞춤형 세라믹 솔루션 제공업체. 첨단 기술과 풍부한 경험으로 최적의 솔루션을 제안합니다.</p>
        <div class="hero__actions">
          <a href="/shop" class="btn btn-primary btn-lg">제품 카탈로그</a>
          <a href="/contact" class="btn btn-outline-light btn-lg">견적 문의하기</a>
        </div>
        <div class="hero__stats">
          <div class="hero__stat">
            <div class="hero__stat-num">20<sup>+</sup></div>
            <div class="hero__stat-label">년 이상 경험</div>
          </div>
          <div class="hero__stat">
            <div class="hero__stat-num">500<sup>+</sup></div>
            <div class="hero__stat-label">납품 거래처</div>
          </div>
          <div class="hero__stat">
            <div class="hero__stat-num">99<sup>%</sup></div>
            <div class="hero__stat-label">고객 만족도</div>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-5 offset-lg-1 d-none d-lg-block">
        <div class="hero__visual">
          <div class="hero__img-wrap">
            <img src="https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=1200&q=80"
              alt="세라믹 가공 현장" />
          </div>
          <div class="hero__badge">
            <div class="hero__badge-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <div class="hero__badge-num">ISO 9001</div>
              <div class="hero__badge-label">품질 인증</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

