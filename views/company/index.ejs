<%- include('../layouts/company-top', { title: '', active: 'home' }) %>

<!-- ── Hero ── -->
<section class="hero">
  <div class="hero-inner">
    <div class="container">
      <p class="hero-eyebrow">Advanced Ceramics Manufacturing Since 2004</p>
      <h1 class="hero-title">
        고성능 세라믹 소재의<br>
        새로운 <em>기준</em>을<br>
        제시합니다
      </h1>
      <p class="hero-sub">
        20년 이상의 기술 경험으로 산업 현장에서 검증된<br>
        고품질 세라믹 소재를 공급합니다
      </p>
      <div class="hero-cta">
        <a href="/shop/products" class="btn btn-primary btn-lg">제품 보기</a>
        <a href="/about" class="btn btn-ghost-light btn-lg">회사 소개</a>
      </div>
    </div>
  </div>
  <div class="hero-stats">
    <div class="container">
      <div class="hero-stats-inner">
        <div class="hero-stat"><div class="hero-stat-num">20<span>+</span></div><div class="hero-stat-label">년 업력</div></div>
        <div class="hero-stat"><div class="hero-stat-num">500<span>+</span></div><div class="hero-stat-label">제품 라인업</div></div>
        <div class="hero-stat"><div class="hero-stat-num">50<span>+</span></div><div class="hero-stat-label">파트너 기업</div></div>
        <div class="hero-stat"><div class="hero-stat-num">99<span>%</span></div><div class="hero-stat-label">고객 만족도</div></div>
      </div>
    </div>
  </div>
</section>

<!-- ── Features ── -->
<section class="feat-section">
  <div class="container">
    <div style="max-width:560px;">
      <span class="sec-eyebrow">Why ENERMADE</span>
      <h2 class="sec-title">왜 에너메이드를<br>선택해야 하는가</h2>
      <p class="sec-sub">세라믹 소재 전문 기업으로서 20년간 쌓아온 기술력과 품질 경험을 바탕으로 고객의 요구를 충족합니다.</p>
    </div>
    <div class="feat-grid">
      <div class="feat-card">
        <span class="feat-num">01</span>
        <div class="feat-icon">🔬</div>
        <div class="feat-card-title">정밀한 소재 품질</div>
        <p class="feat-card-desc">엄격한 품질 관리 프로세스와 첨단 분석 장비로 일관된 고품질 세라믹 소재를 공급합니다.</p>
      </div>
      <div class="feat-card">
        <span class="feat-num">02</span>
        <div class="feat-icon">⚙️</div>
        <div class="feat-card-title">맞춤형 솔루션</div>
        <p class="feat-card-desc">고객의 특수 요구사항에 맞춘 커스텀 소재 개발과 최적화된 사양으로 제품을 공급합니다.</p>
      </div>
      <div class="feat-card">
        <span class="feat-num">03</span>
        <div class="feat-icon">🚀</div>
        <div class="feat-card-title">빠른 납기 대응</div>
        <p class="feat-card-desc">국내 최대 규모의 재고와 효율적인 물류 시스템으로 신속하고 안정적인 납품을 보장합니다.</p>
      </div>
      <div class="feat-card">
        <span class="feat-num">04</span>
        <div class="feat-icon">🛡️</div>
        <div class="feat-card-title">검증된 신뢰성</div>
        <p class="feat-card-desc">국내외 주요 인증을 보유하고 수십 년간 산업 현장에서 검증된 제품 신뢰성을 자랑합니다.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── About Teaser ── -->
<section class="about-section">
  <div class="container">
    <div class="about-grid">
      <div class="about-text-side">
        <span class="sec-eyebrow">Company</span>
        <h2 class="sec-title">기술로 신뢰를,<br>품질로 미래를</h2>
        <p class="sec-sub">
          ENERMADE는 2004년 설립 이래 세라믹 소재 분야에서 끊임없는 기술 혁신과 품질 향상을 추구해 왔습니다.
          국내 최고 수준의 연구개발 역량과 생산 인프라를 바탕으로 고객에게 최상의 솔루션을 제공합니다.
        </p>
        <div class="about-points">
          <div class="about-point"><div class="about-point-dot">✓</div><span>산업용 세라믹 소재 전문 생산 및 공급</span></div>
          <div class="about-point"><div class="about-point-dot">✓</div><span>국내외 인증 보유 및 글로벌 수출 실적</span></div>
          <div class="about-point"><div class="about-point-dot">✓</div><span>전문 연구개발팀 운영을 통한 지속적 기술 혁신</span></div>
        </div>
        <div style="margin-top:2rem;">
          <a href="/about" class="btn btn-dark btn-lg">회사 소개 더 보기</a>
        </div>
      </div>
      <div class="about-visual-side">
        <div class="about-stat-card">
          <div class="about-stat-num">2004</div>
          <div class="about-stat-label">설립 연도 — 20년의 역사</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-num">ISO</div>
          <div class="about-stat-label">국제 품질 인증 보유</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-num">R&D</div>
          <div class="about-stat-label">전문 연구개발팀 운영</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Products Preview ── -->
<section class="products-section">
  <div class="container">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <div>
        <span class="sec-eyebrow">Products</span>
        <h2 class="sec-title">주요 제품</h2>
      </div>
      <a href="/shop/products" class="btn btn-outline">전체 제품 보기 →</a>
    </div>
    <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
      <div class="products-preview-grid">
        <% products.slice(0,3).forEach(function(p) { %>
          <a class="preview-card" href="/shop/products/<%= p.id %>">
            <div class="preview-thumb">
              <img src="<%= p.image || '/images/no-image.png' %>" alt="<%= p.name %>" loading="lazy">
            </div>
            <div class="preview-body">
              <div class="preview-cat"><%= p.category_name || '세라믹 소재' %></div>
              <div class="preview-title"><%= p.name %></div>
              <% if (p.spec) { %><div style="font-size:.8125rem;color:var(--c-muted);margin-top:.25rem;"><%= p.spec %></div><% } %>
            </div>
            <div class="preview-foot">
              <div class="preview-price"><%= Number(p.price || 0).toLocaleString() %><small>원</small></div>
              <span style="font-size:.8125rem;color:var(--c-blue);font-weight:700;">상세 →</span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align:center;padding:4rem 2rem;color:var(--c-muted);background:var(--c-bg);border:1px solid var(--c-border);border-radius:var(--r-xl);margin-top:2rem;">
        등록된 제품이 없습니다. <a href="/shop" style="color:var(--c-blue);font-weight:600;">쇼핑몰 방문하기</a>
      </div>
    <% } %>
  </div>
</section>

<!-- ── CTA ── -->
<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <div>
        <div class="cta-text-title">맞춤 솔루션이 필요하신가요?</div>
        <p class="cta-text-sub">전문 상담팀이 고객의 요구에 맞는 최적의 소재 솔루션을 안내해 드립니다.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary btn-lg">문의하기</a>
        <a href="/shop/products" class="btn btn-ghost-light btn-lg">제품 목록</a>
      </div>
    </div>
  </div>
</section>

<%- include('../layouts/company-bottom') %>
