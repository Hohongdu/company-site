<%- include('../layouts/company-top', { title: '산업용 세라믹 정밀 가공', active: 'home' }) %>

<% const businessAreas = [
  { id: 'ceramic', name: '세라믹 가공', description: '알루미나·지르코니아·탄화규소의 CNC 가공, 연삭, 연마' },
  { id: 'precision', name: '정밀 부품', description: '산업용 부품의 설계·가공부터 3차원 측정 검사까지' },
  { id: 'materials', name: '특수 소재', description: '고온·고압과 마모 환경에 대응하는 세라믹 소재' },
  { id: 'custom', name: '맞춤 제작', description: '도면과 샘플을 바탕으로 소량 시제품부터 양산까지' },
]; %>

<section class="home-hero" aria-labelledby="home-title">
  <div class="container home-hero__layout">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow" data-i18n-auto>산업용 세라믹 · 정밀 부품</p>
      <h1 id="home-title" class="home-hero__title">
        <span data-i18n-auto>공정에 맞춘</span>
        <span data-i18n-auto>정밀 세라믹</span>
      </h1>
      <p class="home-hero__lead" data-i18n-auto>소재 선정과 설계부터 정밀 가공, 시제품, 양산까지. 사용 환경에 맞는 세라믹 부품을 제작합니다.</p>
      <div class="home-actions">
        <a class="btn btn-primary" href="/contact" data-i18n-auto>견적 문의하기</a>
        <a class="btn btn-outline-dark" href="/shop/products" data-i18n-auto>제품 카탈로그</a>
      </div>
    </div>
    <figure class="company-figure home-hero__image">
      <img src="/images/precision-ceramic-components.webp"
           srcset="/images/precision-ceramic-components-720.webp 720w, /images/precision-ceramic-components.webp 1440w"
           sizes="(max-width: 991px) calc(100vw - 2rem), 58vw"
           width="1440" height="960" fetchpriority="high"
           alt="가공된 세라믹 링, 부싱, 플레이트와 노즐의 예시">
      <figcaption data-i18n-auto>정밀 세라믹 부품 예시</figcaption>
    </figure>
  </div>
</section>

<section class="home-section" id="about" aria-labelledby="business-title">
  <div class="container">
    <div class="home-section__header">
      <h2 id="business-title" data-i18n-auto>사업 영역</h2>
      <a class="home-text-link" href="/business" data-i18n-auto>사업 영역 전체 보기</a>
    </div>
    <ul class="home-areas">
      <% for (const area of businessAreas) { %>
        <li>
          <a href="/business#<%= area.id %>">
            <h3 data-i18n-auto><%= area.name %></h3>
            <p data-i18n-auto><%= area.description %></p>
          </a>
        </li>
      <% } %>
    </ul>
  </div>
</section>

<section class="home-section home-quality" id="why" aria-labelledby="quality-title">
  <div class="container home-quality__layout">
    <div class="home-quality__intro">
      <h2 id="quality-title" data-i18n-auto>품질 관리와 기술 지원</h2>
      <p data-i18n-auto>전문 엔지니어가 도면 검토, 소재와 가공 방법 제안, 제품 적용 검토를 지원합니다.</p>
      <a class="home-text-link" href="/research" data-i18n-auto>연구 개발 살펴보기</a>
    </div>
    <dl class="home-quality__facts">
      <div><dt>ISO 9001</dt><dd data-i18n-auto>품질 관리 시스템</dd></div>
      <div><dt>20<sup>+</sup></dt><dd data-i18n-auto>년 이상의 경험</dd></div>
      <div><dt>500<sup>+</sup></dt><dd data-i18n-auto>납품 거래처</dd></div>
      <div><dt>99<sup>%</sup></dt><dd data-i18n-auto>고객 만족도</dd></div>
      <div><dt>24<sup>h</sup></dt><dd data-i18n-auto>기술 지원 대응</dd></div>
    </dl>
  </div>
</section>

<section class="home-partners" aria-labelledby="partners-title">
  <div class="container home-partners__layout">
    <h2 id="partners-title" data-i18n-auto>함께하는 파트너사</h2>
    <ul>
      <li>SAMSUNG</li>
      <li>LG CHEM</li>
      <li>HYUNDAI MOTOR</li>
      <li>SK MATERIALS</li>
      <li>POSCO</li>
      <li>HANWHA</li>
      <li>LOTTE CHEM</li>
      <li>KOLON IND</li>
      <li>DOOSAN</li>
      <li>KIA</li>
    </ul>
  </div>
</section>

<% const questions = [
  {
    question: '최소 주문 수량이 있나요?',
    answer: '제품에 따라 최소 주문 수량이 다릅니다. 맞춤 제작의 경우 소량 주문도 가능하니 문의 주시기 바랍니다.',
  },
  {
    question: '납기는 얼마나 걸리나요?',
    answer: '일반 제품은 주문 후 7~10일, 맞춤 제작은 2~4주 정도 소요됩니다. 긴급 주문의 경우 별도 협의가 가능합니다.',
  },
  {
    question: '샘플 제공이 가능한가요?',
    answer: '네, 일부 제품에 한해 샘플 제공이 가능합니다. 샘플 비용 및 배송비는 별도 협의가 필요합니다.',
  },
  {
    question: '기술 지원이 제공되나요?',
    answer: '제품 적용 검토, 도면 상담, 공정 제안 등 전문 엔지니어가 프로젝트 단계별로 기술 지원을 제공합니다.',
  },
]; %>

<section class="home-section home-faq" id="faq" aria-labelledby="faq-title">
  <div class="container home-faq__layout">
    <div class="home-faq__intro">
      <h2 id="faq-title" data-i18n-auto>자주 묻는 질문</h2>
      <a class="home-text-link" href="/contact" data-i18n-auto>기술 문의 남기기</a>
    </div>
    <div class="accordion accordion-flush" id="faqAccordion">
      <% questions.forEach(({ question, answer }, index) => {
        const expanded = index === 0;
        const panelId = 'faq' + (index + 1);
      %>
        <div class="accordion-item">
          <h3 class="accordion-header">
            <button class="accordion-button<%= expanded ? '' : ' collapsed' %>" type="button"
                    data-bs-toggle="collapse" data-bs-target="#<%= panelId %>"
                    aria-expanded="<%= expanded %>" aria-controls="<%= panelId %>" data-i18n-auto>
              <%= question %>
            </button>
          </h3>
          <div id="<%= panelId %>" class="accordion-collapse collapse<%= expanded ? ' show' : '' %>" data-bs-parent="#faqAccordion">
            <p class="accordion-body" data-i18n-auto><%= answer %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="cta-section" aria-labelledby="quote-title">
  <div class="container home-quote">
    <div>
      <h2 id="quote-title" data-i18n-auto>가공 조건을 알려주세요</h2>
      <p data-i18n-auto>소재, 규격, 수량, 사용 환경을 알려주시면 적합한 가공 방법을 함께 검토합니다.</p>
    </div>
    <a class="btn btn-primary" href="/contact" data-i18n-auto>견적 문의하기</a>
  </div>
</section>

<%- include('../layouts/company-bottom') %>
