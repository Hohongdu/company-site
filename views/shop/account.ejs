<%- include('../layouts/shop-top', { title: '내 정보', active: 'account' }) %>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="list-group shadow-sm">
            <a class="list-group-item list-group-item-action active" href="/shop/account">프로필 관리</a>
            <a class="list-group-item list-group-item-action" href="/shop/account/orders">주문 내역</a>
            <a class="list-group-item list-group-item-action" href="/shop/account/inquiries">문의 내역</a>
        </div>
    </div>
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="mb-3">내 프로필</h4>
                <p class="text-muted mb-4">로그인 사용자 정보를 수정하거나 비밀번호를 변경할 수 있습니다.</p>

                <% if (message) { %>
                    <div class="alert alert-success"><%= message %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/shop/account/profile" method="post" class="row g-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-6">
                        <label class="form-label">이름</label>
                        <input class="form-control" name="name" value="<%= user.name %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">이메일</label>
                        <input class="form-control" name="email" type="email" value="<%= user.email %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">새 비밀번호</label>
                        <input class="form-control" name="password" type="password" placeholder="변경 시에만 입력">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">새 비밀번호 확인</label>
                        <input class="form-control" name="passwordConfirm" type="password" placeholder="비밀번호 확인">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary">저장하기</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="mb-2 text-danger">회원 탈퇴</h5>
                <p class="text-muted mb-3">탈퇴 시 계정 정보는 삭제되고, 주문/문의 내역은 비회원 정보로 보관됩니다.</p>
                <form action="/shop/account/delete" method="post"
                    onsubmit="return confirm('정말 탈퇴하시겠습니까? 이 작업은 되돌릴 수 없습니다.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-outline-danger">회원 탈퇴 진행</button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="mb-2">알림 설정</h5>
                <p class="text-muted mb-3">문의 답변 관련 이메일 알림 수신 여부를 설정할 수 있습니다.</p>
                <form action="/shop/account/notifications" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="emailNotifications" id="emailNotifications"
                            <%= emailNotificationEnabled ? 'checked' : '' %>>
                        <label class="form-check-label" for="emailNotifications">
                            이메일 알림 수신
                        </label>
                    </div>
                    <button class="btn btn-outline-primary">설정 저장</button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="mb-2">배송지 관리</h5>
                <p class="text-muted mb-3">자주 사용하는 배송지를 등록할 수 있습니다.</p>

                <% if (addresses && addresses.length) { %>
                    <div class="list-group mb-3">
                        <% addresses.forEach(address => { %>
                            <div class="list-group-item d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <div class="fw-semibold"><%= address.label || '기본 배송지' %></div>
                                    <div class="text-muted small">
                                        <%= address.recipient_name %> · <%= address.phone || '-' %>
                                    </div>
                                    <div class="text-muted small">
                                        <%= address.address_line1 %> <%= address.address_line2 || '' %> (<%= address.postal_code || '-' %>)
                                    </div>
                                </div>
                                <form method="post" action="/shop/account/addresses/<%= address.id %>/delete">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="btn btn-sm btn-outline-danger">삭제</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border text-muted">등록된 배송지가 없습니다.</div>
                <% } %>

                <form action="/shop/account/addresses" method="post" class="row g-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-3">
                        <input class="form-control" name="label" placeholder="배송지 별칭">
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" name="recipientName" placeholder="수령인" required>
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" name="phone" placeholder="연락처">
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" name="postalCode" placeholder="우편번호">
                    </div>
                    <div class="col-md-6">
                        <input class="form-control" name="addressLine1" placeholder="주소" required>
                    </div>
                    <div class="col-md-6">
                        <input class="form-control" name="addressLine2" placeholder="상세주소">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-primary">배송지 추가</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="mb-2">결제수단 관리</h5>
                <p class="text-muted mb-3">카드/계좌 정보를 간단히 관리합니다.</p>

                <% if (paymentMethods && paymentMethods.length) { %>
                    <div class="list-group mb-3">
                        <% paymentMethods.forEach(method => { %>
                            <div class="list-group-item d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <div class="fw-semibold"><%= method.label || method.provider %></div>
                                    <div class="text-muted small"><%= method.provider %> · **** <%= method.last4 %></div>
                                </div>
                                <form method="post" action="/shop/account/payments/<%= method.id %>/delete">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="btn btn-sm btn-outline-danger">삭제</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border text-muted">등록된 결제수단이 없습니다.</div>
                <% } %>

                <form action="/shop/account/payments" method="post" class="row g-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-4">
                        <input class="form-control" name="label" placeholder="결제수단 별칭">
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" name="provider" placeholder="카드사/은행" required>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" name="last4" placeholder="마지막 4자리" required>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-primary">결제수단 추가</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="mb-2">쿠폰/프로모션</h5>
                <p class="text-muted mb-3">사용 가능한 쿠폰을 확인하거나 등록할 수 있습니다.</p>

                <% if (coupons && coupons.length) { %>
                    <div class="list-group mb-3">
                        <% coupons.forEach(coupon => { %>
                            <div class="list-group-item">
                                <div class="fw-semibold"><%= coupon.code %> · <%= coupon.discount_pct %>%</div>
                                <div class="text-muted small"><%= coupon.description || '설명 없음' %></div>
                                <div class="text-muted small">만료: <%= coupon.expires_at ? coupon.expires_at : '-' %></div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border text-muted">등록된 쿠폰이 없습니다.</div>
                <% } %>

                <form action="/shop/account/coupons" method="post" class="row g-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-4">
                        <input class="form-control" name="code" placeholder="쿠폰 코드" required>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" name="description" placeholder="쿠폰 설명">
                    </div>
                    <div class="col-md-2">
                        <input class="form-control" name="discountPct" placeholder="할인율(%)">
                    </div>
                    <div class="col-md-2">
                        <input class="form-control" name="expiresAt" placeholder="만료일(YYYY-MM-DD)">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-primary">쿠폰 등록</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/shop-bottom') %>
