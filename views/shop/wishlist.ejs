<%- include('../layouts/shop-top', { title: '위시리스트', active: 'wishlist' }) %>

<div class="shop-card p-4">
    <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">위시리스트</h3>
            <p class="text-muted mb-0">찜한 상품을 확인할 수 있습니다.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/shop/products">상품 보러가기</a>
    </div>

    <% if (!items || items.length === 0) { %>
        <div class="alert alert-light border text-muted">찜한 상품이 없습니다.</div>
    <% } else { %>
        <div class="row g-3">
            <% items.forEach(item => { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="shop-card p-3 h-100">
                        <div class="bg-light rounded-3 mb-2" style="height:160px; overflow:hidden;">
                            <img src="<%= item.image || '/images/no-image.png' %>"
                                alt="<%= item.name %>" style="width:100%; height:100%; object-fit:cover;">
                        </div>
                        <div class="fw-semibold"><%= item.name %></div>
                        <div class="text-muted small"><%= Number(item.price || 0).toLocaleString() %>원</div>
                        <div class="mt-2">
                            <a class="btn btn-sm btn-outline-primary" href="/shop/products/<%= item.id %>">상세보기</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('../layouts/shop-bottom') %>
