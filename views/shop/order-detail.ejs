<%- include('../layouts/shop-top', { title: '주문 상세', active: '' }) %>

<!-- Breadcrumb -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:1.5rem;">
  <div>
    <a href="/shop/account/orders" class="btn btn-outline btn-sm">← 주문 내역</a>
  </div>
  <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
    <a href="/shop/products" class="btn btn-outline btn-sm">상품 더 보기</a>
    <a href="/shop/cart" class="btn btn-dark btn-sm">장바구니</a>
  </div>
</div>

<!-- Order header -->
<div style="margin-bottom:1.25rem;">
  <h1 style="font-size:1.25rem;font-weight:800;letter-spacing:-.02em;margin-bottom:.4rem;">주문 상세</h1>
  <div style="font-size:.8125rem;color:#888;">
    주문번호: <strong style="color:#333;"><%= order.order_number %></strong>
    &nbsp;&middot;&nbsp;
    상태: <span class="badge"><%= order.status %></span>
  </div>
</div>

<% const _orderItems = (typeof items !== 'undefined' && Array.isArray(items)) ? items : []; %>
<% if (_orderItems.length === 0) { %>
  <div class="alert alert-success">주문 상품이 없습니다.</div>
<% } else { %>
  <div class="order-detail-layout">
    <!-- Items card -->
    <div style="background:#fff;border:1px solid #eee;border-radius:10px;padding:1.5rem;">
      <h3 style="font-size:.9375rem;font-weight:700;margin-bottom:1rem;">주문 상품</h3>
      <% _orderItems.forEach(function(it) { %>
        <div class="order-item-row">
          <div class="order-item-thumb">
            <% if (it.product_image) { %>
              <img src="<%= it.product_image %>" alt="<%= it.product_name %>" style="width:100%;height:100%;object-fit:cover;">
            <% } else { %>
              <div style="width:100%;height:100%;background:#f2f2f2;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#bbb;">없음</div>
            <% } %>
          </div>
          <div class="order-item-meta">
            <div class="order-item-name"><%= it.product_name %></div>
            <div style="font-size:.8rem;color:#888;margin-top:.25rem;">
              단가: ₩<%= Number(it.unit_price || 0).toLocaleString() %> &middot; 수량: <%= it.quantity %>
            </div>
            <% if (it.product_spec) { %>
              <div style="font-size:.8rem;color:#aaa;">규격: <%= it.product_spec %></div>
            <% } %>
            <div style="margin-top:.5rem;">
              <a href="/shop/products/<%= it.product_id %>" class="btn btn-outline btn-sm">상품 상세</a>
            </div>
          </div>
          <div class="order-item-total">₩<%= Number(it.total_price || 0).toLocaleString() %></div>
        </div>
      <% }); %>
    </div>

    <!-- Summary card -->
    <div class="order-summary-card">
      <h3 style="font-size:.9375rem;font-weight:700;margin-bottom:1rem;">주문 요약</h3>
      <div class="order-summary-row">
        <span>총 금액</span>
        <span>₩<%= Number(order.total_amount || 0).toLocaleString() %></span>
      </div>
      <div class="order-summary-row">
        <span>배송비</span>
        <span>무료</span>
      </div>
      <div class="order-summary-row" style="font-weight:700;border-top:1px solid #eee;padding-top:.75rem;margin-top:.5rem;">
        <span>결제 금액</span>
        <span>₩<%= Number(order.total_amount || 0).toLocaleString() %></span>
      </div>
      <div class="order-summary-row" style="margin-top:.5rem;">
        <span>결제 상태</span>
        <span><%= (typeof payment !== 'undefined' && payment) ? payment.status : '미결제' %></span>
      </div>
      <% if (typeof payment !== 'undefined' && payment && payment.paid_at) { %>
        <div class="order-summary-row">
          <span>결제일시</span>
          <span style="font-size:.8rem;"><%= new Date(payment.paid_at).toLocaleDateString('ko-KR') %></span>
        </div>
      <% } %>
      <div style="margin-top:1.25rem;">
        <a href="/shop/account/orders" class="btn btn-outline" style="width:100%;text-align:center;">주문 목록으로</a>
      </div>
    </div>
  </div>
<% } %>

<%- include('../layouts/shop-bottom') %>
