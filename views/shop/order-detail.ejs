<%- include('../layouts/shop-top', { title: '주문 상세' , active: '' }) %>

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">주문 상세</h3>
            <div class="text-muted small">
                주문번호: <strong>#<%= order.id %></strong>
                <% if (order.created_at) { %>
                    · <%= String(order.created_at).slice(0, 19).replace('T',' ') %>
      <% } %>
    </div>
  </div>

  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-sm btn-outline-secondary" href="/shop/products">상품 더 보기</a>
    <a class="btn btn-sm btn-outline-dark" href="/shop/cart">장바구니</a>
  </div>
</div>

<%
  // 상태 표시(원하면 라우트에서 status를 더 세분화해도 됨)
  const status = (order.status || ' DRAFT').toUpperCase(); let badgeClass='text-bg-secondary' ; let statusLabel=status;
                        if (status==='DRAFT' ) { badgeClass='text-bg-secondary' ; statusLabel='작성중' ; } else if
                        (status==='ORDERED' ) { badgeClass='text-bg-primary' ; statusLabel='주문완료' ; } else if
                        (status==='PAID' ) { badgeClass='text-bg-success' ; statusLabel='결제완료' ; } else if
                        (status==='CANCELED' ) { badgeClass='text-bg-danger' ; statusLabel='취소' ; } %>

                        <div class="row g-3">
                            <!-- 좌측: 주문 아이템 -->
                            <div class="col-12 col-lg-8">
                                <div class="shop-card p-3">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                        <div class="fw-semibold">주문 상품</div>
                                        <span class="badge <%= badgeClass %>">
                                            <%= statusLabel %>
                                        </span>
                                    </div>

                                    <% if (!items || items.length===0) { %>
                                        <div class="text-muted">주문 상품이 없습니다.</div>
                                        <% } else { %>
                                            <% items.forEach(it=> { %>
                                                <div class="d-flex gap-3 flex-wrap py-3 border-top">
                                                    <div class="bg-light rounded-3"
                                                        style="width:120px; height:90px; overflow:hidden;">
                                                        <img src="<%= it.image || 'https://via.placeholder.com/600x400?text=No+Image' %>"
                                                            alt="<%= it.name %>"
                                                            style="width:100%; height:100%; object-fit:cover;">
                                                    </div>

                                                    <div class="flex-grow-1" style="min-width:220px;">
                                                        <div class="d-flex justify-content-between flex-wrap gap-2">
                                                            <div>
                                                                <div class="fw-semibold">
                                                                    <%= it.name %>
                                                                </div>
                                                                <% if (it.spec) { %>
                                                                    <div class="text-muted small">규격: <%= it.spec %>
                                                                    </div>
                                                                    <% } %>
                                                                        <div class="text-muted small">
                                                                            단가: <%= Number(it.price ||
                                                                                0).toLocaleString() %>원 · 수량: <%=
                                                                                    it.quantity %>
                                                                        </div>
                                                            </div>

                                                            <div class="fw-bold">
                                                                <%= Number((it.price || 0) * (it.quantity ||
                                                                    0)).toLocaleString() %>원
                                                            </div>
                                                        </div>

                                                        <div class="mt-2 d-flex gap-2 flex-wrap">
                                                            <a class="btn btn-sm btn-outline-secondary"
                                                                href="/shop/products/<%= it.product_id %>">
                                                                상품 상세
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                                    <% } %>
                                </div>
                            </div>

                            <!-- 우측: 주문 요약 -->
                            <div class="col-12 col-lg-4">
                                <div class="shop-card p-3">
                                    <h5 class="fw-bold mb-3">주문 요약</h5>

                                    <div class="d-flex justify-content-between text-muted">
                                        <span>상품 금액</span>
                                        <span>
                                            <%= Number(order.total_amount || 0).toLocaleString() %>원
                                        </span>
                                    </div>

                                    <div class="d-flex justify-content-between text-muted mt-1">
                                        <span>배송/기타</span>
                                        <span>0원</span>
                                    </div>

                                    <hr>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold">총 합계</span>
                                        <span class="fs-4 fw-bold">
                                            <%= Number(order.total_amount || 0).toLocaleString() %>원
                                        </span>
                                    </div>

                                    <div class="mt-3 d-grid gap-2">
                                        <button class="btn btn-primary" type="button" disabled>
                                            결제(추후 연동)
                                        </button>

                                        <% if (status !=='CANCELED' ) { %>
                                            <button class="btn btn-outline-danger" type="button" disabled>
                                                주문 취소(추후)
                                            </button>
                                            <% } %>
                                    </div>

                                    <div class="text-muted small mt-3">
                                        결제 기능은 추후 PG 연동 시 활성화됩니다.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <%- include('../layouts/shop-bottom') %>