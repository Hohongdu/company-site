<%- include('../layouts/shop-top', { title: '주문 상세' , active: '' }) %>

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">주문 상세</h3>
            <div class="text-muted small">주문번호: <strong>#<%= order.id %></strong></div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-secondary" href="/shop/products">상품 더 보기</a>
            <a class="btn btn-sm btn-outline-dark" href="/shop/cart">장바구니</a>
        </div>
    </div>

    <% if (!items || items.length===0) { %>
        <div class="alert alert-light border">주문 상품이 없습니다.</div>
        <% } else { %>
            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <div class="shop-card p-3">
                        <h5 class="fw-bold mb-3">주문 상품</h5>
                        <% items.forEach(it=> { %>
                            <div class="d-flex gap-3 flex-wrap py-3 border-top">
                                <div class="bg-light rounded-3" style="width:120px; height:90px; overflow:hidden;">
                                    <img src="<%= it.image || 'https://via.placeholder.com/600x400?text=No+Image' %>"
                                        alt="<%= it.name %>" style="width:100%; height:100%; object-fit:cover;">
                                </div>

                                <div class="flex-grow-1" style="min-width:220px;">
                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                        <div>
                                            <div class="fw-semibold">
                                                <%= it.name %>
                                            </div>
                                            <div class="text-muted small">단가: <%= Number(it.price || 0).toLocaleString()
                                                    %>원 · 수량: <%= it.quantity %>
                                            </div>
                                            <% if (it.spec) { %>
                                                <div class="text-muted small">규격: <%= it.spec %>
                                                </div>
                                                <% } %>
                                        </div>
                                        <div class="fw-bold">
                                            <%= Number((it.price || 0) * (it.quantity || 0)).toLocaleString() %>원
                                        </div>
                                    </div>

                                    <div class="mt-2">
                                        <a class="btn btn-sm btn-outline-secondary"
                                            href="/shop/products/<%= it.product_id %>">상품 상세</a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="shop-card p-3">
                        <h5 class="fw-bold mb-3">주문 요약</h5>
                        <div class="d-flex justify-content-between text-muted">
                            <span>총 금액</span><span>
                                <%= Number(order.total_amount || 0).toLocaleString() %>원
                            </span>
                        </div>
                        <button class="btn btn-primary w-100 mt-3" disabled>결제(추후 연동)</button>
                    </div>
                </div>
            </div>
            <% } %>

                <%- include('../layouts/shop-bottom') %>