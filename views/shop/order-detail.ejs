<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>주문 상세 - 우리 회사</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/header') %>

        <main class="py-5">
            <div class="container" style="max-width: 720px;">
                <h1 class="h3 mb-4">주문 상세</h1>

                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h5 mb-3">
                            <%= order.product_name %>
                        </h2>

                        <% if (order.product_image) { %>
                            <img src="<%= order.product_image %>" class="img-fluid rounded mb-3"
                                alt="<%= order.product_name %>">
                            <% } %>

                                <p class="mb-1 text-muted">
                                    상태:
                                    <% if (order.status==='PENDING' ) { %>
                                        <span class="badge bg-warning text-dark">결제 대기</span>
                                        <% } else if (order.status==='PAID' ) { %>
                                            <span class="badge bg-success">결제 완료</span>
                                            <% } else if (order.status==='CANCELED' ) { %>
                                                <span class="badge bg-secondary">취소됨</span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-dark">
                                                        <%= order.status %>
                                                    </span>
                                                    <% } %>
                                </p>

                                <p class="mb-1">주문 번호: <strong>
                                        <%= order.id %>
                                    </strong></p>
                                <p class="mb-3">주문 금액: <strong>
                                        <%= order.amount.toLocaleString() %>원
                                    </strong></p>

                                <p class="mb-0 text-muted small">
                                    주문일: <%= order.created_at.toISOString().slice(0, 19).replace('T', ' ' ) %>
                                </p>
                    </div>
                </div>

                <!-- ✅ 여기서부터 나중에 카카오페이/토스페이 연동 버튼 들어감 -->
                <% if (order.status==='PENDING' ) { %>
                    <h2 class="h5 mb-3">결제 수단 선택</h2>

                    <div class="d-flex flex-wrap gap-2">
                        <!-- 카카오페이 -->
                        <form method="POST" action="/payments/ready">
                            <input type="hidden" name="orderId" value="<%= order.id %>">
                            <input type="hidden" name="method" value="KAKAO">
                            <button type="submit" class="btn btn-warning">
                                카카오페이로 결제
                            </button>
                        </form>

                        <!-- 네이버페이 -->
                        <form method="POST" action="/payments/ready">
                            <input type="hidden" name="orderId" value="<%= order.id %>">
                            <input type="hidden" name="method" value="NAVER">
                            <button type="submit" class="btn btn-success">
                                네이버페이로 결제
                            </button>
                        </form>

                        <!-- 토스페이 -->
                        <form method="POST" action="/payments/ready">
                            <input type="hidden" name="orderId" value="<%= order.id %>">
                            <input type="hidden" name="method" value="TOSS">
                            <button type="submit" class="btn btn-primary">
                                토스페이로 결제
                            </button>
                        </form>
                    </div>
                    <% } %>


						<a href="/shop/products" class="btn btn-link mt-3">&laquo; 상품 목록으로 돌아가기</a>
            </div>
        </main>

        <%- include('../partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>