<% const _activeItem = typeof activeItem !== 'undefined' ? activeItem : ''; %>
<aside class="acct-sidebar">
  <div class="acct-sidebar__head">
    <div class="acct-avatar"><%= user.name.charAt(0) %></div>
    <div>
      <div class="acct-user-name"><%= user.name %></div>
      <div class="acct-user-email"><%= user.email %></div>
    </div>
  </div>
  <nav class="acct-nav">
    <!-- 내 정보 -->
    <div class="acct-nav-group-label">내 정보</div>
    <a class="acct-nav-link <%= _activeItem === 'profile' ? 'is-active' : '' %>" href="/shop/account">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      내 정보
    </a>
    <a class="acct-nav-link <%= _activeItem === 'inquiries' ? 'is-active' : '' %>" href="/shop/account/inquiries">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      문의 내역
    </a>

    <!-- 쇼핑몰 -->
    <div class="acct-nav-group-label" style="margin-top:12px;">쇼핑몰</div>
    <a class="acct-nav-link <%= _activeItem === 'shop-info' ? 'is-active' : '' %>" href="/shop/account/shop-info">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      쇼핑몰 내 정보
    </a>

    <!-- 관리자 전용 -->
    <% if (user && user.is_admin) { %>
      <div class="acct-nav-group-label" style="margin-top:12px;">관리자</div>
      <a class="acct-nav-link" href="/admin/dashboard">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        관리자 대시보드
      </a>
    <% } %>
  </nav>
</aside>
