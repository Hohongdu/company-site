<% const _activeItem = typeof activeItem !== 'undefined' ? activeItem : ''; %>
<aside class="acct-sidebar">
  <div class="acct-sidebar__head">
    <div class="acct-avatar"><%= user.name.charAt(0) %></div>
    <div>
      <div class="acct-user-name"><%= user.name %></div>
      <div class="acct-user-email"><%= user.email %></div>
    </div>
  </div>
  <nav class="acct-nav">
    <div class="acct-nav-group-label">내 정보</div>
    <a class="acct-nav-link <%= _activeItem === 'profile' ? 'is-active' : '' %>" href="/shop/account">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      내 정보
    </a>
    <a class="acct-nav-link <%= _activeItem === 'orders' ? 'is-active' : '' %>" href="/shop/account/orders">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      주문 내역
    </a>
    <a class="acct-nav-link <%= _activeItem === 'inquiries' ? 'is-active' : '' %>" href="/shop/account/inquiries">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      문의 내역
    </a>
    <% if (user && user.is_admin) { %>
    <div class="acct-nav-group-label" style="margin-top:12px;">관리자</div>
    <a class="acct-nav-link" href="/admin/dashboard">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
      </svg>
      관리자 대시보드
    </a>
    <% } %>
  </nav>
</aside>
