<%- include('../layouts/shop-top', { title: '결제 상세', active: '', showBack: true, backUrl: '/shop/orders/' + order.order_number }) %>

<%
const providerMap = {
  KAKAO:  '카카오페이',
  TOSS:   '토스페이',
  NAVER:  '네이버페이',
  CARD:   '신용카드',
  BANK:   '계좌이체',
};
const providerName = providerMap[payment.provider] || payment.provider || '-';

function fmtDatetime(d) {
  if (!d) return '-';
  const dt = new Date(d);
  if (isNaN(dt)) return String(d);
  const pad = n => String(n).padStart(2, '0');
  return dt.getFullYear() + '-' + pad(dt.getMonth()+1) + '-' + pad(dt.getDate())
       + ' ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes()) + ':' + pad(dt.getSeconds());
}

const paidAt    = fmtDatetime(payment.approved_at || payment.requested_at);
const paidAmt   = Number(payment.amount || order.total_amount || 0);
const orderAmt  = Number(order.total_amount || 0);
%>

<div style="background:#f5f5f5;min-height:100%;padding-bottom:32px;">

  <!-- ── 총 주문 금액 ── -->
  <div style="padding:28px 20px 8px;">
    <h2 style="font-size:18px;font-weight:800;color:#111;margin:0 0 16px;">총 주문 금액</h2>
    <div style="background:#fff;border-radius:16px;overflow:hidden;">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:1px dashed #e5e5e5;">
        <span style="font-size:15px;color:#888;">주문금액</span>
        <span style="font-size:15px;color:#888;"><%= orderAmt.toLocaleString() %> 원</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 20px;">
        <span style="font-size:15px;font-weight:700;color:#111;">최종 결제금액</span>
        <span style="font-size:15px;font-weight:700;color:#111;"><%= paidAmt.toLocaleString() %> 원</span>
      </div>
    </div>
  </div>

  <!-- ── 결제정보 ── -->
  <div style="padding:24px 20px 8px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <h2 style="font-size:18px;font-weight:800;color:#111;margin:0;">결제정보</h2>
      <% if (payment.receipt_url) { %>
        <a href="<%= payment.receipt_url %>" target="_blank" rel="noopener noreferrer"
           style="font-size:14px;color:#555;text-decoration:none;display:flex;align-items:center;gap:2px;">
          영수증 보기
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="flex-shrink:0;">
            <path d="M9 18l6-6-6-6" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      <% } %>
    </div>
    <div style="background:#fff;border-radius:16px;overflow:hidden;">
      <!-- 주문번호 -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid #f0f0f0;">
        <span style="font-size:14px;color:#888;white-space:nowrap;flex-shrink:0;margin-right:16px;">주문번호</span>
        <span style="font-size:14px;color:#111;font-weight:500;word-break:break-all;text-align:right;"><%= order.order_number %></span>
      </div>
      <!-- 결제방법 -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid #f0f0f0;">
        <span style="font-size:14px;color:#888;">결제방법</span>
        <span style="font-size:14px;color:#111;font-weight:500;"><%= providerName %></span>
      </div>
      <!-- 결제일시 -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid #f0f0f0;">
        <span style="font-size:14px;color:#888;white-space:nowrap;flex-shrink:0;margin-right:16px;">결제일시</span>
        <span style="font-size:14px;color:#111;font-weight:500;"><%= paidAt %></span>
      </div>
      <!-- 결제금액 -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;">
        <span style="font-size:14px;color:#888;">결제금액</span>
        <span style="font-size:14px;color:#111;font-weight:500;"><%= paidAmt.toLocaleString() %> 원</span>
      </div>
    </div>
  </div>

</div>

<%- include('../layouts/shop-bottom') %>
