<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>장바구니 - SHOP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
</head>

<body class="shop-wrap">
    <%- include('../partials/header-shop') %>

        <main class="py-4">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between mb-3">
                    <div>
                        <h3 class="fw-bold mb-1">장바구니</h3>
                        <% if (isGuest) { %>
                            <div class="text-muted small">비회원 장바구니입니다. 브라우저 세션이 끝나면 초기화됩니다.</div>
                            <% } else { %>
                                <div class="text-muted small">회원 장바구니입니다. 로그인 상태에서 유지됩니다.</div>
                                <% } %>
                    </div>
                    <!-- ✅ 여기 한 군데에 버튼 2개를 같이 둔다 -->
                    <div class="d-flex gap-2 flex-shrink-0">
                        <a class="btn btn-outline-dark btn-sm" href="/shop/products">상품 더 보기</a>

                        <form action="/shop/cart/clear" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                onclick="return confirm('장바구니를 비울까요?');">
                                장바구니 전체 비우기
                            </button>
                        </form>
                    </div>


                </div>


                <% if (!items || items.length===0) { %>
                    <div class="card shop-card">
                        <div class="card-body p-4">
                            <div class="text-muted">장바구니가 비어 있어요.</div>
                            <a href="/shop/products" class="btn btn-dark mt-3">상품 보러가기</a>
                        </div>
                    </div>
                    <% } else { %>

                        <div class="row g-3">
                            <!-- 아이템 리스트 -->
                            <div class="col-lg-8">
                                <% items.forEach(item=> { %>
                                    <div class="card shop-card mb-3">
                                        <div class="card-body">
                                            <div class="d-flex gap-3">
                                                <img src="<%= item.image ? item.image : 'https://via.placeholder.com/300x200?text=No+Image' %>"
                                                    style="width:120px;height:90px;object-fit:cover;border-radius:12px;background:#eee;"
                                                    alt="<%= item.name %>" />

                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                        <div>
                                                            <div class="fw-semibold">
                                                                <%= item.name %>
                                                            </div>
                                                            <div class="text-muted small">
                                                                단가: <%= Number(item.price||0).toLocaleString() %>원
                                                            </div>
                                                        </div>
                                                        <div class="price">
                                                            <%= Number((item.price||0) *
                                                                (item.quantity||0)).toLocaleString() %>원
                                                        </div>
                                                    </div>

                                                    <div class="d-flex gap-2 align-items-center mt-3 flex-wrap">
                                                        <!-- 수량 업데이트 -->
                                                        <form action="/shop/cart/update" method="post"
                                                            class="d-flex gap-2 align-items-center">
                                                            <% if (!isGuest) { %>
                                                                <input type="hidden" name="cartItemId"
                                                                    value="<%= item.cart_item_id %>">
                                                                <% } %>
                                                                    <input type="hidden" name="productId"
                                                                        value="<%= item.product_id %>">

                                                                    <input type="number" name="quantity"
                                                                        class="form-control form-control-sm"
                                                                        value="<%= item.quantity %>" min="1"
                                                                        style="max-width:100px;">
                                                                    <button class="btn btn-sm btn-outline-dark"
                                                                        type="submit">변경</button>
                                                        </form>

                                                        <!-- 삭제 -->
                                                        <form action="/shop/cart/remove" method="post">
                                                            <% if (!isGuest) { %>
                                                                <input type="hidden" name="cartItemId"
                                                                    value="<%= item.cart_item_id %>">
                                                                <% } %>
                                                                    <input type="hidden" name="productId"
                                                                        value="<%= item.product_id %>">
                                                                    <button class="btn btn-sm btn-outline-secondary"
                                                                        type="submit">삭제</button>
                                                        </form>



                                                        <a class="btn btn-sm btn-link text-decoration-none"
                                                            href="/shop/products/<%= item.product_id %>">상세보기</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>

                            <!-- 결제 요약(결제는 나중에) -->
                            <div class="col-lg-4">
                                <div class="card shop-card">
                                    <div class="card-body p-4">
                                        <div class="fw-bold mb-2">주문 요약</div>

                                        <div class="d-flex justify-content-between text-muted mb-1">
                                            <span>상품 금액</span>
                                            <span>
                                                <%= Number(totalAmount||0).toLocaleString() %>원
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between text-muted mb-3">
                                            <span>배송/기타</span>
                                            <span>0원</span>
                                        </div>

                                        <hr>

                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="fw-bold">총 합계</span>
                                            <span class="price fs-4">
                                                <%= Number(totalAmount||0).toLocaleString() %>원
                                            </span>
                                        </div>

                                        <button class="btn btn-dark w-100" type="button" disabled>
                                            결제(추후 연동)
                                        </button>

                                        <% if (isGuest) { %>
                                            <div class="small text-muted mt-3">
                                                💡 로그인하면 장바구니를 유지할 수 있어요.
                                                <a href="/auth/login" class="text-decoration-none">로그인</a>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <% } %>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>