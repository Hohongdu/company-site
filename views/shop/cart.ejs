<%- include('../layouts/shop-top', { title: '장바구니' , active: 'cart' }) %>

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">장바구니</h3>
            <div class="text-muted small">
                <% if (isGuest) { %>
                    비회원 장바구니입니다. 브라우저 세션이 끝나면 초기화됩니다.
                    <% } else { %>
                        회원 장바구니입니다. 로그인 상태에서 유지됩니다.
                        <% } %>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-secondary" href="/shop/products">상품 더 보기</a>
            <form action="/shop/cart/clear" method="post" class="m-0" onsubmit="return confirm('장바구니를 비울까요?');">
                <button class="btn btn-sm btn-outline-danger" type="submit">장바구니 전체 비우기</button>
            </form>
        </div>
    </div>

    <% if (!items || items.length===0) { %>
        <div class="shop-card p-4">
            <div class="text-muted mb-3">장바구니가 비어 있어요.</div>
            <a href="/shop/products" class="btn btn-primary btn-sm">상품 보러가기</a>
        </div>
        <% } else { %>

            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <% items.forEach(it=> { %>
                        <div class="shop-card p-3 mb-3">
                            <div class="d-flex gap-3 flex-wrap">
                                <div class="bg-light rounded-3" style="width:120px; height:90px; overflow:hidden;">
                                    <img src="<%= it.image || 'https://via.placeholder.com/600x400?text=No+Image' %>"
                                        alt="<%= it.name %>" style="width:100%; height:100%; object-fit:cover;">
                                </div>

                                <div class="flex-grow-1" style="min-width:220px;">
                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                        <div>
                                            <div class="fw-semibold">
                                                <%= it.name %>
                                            </div>
                                            <div class="text-muted small">단가: <%= Number(it.price || 0).toLocaleString()
                                                    %>원</div>
                                        </div>
                                        <div class="fw-bold">
                                            <%= Number((it.price || 0) * (it.quantity || 0)).toLocaleString() %>원
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 flex-wrap align-items-center mt-3">
                                        <form action="/shop/cart/update" method="post" class="d-flex gap-2 flex-wrap">
                                            <% if (!isGuest) { %>
                                                <input type="hidden" name="cartItemId" value="<%= it.cart_item_id %>">
                                                <% } %>
                                                    <input type="hidden" name="productId" value="<%= it.product_id %>">

                                                    <input type="number" name="quantity" min="1"
                                                        value="<%= it.quantity %>" class="form-control form-control-sm"
                                                        style="max-width:90px;">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                        type="submit">변경</button>
                                        </form>

                                        <form action="/shop/cart/remove" method="post" class="m-0">
                                            <% if (!isGuest) { %>
                                                <input type="hidden" name="cartItemId" value="<%= it.cart_item_id %>">
                                                <% } %>
                                                    <input type="hidden" name="productId" value="<%= it.product_id %>">
                                                    <button class="btn btn-sm btn-outline-danger"
                                                        type="submit">삭제</button>
                                        </form>

                                        <a class="btn btn-sm btn-outline-secondary"
                                            href="/shop/products/<%= it.product_id %>">상세보기</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="shop-card p-3">
                        <h5 class="fw-bold mb-3">주문 요약</h5>
                        <div class="d-flex justify-content-between text-muted">
                            <span>상품 금액</span>
                            <span>
                                <%= Number(totalAmount || 0).toLocaleString() %>원
                            </span>
                        </div>
                        <div class="d-flex justify-content-between text-muted mt-1">
                            <span>배송/기타</span>
                            <span>0원</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">총 합계</span>
                            <span class="fs-4 fw-bold">
                                <%= Number(totalAmount || 0).toLocaleString() %>원
                            </span>
                        </div>
                        <button class="btn btn-primary w-100 mt-3" disabled>결제(추후 연동)</button>

                        <% if (isGuest) { %>
                            <div class="text-muted small mt-3">
                                로그인하면 장바구니를 유지할 수 있어요.
                                <a href="/auth/login" class="text-decoration-none">로그인</a>
                            </div>
                            <% } %>
                    </div>
                </div>
            </div>

            <% } %>

                <%- include('../layouts/shop-bottom') %>