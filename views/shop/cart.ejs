<%- include('../layouts/shop-top', { title: '장바구니', active: 'cart' }) %>

<!-- ─────────────────────────────────────────────
   장바구니 화면
   구조: 오류 알림 → 카트 아이템 리스트 → 주문 요약 → sticky 결제 CTA
   비회원 주문 폼은 결제 버튼 위에 위치 (기존 동작 유지)
   ───────────────────────────────────────────── -->

<% if (cartError) { %>
  <div class="app-section">
    <div class="app-alert app-alert--warn"><%= cartError %></div>
  </div>
<% } %>

<!-- ── 대량 주문 진입 버튼 ── -->
<div class="app-section--pad" style="padding-bottom:0;padding-top:16px;">
  <button class="app-btn app-btn--outline" style="width:100%;gap:8px;justify-content:flex-start;"
          data-sheet-open="bulkOrderSheet" data-sheet-overlay="appSheetOverlay"
          type="button">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"
            stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="currentColor" stroke-width="1.8"/>
      <line x1="12" y1="22.08" x2="12" y2="12" stroke="currentColor" stroke-width="1.8"/>
    </svg>
    <span data-i18n-auto>📦 대량 주문 (제품코드·수량 일괄 입력)</span>
    <span style="margin-left:auto;font-size:11px;color:var(--c-muted);">B2B</span>
  </button>
</div>

<!-- ── 빈 장바구니 ── -->
<% if (!items || items.length === 0) { %>
  <div class="app-section--pad" style="padding-top:48px;">
    <div class="app-empty">
      <div class="app-empty__icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"
                stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.5"/>
          <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round"/>
        </svg>
      </div>
      <p class="app-empty__title">장바구니가 비어 있어요</p>
      <p class="app-empty__desc">마음에 드는 상품을 담아보세요</p>
      <a href="/shop/products" class="app-btn app-btn--primary app-btn--sm">상품 보러가기</a>
    </div>
  </div>

<% } else { %>

  <!-- ── 비회원 안내 배너 ── -->
  <% if (isGuest) { %>
    <div class="app-section" style="padding-bottom:0;">
      <div class="app-alert app-alert--info">
        비회원 장바구니입니다. 브라우저 세션이 끝나면 초기화됩니다.
      </div>
    </div>
  <% } %>

  <!-- ── 카트 아이템 목록 ── -->
  <div class="app-cart-list">
    <% items.forEach(function(it) { %>
      <div class="app-cart-item">

        <!-- 상품 썸네일 -->
        <a href="/shop/products/<%= it.product_id %>"
           class="app-cart-item__thumb"
           aria-label="<%= it.name %> 상세 보기">
          <% if (it.image) { %>
            <img src="<%= it.image %>" alt="<%= it.name %>" loading="lazy">
          <% } else { %>
            <div class="app-product-card__placeholder" style="height:100%;border-radius:var(--r-lg);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="2"
                      stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
          <% } %>
        </a>

        <!-- 상품 정보 -->
        <div class="app-cart-item__info">
          <div class="app-cart-item__name">
            <a href="/shop/products/<%= it.product_id %>"
               style="color:inherit;text-decoration:none;"><%= it.name %></a>
          </div>
          <div class="app-cart-item__unit">
            단가 <%= Number(it.price || 0).toLocaleString() %>원
          </div>

          <!-- 수량 조절 + 소계 -->
          <div class="app-cart-item__controls">
            <form action="/shop/cart/update" method="post"
                  class="app-cart-qty" id="qtyForm_<%= it.product_id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (!isGuest) { %>
                <input type="hidden" name="cartItemId" value="<%= it.cart_item_id %>">
              <% } %>
              <input type="hidden" name="productId" value="<%= it.product_id %>">
              <button class="app-cart-qty__btn" type="button"
                      data-qty-dec="qty_<%= it.product_id %>"
                      aria-label="수량 감소">−</button>
              <input class="app-cart-qty__num" id="qty_<%= it.product_id %>"
                     name="quantity" type="number"
                     min="1" value="<%= it.quantity %>"
                     data-unit-price="<%= it.price || 0 %>"
                     data-subtotal-id="sub_<%= it.product_id %>"
                     readonly>
              <button class="app-cart-qty__btn" type="button"
                      data-qty-inc="qty_<%= it.product_id %>"
                      aria-label="수량 증가">+</button>
              <!-- 변경 적용: 체크 아이콘 submit -->
              <button type="submit"
                      style="width:30px;height:30px;border:none;background:var(--c-accent);color:#fff;border-radius:var(--r);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-left:4px;"
                      aria-label="수량 변경 적용">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                  <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
            <span class="app-cart-item__price" id="sub_<%= it.product_id %>">
              <%= Number((it.price || 0) * (it.quantity || 0)).toLocaleString() %>원
            </span>
          </div>
        </div><!-- /info -->

        <!-- 삭제 버튼 -->
        <form action="/shop/cart/remove" method="post" style="flex-shrink:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (!isGuest) { %>
            <input type="hidden" name="cartItemId" value="<%= it.cart_item_id %>">
          <% } %>
          <input type="hidden" name="productId" value="<%= it.product_id %>">
          <button class="app-cart-remove" type="submit" aria-label="<%= it.name %> 삭제">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round"/>
            </svg>
          </button>
        </form>

      </div><!-- /app-cart-item -->
    <% }); %>

    <!-- 전체 비우기 -->
    <div style="padding:12px 16px;text-align:right;">
      <form action="/shop/cart/clear" method="post" class="m-0"
            onsubmit="return confirm('장바구니를 비울까요?');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="app-btn app-btn--sm"
                style="color:var(--c-muted);border:1px solid var(--c-border);"
                type="submit">전체 비우기</button>
      </form>
    </div>

  </div><!-- /app-cart-list -->


  <!-- ── 주문 요약 ── -->
  <div class="app-section--pad" style="padding-top:8px;padding-bottom:120px;">
    <div class="app-order-summary">
      <div class="app-order-summary__row">
        <span>총 상품금액</span>
        <span id="summaryTotal"><%= Number(totalAmount || 0).toLocaleString() %>원</span>
      </div>
      <div class="app-order-summary__row">
        <span>배송비</span>
        <span>0원</span>
      </div>
      <div class="app-order-summary__row app-order-summary__row--total">
        <span>총 주문금액</span>
        <span id="summaryFinal"><%= Number(totalAmount || 0).toLocaleString() %>원</span>
      </div>
    </div>

    <!-- 비회원 주문 정보 폼 -->
    <% if (paymentEnabled && isGuest) { %>
      <div class="app-guest-form">
        <p class="app-guest-form__title">비회원 주문 정보</p>
        <div class="app-field">
          <label class="app-field__label" for="guestName">이름</label>
          <input class="app-field__input" id="guestName" name="guestName"
                 form="checkoutForm"
                 required value="<%= guestInfo?.guestName || '' %>">
        </div>
        <div class="app-field">
          <label class="app-field__label" for="guestEmail">이메일</label>
          <input class="app-field__input" id="guestEmail" name="guestEmail"
                 type="email" form="checkoutForm"
                 placeholder="또는 연락처 입력"
                 value="<%= guestInfo?.guestEmail || '' %>">
        </div>
        <div class="app-field">
          <label class="app-field__label" for="guestPhone">연락처</label>
          <input class="app-field__input" id="guestPhone" name="guestPhone"
                 form="checkoutForm"
                 placeholder="010-0000-0000"
                 value="<%= guestInfo?.guestPhone || '' %>">
        </div>
      </div>
    <% } %>
  </div>


  <!-- ── Sticky 결제 CTA ── -->
  <div class="app-cart-cta">
    <div class="app-cart-cta__inner">
      <% if (paymentEnabled) { %>
        <%# 비회원 필드는 위 guest-form의 input들이 form="checkoutForm"으로 연결됨 %>
        <form action="/shop/checkout/kakao" method="post"
              id="checkoutForm" style="flex:1;display:flex;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="app-btn app-btn--primary" type="submit"
                  style="flex:1;font-size:16px;font-weight:700;">
            주문서 작성
            <span style="font-size:14px;font-weight:400;opacity:.85;margin-left:6px;">
              (<span id="ctaTotal"><%= Number(totalAmount || 0).toLocaleString() %></span>원)
            </span>
          </button>
        </form>
      <% } else { %>
        <button class="app-btn app-btn--outline" style="flex:1;" disabled>
          결제 미설정 (관리자 문의)
        </button>
      <% } %>
    </div>
  </div><!-- /app-cart-cta -->

<% } %><!-- /if items -->


<!-- ── 수량 변경 시 소계 실시간 업데이트 ── -->
<script>
(function () {
  'use strict';

  /* 수량 input change → 소계 업데이트 */
  document.addEventListener('change', function (e) {
    var input = e.target;
    if (input.tagName !== 'INPUT' || input.type !== 'number') return;

    var unitPrice  = parseInt(input.getAttribute('data-unit-price')) || 0;
    var subtotalId = input.getAttribute('data-subtotal-id');
    if (!subtotalId) return;

    var qty      = Math.max(1, parseInt(input.value) || 1);
    var subtotal = unitPrice * qty;
    var el = document.getElementById(subtotalId);
    if (el) el.textContent = subtotal.toLocaleString() + '원';

    /* 주문 합계 재계산 */
    recalcTotal();
  });

  function recalcTotal() {
    var total = 0;
    document.querySelectorAll('[data-unit-price]').forEach(function (input) {
      var unit = parseInt(input.getAttribute('data-unit-price')) || 0;
      var qty  = Math.max(1, parseInt(input.value) || 1);
      total += unit * qty;
    });
    var fmt = total.toLocaleString();
    ['summaryTotal','summaryFinal','ctaTotal'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.textContent = (id === 'ctaTotal') ? fmt : fmt + '원';
    });
  }
})();
</script>

<!-- ══════════════════════════════════════════
   대량 주문 드로어 (Bulk SKU Order Sheet)
══════════════════════════════════════════ -->
<div class="app-sheet" id="bulkOrderSheet" role="dialog" aria-modal="true" aria-label="대량 주문">
  <div class="app-sheet__handle" aria-hidden="true"></div>
  <div class="app-sheet__head">
    <h2 class="app-sheet__title" data-i18n-auto>📦 대량 주문</h2>
    <button class="app-sheet__close" type="button" data-sheet-close aria-label="닫기">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="app-sheet__body" style="overflow-y:auto;">
    <div style="background:#eff6ff;border-radius:10px;padding:12px 14px;margin-bottom:20px;font-size:12px;color:#1e40af;line-height:1.6;">
      <strong>💡 사용법</strong><br>
      제품코드와 수량을 한 줄에 하나씩 입력하세요.<br>
      구분자: 콤마(,) · 탭 · 2칸 이상 공백 모두 인식<br>
      <code style="font-size:11px;">INS-A40-001, 10</code><br>
      <code style="font-size:11px;">NOZ-Z12-003  5</code>
    </div>

    <div class="app-field" style="margin-bottom:16px;">
      <label class="app-field__label" for="bulkSkuInput" data-i18n-auto>제품코드·수량 입력 (최대 100줄)</label>
      <textarea class="app-field__input" id="bulkSkuInput"
                rows="8" style="font-family:monospace;font-size:13px;resize:vertical;"
                placeholder="INS-A40-001, 10&#10;NOZ-Z12-003  5&#10;LNR-HT200	3"></textarea>
    </div>

    <div id="bulkSheetResult" style="display:none;margin-bottom:16px;"></div>
  </div>

  <div class="app-sheet__footer">
    <button class="app-btn app-btn--outline" style="flex:1;" type="button"
            data-sheet-close data-i18n-auto>취소</button>
    <button class="app-btn app-btn--primary" style="flex:2;" type="button"
            id="bulkSubmitBtn" data-i18n-auto>장바구니에 추가</button>
  </div>
</div><!-- /bulkOrderSheet -->

<script>
(function () {
  'use strict';
  var submitBtn = document.getElementById('bulkSubmitBtn');
  var resultEl  = document.getElementById('bulkSheetResult');
  var csrf      = '<%= csrfToken %>';

  function showResult(html, type) {
    resultEl.style.display = 'block';
    resultEl.innerHTML = '<div class="app-alert app-alert--' + (type||'info') + '">' + html + '</div>';
  }

  if (submitBtn) {
    submitBtn.addEventListener('click', function () {
      var raw = (document.getElementById('bulkSkuInput').value || '').trim();
      if (!raw) {
        showResult('제품코드와 수량을 입력해주세요.', 'warn');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '처리 중…';
      resultEl.style.display = 'none';

      fetch('/shop/cart/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
        body: JSON.stringify({ skuList: raw }),
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.ok) {
            showResult(
              '✅ <strong>' + (res.addedCount || 0) + '개 SKU</strong>가 추가되었습니다. — ' + res.message,
              'success'
            );
            submitBtn.textContent = '추가 완료';
            /* 장바구니 카운트 뱃지 갱신 */
            if (typeof window.__updateCartCount === 'function') window.__updateCartCount();
            setTimeout(function () {
              window.AppSheet && window.AppSheet.close('bulkOrderSheet', 'appSheetOverlay');
              resultEl.style.display = 'none';
              submitBtn.disabled = false;
              submitBtn.textContent = '장바구니에 추가';
              /* 페이지 새로고침으로 카트 목록 반영 */
              location.reload();
            }, 2000);
          } else {
            showResult('⚠️ ' + (res.message || '처리 중 오류가 발생했습니다.'), 'warn');
            submitBtn.disabled = false;
            submitBtn.textContent = '장바구니에 추가';
          }
        })
        .catch(function () {
          showResult('⚠️ 네트워크 오류. 다시 시도해주세요.', 'warn');
          submitBtn.disabled = false;
          submitBtn.textContent = '장바구니에 추가';
        });
    });
  }
})();
</script>

<%- include('../layouts/shop-bottom') %>
