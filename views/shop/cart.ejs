<%- include('../layouts/shop-top', { title: '장바구니' , active: 'cart' }) %>

    <div class="cart-header">
        <div>
            <h3 class="fw-bold mb-1">장바구니</h3>
            <div class="text-muted small">
                <% if (isGuest) { %>
                    비회원 장바구니입니다. 브라우저 세션이 끝나면 초기화됩니다.
                <% } else { %>
                    회원 장바구니입니다. 로그인 상태에서 유지됩니다.
                <% } %>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-secondary" href="/shop/products">상품 더 보기</a>
            <form action="/shop/cart/clear" method="post" class="m-0" onsubmit="return confirm('장바구니를 비울까요?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-danger" type="submit">장바구니 전체 비우기</button>
            </form>
        </div>
    </div>

    <% if (cartError) { %>
        <div class="alert alert-warning"><%= cartError %></div>
        <% } %>

            <% if (!items || items.length===0) { %>
        <div class="shop-card p-4">
            <div class="text-muted mb-3">장바구니가 비어 있어요.</div>
            <a href="/shop/products" class="btn btn-primary btn-sm">상품 보러가기</a>
        </div>
        <% } else { %>

            <div class="cart-grid">
                <div class="cart-items">
                    <% items.forEach(it=> { %>
                        <div class="cart-item">
                            <div class="cart-thumb">
                                <img src="<%= it.image || 'https://via.placeholder.com/600x400?text=No+Image' %>"
                                    alt="<%= it.name %>">
                            </div>
                            <div class="cart-info">
                                <div class="cart-title"><%= it.name %></div>
                                <div class="cart-sub">단가: <%= Number(it.price || 0).toLocaleString() %>원</div>
                                <div class="cart-actions">
                                    <form action="/shop/cart/update" method="post" class="d-flex gap-2 flex-wrap">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <% if (!isGuest) { %>
                                            <input type="hidden" name="cartItemId" value="<%= it.cart_item_id %>">
                                        <% } %>
                                        <input type="hidden" name="productId" value="<%= it.product_id %>">
                                        <input type="number" name="quantity" min="1" value="<%= it.quantity %>"
                                            class="form-control form-control-sm">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">수량 변경</button>
                                    </form>
                                    <form action="/shop/cart/remove" method="post" class="m-0">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <% if (!isGuest) { %>
                                            <input type="hidden" name="cartItemId" value="<%= it.cart_item_id %>">
                                        <% } %>
                                        <input type="hidden" name="productId" value="<%= it.product_id %>">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">삭제</button>
                                    </form>
                                    <a class="btn btn-sm btn-outline-secondary" href="/shop/products/<%= it.product_id %>">상세보기</a>
                                </div>
                            </div>
                            <div class="cart-price">
                                <div class="fw-bold"><%= Number((it.price || 0) * (it.quantity || 0)).toLocaleString() %>원</div>
                            </div>
                        </div>
                        <% }) %>
                </div>

                <aside class="cart-summary">
                    <div class="shop-card p-3">
                        <h5 class="fw-bold mb-3">주문정보</h5>
                        <div class="d-flex justify-content-between text-muted">
                            <span>총 상품금액</span><span><%= Number(totalAmount || 0).toLocaleString() %>원</span>
                        </div>
                        <% if (typeof discountAmount !== 'undefined' && discountAmount > 0) { %>
                        <div class="d-flex justify-content-between text-danger mt-1">
                            <span>쿠폰 할인 (<%= appliedCoupon.discount_pct %>%)</span>
                            <span>-<%= Number(discountAmount).toLocaleString() %>원</span>
                        </div>
                        <% } %>
                        <div class="d-flex justify-content-between text-muted mt-1">
                            <span>배송비</span><span>0원</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">총 주문금액</span>
                            <span class="fs-4 fw-bold"><%= Number(typeof finalAmount !== 'undefined' ? finalAmount : totalAmount).toLocaleString() %>원</span>
                        </div>

                        <%/* 쿠폰 입력 */%>
                        <% if (user) { %>
                        <div class="mt-3">
                            <% if (typeof appliedCoupon !== 'undefined' && appliedCoupon) { %>
                                <div class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border border-success mb-2">
                                    <span class="text-success small fw-semibold flex-grow-1">✓ <%= appliedCoupon.code %> (<%= appliedCoupon.discount_pct %>% 할인 적용)</span>
                                    <form action="/shop/cart/coupon/remove" method="post" class="m-0">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">제거</button>
                                    </form>
                                </div>
                            <% } else { %>
                                <form action="/shop/cart/coupon" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input class="form-control form-control-sm" name="couponCode" placeholder="쿠폰 코드 입력" maxlength="50">
                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">적용</button>
                                </form>
                            <% } %>
                        </div>
                        <% } %>

                        <% if (paymentEnabled) { %>
                            <form action="/shop/checkout/kakao" method="post" class="m-0">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <% if (isGuest) { %>
                                    <div class="border rounded-3 p-3 mt-3 bg-light">
                                        <div class="fw-semibold mb-2">비회원 주문 정보</div>
                                        <div class="mb-2">
                                            <label class="form-label small">이름</label>
                                            <input class="form-control form-control-sm" name="guestName" required
                                                value="<%= guestInfo?.guestName || '' %>">
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">이메일</label>
                                            <input class="form-control form-control-sm" name="guestEmail" type="email"
                                                placeholder="또는 연락처 입력" value="<%= guestInfo?.guestEmail || '' %>">
                                        </div>
                                        <div>
                                            <label class="form-label small">연락처</label>
                                            <input class="form-control form-control-sm" name="guestPhone"
                                                placeholder="010-0000-0000" value="<%= guestInfo?.guestPhone || '' %>">
                                        </div>
                                    </div>
                                <% } %>

                                <div class="border rounded-3 p-3 mt-3 bg-light">
                                    <div class="fw-semibold mb-2">배송 정보</div>
                                    <div class="mb-2">
                                        <label class="form-label small">받는 분</label>
                                        <input class="form-control form-control-sm" name="shippingName" placeholder="수령인 이름">
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">연락처</label>
                                        <input class="form-control form-control-sm" name="shippingPhone" placeholder="010-0000-0000">
                                    </div>
                                    <div>
                                        <label class="form-label small">배송 주소</label>
                                        <input class="form-control form-control-sm" name="shippingAddress" placeholder="주소를 입력해주세요">
                                    </div>
                                </div>

                                <button class="btn btn-primary w-100 mt-3" type="submit">주문서 작성</button>
                            </form>
                        <% } else { %>
                            <button class="btn btn-primary w-100 mt-3" disabled>결제(카카오페이 미설정)</button>
                        <% } %>
                    </div>
                </aside>
            </div>

            <% } %>

                <%- include('../layouts/shop-bottom') %>
