<%- include('../layouts/shop-top', { title: '비회원 주문 조회' , active: 'order_lookup' }) %>

<div class="shop-card p-4">
    <h3 class="fw-bold mb-2">비회원 주문 조회</h3>
    <p class="text-muted mb-4">주문번호와 이메일 또는 연락처를 입력하면 주문 상태를 확인할 수 있습니다.</p>

    <% if (error) { %>
        <div class="alert alert-warning"><%= error %></div>
        <% } %>

            <form action="/shop/orders/guest" method="post" class="row g-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-12 col-md-6">
                    <label class="form-label">주문번호</label>
                    <input class="form-control" name="orderNumber" required value="<%= form.orderNumber %>">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">이메일</label>
                    <input class="form-control" type="email" name="guestEmail" value="<%= form.guestEmail %>">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">연락처</label>
                    <input class="form-control" name="guestPhone" placeholder="010-0000-0000"
                        value="<%= form.guestPhone %>">
                </div>
                <div class="col-12">
                    <button class="btn btn-primary">조회하기</button>
                </div>
            </form>
</div>

<%- include('../layouts/shop-bottom') %>
