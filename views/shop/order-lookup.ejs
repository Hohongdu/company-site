<%- include('../layouts/shop-top', { title: '비회원 주문 조회' , active: 'order_lookup' }) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="shop-card p-4">
        <h3 class="fw-bold mb-2" data-i18n-auto>비회원 주문 조회</h3>
        <p class="text-muted mb-4" data-i18n-auto>주문번호와 이메일 또는 연락처를 입력하면 주문 상태를 확인할 수 있습니다.</p>

        <% if (error) { %>
          <div class="alert alert-warning"><%= error %></div>
        <% } %>

        <form action="/shop/orders/guest" method="post" class="row g-3">
          <div class="col-12 col-md-6">
            <label class="form-label" data-i18n-auto>주문번호</label>
            <input class="form-control" name="orderNumber" required value="<%= form.orderNumber %>">
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label" data-i18n-auto>이메일</label>
            <input class="form-control" type="email" name="guestEmail" value="<%= form.guestEmail %>">
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label" data-i18n-auto>연락처</label>
            <input class="form-control" name="guestPhone"
              placeholder="010-0000-0000" value="<%= form.guestPhone %>">
          </div>
          <div class="col-12">
            <button class="btn btn-primary" data-i18n-auto>조회하기</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
