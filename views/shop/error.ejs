<%- include('../layouts/shop-top', { title: '오류', active: '' }) %>

<div class="result-page">
  <div class="result-card">
    <div class="result-icon" style="color:#e67e22;">⚠️</div>
    <div class="result-title">요청 처리 중 오류가 발생했습니다</div>
    <div class="result-sub"><%= typeof message !== 'undefined' && message ? message : '잠시 후 다시 시도해주세요.' %></div>

    <div style="display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem;">
      <a href="<%= typeof backHref !== 'undefined' && backHref ? backHref : '/shop/account/orders' %>" class="btn btn-outline">이전 페이지로</a>
      <a href="/shop" class="btn btn-primary">쇼핑몰 홈</a>
    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
