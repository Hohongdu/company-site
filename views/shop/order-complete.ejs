<%- include('../layouts/shop-top', { title: '주문 완료' , active: '' }) %>

<div class="shop-card p-4 mb-3">
    <h3 class="fw-bold mb-2">주문이 완료되었습니다 🎉</h3>
    <p class="text-muted mb-4">결제가 정상적으로 처리되었어요. 주문번호로 언제든 조회할 수 있습니다.</p>

    <div class="border rounded-4 p-3 mb-3 bg-light">
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">주문번호</span>
            <strong><%= order?.order_number %></strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">결제 상태</span>
            <strong><%= payment?.status || 'APPROVED' %></strong>
        </div>
        <div class="d-flex justify-content-between">
            <span class="text-muted">결제 금액</span>
            <strong><%= Number(order?.total_amount || 0).toLocaleString() %>원</strong>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a href="/shop/products" class="btn btn-primary">계속 쇼핑하기</a>
        <% if (order?.order_number && order?.user_id) { %>
            <a href="/shop/orders/<%= order.order_number %>" class="btn btn-outline-secondary">주문 상세</a>
            <% } %>
            <a href="/shop/orders/guest" class="btn btn-outline-dark">비회원 주문 조회</a>
    </div>
</div>

<div class="shop-card p-3">
    <h5 class="fw-bold mb-3">주문 상품</h5>
    <% if (!items || items.length===0) { %>
        <div class="text-muted">주문 상품이 없습니다.</div>
        <% } else { %>
            <% items.forEach(it=> { %>
                <div class="d-flex gap-3 flex-wrap py-3 border-top">
                    <!-- HIGH-B 수정: via.placeholder.com 서비스 종료 → 이미지 없을 때 인라인 SVG 사용 -->
                    <div class="bg-light rounded-3" style="width:120px; height:90px; overflow:hidden; display:flex; align-items:center; justify-content:center;">
                        <% if (it.product_image) { %>
                            <img src="<%= it.product_image %>" alt="<%= it.product_name %>" style="width:100%; height:100%; object-fit:cover;">
                        <% } else { %>
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="2" stroke="#cbd5e1" stroke-width="1.5"/>
                                <path d="M3 9l4-4 4 4 4-4 4 4" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="8.5" cy="13.5" r="1.5" fill="#cbd5e1"/>
                            </svg>
                        <% } %>
                    </div>

                    <div class="flex-grow-1" style="min-width:220px;">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <div>
                                <div class="fw-semibold">
                                    <%= it.product_name %>
                                </div>
                                <div class="text-muted small">단가: <%= Number(it.unit_price || 0).toLocaleString() %>원 ·
                                    수량: <%= it.quantity %>
                                </div>
                                <% if (it.product_spec) { %>
                                    <div class="text-muted small">규격: <%= it.product_spec %>
                                    </div>
                                    <% } %>
                            </div>
                            <div class="fw-bold">
                                <%= Number(it.total_price || 0).toLocaleString() %>원
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
                    <% } %>
</div>

<%- include('../layouts/shop-bottom') %>
