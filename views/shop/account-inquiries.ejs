<%- include('../layouts/shop-top', { title: '문의 내역', active: 'account' }) %>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="list-group shadow-sm">
            <a class="list-group-item list-group-item-action" href="/shop/account">프로필 관리</a>
            <a class="list-group-item list-group-item-action" href="/shop/account/orders">주문 내역</a>
            <a class="list-group-item list-group-item-action active" href="/shop/account/inquiries">문의 내역</a>
        </div>
    </div>
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div>
                        <h4 class="mb-1">문의 내역</h4>
                        <p class="text-muted mb-0">문의 답변 상태와 내용을 확인할 수 있습니다.</p>
                    </div>
                    <a class="btn btn-outline-primary" href="/shop/inquiries">새 문의 작성</a>
                </div>

                <% if (!inquiries || inquiries.length === 0) { %>
                    <div class="alert alert-light border text-muted">등록된 문의가 없습니다.</div>
                <% } %>

                <% inquiries.forEach(inquiry => { %>
                    <div class="border rounded-3 p-3 mb-3 bg-white">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <div>
                                <div class="fw-semibold"><%= inquiry.title %></div>
                                <div class="text-muted small">
                                    접수일: <%= new Date(inquiry.created_at).toLocaleString() %>
                                </div>
                            </div>
                            <span class="badge <%= inquiry.answer_content ? 'bg-success' : 'bg-secondary' %>">
                                <%= inquiry.answer_content ? '답변 완료' : '답변 대기' %>
                            </span>
                        </div>
                        <div class="mt-3">
                            <div class="text-muted small mb-1">문의 내용</div>
                            <div class="border rounded p-2 bg-light" style="white-space:pre-wrap;"><%= inquiry.content %></div>
                        </div>
                        <% if (inquiry.answer_content) { %>
                            <div class="mt-3">
                                <div class="text-muted small mb-1">답변</div>
                                <div class="border rounded p-2" style="white-space:pre-wrap;"><%= inquiry.answer_content %></div>
                            </div>
                        <% } %>
                        <% if (inquiry.notification_status) { %>
                            <div class="text-muted small mt-2">
                                알림 상태: <%= inquiry.notification_channel || 'NONE' %> (<%= inquiry.notification_status %>)
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/shop-bottom') %>
