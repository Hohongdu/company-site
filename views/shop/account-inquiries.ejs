<%- include('../layouts/shop-top', { title: '문의 내역', active: 'account' }) %>

<div class="account-layout">
  <!-- Sidebar -->
  <aside class="account-sidebar">
    <a href="/shop/account" class="account-nav-link">프로필 관리</a>
    <a href="/shop/account/orders" class="account-nav-link">주문 내역</a>
    <a href="/shop/account/inquiries" class="account-nav-link active">문의 내역</a>
  </aside>

  <!-- Main -->
  <main>
    <div class="account-card">
      <div class="account-card-head" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
        <div>
          <div class="account-card-title">문의 내역</div>
          <div class="account-card-sub">문의 답변 상태와 내용을 확인할 수 있습니다.</div>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap;">
          <a href="/shop/inquiries" class="btn btn-outline btn-sm">새 문의 작성</a>
          <a href="/shop/inquiries/guest" class="btn btn-outline btn-sm">비회원 문의 조회</a>
        </div>
      </div>
      <div class="account-card-body">
        <% const _inquiries = (typeof inquiries !== 'undefined' && Array.isArray(inquiries)) ? inquiries : []; %>
        <% if (_inquiries.length === 0) { %>
          <p style="color:#aaa;font-size:.875rem;text-align:center;padding:2rem 0;">등록된 문의가 없습니다.</p>
        <% } else { %>
          <div style="display:flex;flex-direction:column;gap:.75rem;">
            <% _inquiries.forEach(function(inquiry) { %>
              <div class="inquiry-thread">
                <div class="inquiry-head">
                  <div>
                    <div class="inquiry-title"><%= inquiry.title %></div>
                    <div class="inquiry-date">접수일: <%= new Date(inquiry.created_at).toLocaleDateString('ko-KR') %></div>
                  </div>
                  <span class="badge" style="<%= inquiry.answer_content ? 'background:#27ae60;color:#fff;' : 'background:#95a5a6;color:#fff;' %>">
                    <%= inquiry.answer_content ? '답변 완료' : '답변 대기' %>
                  </span>
                </div>
                <div class="inquiry-content-block">
                  <div style="font-size:.75rem;color:#aaa;margin-bottom:.3rem;">문의 내용</div>
                  <div style="white-space:pre-wrap;font-size:.875rem;"><%= inquiry.content %></div>
                </div>
                <% if (inquiry.answer_content) { %>
                  <div class="inquiry-answer-block">
                    <div class="inquiry-answer-label">답변</div>
                    <div style="white-space:pre-wrap;font-size:.875rem;"><%= inquiry.answer_content %></div>
                  </div>
                <% } %>
                <% if (inquiry.notification_status) { %>
                  <div style="font-size:.75rem;color:#bbb;margin-top:.5rem;">
                    알림: <%= inquiry.notification_channel || 'NONE' %> (<%= inquiry.notification_status %>)
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/shop-bottom') %>
