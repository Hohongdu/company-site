<%- include('../layouts/shop-top', { title: '문의 내역', active: 'account' }) %>

<div class="shop-account-wrap">
  <aside class="acct-sidebar">
    <div class="acct-sidebar__head">
      <div class="acct-avatar"><%= user.name.charAt(0) %></div>
      <div>
        <div class="acct-user-name"><%= user.name %></div>
        <div class="acct-user-email"><%= user.email %></div>
      </div>
    </div>
    <nav class="acct-nav">
      <a class="acct-nav-link" href="/shop/account">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        프로필 관리
      </a>
      <a class="acct-nav-link" href="/shop/account/orders">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        주문 내역
      </a>
      <a class="acct-nav-link is-active" href="/shop/account/inquiries">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        문의 내역
      </a>
    </nav>
  </aside>

  <div class="acct-content">
    <div class="acct-card">
      <div class="acct-card__head" style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
        <div>
          <h4 class="acct-card__title">문의 내역</h4>
          <p class="acct-card__desc">문의 답변 상태와 내용을 확인할 수 있습니다.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a class="btn btn-outline-primary btn-sm" href="/shop/inquiries">새 문의 작성</a>
          <a class="btn btn-outline-secondary btn-sm" href="/shop/inquiries/guest">비회원 문의 조회</a>
        </div>
      </div>

      <% if (!inquiries || inquiries.length === 0) { %>
        <div class="acct-empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <p>등록된 문의가 없습니다.</p>
        </div>
      <% } %>

      <div class="acct-inquiry-list">
        <% inquiries.forEach(inquiry => { %>
          <div class="acct-inquiry-item">
            <div class="acct-inquiry-header">
              <div>
                <div class="acct-inquiry-title"><%= inquiry.title %></div>
                <div class="acct-inquiry-date">접수일: <%= new Date(inquiry.created_at).toLocaleDateString('ko-KR') %></div>
              </div>
              <span class="acct-status-badge acct-status-badge--<%= inquiry.answer_content ? 'done' : 'pending' %>">
                <%= inquiry.answer_content ? '답변 완료' : '답변 대기' %>
              </span>
            </div>
            <div class="acct-inquiry-body">
              <div class="acct-inquiry-label">문의 내용</div>
              <div class="acct-inquiry-text"><%= inquiry.content %></div>
            </div>
            <% if (inquiry.answer_content) { %>
              <div class="acct-inquiry-answer">
                <div class="acct-inquiry-label">답변</div>
                <div class="acct-inquiry-text acct-inquiry-text--answer"><%= inquiry.answer_content %></div>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
