<%- include('../layouts/shop-top', { title: '상품 목록' , active: 'products' }) %>

    <div class="shop-grid">
        <aside class="shop-sidebar">
            <div class="shop-card p-3">
                <div class="fw-semibold mb-2" data-i18n data-i18n-ko="필터" data-i18n-en="Filter"
                    data-i18n-zh="筛选" data-i18n-ja="フィルター">필터</div>
                <form action="/shop/products" method="get" class="mb-3">
                    <input class="form-control form-control-sm" name="q" placeholder="검색어를 입력하세요" value="<%= query || '' %>"
                        data-i18n-placeholder data-i18n-placeholder-ko="검색어를 입력하세요"
                        data-i18n-placeholder-en="Enter a keyword" data-i18n-placeholder-zh="请输入关键词"
                        data-i18n-placeholder-ja="検索語を入力してください">
                </form>

                <div class="fw-semibold mb-2" data-i18n data-i18n-ko="카테고리" data-i18n-en="Category"
                    data-i18n-zh="类别" data-i18n-ja="カテゴリ">카테고리</div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/shop/products?category=all"
                        class="chip <%= (!currentCategory || currentCategory==='all') ? 'active' : '' %>">
                        <span data-i18n data-i18n-ko="전체" data-i18n-en="All" data-i18n-zh="全部" data-i18n-ja="すべて">전체</span>
                    </a>
                    <% (categories || []).forEach(c=> { %>
                        <a href="/shop/products?category=<%= c.slug %>"
                            class="chip <%= (currentCategory === c.slug) ? 'active' : '' %>">
                            <%= c.name %>
                        </a>
                        <% }) %>
                </div>
            </div>
        </aside>

        <section class="shop-content">
            <div class="shop-toolbar">
                <div>
                    <h3 class="fw-bold mb-1" data-i18n data-i18n-ko="상품 목록" data-i18n-en="Product List"
                        data-i18n-zh="商品列表" data-i18n-ja="商品一覧">상품 목록</h3>
                    <div class="text-muted small" data-i18n data-i18n-ko="카테고리와 검색으로 상품을 찾을 수 있습니다."
                        data-i18n-en="Find products by category or search."
                        data-i18n-zh="可以通过分类或搜索查找商品。" data-i18n-ja="カテゴリや検索で商品を探せます。">
                        카테고리와 검색으로 상품을 찾을 수 있습니다.
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-sm btn-outline-dark" href="/shop/cart" data-i18n data-i18n-ko="장바구니"
                        data-i18n-en="Cart" data-i18n-zh="购物车" data-i18n-ja="カート">장바구니</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/shop/products?category=all" data-i18n
                        data-i18n-ko="전체보기" data-i18n-en="View All" data-i18n-zh="查看全部" data-i18n-ja="すべて表示">전체보기</a>
                </div>
            </div>

            <% if (!products || products.length===0) { %>
                <div class="alert alert-light border" data-i18n data-i18n-ko="해당 조건의 상품이 없습니다."
                    data-i18n-en="No products match the filter." data-i18n-zh="没有符合条件的商品。"
                    data-i18n-ja="条件に合う商品がありません。">해당 조건의 상품이 없습니다.</div>
            <% } else { %>
                <div class="product-grid">
                    <% (products || []).forEach(p=> { %>
                        <div class="product-card">
                            <a href="/shop/products/<%= p.id %>">
                                <div class="product-thumb">
                                    <img src="<%= p.image_thumb || p.image || 'https://via.placeholder.com/800x600?text=No+Image' %>"
                                        alt="<%= p.name %>">
                                </div>
                            </a>
                            <div class="product-body">
                                <div class="product-title"><%= p.name %></div>
                                <% if (p.spec) { %>
                                    <div class="product-spec"><%= p.spec %></div>
                                <% } %>
                                <div class="product-meta">
                                    <div class="price"><%= Number(p.price || 0).toLocaleString() %>원</div>
                                    <% if (p.category_name) { %>
                                        <span class="badge text-bg-light border"><%= p.category_name %></span>
                                    <% } else { %>
                                        <span class="badge text-bg-light border" data-i18n data-i18n-ko="미분류"
                                            data-i18n-en="Uncategorized" data-i18n-zh="未分类" data-i18n-ja="未分類">
                                            미분류
                                        </span>
                                    <% } %>
                                </div>
                                <form action="/shop/cart/add" method="post" class="product-actions">
                                    <input type="hidden" name="productId" value="<%= p.id %>">
                                    <input type="number" name="quantity" min="1" value="1" class="form-control form-control-sm">
                                    <button class="btn btn-sm btn-primary flex-grow-1" type="submit" data-i18n
                                        data-i18n-ko="담기" data-i18n-en="Add" data-i18n-zh="加入"
                                        data-i18n-ja="追加">담기</button>
                                    <a class="btn btn-sm btn-outline-secondary" href="/shop/products/<%= p.id %>" data-i18n
                                        data-i18n-ko="상세" data-i18n-en="Details" data-i18n-zh="详情"
                                        data-i18n-ja="詳細">상세</a>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </div>

    <%- include('../layouts/shop-bottom') %>
