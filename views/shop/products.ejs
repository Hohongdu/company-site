<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <title>우리 회사 - 상품 목록</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/header') %>

        <main class="py-5">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0">상품 목록</h1>

                    <% if (typeof user !=='undefined' && user) { %>
                        <a href="/admin/products/new" class="btn btn-outline-primary btn-sm">
                            상품 추가
                        </a>
                        <% } %>
                </div>

                <div class="row g-4">
                    <% if (products && products.length> 0) { %>
                        <% products.forEach(item=> { %>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <% if (item.image) { %>
                                        <img src="<%= item.image %>" class="card-img-top" alt="<%= item.name %>">
                                        <% } else { %>
                                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white"
                                                style="height: 180px;">
                                                이미지 준비중
                                            </div>
                                            <% } %>
                                                <div class="card-body d-flex flex-column">
                                                    <h5 class="card-title">
                                                        <%= item.name %>
                                                    </h5>
                                                    <p class="card-text text-muted mb-2">
                                                        <%= item.description %>
                                                    </p>
                                                    <p class="fw-bold mb-3">
                                                        <%= item.price.toLocaleString() %>원
                                                    </p>

                                                    <div class="mt-auto d-flex flex-wrap gap-2">
												<a href="/shop/products/<%= item.id %>"
                                                            class="btn btn-sm btn-outline-secondary">
                                                            상세 보기
                                                        </a>
                                                        <button class="btn btn-sm btn-primary" disabled>
                                                            구매 (준비중)
                                                        </button>

                                                        <% if (typeof user !=='undefined' && user) { %>
                                                            <a href="/admin/products/<%= item.id %>/edit"
                                                                class="btn btn-sm btn-outline-warning">
                                                                수정
                                                            </a>

                                                            <form method="POST"
                                                                action="/admin/products/<%= item.id %>/delete"
                                                                onsubmit="return confirm('정말 이 상품을 삭제하시겠습니까?');"
                                                                style="display: inline;">
                                                                <button type="submit"
                                                                    class="btn btn-sm btn-outline-danger">
                                                                    삭제
                                                                </button>
                                                            </form>
                                                            <% } %>
                                                    </div>

                                                </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="col-12">
                                        <div class="alert alert-info">
                                            등록된 상품이 없습니다. 나중에 관리자 페이지에서 상품을 추가하세요.
                                        </div>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </main>

        <%- include('../partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>