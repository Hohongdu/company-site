<%- include('../layouts/shop-top', { title: '상품 목록' , active: 'products' }) %>

    <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">상품 목록</h3>
            <div class="text-muted small">카테고리 필터와 검색을 사용할 수 있습니다.</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-dark" href="/shop/cart">장바구니</a>
            <a class="btn btn-sm btn-outline-secondary" href="/shop/products?category=all">전체보기</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-3">
            <div class="shop-card p-3">
                <div class="fw-semibold mb-2">카테고리</div>

                <div class="d-grid gap-2">
                    <a href="/shop/products?category=all"
                        class="btn btn-sm <%= (!currentCategory || currentCategory==='all') ? 'btn-primary' : 'btn-outline-primary' %>">
                        전체
                    </a>

                    <% (categories || []).forEach(c=> { %>
                        <a href="/shop/products?category=<%= c.slug %>"
                            class="btn btn-sm <%= (currentCategory === c.slug) ? 'btn-primary' : 'btn-outline-primary' %>">
                            <%= c.name %>
                        </a>
                        <% }) %>
                </div>

                <hr>
                <div class="text-muted small">
                    비회원도 장바구니 사용 가능<br />(브라우저 세션 종료 시 초기화)
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-9">
            <% if (!products || products.length===0) { %>
                <div class="alert alert-light border">해당 조건의 상품이 없습니다.</div>
                <% } %>

                    <div class="row g-3">
                        <% (products || []).forEach(p=> { %>
                            <div class="col-12 col-sm-6 col-xl-4">
                                <div class="shop-card p-3 h-100">
                                    <a href="/shop/products/<%= p.id %>" class="text-decoration-none">
                                        <div class="bg-light rounded-3 mb-2" style="height:160px; overflow:hidden;">
                                            <img src="<%= p.image || 'https://via.placeholder.com/800x600?text=No+Image' %>"
                                                alt="<%= p.name %>" style="width:100%; height:100%; object-fit:cover;">
                                        </div>
                                        <div class="fw-semibold text-dark">
                                            <%= p.name %>
                                        </div>
                                    </a>

                                    <% if (p.spec) { %>
                                        <div class="text-muted small mt-1">
                                            <%= p.spec %>
                                        </div>
                                        <% } %>

                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <div class="price">
                                                    <%= Number(p.price || 0).toLocaleString() %>원
                                                </div>
                                                <span class="badge text-bg-light border">
                                                    <%= p.category_name || '미분류' %>
                                                </span>
                                            </div>

                                            <hr class="my-3">

                                            <form action="/shop/cart/add" method="post" class="d-flex gap-2 flex-wrap">
                                                <input type="hidden" name="productId" value="<%= p.id %>">
                                                <input type="number" name="quantity" min="1" value="1"
                                                    class="form-control form-control-sm" style="max-width:90px;">
                                                <button class="btn btn-sm btn-primary flex-grow-1" type="submit">장바구니
                                                    담기</button>
                                                <a class="btn btn-sm btn-outline-secondary"
                                                    href="/shop/products/<%= p.id %>">상세</a>
                                            </form>
                                </div>
                            </div>
                            <% }) %>
                    </div>
        </div>
    </div>

    <%- include('../layouts/shop-bottom') %>