<%- include('../layouts/shop-top', { title: '상품 목록', active: 'products' }) %>

<div class="shop-layout">
  <!-- Sidebar -->
  <aside class="shop-sidebar">
    <div class="shop-sidebar-card">
      <div class="shop-sidebar-title">카테고리</div>
      <ul class="filter-list">
        <li>
          <a href="/shop/products" class="filter-link <%= (!currentCategory || currentCategory === 'all') ? 'active' : '' %>">
            전체
            <% if (typeof total !== 'undefined') { %><span class="filter-count"><%= total %></span><% } %>
          </a>
        </li>
        <% (typeof categories !== 'undefined' && categories ? categories : []).forEach(function(c) { %>
          <li>
            <a href="/shop/products?category=<%= encodeURIComponent(c.slug || c.name) %><% if (typeof q !== 'undefined' && q) { %>&q=<%= encodeURIComponent(q) %><% } %>"
               class="filter-link <%= (currentCategory === (c.slug || c.name)) ? 'active' : '' %>">
              <%= c.name %>
              <% if (c.count) { %><span class="filter-count"><%= c.count %></span><% } %>
            </a>
          </li>
        <% }); %>
      </ul>
    </div>
  </aside>

  <!-- Main -->
  <main>
    <div class="catalog-head">
      <div class="catalog-count">
        <% if (typeof total !== 'undefined') { %>
          총 <strong><%= total %></strong>개 상품
        <% } else if (typeof products !== 'undefined' && products) { %>
          총 <strong><%= products.length %></strong>개 상품
        <% } %>
        <% if (typeof q !== 'undefined' && q) { %>
          &nbsp;— "<strong><%= q %></strong>" 검색 결과
        <% } %>
        <% if (currentCategory && currentCategory !== 'all') { %>
          &nbsp;— <strong><%= currentCategory %></strong>
        <% } %>
      </div>
      <div class="catalog-sort">
        <form action="/shop/products" method="get" style="display:flex;gap:.4rem;">
          <% if (currentCategory && currentCategory !== 'all') { %>
            <input type="hidden" name="category" value="<%= currentCategory %>">
          <% } %>
          <input class="form-control" style="width:180px;height:32px;font-size:.8125rem;" type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="상품 검색...">
          <button class="btn btn-primary btn-sm" type="submit">검색</button>
        </form>
      </div>
    </div>

    <% const _prods = (typeof products !== 'undefined' && Array.isArray(products)) ? products : []; %>
    <% if (_prods.length > 0) { %>
      <div class="list-product-grid">
        <% _prods.forEach(function(p) { %>
          <div class="product-card">
            <a href="/shop/products/<%= p.id %>" class="product-thumb">
              <% if (p.image || p.image_thumb) { %>
                <img src="<%= p.image_thumb || p.image %>" alt="<%= p.name %>" loading="lazy">
              <% } else { %>
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f2f2f2;color:#bbb;font-size:.75rem;">이미지 없음</div>
              <% } %>
            </a>
            <div class="product-body">
              <% if (p.category_name) { %><div class="product-cat"><%= p.category_name %></div><% } %>
              <div class="product-name"><%= p.name %></div>
              <% if (p.spec) { %><div class="product-spec"><%= p.spec %></div><% } %>
            </div>
            <div class="product-foot">
              <div class="product-price">
                <% if (p.price) { %>₩<%= Number(p.price).toLocaleString() %><% } else { %>문의 요망<% } %>
              </div>
              <form action="/shop/cart/add" method="POST" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="productId" value="<%= p.id %>">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="product-add-btn" title="장바구니 담기">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/></svg>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="shop-empty">
        <div class="shop-empty-icon">🔍</div>
        <div class="shop-empty-text">
          <% if (typeof q !== 'undefined' && q) { %>
            "<strong><%= q %></strong>"에 해당하는 상품이 없습니다.
          <% } else { %>
            해당 카테고리의 상품이 없습니다.
          <% } %>
        </div>
        <a href="/shop/products" class="btn btn-outline" style="margin-top:1rem;">전체 상품 보기</a>
      </div>
    <% } %>

    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <nav style="display:flex;justify-content:center;gap:.35rem;margin-top:2rem;">
        <% if (page > 1) { %>
          <a href="/shop/products?page=<%= page - 1 %><% if (currentCategory) { %>&category=<%= encodeURIComponent(currentCategory) %><% } %><% if (q) { %>&q=<%= encodeURIComponent(q) %><% } %>" class="btn btn-outline btn-sm">← 이전</a>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/shop/products?page=<%= i %><% if (currentCategory) { %>&category=<%= encodeURIComponent(currentCategory) %><% } %><% if (q) { %>&q=<%= encodeURIComponent(q) %><% } %>"
             class="btn btn-sm <%= i === page ? 'btn-primary' : 'btn-outline' %>"><%= i %></a>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="/shop/products?page=<%= page + 1 %><% if (currentCategory) { %>&category=<%= encodeURIComponent(currentCategory) %><% } %><% if (q) { %>&q=<%= encodeURIComponent(q) %><% } %>" class="btn btn-outline btn-sm">다음 →</a>
        <% } %>
      </nav>
    <% } %>
  </main>
</div>

<%- include('../layouts/shop-bottom') %>
