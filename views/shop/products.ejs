<%- include('../layouts/shop-top', { title: '상품 목록', active: 'products' }) %>

<div class="shop-page">
  <div class="container">
    <div class="shop-grid">

      <!-- Sidebar -->
      <aside class="shop-sidebar">
        <div class="sidebar-card">
          <div class="sidebar-section sidebar-search">
            <div class="sidebar-label">상품 검색</div>
            <form action="/shop/products" method="get">
              <input class="form-control form-control-sm" name="q"
                placeholder="검색어를 입력하세요" value="<%= query || '' %>">
            </form>
          </div>
          <div class="sidebar-section">
            <div class="sidebar-label">카테고리</div>
            <div class="d-flex flex-wrap gap-2">
              <a href="/shop/products?category=all" class="chip <%= (!currentCategory || currentCategory==='all') ? 'active' : '' %>">전체</a>
              <% (categories || []).forEach(function(c) { %>
                <a href="/shop/products?category=<%= c.slug %>" class="chip <%= (currentCategory === c.slug) ? 'active' : '' %>">
                  <%= c.name %>
                </a>
              <% }); %>
            </div>
          </div>
        </div>
      </aside>

      <!-- Content -->
      <section class="shop-content">
        <div class="shop-toolbar">
          <div>
            <h3 class="shop-toolbar__title">상품 목록</h3>
            <p class="shop-toolbar__sub">카테고리와 검색으로 상품을 찾을 수 있습니다.</p>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-dark" href="/shop/cart">장바구니</a>
            <a class="btn btn-sm btn-outline-secondary" href="/shop/products?category=all">전체보기</a>
          </div>
        </div>

        <% if (!products || products.length === 0) { %>
          <div style="text-align:center;padding:60px 20px;background:#fff;border:1px solid var(--c-border);border-radius:var(--r-xl);">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" style="margin:0 auto 14px;color:var(--c-muted-2);">
              <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/>
              <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <p style="color:var(--c-muted);margin:0;">해당 조건의 상품이 없습니다.</p>
          </div>
        <% } else { %>
          <div class="product-grid">
            <% (products || []).forEach(function(p) { %>
              <div class="product-card">
                <a href="/shop/products/<%= p.id %>">
                  <div class="product-thumb">
                    <% if (p.image_thumb || p.image) { %>
                      <img src="<%= p.image_thumb || p.image %>" alt="<%= p.name %>">
                    <% } else { %>
                      <div class="product-thumb-placeholder">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
                      </div>
                    <% } %>
                  </div>
                </a>
                <div class="product-body">
                  <% if (p.category_name) { %>
                    <div class="product-cat"><%= p.category_name %></div>
                  <% } %>
                  <div class="product-name"><a href="/shop/products/<%= p.id %>" style="color:inherit;text-decoration:none;"><%= p.name %></a></div>
                  <% if (p.spec) { %>
                    <div class="product-spec"><%= p.spec %></div>
                  <% } %>
                  <div class="product-price"><%= Number(p.price || 0).toLocaleString() %><span>원</span></div>
                  <form action="/shop/cart/add" method="post" class="product-actions">
                    <input type="hidden" name="productId" value="<%= p.id %>">
                    <input type="number" name="quantity" min="1" value="1" class="product-qty">
                    <button class="btn btn-primary btn-sm flex-grow-1" type="submit">담기</button>
                    <a class="btn btn-outline-secondary btn-sm" href="/shop/products/<%= p.id %>">상세</a>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>

    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
