<%- include('../layouts/shop-top', { title: '상품 목록', active: 'products' }) %>

<!-- ─────────────────────────────────────────────
   상품 목록 페이지
   구조: 검색바 → 카테고리 칩 → 툴바(필터/정렬) → 2열 그리드
   사이드바 완전 제거 — 필터는 바텀시트로
   ───────────────────────────────────────────── -->

<!-- 검색바 -->
<div class="app-section">
  <form class="app-searchbar" action="/shop/products" method="get" role="search">
    <% if (currentCategory && currentCategory !== 'all') { %>
      <!-- 카테고리 필터 유지 -->
      <input type="hidden" name="category" value="<%= currentCategory %>">
    <% } %>
    <span class="app-searchbar__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
        <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </span>
    <input type="search" name="q" value="<%= query || '' %>"
           placeholder="상품명 검색" autocomplete="off" aria-label="상품 검색">
    <% if (query) { %>
      <a href="/shop/products<%= currentCategory && currentCategory !== 'all' ? '?category=' + currentCategory : '' %>"
         style="color:var(--c-muted-2);display:flex;align-items:center;" aria-label="검색 초기화">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </a>
    <% } %>
    <button class="app-searchbar__submit" type="submit" aria-label="검색">검색</button>
  </form>
</div>

<!-- 카테고리 칩 — 가로 스크롤 -->
<div class="app-section">
  <div class="app-chips">
    <a class="app-chip <%= (!currentCategory || currentCategory === 'all') ? 'is-active' : '' %>"
       href="/shop/products?category=all<%= query ? '&q=' + encodeURIComponent(query) : '' %>">전체</a>
    <% (categories || []).forEach(function(c) { %>
      <a class="app-chip <%= currentCategory === c.slug ? 'is-active' : '' %>"
         href="/shop/products?category=<%= c.slug %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
        <%= c.name %>
      </a>
    <% }); %>
  </div>
</div>

<!-- 툴바: 상품 수 + 필터 버튼 -->
<div class="app-section">
  <div class="app-toolbar">
    <span class="app-toolbar__count">
      상품 <strong><%= (products || []).length.toLocaleString() %></strong>개
      <% if (currentCategory && currentCategory !== 'all') { %>
        · <span style="color:var(--c-accent);font-weight:600;"><%= currentCategory %></span>
      <% } %>
      <% if (query) { %>
        · "<%= query %>"
      <% } %>
    </span>

    <!-- 필터 바텀시트 열기 버튼 -->
    <button class="app-filter-btn <%= (currentCategory && currentCategory !== 'all') ? 'has-filter' : '' %>"
            type="button"
            data-sheet-open="filterSheet"
            aria-expanded="false"
            aria-controls="filterSheet">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z" stroke="currentColor" stroke-width="2"
              stroke-linejoin="round"/>
      </svg>
      필터<% if (currentCategory && currentCategory !== 'all') { %> 적용<% } %>
    </button>
  </div>
</div>

<!-- ── 상품 그리드 ── -->
<div class="app-section--pad" style="padding-top:4px;">

  <% if (!products || products.length === 0) { %>
    <!-- 빈 상태 -->
    <div class="app-empty">
      <div class="app-empty__icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/>
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="app-empty__title">검색 결과가 없어요</p>
      <p class="app-empty__desc">다른 키워드나 카테고리를 시도해보세요</p>
      <a href="/shop/products" class="app-btn app-btn--primary app-btn--sm">전체 상품 보기</a>
    </div>

  <% } else { %>
    <div class="app-product-grid">
      <% (products || []).forEach(function(p) { %>
        <div class="app-product-card">

          <!-- 썸네일 -->
          <div class="app-product-card__thumb">
            <a href="/shop/products/<%= p.id %>" aria-label="<%= p.name %> 상세 보기">
              <% if (p.image_thumb || p.image) { %>
                <img src="<%= p.image_thumb || p.image %>" alt="<%= p.name %>" loading="lazy">
              <% } else { %>
                <div class="app-product-card__placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="3" width="18" height="18" rx="2"
                          stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
              <% } %>
            </a>
          </div>

          <!-- 상품 정보 -->
          <div class="app-product-card__body">
            <% if (p.category_name) { %>
              <span class="app-product-card__cat"><%= p.category_name %></span>
            <% } %>
            <div class="app-product-card__name">
              <a href="/shop/products/<%= p.id %>"
                 style="color:inherit;text-decoration:none;"><%= p.name %></a>
            </div>
            <% if (p.spec) { %>
              <div class="app-product-card__spec"><%= p.spec %></div>
            <% } %>
            <div class="app-product-card__price">
              <%= Number(p.price || 0).toLocaleString() %><span>원</span>
            </div>
          </div>

          <!-- 액션 버튼 -->
          <div class="app-product-card__action">
            <%# products.ejs에서는 폼 서밋(기존 동작)을 유지 %>
            <form action="/shop/cart/add" method="post" style="flex:1;display:flex;gap:6px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="productId" value="<%= p.id %>">
              <input type="hidden" name="quantity" value="1">
              <button class="app-btn app-btn--primary app-btn--sm" type="submit"
                      style="flex:1;" aria-label="<%= p.name %> 장바구니 담기">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2"
                        stroke-linecap="round"/>
                </svg>
                담기
              </button>
              <a class="app-btn app-btn--outline app-btn--sm"
                 href="/shop/products/<%= p.id %>" aria-label="상세보기">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                </svg>
              </a>
            </form>
          </div>

        </div><!-- /app-product-card -->
      <% }); %>
    </div><!-- /app-product-grid -->
  <% } %>

</div><!-- /app-section--pad -->


<!-- ═══════════════════════════════════════════
   필터 바텀시트
   카테고리 선택 → 링크 이동 (JS fetch 불필요)
═══════════════════════════════════════════ -->
<div class="app-sheet-overlay" id="appSheetOverlay" aria-hidden="true"></div>

<div class="app-sheet" id="filterSheet" role="dialog" aria-modal="true" aria-label="필터">
  <div class="app-sheet__handle" aria-hidden="true"></div>

  <div class="app-sheet__head">
    <h2 class="app-sheet__title">필터</h2>
    <button class="app-sheet__close" type="button" data-sheet-close aria-label="닫기">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="app-sheet__body">
    <!-- 카테고리 필터 -->
    <p class="app-sheet__sec-label">카테고리</p>
    <div class="app-chips" style="flex-wrap:wrap;overflow:visible;">
      <a class="app-chip <%= (!currentCategory || currentCategory === 'all') ? 'is-active' : '' %>"
         href="/shop/products<%= query ? '?q=' + encodeURIComponent(query) : '' %>">전체</a>
      <% (categories || []).forEach(function(c) { %>
        <a class="app-chip <%= currentCategory === c.slug ? 'is-active' : '' %>"
           href="/shop/products?category=<%= c.slug %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
          <%= c.name %>
        </a>
      <% }); %>
    </div>
  </div>

  <!-- 적용/초기화 버튼 -->
  <div class="app-sheet__footer">
    <a class="app-btn app-btn--outline" style="flex:1;text-align:center;"
       href="/shop/products<%= query ? '?q=' + encodeURIComponent(query) : '' %>">
      초기화
    </a>
    <button class="app-btn app-btn--primary" style="flex:2;"
            type="button" data-sheet-close>
      닫기
    </button>
  </div>
</div><!-- /filterSheet -->

<%- include('../layouts/shop-bottom') %>
