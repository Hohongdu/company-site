<%- include('../layouts/shop-top', { title: '전체 상품', active: 'products' }) %>

<%
const categoryName = categories.find((item) => item.slug === currentCategory)?.name;
const filtered = currentCategory !== 'all';
%>
<section class="shop-page-heading">
  <div class="shop-shell">
    <p class="shop-breadcrumb"><a href="/shop">제품몰 홈</a><span aria-hidden="true">/</span> 전체 상품</p>
    <h1 data-i18n-auto><%= categoryName || '전체 상품' %></h1>
    <p data-i18n-auto>제품명·제품코드·규격으로 검색하거나 카테고리별로 살펴보세요.</p>
  </div>
</section>

<div class="shop-shell shop-section shop-catalog">
  <aside class="shop-catalog__sidebar" aria-label="상품 필터">
    <h2 data-i18n-auto>카테고리</h2>
    <%- include('partials/catalog-categories') %>
  </aside>

  <section class="shop-catalog__results" aria-labelledby="shop-results-title">
    <div class="shop-results-bar">
      <div>
        <h2 id="shop-results-title" data-i18n-auto><%= query ? '검색 결과' : '상품 목록' %></h2>
        <p><% if (query) { %><strong>“<%= query %>”</strong> · <% } %><%= products.length.toLocaleString('ko-KR') %>개 상품</p>
      </div>
      <details class="shop-catalog__mobile-filter" <%= filtered ? 'data-filtered' : '' %>>
        <summary>필터<% if (filtered) { %> · 1<% } %></summary>
        <%- include('partials/catalog-categories') %>
      </details>
    </div>
    <% if (query || filtered) { %>
      <div class="shop-active-filters">
        <% if (filtered && categoryName) { %><span><%= categoryName %></span><% } %>
        <a href="/shop/products">검색·필터 초기화</a>
      </div>
    <% } %>

    <% if (products.length) { %>
      <div class="shop-product-grid">
        <% for (const product of products) { %>
          <%- include('partials/catalog-product', { product, quickAdd: false }) %>
        <% } %>
      </div>
    <% } else { %>
      <div class="shop-empty">
        <h3 data-i18n-auto><%= query || filtered ? '조건에 맞는 상품이 없습니다' : '현재 등록된 상품이 없습니다' %></h3>
        <p data-i18n-auto><%= query || filtered ? '검색어 또는 카테고리를 바꾸어 확인해 보세요.' : '필요한 부품의 소재와 규격을 알려주시면 확인해 드립니다.' %></p>
        <% if (query && noHitSuggestions.length) { %>
          <ul class="shop-suggestions" aria-label="인기 검색어">
            <% for (const item of noHitSuggestions) { %>
              <li><a href="/shop/products?q=<%= encodeURIComponent(item.keyword) %>"><%= item.keyword %></a></li>
            <% } %>
          </ul>
        <% } %>
        <div class="shop-actions">
          <% if (query || filtered) { %><a class="app-btn app-btn--outline" href="/shop/products">전체 상품 보기</a><% } %>
          <a class="app-btn app-btn--primary" href="/shop/inquiries" data-i18n-auto>제품 문의하기</a>
        </div>
      </div>
    <% } %>
  </section>
</div>

<%- include('../layouts/shop-bottom') %>
