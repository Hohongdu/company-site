<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>상품몰</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
</head>

<body class="shop-wrap">
    <%- include('../partials/header-shop') %>

        <main class="py-4">
            <div class="container">
                <!-- 상단 타이틀 -->
                <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <h2 class="shop-title fw-bold mb-1">제목</h2>
                        <div class="text-muted">대충 여기에 부제목 들어감</div>
                    </div>
                    <a href="/shop/cart" class="btn btn-outline-dark btn-sm">장바구니 보기</a>
                </div>

                <div class="row g-3">
                    <!-- 왼쪽: 카테고리 -->
                    <div class="col-lg-3">
                        <div class="card shop-card sticky-filters">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="fw-bold">카테고리</div>
                                    <a class="btn btn-sm btn-light" href="/shop/products?category=all">전체</a>
                                </div>

                                <div class="d-grid gap-2">
                                    <a href="/shop/products?category=all"
                                        class="btn btn-sm <%= currentCategory === 'all' ? 'btn-dark' : 'btn-outline-dark' %> category-pill">
                                        전체보기
                                    </a>

                                    <% if (categories && categories.length) { %>
                                        <% categories.forEach(c=> { %>
                                            <a href="/shop/products?category=<%= c.slug %>"
                                                class="btn btn-sm <%= currentCategory === c.slug ? 'btn-dark' : 'btn-outline-dark' %> category-pill">
                                                <%= c.name %>
                                            </a>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="text-muted small">카테고리가 아직 없습니다.</div>
                                                    <% } %>
                                </div>

                                <hr class="my-3">

                                <div class="small text-muted">
                                    ✅ 비회원도 장바구니 사용 가능<br>
                                    (브라우저 닫으면 초기화)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 오른쪽: 상품 카드 -->
                    <div class="col-lg-9">
                        <div class="row g-3">
                            <% if (!products || products.length===0) { %>
                                <div class="col-12">
                                    <div class="alert alert-light border">현재 카테고리에 상품이 없습니다.</div>
                                </div>
                                <% } %>

                                    <% products.forEach(p=> { %>
                                        <div class="col-sm-6 col-xl-4">
                                            <div class="card shop-card h-100">
                                                <a href="/shop/products/<%= p.id %>"
                                                    class="text-decoration-none text-dark">
                                                    <img src="<%= p.image ? p.image : 'https://via.placeholder.com/600x400?text=No+Image' %>"
                                                        class="shop-thumb" alt="<%= p.name %>" />
                                                </a>

                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div class="fw-semibold">
                                                            <a href="/shop/products/<%= p.id %>"
                                                                class="text-decoration-none text-dark">
                                                                <%= p.name %>
                                                            </a>
                                                        </div>
                                                        <% if (p.category_name) { %>
                                                            <span class="badge-soft">
                                                                <%= p.category_name %>
                                                            </span>
                                                            <% } %>
                                                    </div>

                                                    <% if (p.spec) { %>
                                                        <div class="text-muted small mb-2">
                                                            <%= p.spec %>
                                                        </div>
                                                        <% } else { %>
                                                            <div class="text-muted small mb-2">규격 정보 준비중</div>
                                                            <% } %>

                                                                <div
                                                                    class="d-flex align-items-center justify-content-between">
                                                                    <div class="price">
                                                                        <%= Number(p.price || 0).toLocaleString() %>원
                                                                    </div>
                                                                    <a href="/shop/products/<%= p.id %>"
                                                                        class="btn btn-dark btn-sm">
                                                                        상세보기
                                                                    </a>
                                                                </div>

                                                                <hr class="my-3">

                                                                <!-- 장바구니 담기 -->
                                                                <form action="/shop/cart/add" method="post"
                                                                    class="d-flex gap-2">
                                                                    <input type="hidden" name="productId"
                                                                        value="<%= p.id %>">
                                                                    <input type="number" name="quantity"
                                                                        class="form-control form-control-sm" value="1"
                                                                        min="1" style="max-width:90px;">
                                                                    <button class="btn btn-outline-dark btn-sm w-100"
                                                                        type="submit">
                                                                        장바구니 담기
                                                                    </button>
                                                                </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>