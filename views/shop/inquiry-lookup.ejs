<%- include('../layouts/shop-top', { title: '비회원 문의 조회', active: 'inquiry' }) %>

<div class="shop-card p-4">
    <h3 class="fw-bold mb-2">비회원 문의 조회</h3>
    <p class="text-muted mb-4">문의 번호와 이메일 또는 연락처로 답변을 조회할 수 있습니다.</p>

    <% if (error) { %>
        <div class="alert alert-warning"><%= error %></div>
    <% } %>

    <form action="/shop/inquiries/guest" method="post" class="row g-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-12 col-md-4">
            <label class="form-label">문의 번호</label>
            <input class="form-control" name="inquiryId" value="<%= form.inquiryId %>" required>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">이메일</label>
            <input class="form-control" type="email" name="guestEmail" value="<%= form.guestEmail %>">
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">연락처</label>
            <input class="form-control" name="guestPhone" value="<%= form.guestPhone %>">
        </div>
        <div class="col-12">
            <button class="btn btn-primary">조회하기</button>
        </div>
    </form>

    <% if (result) { %>
        <div class="border rounded-3 p-3 mt-4 bg-white">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <div>
                    <div class="fw-semibold"><%= result.title %></div>
                    <div class="text-muted small">접수일: <%= new Date(result.created_at).toLocaleString() %></div>
                </div>
                <span class="badge <%= result.answer_content ? 'bg-success' : 'bg-secondary' %>">
                    <%= result.answer_content ? '답변 완료' : '답변 대기' %>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-muted small mb-1">문의 내용</div>
                <div class="border rounded p-2 bg-light" style="white-space:pre-wrap;"><%= result.content %></div>
            </div>
            <% if (result.answer_content) { %>
                <div class="mt-3">
                    <div class="text-muted small mb-1">답변</div>
                    <div class="border rounded p-2" style="white-space:pre-wrap;"><%= result.answer_content %></div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<%- include('../layouts/shop-bottom') %>
