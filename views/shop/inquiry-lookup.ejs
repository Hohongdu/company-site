<%- include('../layouts/shop-top', { title: '비회원 문의 조회', active: '' }) %>

<div class="lookup-wrap">
  <div class="lookup-card">
    <div class="lookup-head">
      <div class="lookup-title">비회원 문의 조회</div>
      <div class="lookup-sub">문의 번호와 이메일 또는 연락처로 답변을 조회할 수 있습니다.</div>
    </div>
    <div class="lookup-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" style="margin-bottom:1rem;"><%= error %></div>
      <% } %>

      <form action="/shop/inquiries/guest" method="POST">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
          <div class="form-group" style="grid-column:1/-1;">
            <label class="form-label">문의 번호 <span style="color:#e74c3c;">*</span></label>
            <input class="form-control" name="inquiryId" required
              value="<%= (typeof form !== 'undefined' && form) ? form.inquiryId || '' : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">이메일</label>
            <input class="form-control" type="email" name="guestEmail"
              value="<%= (typeof form !== 'undefined' && form) ? form.guestEmail || '' : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">연락처</label>
            <input class="form-control" name="guestPhone"
              value="<%= (typeof form !== 'undefined' && form) ? form.guestPhone || '' : '' %>">
          </div>
        </div>
        <div style="margin-top:.75rem;">
          <button class="btn btn-primary" type="submit">조회하기</button>
        </div>
      </form>

      <!-- Result -->
      <% const _inqResult = (typeof inquiry !== 'undefined' && inquiry) ? inquiry : (typeof result !== 'undefined' && result) ? result : null; %>
      <% if (_inqResult) { %>
        <div class="inquiry-thread" style="margin-top:1.5rem;">
          <div class="inquiry-head">
            <div>
              <div class="inquiry-title"><%= _inqResult.title %></div>
              <div class="inquiry-date">접수일: <%= new Date(_inqResult.created_at).toLocaleDateString('ko-KR') %></div>
            </div>
            <span class="badge" style="<%= _inqResult.answer_content ? 'background:#27ae60;color:#fff;' : 'background:#95a5a6;color:#fff;' %>">
              <%= _inqResult.answer_content ? '답변 완료' : '답변 대기' %>
            </span>
          </div>
          <div class="inquiry-content-block">
            <div style="font-size:.75rem;color:#aaa;margin-bottom:.3rem;">문의 내용</div>
            <div style="white-space:pre-wrap;font-size:.875rem;"><%= _inqResult.content %></div>
          </div>
          <% if (_inqResult.answer_content) { %>
            <div class="inquiry-answer-block">
              <div class="inquiry-answer-label">답변</div>
              <div style="white-space:pre-wrap;font-size:.875rem;"><%= _inqResult.answer_content %></div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
