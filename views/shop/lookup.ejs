<%- include('../layouts/shop-top', { title: '조회', active: 'lookup' }) %>

<div class="shop-page">
  <div class="container" style="max-width:640px;">

    <div style="text-align:center;margin-bottom:36px;">
      <h2 data-i18n-auto style="font-size:24px;font-weight:800;color:var(--c-text,#0f172a);margin-bottom:8px;">조회</h2>
      <p data-i18n-auto style="font-size:15px;color:var(--c-muted,#64748b);">주문 또는 문의 내역을 확인하세요.</p>
    </div>

    <!-- 탭 -->
    <div style="display:flex;gap:0;border:1px solid var(--c-border,#e2e8f0);border-radius:12px;overflow:hidden;margin-bottom:32px;background:var(--c-bg,#fff);">
      <a href="/shop/orders/guest"
         class="lookup-tab-card"
         style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:24px 16px;text-decoration:none;color:var(--c-text,#0f172a);border-right:1px solid var(--c-border,#e2e8f0);transition:background .15s;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent,#ea580c)" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M3 9h18M9 21V9"/>
        </svg>
        <div>
          <div data-i18n-auto style="font-weight:700;font-size:15px;margin-bottom:2px;">주문 조회</div>
          <div data-i18n-auto style="font-size:12px;color:var(--c-muted);">주문번호 또는 이메일로 조회</div>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-muted,#94a3b8)" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="/shop/inquiries/guest"
         class="lookup-tab-card"
         style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:24px 16px;text-decoration:none;color:var(--c-text,#0f172a);transition:background .15s;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent,#ea580c)" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <div>
          <div data-i18n-auto style="font-weight:700;font-size:15px;margin-bottom:2px;">문의 조회</div>
          <div data-i18n-auto style="font-size:12px;color:var(--c-muted);">문의번호 + 이메일로 조회</div>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-muted,#94a3b8)" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- 로그인 유도 -->
    <% if (!user) { %>
    <div style="background:var(--c-bg-2,#f8fafc);border:1px solid var(--c-border,#e2e8f0);border-radius:12px;padding:20px 24px;text-align:center;">
      <div data-i18n-auto style="font-size:14px;color:var(--c-muted);margin-bottom:12px;">
        회원이시라면 로그인 후 마이페이지에서 더 편리하게 확인하세요.
      </div>
      <a href="/auth/login" class="btn btn-primary btn-sm" data-i18n-auto>로그인하기</a>
    </div>
    <% } %>

  </div>
</div>

<%- include('../layouts/shop-bottom') %>
