<%- include('../layouts/shop-top', { title: '결제 완료', active: '' }) %>

<div class="result-page">
  <div class="result-card">
    <div class="result-icon" style="color:#27ae60;">✅</div>
    <div class="result-title">결제가 완료되었습니다</div>
    <div class="result-sub">카카오페이 결제가 정상적으로 처리되었습니다.</div>

    <div style="background:#f8f8f8;border:1px solid #eee;border-radius:8px;padding:1rem;margin:1.25rem 0;text-align:left;">
      <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;font-size:.875rem;">
        <span style="color:#888;">주문번호</span>
        <strong><%= payment.orderId %></strong>
      </div>
      <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;font-size:.875rem;">
        <span style="color:#888;">상품</span>
        <strong><%= payment.itemName %></strong>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:.875rem;">
        <span style="color:#888;">결제 금액</span>
        <strong>₩<%= Number(payment.totalAmount || 0).toLocaleString() %></strong>
      </div>
    </div>

    <div style="display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;">
      <a href="/shop/products" class="btn btn-primary">계속 쇼핑하기</a>
      <a href="/shop/cart" class="btn btn-outline">장바구니로 이동</a>
    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
