<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SHOP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
</head>

<body class="shop-wrap">
    <%- include('../partials/header-shop') %>

        <main class="py-4">
            <div class="container">
                <!-- Hero -->
                <div class="card shop-card mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="row align-items-center g-3">
                            <div class="col-lg-7">
                                <div class="badge-soft mb-2">Special Materials Store</div>
                                <h2 class="fw-bold mb-2">특수 소재 / 가공 상품을 한 곳에서</h2>
                                <div class="text-muted mb-3">카테고리별로 빠르게 찾고, 장바구니에 담아 견적/주문 흐름으로 연결할 수 있어요.</div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="/shop/products" class="btn btn-dark">상품 보러가기</a>
                                    <a href="/shop/cart" class="btn btn-outline-dark">장바구니</a>
                                </div>
                                <div class="small text-muted mt-3">
                                    비회원도 장바구니 사용 가능 (브라우저 세션 종료 시 초기화)
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4" style="background:#111; color:#fff;">
                                    <div class="fw-bold mb-2">빠른 카테고리</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-light category-pill"
                                            href="/shop/products?category=all">전체</a>
                                        <% if (categories && categories.length) { %>
                                            <% categories.slice(0,6).forEach(c=> { %>
                                                <a class="btn btn-sm btn-outline-light category-pill"
                                                    href="/shop/products?category=<%= c.slug %>">
                                                    <%= c.name %>
                                                </a>
                                                <% }) %>
                                                    <% } else { %>
                                                        <span class="small opacity-75">카테고리가 없습니다.</span>
                                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Latest -->
                <div class="d-flex align-items-end justify-content-between mb-2">
                    <h4 class="fw-bold mb-0">최근 등록 상품</h4>
                    <a href="/shop/products" class="btn btn-sm btn-outline-dark">전체보기</a>
                </div>

                <div class="row g-3">
                    <% if (!latest || latest.length===0) { %>
                        <div class="col-12">
                            <div class="alert alert-light border">최근 등록된 상품이 없습니다.</div>
                        </div>
                        <% } %>

                            <% (latest || []).forEach(p=> { %>
                                <div class="col-sm-6 col-xl-3">
                                    <div class="card shop-card h-100">
                                        <a href="/shop/products/<%= p.id %>" class="text-decoration-none text-dark">
                                            <img src="<%= p.image ? p.image : 'https://via.placeholder.com/600x400?text=No+Image' %>"
                                                class="shop-thumb" alt="<%= p.name %>">
                                        </a>
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="fw-semibold">
                                                    <a href="/shop/products/<%= p.id %>"
                                                        class="text-decoration-none text-dark">
                                                        <%= p.name %>
                                                    </a>
                                                </div>
                                                <% if (p.category_name) { %><span class="badge-soft">
                                                        <%= p.category_name %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="price">
                                                    <%= Number(p.price||0).toLocaleString() %>원
                                                </div>
                                                <a class="btn btn-sm btn-dark" href="/shop/products/<%= p.id %>">보기</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                </div>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>