<%- include('../layouts/shop-top', { title: '쇼핑몰', active: 'home' }) %>

<!-- Hero (negative margins to break out of container padding) -->
<section class="shop-hero" style="margin-left:-1.5rem;margin-right:-1.5rem;margin-top:-2rem;padding:3.5rem 2rem 3rem;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:#fff;border-radius:0;">
  <div style="max-width:680px;">
    <p style="font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;opacity:.5;margin-bottom:.75rem;">ENERMADE CERAMIC SOLUTIONS</p>
    <h1 style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;line-height:1.2;margin-bottom:1rem;">
      세라믹 소재 전문<br>ENERMADE 쇼핑몰
    </h1>
    <p style="opacity:.65;font-size:.9375rem;line-height:1.65;margin-bottom:1.75rem;">알루미나·지르코니아·탄화규소·질화규소 계열 고기능 세라믹 제품을<br>온라인으로 편리하게 구매하세요.</p>
    <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
      <a href="/shop/products" class="btn btn-primary">전체 상품 보기</a>
      <a href="/shop/products?category=알루미나" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);">알루미나</a>
      <a href="/shop/products?category=지르코니아" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);">지르코니아</a>
      <a href="/shop/products?category=탄화규소" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);">탄화규소</a>
      <a href="/shop/products?category=질화규소" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);">질화규소</a>
    </div>
  </div>
</section>

<!-- Catalog -->
<section class="catalog-section">
  <div class="catalog-head">
    <div class="catalog-count">
      <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
        총 <strong><%= products.length %></strong>개 상품
      <% } else { %>
        전체 상품
      <% } %>
    </div>
    <div class="catalog-sort">
      <a href="/shop/products" class="btn btn-outline btn-sm">전체 보기 →</a>
    </div>
  </div>

  <% const _products = (typeof products !== 'undefined' && Array.isArray(products)) ? products : (typeof latest !== 'undefined' && Array.isArray(latest)) ? latest : []; %>

  <% if (_products.length > 0) { %>
    <div class="product-grid">
      <% _products.forEach(function(p) { %>
        <div class="product-card">
          <a href="/shop/products/<%= p.id %>" class="product-thumb">
            <% if (p.image || p.image_thumb) { %>
              <img src="<%= p.image_thumb || p.image %>" alt="<%= p.name %>" loading="lazy">
            <% } else { %>
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f2f2f2;color:#bbb;font-size:.75rem;">이미지 없음</div>
            <% } %>
          </a>
          <div class="product-body">
            <% if (p.category_name) { %><div class="product-cat"><%= p.category_name %></div><% } %>
            <div class="product-name"><%= p.name %></div>
            <% if (p.spec) { %><div class="product-spec"><%= p.spec %></div><% } %>
          </div>
          <div class="product-foot">
            <div class="product-price">
              <% if (p.price) { %>₩<%= Number(p.price).toLocaleString() %><% } else { %>문의 요망<% } %>
            </div>
            <form action="/shop/cart/add" method="POST" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <input type="hidden" name="productId" value="<%= p.id %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="product-add-btn" title="장바구니 담기">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/></svg>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="shop-empty">
      <div class="shop-empty-icon">📦</div>
      <div class="shop-empty-text">등록된 상품이 없습니다.</div>
      <a href="/contact" class="btn btn-outline" style="margin-top:1rem;">제품 문의하기</a>
    </div>
  <% } %>
</section>

<%- include('../layouts/shop-bottom') %>
