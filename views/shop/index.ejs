<%- include('../layouts/shop-top', { title: '산업용 세라믹', active: 'home' }) %>

<section class="shop-home-hero">
  <div class="shop-shell shop-home-hero__layout">
    <div>
      <p class="shop-eyebrow" data-i18n-auto>산업용 세라믹 부품</p>
      <h1 data-i18n-auto>ENERMADE 제품몰</h1>
      <p class="shop-home-hero__intro" data-i18n-auto>필요한 부품을 제품코드나 규격으로 찾으세요. 별도 규격이나 대량 발주는 견적으로 문의할 수 있습니다.</p>
      <div class="shop-actions">
        <a class="app-btn app-btn--primary" href="/shop/products" data-i18n-auto>전체 상품 보기</a>
        <a class="app-btn app-btn--outline" href="/shop/inquiries" data-i18n-auto>견적 문의</a>
      </div>
    </div>
    <figure class="shop-home-hero__media">
      <img src="/images/precision-ceramic-components-720.webp" alt="세라믹 링, 부싱, 플레이트 및 노즐 예시" width="720" height="480" fetchpriority="high">
      <figcaption data-i18n-auto>정밀 세라믹 부품 예시</figcaption>
    </figure>
  </div>
</section>

<section class="shop-shell shop-section" aria-labelledby="shop-categories-title">
  <div class="shop-section__heading">
    <h2 id="shop-categories-title" data-i18n-auto>카테고리</h2>
  </div>
  <% if (categories.length) { %>
    <ul class="shop-category-tiles">
      <% for (const category of categories) { %>
        <li><a href="/shop/products?category=<%= encodeURIComponent(category.slug) %>" data-i18n-auto><%= category.name %></a></li>
      <% } %>
    </ul>
  <% } else { %>
    <p class="shop-muted">등록된 카테고리가 없습니다.</p>
  <% } %>
</section>

<section class="shop-shell shop-section shop-section--latest" aria-labelledby="shop-latest-title">
  <div class="shop-section__heading">
    <h2 id="shop-latest-title" data-i18n-auto>최근 등록 상품</h2>
    <a class="shop-text-link" href="/shop/products" data-i18n-auto>전체 상품 보기</a>
  </div>
  <% if (latest.length) { %>
    <div class="shop-product-grid shop-product-grid--home">
      <% for (const product of latest) { %>
        <%- include('partials/catalog-product', { product, quickAdd: true }) %>
      <% } %>
    </div>
  <% } else { %>
    <div class="shop-empty">
      <h3 data-i18n-auto>현재 등록된 상품이 없습니다</h3>
      <p data-i18n-auto>필요한 제품의 소재와 규격을 알려주시면 확인해 드립니다.</p>
      <a class="app-btn app-btn--outline" href="/shop/inquiries" data-i18n-auto>제품 문의하기</a>
    </div>
  <% } %>
</section>

<%- include('../layouts/shop-bottom') %>
