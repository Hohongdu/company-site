<%- include('../layouts/shop-top', { title: '주문 내역', active: 'account' }) %>

<div class="shop-account-wrap">
  <%- include('partials/account-sidebar', { activeItem: 'orders' }) %>

  <div class="acct-content">
    <div class="acct-card">
      <div class="acct-card__head">
        <h4 class="acct-card__title">주문 내역</h4>
        <p class="acct-card__desc">주문 상세 페이지로 이동해 확인할 수 있습니다.</p>
      </div>

      <% if (!orders || orders.length === 0) { %>
        <div class="acct-empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <p>주문 내역이 없습니다.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width:60px;">#</th>
                <th>상태</th>
                <th>결제금액</th>
                <th>주문일</th>
                <th class="text-end">관리</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach((order, idx) => { %>
                <tr>
                  <td class="fw-semibold text-muted small"><%= orders.length - idx %></td>
                  <td>
                    <span class="acct-status-badge acct-status-badge--<%= order.status === 'PENDING' ? 'pending' : order.status === 'COMPLETED' ? 'done' : 'default' %>">
                      <%= order.status %>
                    </span>
                  </td>
                  <td><%= Number(order.total_amount || 0).toLocaleString() %>원</td>
                  <td class="text-muted small"><%= new Date(order.created_at).toLocaleDateString('ko-KR') %></td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                      <a class="btn btn-sm btn-outline-primary" href="/shop/orders/<%= order.order_number %>">상세보기</a>
                      <% if (order.status === 'PENDING') { %>
                        <form method="post" action="/shop/account/orders/<%= order.id %>/cancel">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button class="btn btn-sm btn-outline-danger">취소 요청</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/shop-bottom') %>
