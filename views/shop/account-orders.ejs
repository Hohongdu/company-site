<%- include('../layouts/shop-top', { title: '주문 내역', active: 'account' }) %>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="list-group shadow-sm">
            <a class="list-group-item list-group-item-action" href="/shop/account">프로필 관리</a>
            <a class="list-group-item list-group-item-action active" href="/shop/account/orders">주문 내역</a>
            <a class="list-group-item list-group-item-action" href="/shop/account/inquiries">문의 내역</a>
        </div>
    </div>
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="mb-1">주문 내역</h4>
                <p class="text-muted mb-3">주문 상세 페이지로 이동해 확인할 수 있습니다.</p>

                <% if (!orders || orders.length === 0) { %>
                    <div class="alert alert-light border text-muted">주문 내역이 없습니다.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>주문번호</th>
                                    <th>상태</th>
                                    <th>결제금액</th>
                                    <th>주문일</th>
                                    <th class="text-end">관리</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                    <tr>
                                        <td class="fw-semibold"><%= order.order_number %></td>
                                        <td><span class="badge bg-secondary"><%= order.status %></span></td>
                                        <td><%= Number(order.total_amount || 0).toLocaleString() %>원</td>
                                        <td><%= new Date(order.created_at).toLocaleString() %></td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                                <a class="btn btn-sm btn-outline-primary" href="/shop/orders/<%= order.order_number %>">
                                                    상세보기
                                                </a>
                                                <% if (order.status === 'PENDING') { %>
                                                    <form method="post" action="/shop/account/orders/<%= order.id %>/cancel">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button class="btn btn-sm btn-outline-danger">취소 요청</button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/shop-bottom') %>
