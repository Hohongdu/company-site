<%- include('../layouts/shop-top', { title: '주문 내역', active: 'account' }) %>

<div class="account-layout">
  <!-- Sidebar -->
  <aside class="account-sidebar">
    <a href="/shop/account" class="account-nav-link">프로필 관리</a>
    <a href="/shop/account/orders" class="account-nav-link active">주문 내역</a>
    <a href="/shop/account/inquiries" class="account-nav-link">문의 내역</a>
  </aside>

  <!-- Main -->
  <main>
    <div class="account-card">
      <div class="account-card-head">
        <div class="account-card-title">주문 내역</div>
        <div class="account-card-sub">주문 상세 페이지로 이동해 확인할 수 있습니다.</div>
      </div>
      <div class="account-card-body">
        <% const _orders = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : []; %>
        <% if (_orders.length === 0) { %>
          <p style="color:#aaa;font-size:.875rem;text-align:center;padding:2rem 0;">주문 내역이 없습니다.</p>
        <% } else { %>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>주문번호</th>
                  <th>상태</th>
                  <th>결제금액</th>
                  <th>주문일</th>
                  <th style="text-align:right;">관리</th>
                </tr>
              </thead>
              <tbody>
                <% _orders.forEach(function(order) { %>
                  <tr>
                    <td style="font-weight:600;"><%= order.order_number %></td>
                    <td>
                      <span class="badge"><%= order.status %></span>
                    </td>
                    <td>₩<%= Number(order.total_amount || 0).toLocaleString() %></td>
                    <td style="font-size:.8rem;color:#888;"><%= new Date(order.created_at).toLocaleDateString('ko-KR') %></td>
                    <td style="text-align:right;">
                      <div style="display:flex;justify-content:flex-end;gap:.4rem;flex-wrap:wrap;">
                        <a href="/shop/orders/<%= order.order_number %>" class="btn btn-outline btn-sm">상세보기</a>
                        <% if (order.status === 'PENDING') { %>
                          <form method="POST" action="/shop/account/orders/<%= order.id %>/cancel" style="margin:0;">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button class="btn btn-sm" style="border-color:#e74c3c;color:#e74c3c;" type="submit">취소 요청</button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/shop-bottom') %>
