<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>
        <%= product.name %> - 상품 상세
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/header') %>

        <main class="py-5">
            <div class="container">
			<a href="/shop/products" class="btn btn-link mb-3">&laquo; 상품 목록으로 돌아가기</a>

                <div class="row g-4">
                    <!-- 이미지 영역 -->
                    <div class="col-md-5">
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>">
                            <% } else { %>
                                <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white"
                                    style="height: 300px;">
                                    이미지 준비중
                                </div>
                                <% } %>
                    </div>

                    <!-- 정보 영역 -->
                    <div class="col-md-7">
                        <h1 class="mb-3">
                            <%= product.name %>
                        </h1>
                        <p class="lead text-muted mb-3">
                            <%= product.description %>
                        </p>
                        <p class="fs-4 fw-bold mb-4">
                            <%= product.price.toLocaleString() %>원
                        </p>

						<!-- 장바구니 담기 (회원/비회원 공통) -->
						<div class="d-flex flex-wrap gap-2 mt-3 align-items-start">
							<form method="POST" action="/shop/cart/add" class="d-flex" style="max-width: 260px;">
								<input type="hidden" name="productId" value="<%= product.id %>">
								<div class="input-group">
									<input type="number" name="quantity" value="1" min="1" class="form-control">
									<button type="submit" class="btn btn-primary">장바구니 담기</button>
								</div>
							</form>
							<a href="/shop/cart" class="btn btn-outline-secondary">장바구니 보기</a>

							<% if (typeof user !=='undefined' && user) { %>
                                <a href="/admin/products/<%= product.id %>/edit" class="btn btn-outline-warning">
                                    수정
                                </a>
                                <form method="POST" action="/admin/products/<%= product.id %>/delete"
                                    onsubmit="return confirm('정말 이 상품을 삭제하시겠습니까?');" style="display: inline;">
                                    <button type="submit" class="btn btn-outline-danger">
                                        삭제
                                    </button>
                                </form>
								<% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>