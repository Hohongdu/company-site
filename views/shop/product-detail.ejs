<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= product.name %> - SHOP
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
</head>

<body class="shop-wrap">
    <%- include('../partials/header-shop') %>

        <main class="py-4">
            <div class="container">
                <div class="mb-3">
                    <a href="/shop/products" class="text-decoration-none text-muted">← 상품 목록</a>
                </div>

                <div class="row g-4">
                    <!-- 이미지 -->
                    <div class="col-lg-6">
                        <div class="card shop-card">
                            <img src="<%= product.image ? product.image : 'https://via.placeholder.com/900x650?text=No+Image' %>"
                                class="w-100" style="height:420px; object-fit:cover; background:#eee;"
                                alt="<%= product.name %>" />
                        </div>
                    </div>

                    <!-- 정보 -->
                    <div class="col-lg-6">
                        <div class="card shop-card">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <h3 class="fw-bold mb-1">
                                        <%= product.name %>
                                    </h3>
                                    <% if (product.category_name) { %>
                                        <span class="badge-soft">
                                            <%= product.category_name %>
                                        </span>
                                        <% } %>
                                </div>

                                <% if (product.code) { %>
                                    <div class="text-muted small mb-2">상품코드: <%= product.code %>
                                    </div>
                                    <% } %>

                                        <div class="price fs-3 mb-3">
                                            <%= Number(product.price||0).toLocaleString() %>원
                                        </div>

                                        <div class="row g-2 mb-3">
                                            <div class="col-12">
                                                <div class="p-3 rounded-4 bg-light border">
                                                    <div class="fw-semibold mb-1">규격(Spec)</div>
                                                    <div class="text-muted">
                                                        <%= product.spec ? product.spec : '규격 정보 준비중' %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <% if (product.description) { %>
                                            <div class="mb-3">
                                                <div class="fw-semibold mb-1">설명</div>
                                                <div class="text-muted">
                                                    <%= product.description %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- 장바구니 담기 -->
                                                <form action="/shop/cart/add" method="post"
                                                    class="d-flex gap-2 align-items-center">
                                                    <input type="hidden" name="productId" value="<%= product.id %>">
                                                    <input type="number" name="quantity" class="form-control" value="1"
                                                        min="1" style="max-width:110px;">
                                                    <button type="submit" class="btn btn-dark w-100">장바구니 담기</button>
                                                </form>

                                                <div class="d-flex gap-2 mt-3">
                                                    <a href="/shop/cart" class="btn btn-outline-dark w-100">장바구니로</a>
                                                    <a href="/shop/products" class="btn btn-outline-secondary w-100">계속
                                                        쇼핑</a>
                                                </div>

                                                <div class="small text-muted mt-3">
                                                    비회원도 장바구니 사용 가능 (브라우저 세션 종료 시 초기화)
                                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>