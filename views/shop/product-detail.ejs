<%- include('../layouts/shop-top', {
  title: product.name,
  active: 'products',
  showBack: true,
  backUrl: '/shop/products'
}) %>

<!-- ─────────────────────────────────────────────
   상품 상세 화면
   구조: 풀블리드 이미지 → 상품 정보 → 구매 CTA(sticky bottom) → 리뷰 → 연관 상품
   app-main에 has-bottom-cta 클래스 추가 → 콘텐츠가 CTA 뒤에 숨지 않도록 패딩
   ───────────────────────────────────────────── -->
<script>
/* has-bottom-cta 클래스를 app-main에 추가 */
document.getElementById('app-main').classList.add('has-bottom-cta');
</script>

<!-- ── 상품 이미지 ── -->
<div class="app-detail-img">
  <% if (product.image) { %>
    <img src="<%= product.image %>" alt="<%= product.name %>" loading="eager">
  <% } else { %>
    <div class="app-product-card__placeholder" style="height:100%;border-radius:0;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M3 9l4-4 4 4 4-4 4 4" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  <% } %>
</div>

<!-- ── 상품 정보 영역 ── -->
<div class="app-detail-body">

  <!-- 카테고리 배지 -->
  <% if (product.category_name) { %>
    <span class="app-detail-badge" data-i18n-auto><%= product.category_name %></span>
  <% } %>

  <!-- 상품명 -->
  <h1 class="app-detail-name" data-i18n-auto><%= product.name %></h1>

  <!-- 평점 -->
  <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
    <span style="font-size:14px;color:var(--c-accent);font-weight:700;">★</span>
    <span style="font-size:14px;font-weight:600;color:var(--c-text);">
      <%= reviewStats?.avg_rating ? Number(reviewStats.avg_rating).toFixed(1) : '0.0' %>
    </span>
    <span style="font-size:13px;color:var(--c-muted);">
      (<%= reviewStats?.review_count || 0 %>건)
    </span>
    <% if (user) { %>
      <a href="#reviews" style="font-size:12px;color:var(--c-accent);margin-left:auto;">리뷰 쓰기</a>
    <% } %>
  </div>

  <!-- 가격 + 납기 뱃지 -->
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:4px;">
    <div class="app-detail-price" style="margin-bottom:0;">
      <%= Number(product.price || 0).toLocaleString() %><span>원</span>
    </div>
    <%# 납기 예측 뱃지 — stock_quantity 기반 %>
    <% if (product.stock_quantity > 0) { %>
      <span style="
        background:#dcfce7;color:#15803d;
        font-size:11px;font-weight:700;
        padding:3px 8px;border-radius:20px;
        letter-spacing:.02em;
      " data-i18n-auto>⚡ 즉시출고</span>
    <% } else if (product.stock_quantity === 0) { %>
      <span style="
        background:#fff7ed;color:#c2410c;
        font-size:11px;font-weight:700;
        padding:3px 8px;border-radius:20px;
      " data-i18n-auto>🏭 제작 2주</span>
    <% } else { %>
      <span style="
        background:#f1f5f9;color:#64748b;
        font-size:11px;font-weight:700;
        padding:3px 8px;border-radius:20px;
      " data-i18n-auto>📞 납기 협의</span>
    <% } %>
  </div>

  <!-- 규격/스펙 -->
  <% if (product.code || product.spec) { %>
    <div class="app-spec-box">
      <% if (product.code) { %>
        <div style="margin-bottom:10px;">
          <div class="app-spec-box__label" data-i18n-auto>제품코드</div>
          <div class="app-spec-box__value"><%= product.code %></div>
        </div>
      <% } %>
      <% if (product.spec) { %>
        <div>
          <div class="app-spec-box__label" data-i18n-auto>규격/스펙</div>
          <div class="app-spec-box__value" data-i18n-auto><%= product.spec %></div>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- 상품 설명 -->
  <% if (product.description) { %>
    <div style="margin-top:16px;font-size:14px;color:var(--c-text-2);line-height:1.7;">
      <%= product.description %>
    </div>
  <% } %>

  <!-- ── 기술자료실 (Technical Data Room) ── -->
  <div style="margin-top:20px;">
    <div style="
      display:flex;align-items:center;
      justify-content:space-between;margin-bottom:12px;
    ">
      <span style="font-size:13px;font-weight:700;color:var(--c-text);" data-i18n-auto>📄 기술문서</span>
      <% if (!user) { %>
        <a href="/auth/login" style="font-size:11px;color:var(--c-accent);" data-i18n-auto>로그인 후 다운로드</a>
      <% } %>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;">
      <%
        const docTypes = [
          { icon:'📑', label:'데이터시트 (PDF)', size:'1.2 MB', ext:'PDF', locked: !user },
          { icon:'📐', label:'도면 (CAD/DXF)',   size:'842 KB', ext:'DXF', locked: !user },
          { icon:'🏅', label:'ISO 9001 인증서',  size:'380 KB', ext:'PDF', locked: false },
        ];
      %>
      <% docTypes.forEach(function(doc) { %>
        <div style="
          display:flex;align-items:center;gap:10px;
          padding:10px 12px;border-radius:var(--r-lg);
          border:1px solid var(--c-border);
          background:var(--c-bg);
        ">
          <span style="font-size:18px;flex-shrink:0;"><%= doc.icon %></span>
          <div style="flex:1;min-width:0;">
            <div style="font-size:12px;font-weight:600;color:var(--c-text);" data-i18n-auto><%= doc.label %></div>
            <div style="font-size:11px;color:var(--c-muted);"><%= doc.size %></div>
          </div>
          <% if (doc.locked) { %>
            <a href="/auth/login" style="
              font-size:11px;padding:4px 10px;border-radius:6px;
              background:#f1f5f9;color:#64748b;text-decoration:none;
            " data-i18n-auto>🔒 로그인</a>
          <% } else { %>
            <span style="
              font-size:10px;font-weight:700;padding:3px 7px;border-radius:4px;
              background:#dbeafe;color:#1d4ed8;letter-spacing:.04em;
            "><%= doc.ext %></span>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- 찜하기 (로그인 유저만) -->
  <% if (user) { %>
    <form action="/shop/wishlist/toggle" method="post" style="margin-top:20px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <button class="app-btn <%= wished ? 'app-btn--primary' : 'app-btn--outline' %>"
              type="submit"
              style="width:100%;gap:6px;">
        <svg width="15" height="15" viewBox="0 0 24 24"
             fill="<%= wished ? 'currentColor' : 'none' %>" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
                stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        <%= wished ? '찜 해제' : '찜하기' %>
      </button>
    </form>
  <% } %>

  <!-- 안내 문구 -->
  <p style="font-size:12px;color:var(--c-muted-2);margin-top:12px;text-align:center;">
    비회원도 장바구니 사용 가능 (세션 종료 시 초기화)
  </p>

</div><!-- /app-detail-body -->


<!-- ══════════════════════════════════════════
   리뷰 섹션
══════════════════════════════════════════ -->
<div class="app-section--pad" id="reviews">

  <div class="app-sec-head">
    <div>
      <h2 class="app-sec-title">리뷰/평점</h2>
      <p class="app-sec-sub">총 <%= reviewStats?.review_count || 0 %>건</p>
    </div>
  </div>

  <!-- 리뷰 작성 폼 -->
  <% if (user) { %>
    <form class="app-review-write" method="post"
          action="/shop/products/<%= product.id %>/reviews">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="display:flex;gap:8px;margin-bottom:8px;">
        <select class="app-field__input" name="rating" required
                style="flex:0 0 90px;">
          <option value="">평점</option>
          <option value="5">★ 5점</option>
          <option value="4">★ 4점</option>
          <option value="3">★ 3점</option>
          <option value="2">★ 2점</option>
          <option value="1">★ 1점</option>
        </select>
        <input class="app-field__input" name="content"
               placeholder="리뷰 내용을 입력해주세요." required
               style="flex:1;">
      </div>
      <button class="app-btn app-btn--primary" type="submit" style="width:100%;">
        리뷰 등록
      </button>
    </form>
  <% } else { %>
    <div class="app-alert app-alert--info" style="margin-bottom:16px;">
      리뷰를 작성하려면 <a href="/auth/login" style="color:var(--c-accent);font-weight:600;">로그인</a>해주세요.
    </div>
  <% } %>

  <!-- 리뷰 목록 -->
  <% if (!reviews || reviews.length === 0) { %>
    <div class="app-empty" style="padding:24px 0;">
      <p class="app-empty__desc">등록된 리뷰가 없습니다.</p>
    </div>
  <% } else { %>
    <% reviews.forEach(function(review) { %>
      <div class="app-review-card">
        <div class="app-review-card__head">
          <strong class="app-review-card__name"><%= review.user_name || '고객' %></strong>
          <span class="app-review-card__rating">★ <%= review.rating %>점</span>
        </div>
        <div class="app-review-card__date">
          <%= new Date(review.created_at).toLocaleDateString('ko-KR') %>
        </div>
        <div class="app-review-card__content"><%= review.content %></div>
      </div>
    <% }); %>
  <% } %>

</div><!-- /reviews -->


<!-- ══════════════════════════════════════════
   연관 상품 — 가로 스크롤
══════════════════════════════════════════ -->
<% if (related && related.length > 0) { %>
  <div class="app-related">
    <div class="app-sec-head" style="padding:0 16px;">
      <h2 class="app-sec-title">연관 상품</h2>
      <a class="app-sec-more" href="/shop/products">전체 보기 →</a>
    </div>
    <div class="app-related-scroll">
      <% related.forEach(function(item) { %>
        <div class="app-related-card">
          <a href="/shop/products/<%= item.id %>" class="app-related-card__thumb"
             aria-label="<%= item.name %> 상세 보기">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
            <% } else { %>
              <div class="app-product-card__placeholder" style="height:100%;border-radius:var(--r-lg);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="3" width="18" height="18" rx="2"
                        stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </div>
            <% } %>
          </a>
          <div class="app-related-card__body">
            <div class="app-related-card__name">
              <a href="/shop/products/<%= item.id %>"
                 style="color:inherit;text-decoration:none;"><%= item.name %></a>
            </div>
            <div class="app-related-card__price">
              <%= Number(item.price || 0).toLocaleString() %><span>원</span>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<!-- 하단 여백 (sticky CTA 높이만큼) -->
<div style="height:16px;"></div>


<!-- ══════════════════════════════════════════
   장바구니 담기 확인 모달
══════════════════════════════════════════ -->
<div id="cartAddedOverlay" style="
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.48);z-index:2000;
  align-items:center;justify-content:center;
  padding:20px;
" role="dialog" aria-modal="true" aria-labelledby="cartAddedTitle">
  <div style="
    background:var(--c-bg);border-radius:var(--r-xl);
    padding:28px 24px;max-width:340px;width:100%;
    box-shadow:0 20px 60px rgba(0,0,0,.3);
    text-align:center;
  ">
    <!-- 체크 아이콘 -->
    <div style="
      width:52px;height:52px;border-radius:50%;
      background:rgba(22,163,74,.12);
      display:flex;align-items:center;justify-content:center;
      margin:0 auto 16px;
    ">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" stroke="#16a34a" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <h3 id="cartAddedTitle" style="
      font-size:16px;font-weight:700;
      color:var(--c-text);margin:0 0 6px;
    ">장바구니에 담겼습니다</h3>
    <p style="
      font-size:13px;color:var(--c-muted);margin:0 0 20px;
    " id="cartAddedDesc">이어서 쇼핑하시겠습니까?</p>
    <div style="display:flex;gap:10px;">
      <button id="cartModalNo" style="
        flex:1;padding:11px 0;border-radius:var(--r-lg);
        border:1.5px solid var(--c-border);background:var(--c-bg);
        color:var(--c-text);font-size:14px;font-weight:600;cursor:pointer;
      ">아니오 (장바구니)</button>
      <button id="cartModalYes" style="
        flex:1;padding:11px 0;border-radius:var(--r-lg);
        border:none;background:var(--c-accent);
        color:#fff;font-size:14px;font-weight:600;cursor:pointer;
      ">예 (계속 쇼핑)</button>
    </div>
  </div>
</div>


<!-- ══════════════════════════════════════════
   Sticky 하단 구매 CTA
   form submit → fetch → 모달 표시 (기존 redirect 대신)
   수량 조절은 shop-bottom.ejs의 공통 핸들러(data-qty-inc/dec) 사용
══════════════════════════════════════════ -->
<div class="app-bottom-cta" id="detailBottomCta">
  <form action="/shop/cart/add" method="post" id="detailCartForm"
        style="width:100%;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="productId" value="<%= product.id %>">

    <div class="app-bottom-cta__inner">

      <!-- 수량 조절 -->
      <div class="app-qty">
        <button class="app-qty__btn" type="button"
                data-qty-dec="detailQty" aria-label="수량 감소">−</button>
        <input class="app-qty__input" id="detailQty" name="quantity"
               type="number" min="1" value="1" readonly>
        <button class="app-qty__btn" type="button"
                data-qty-inc="detailQty" aria-label="수량 증가">+</button>
      </div>

      <!-- 장바구니 담기 버튼 -->
      <button class="app-btn app-btn--outline" type="submit"
              id="detailAddBtn"
              form="detailCartForm"
              style="flex:1;min-width:0;"
              aria-label="장바구니 담기">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"
                stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2"/>
          <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="2"
                stroke-linecap="round"/>
        </svg>
        담기
      </button>

      <!-- 샘플 요청 -->
      <button class="app-btn app-btn--outline"
              type="button"
              data-sheet-open="sampleSheet"
              data-sheet-overlay="rfqSheetOverlay"
              style="flex:1;min-width:0;font-size:12px;">
        🧪 샘플
      </button>

      <!-- 견적 요청 버튼 (RFQ Drawer 열기) -->
      <button class="app-btn app-btn--primary"
              type="button"
              data-sheet-open="rfqSheet"
              data-sheet-overlay="rfqSheetOverlay"
              style="flex:1.4;min-width:0;">
        📋 견적 요청
      </button>

    </div>
  </form>
</div><!-- /detailBottomCta -->


<!-- ══════════════════════════════════════════
   샘플 요청·평가 플로우 드로어
══════════════════════════════════════════ -->
<div class="app-sheet" id="sampleSheet" role="dialog" aria-modal="true" aria-label="샘플 요청">
  <div class="app-sheet__handle" aria-hidden="true"></div>
  <div class="app-sheet__head">
    <h2 class="app-sheet__title" data-i18n-auto>🧪 샘플 요청</h2>
    <button class="app-sheet__close" type="button" data-sheet-close aria-label="닫기">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="app-sheet__body" style="overflow-y:auto;">
    <div style="background:#eff6ff;border-radius:10px;padding:12px 14px;margin-bottom:20px;font-size:12px;color:#1e40af;">
      <strong>📦 샘플 정책</strong><br>
      최대 5개까지 평가용 샘플을 신청할 수 있습니다. 2~3 영업일 내 배송됩니다.
    </div>

    <form id="sampleForm">
      <input type="hidden" name="productId" value="<%= product.id %>">

      <div class="app-field" style="margin-bottom:14px;">
        <label class="app-field__label" for="sampleQty" data-i18n-auto>샘플 수량 (최대 5개)</label>
        <div style="display:flex;align-items:center;gap:8px;">
          <div class="app-qty">
            <button class="app-qty__btn" type="button" data-qty-dec="sampleQty">−</button>
            <input class="app-qty__input" id="sampleQty" name="quantity" type="number" min="1" max="5" value="1">
            <button class="app-qty__btn" type="button" data-qty-inc="sampleQty">+</button>
          </div>
          <span style="font-size:12px;color:var(--c-muted);">개</span>
        </div>
      </div>

      <div class="app-field" style="margin-bottom:14px;">
        <label class="app-field__label" for="sampleApp" data-i18n-auto>적용 장비 / 용도 <span style="color:var(--c-accent);">*</span></label>
        <input class="app-field__input" id="sampleApp" name="application" type="text"
               placeholder="예: 고온 소결로 내부 라이너 교체" maxlength="200" required>
      </div>

      <div class="app-field" style="margin-bottom:14px;">
        <label class="app-field__label" for="sampleCond" data-i18n-auto>시험 조건 (선택)</label>
        <input class="app-field__input" id="sampleCond" name="testCondition" type="text"
               placeholder="예: 1400℃, H2 분위기, 반복 열충격" maxlength="200">
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
        <div class="app-field">
          <label class="app-field__label" for="sampleName" data-i18n-auto>담당자 <span style="color:var(--c-accent);">*</span></label>
          <input class="app-field__input" id="sampleName" name="contactName" type="text"
                 placeholder="홍길동" required value="<%= user?.name || '' %>">
        </div>
        <div class="app-field">
          <label class="app-field__label" for="sampleEmail" data-i18n-auto>이메일 <span style="color:var(--c-accent);">*</span></label>
          <input class="app-field__input" id="sampleEmail" name="contactEmail" type="email"
                 placeholder="contact@company.com" required value="<%= user?.email || '' %>">
        </div>
      </div>

      <div class="app-field" style="margin-bottom:20px;">
        <label class="app-field__label" for="sampleCompany" data-i18n-auto>회사명</label>
        <input class="app-field__input" id="sampleCompany" name="companyName" type="text"
               placeholder="(주)에너메이드" value="<%= user?.company || '' %>">
      </div>

      <div id="sampleAlert" style="display:none;margin-bottom:12px;"></div>
    </form>
  </div>

  <div class="app-sheet__footer">
    <button class="app-btn app-btn--outline" style="flex:1;" type="button" data-sheet-close data-i18n-auto>취소</button>
    <button class="app-btn app-btn--primary" style="flex:2;" type="button" id="sampleSubmitBtn" data-i18n-auto>샘플 신청</button>
  </div>
</div><!-- /sampleSheet -->

<script>
(function () {
  'use strict';
  var form      = document.getElementById('sampleForm');
  var submitBtn = document.getElementById('sampleSubmitBtn');
  var alertEl   = document.getElementById('sampleAlert');
  var csrf      = '<%= csrfToken %>';

  function showAlert(msg, type) {
    alertEl.style.display = 'block';
    alertEl.className = 'app-alert app-alert--' + (type || 'info');
    alertEl.textContent = msg;
  }

  submitBtn.addEventListener('click', function () {
    alertEl.style.display = 'none';
    var name  = form.querySelector('[name="contactName"]').value.trim();
    var email = form.querySelector('[name="contactEmail"]').value.trim();
    var app   = form.querySelector('[name="application"]').value.trim();
    if (!name || !email || !app) {
      showAlert('담당자명, 이메일, 적용 용도는 필수입니다.', 'warn');
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = '처리 중…';

    var data = {};
    Array.from(new FormData(form).entries()).forEach(function(e){ data[e[0]] = e[1]; });

    fetch('/shop/inquiries/sample', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
      body: JSON.stringify(data),
    })
      .then(function(r){ return r.json(); })
      .then(function(res) {
        if (res.ok) {
          showAlert('✅ ' + res.message, 'success');
          submitBtn.textContent = '신청 완료';
          setTimeout(function() {
            window.AppSheet && window.AppSheet.close('sampleSheet', 'rfqSheetOverlay');
            alertEl.style.display = 'none';
            submitBtn.disabled = false;
            submitBtn.textContent = '샘플 신청';
          }, 3000);
        } else {
          showAlert('⚠️ ' + (res.message || '오류'), 'warn');
          submitBtn.disabled = false;
          submitBtn.textContent = '샘플 신청';
        }
      })
      .catch(function() {
        showAlert('⚠️ 네트워크 오류', 'warn');
        submitBtn.disabled = false;
        submitBtn.textContent = '샘플 신청';
      });
  });
})();
</script>

<!-- ══════════════════════════════════════════
   RFQ 견적 요청 드로어 (슬라이드 업 패널)
══════════════════════════════════════════ -->
<div class="app-sheet-overlay" id="rfqSheetOverlay" aria-hidden="true"></div>

<div class="app-sheet" id="rfqSheet" role="dialog" aria-modal="true" aria-label="견적 요청">
  <div class="app-sheet__handle" aria-hidden="true"></div>

  <div class="app-sheet__head">
    <h2 class="app-sheet__title" data-i18n-auto>📋 견적 요청</h2>
    <button class="app-sheet__close" type="button" data-sheet-close aria-label="닫기">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="app-sheet__body" style="overflow-y:auto;">
    <!-- 상품 정보 요약 -->
    <div style="
      background:var(--c-bg-2,#f8f8f8);border-radius:var(--r-lg);
      padding:12px 14px;margin-bottom:20px;
      display:flex;align-items:center;gap:12px;
    ">
      <% if (product.image) { %>
        <img src="<%= product.image %>" alt=""
             style="width:44px;height:44px;object-fit:cover;border-radius:var(--r-md);flex-shrink:0;">
      <% } %>
      <div style="min-width:0;">
        <div style="font-size:13px;font-weight:700;color:var(--c-text);
                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
             data-i18n-auto><%= product.name %></div>
        <% if (product.code) { %>
          <div style="font-size:11px;color:var(--c-muted);">CODE: <%= product.code %></div>
        <% } %>
      </div>
    </div>

    <form id="rfqForm">
      <input type="hidden" name="productId" value="<%= product.id %>">

      <!-- 수량 -->
      <div class="app-field" style="margin-bottom:14px;">
        <label class="app-field__label" for="rfqQty" data-i18n-auto>수량</label>
        <div style="display:flex;align-items:center;gap:8px;">
          <div class="app-qty">
            <button class="app-qty__btn" type="button"
                    data-qty-dec="rfqQty" aria-label="수량 감소">−</button>
            <input class="app-qty__input" id="rfqQty" name="quantity"
                   type="number" min="1" value="1">
            <button class="app-qty__btn" type="button"
                    data-qty-inc="rfqQty" aria-label="수량 증가">+</button>
          </div>
          <span style="font-size:12px;color:var(--c-muted);" data-i18n-auto>개</span>
        </div>
      </div>

      <!-- 2열: 목표 단가 / 희망 납기 -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
        <div class="app-field">
          <label class="app-field__label" for="rfqPrice" data-i18n-auto>목표 단가 (선택)</label>
          <input class="app-field__input" id="rfqPrice" name="targetPrice"
                 type="text" placeholder="예: 5,000원/개" maxlength="100">
        </div>
        <div class="app-field">
          <label class="app-field__label" for="rfqDelivery" data-i18n-auto>희망 납기 (선택)</label>
          <input class="app-field__input" id="rfqDelivery" name="deliveryDate"
                 type="date" min="<%= new Date().toISOString().slice(0,10) %>">
        </div>
      </div>

      <!-- 회사명 -->
      <div class="app-field" style="margin-bottom:14px;">
        <label class="app-field__label" for="rfqCompany" data-i18n-auto>회사명 (선택)</label>
        <input class="app-field__input" id="rfqCompany" name="companyName"
               type="text" placeholder="(주)에너메이드" maxlength="100"
               value="<%= user?.company || '' %>">
      </div>

      <!-- 2열: 담당자 / 이메일 -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
        <div class="app-field">
          <label class="app-field__label" for="rfqName" data-i18n-auto>담당자 <span style="color:var(--c-accent);">*</span></label>
          <input class="app-field__input" id="rfqName" name="contactName"
                 type="text" placeholder="홍길동" maxlength="100" required
                 value="<%= user?.name || '' %>">
        </div>
        <div class="app-field">
          <label class="app-field__label" for="rfqEmail" data-i18n-auto>이메일 <span style="color:var(--c-accent);">*</span></label>
          <input class="app-field__input" id="rfqEmail" name="contactEmail"
                 type="email" placeholder="contact@company.com" maxlength="150" required
                 value="<%= user?.email || '' %>">
        </div>
      </div>

      <!-- 요청사항 -->
      <div class="app-field" style="margin-bottom:20px;">
        <label class="app-field__label" for="rfqMessage" data-i18n-auto>요청사항 (선택)</label>
        <textarea class="app-field__input" id="rfqMessage" name="message"
                  rows="3" maxlength="1000"
                  placeholder="특수 규격, 재질, 수량 할인 조건 등 자유롭게 입력해주세요."></textarea>
      </div>

      <!-- 알림 메시지 영역 -->
      <div id="rfqAlert" style="display:none;margin-bottom:12px;"></div>
    </form>
  </div>

  <div class="app-sheet__footer">
    <button class="app-btn app-btn--outline" style="flex:1;"
            type="button" data-sheet-close data-i18n-auto>취소</button>
    <button class="app-btn app-btn--primary" style="flex:2;"
            type="button" id="rfqSubmitBtn" data-i18n-auto>견적 요청 전송</button>
  </div>
</div><!-- /rfqSheet -->

<script>
(function () {
  'use strict';

  var form      = document.getElementById('rfqForm');
  var submitBtn = document.getElementById('rfqSubmitBtn');
  var alertEl   = document.getElementById('rfqAlert');
  var csrfToken = '<%= csrfToken %>';

  function showAlert(msg, type) {
    alertEl.style.display = 'block';
    alertEl.className = 'app-alert app-alert--' + (type || 'info');
    alertEl.textContent = msg;
  }

  function hideAlert() {
    alertEl.style.display = 'none';
  }

  submitBtn.addEventListener('click', function () {
    hideAlert();

    /* 필수 입력 검증 */
    var name  = form.querySelector('[name="contactName"]').value.trim();
    var email = form.querySelector('[name="contactEmail"]').value.trim();
    if (!name || !email) {
      showAlert('담당자명과 이메일은 필수입니다.', 'warn');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '전송 중…';

    var data = {};
    Array.from(new FormData(form).entries()).forEach(function (e) {
      data[e[0]] = e[1];
    });

    fetch('/shop/inquiries/rfq', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-csrf-token': csrfToken,
      },
      body: JSON.stringify(data),
    })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (res.ok) {
          showAlert('✅ ' + res.message, 'success');
          submitBtn.textContent = '전송 완료';
          /* 3초 후 드로어 닫기 */
          setTimeout(function () {
            window.AppSheet && window.AppSheet.close('rfqSheet', 'rfqSheetOverlay');
            hideAlert();
            submitBtn.disabled = false;
            submitBtn.textContent = '견적 요청 전송';
          }, 3000);
        } else {
          showAlert('⚠️ ' + (res.message || '오류가 발생했습니다.'), 'warn');
          submitBtn.disabled = false;
          submitBtn.textContent = '견적 요청 전송';
        }
      })
      .catch(function () {
        showAlert('⚠️ 네트워크 오류가 발생했습니다. 다시 시도해주세요.', 'warn');
        submitBtn.disabled = false;
        submitBtn.textContent = '견적 요청 전송';
      });
  });
})();
</script>

<script>
(function () {
  'use strict';

  var form    = document.getElementById('detailCartForm');
  var overlay = document.getElementById('cartAddedOverlay');
  var btnNo   = document.getElementById('cartModalNo');
  var btnYes  = document.getElementById('cartModalYes');
  var addBtn  = document.getElementById('detailAddBtn');

  if (!form || !overlay) return;

  /* 모달 열기/닫기 */
  function openModal(cartCount) {
    var desc = document.getElementById('cartAddedDesc');
    if (desc && cartCount > 0) {
      desc.textContent = '장바구니에 ' + cartCount + '개 담겨있습니다. 이어서 쇼핑하시겠습니까?';
    }
    overlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    btnYes && btnYes.focus();
  }

  function closeModal() {
    overlay.style.display = 'none';
    document.body.style.overflow = '';
  }

  /* "예" → 현재 페이지 유지 (모달만 닫기) */
  btnYes && btnYes.addEventListener('click', closeModal);

  /* "아니오" → 장바구니로 이동 */
  btnNo && btnNo.addEventListener('click', function () {
    closeModal();
    window.location.href = '/shop/cart';
  });

  /* 오버레이 외부 클릭 시 닫기 */
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeModal();
  });

  /* Escape 키 닫기 */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.style.display === 'flex') closeModal();
  });

  /* 장바구니 헤더 배지 갱신 */
  function updateCartBadge(count) {
    var badges = document.querySelectorAll('.shop-cart-badge, .app-tab-badge');
    badges.forEach(function (b) {
      if (count > 0) { b.textContent = count; b.style.display = ''; }
      else { b.style.display = 'none'; }
    });
    var headerBtn = document.querySelector('.app-header__btn[href="/shop/cart"]');
    if (headerBtn) {
      var existing = headerBtn.querySelector('.shop-cart-badge');
      if (count > 0 && !existing) {
        var span = document.createElement('span');
        span.className = 'app-header-badge shop-cart-badge';
        span.textContent = count;
        headerBtn.appendChild(span);
      }
    }
  }

  /* 폼 submit 인터셉트 */
  form.addEventListener('submit', function (e) {
    e.preventDefault();

    if (addBtn) { addBtn.disabled = true; }

    var body = new URLSearchParams();
    body.append('_csrf',     form.querySelector('[name="_csrf"]').value);
    body.append('productId', form.querySelector('[name="productId"]').value);
    body.append('quantity',  document.getElementById('detailQty').value || '1');

    fetch('/shop/cart/add', {
      method:  'POST',
      headers: {
        'Content-Type':     'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest',
        'x-csrf-token':     body.get('_csrf') || ''
      },
      body: body.toString()
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.ok) {
          updateCartBadge(data.cartCount || 0);
          openModal(data.cartCount || 0);
        } else {
          alert(data.message || '장바구니 담기에 실패했습니다.');
        }
      })
      .catch(function () {
        alert('네트워크 오류가 발생했습니다. 다시 시도해주세요.');
      })
      .finally(function () {
        if (addBtn) { addBtn.disabled = false; }
      });
  });
})();
</script>

