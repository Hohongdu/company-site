<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <title>우리 회사 - 문의하기</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- 네비게이션 공통 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">우리 회사</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">홈</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/about">회사 소개</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/contact">문의하기</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <h1 class="mb-4">문의하기</h1>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">이름</label>
                            <input type="text" class="form-control" placeholder="성함을 입력해주세요">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">이메일</label>
                            <input type="email" class="form-control" placeholder="example@company.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">문의 내용</label>
                            <textarea class="form-control" rows="4" placeholder="문의하실 내용을 적어주세요"></textarea>
                        </div>
                        <!-- 나중에 실제 POST /api/contact 이런 식으로 연결할 수 있음 -->
                        <button type="submit" class="btn btn-primary">문의 보내기</button>
                    </form>
                </div>

                <div class="col-md-6">
                    <h2 class="h5 mb-3">연락처 & 위치</h2>
                    <p class="mb-1">전화: 010-0000-0000</p>
                    <p class="mb-1">이메일: contact@company.com</p>
                    <p class="mb-3">주소: 서울시 어딘가 00로 00</p>

                    <div
                        class="ratio ratio-16x9 bg-secondary rounded-3 d-flex align-items-center justify-content-center text-white">
                        <!-- 나중에 지도 iframe 또는 카카오맵 스크립트 넣기 -->
                        지도 영역 (추후 연동)
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white py-3 mt-5">
        <div class="container text-center small">
            © <span id="year"></span> 우리 회사. All rights reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>