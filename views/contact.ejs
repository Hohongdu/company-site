<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>우리 회사 - 문의하기</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- 공통 헤더 -->
    <%- include('partials/header') %>

        <!-- 메인 영역 -->
        <main class="py-5">
            <div class="container">
                <h1 class="mb-4">문의하기</h1>

                <div class="row">
                    <!-- 문의 폼 -->
                    <div class="col-md-6 mb-4">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">이름</label>
                                <input type="text" class="form-control" placeholder="성함을 입력해주세요">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">이메일</label>
                                <input type="email" class="form-control" placeholder="example@company.com">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">문의 내용</label>
                                <textarea class="form-control" rows="4" placeholder="문의하실 내용을 적어주세요"></textarea>
                            </div>

                            <!-- 실제 전송: 나중에 /api/contact로 연결 -->
                            <button type="submit" class="btn btn-primary">문의 보내기</button>
                        </form>
                    </div>

                    <!-- 회사 정보 -->
                    <div class="col-md-6">
                        <h2 class="h5 mb-3">연락처 & 위치</h2>

                        <p class="mb-1">전화: 010-0000-0000</p>
                        <p class="mb-1">이메일: contact@company.com</p>
                        <p class="mb-3">주소: 서울특별시 OO구 OO로 123</p>

                        <div
                            class="ratio ratio-16x9 bg-secondary rounded-3 d-flex align-items-center justify-content-center text-white">
                            지도 영역 (나중에 카카오맵/구글맵 삽입)
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- 공통 푸터 -->
        <%- include('partials/footer') %>

            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
            </script>
            <script src="/js/main.js"></script>
</body>

</html>