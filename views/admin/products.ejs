<%- include('partials/admin-header', { title: '상품 관리' , active: 'products' }) %>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-1">상품 관리</h3>
            <div class="text-muted small">상품 목록 확인 / 수정 / 삭제</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/admin">대시보드</a>
            <a class="btn btn-outline-dark btn-sm" href="/shop/products">상품몰 보기</a>
            <a class="btn btn-dark btn-sm" href="/admin/products/new">+ 상품 등록</a>
            <a href="/admin/products/export" class="btn btn-outline-light btn-sm">
                엑셀 다운로드
            </a>

        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <% if (!products || products.length===0) { %>
                <div class="text-muted">등록된 상품이 없습니다.</div>
                <% } else { %>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th style="width:90px;">ID</th>
                                    <th>상품명</th>
                                    <th style="width:140px;">가격</th>
                                    <th style="width:180px;">카테고리</th>
                                    <th style="width:200px;" class="text-end">관리</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% products.forEach(p=> { %>
                                    <tr>
                                        <td>
                                            <%= p.id %>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">
                                                <%= p.name %>
                                            </div>
                                            <% if (p.code) { %>
                                                <div class="text-muted small">코드: <%= p.code %>
                                                </div>
                                                <% } %>
                                        </td>
                                        <td>
                                            <%= Number(p.price || 0).toLocaleString() %> 원
                                        </td>
                                        <td>
                                            <%= p.category_name || '-' %>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-primary btn-sm"
                                                href="/admin/products/<%= p.id %>/edit">수정</a>

                                            <form action="/admin/products/<%= p.id %>/delete" method="post"
                                                class="d-inline"
                                                onsubmit="return confirm('정말 삭제할까요? (장바구니 항목도 함께 정리됩니다)');">
                                                <button class="btn btn-outline-danger btn-sm" type="submit">삭제</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% } %>
        </div>
    </div>

    <%- include('partials/admin-footer') %>