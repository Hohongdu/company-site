<%- include('partials/admin-header', { title: '상품 관리' , subtitle: '상품 등록/수정/삭제' , active: 'products' }) %>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1">상품 목록</h3>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" href="/admin/products/new">+ 새 상품</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/products/import">엑셀 업로드</a>
        </div>
    </div>

    <% const list=(typeof products !=='undefined' && products) ? products : []; %>

        <div class="card shadow-sm">
            <div class="card-body">
                <form id="bulkDeleteForm" action="/admin/products/bulk-delete" method="post"
                    onsubmit="return confirm('선택한 상품을 삭제할까요?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <div class="text-muted small">선택 삭제 기능</div>
                        <button class="btn btn-sm btn-outline-danger" type="submit" id="bulkDeleteBtn" disabled>
                            선택 삭제
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr class="text-muted small">
                                    <th style="width:44px;">
                                        <input class="form-check-input" type="checkbox" id="checkAll">
                                    </th>
                                    <th style="min-width:80px;">ID</th>
                                    <th style="min-width:140px;">코드</th>
                                    <th style="min-width:220px;">상품명</th>
                                    <th style="min-width:160px;">카테고리</th>
                                    <th style="min-width:120px;" class="text-end">가격</th>
                                    <th style="min-width:160px;">관리</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (list.length===0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">등록된 상품이 없습니다.</td>
                                    </tr>
                                    <% } %>

                                        <% list.forEach((p)=> { %>
                                            <tr>
                                                <td>
                                                    <input class="form-check-input js-row-check" type="checkbox"
                                                        name="productIds" value="<%= p.id %>">
                                                </td>
                                                <td>
                                                    <%= p.id %>
                                                </td>
                                                <td class="text-muted">
                                                    <%= p.code || '-' %>
                                                </td>
                                                <td class="fw-semibold">
                                                    <%= p.name %>
                                                </td>
                                                <td class="text-muted">
                                                    <%= p.category_name || '-' %>
                                                </td>
                                                <td class="text-end">
                                                    <%= Number(p.price || 0).toLocaleString() %>원
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-2 flex-wrap">
                                                        <a class="btn btn-sm btn-outline-primary"
                                                            href="/admin/products/<%= p.id %>/edit">수정</a>

                                                        <!-- ✅ 삭제 폼 (중첩 아님) + CSRF 포함 -->
                                                        <form action="/admin/products/<%= p.id %>/delete" method="post"
                                                            onsubmit="return confirm('삭제할까요?');">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                type="submit">삭제</button>
                                                        </form>

                                                        <a class="btn btn-sm btn-outline-secondary"
                                                            href="/shop/products/<%= p.id %>" target="_blank">샵에서 보기</a>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>

        <script>
            const checkAll = document.getElementById('checkAll');
            const rowChecks = Array.from(document.querySelectorAll('.js-row-check'));
            const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');

            const syncBulkState = () => {
                const checkedCount = rowChecks.filter((el) => el.checked).length;
                bulkDeleteBtn.disabled = checkedCount === 0;
                if (checkAll) {
                    checkAll.checked = checkedCount > 0 && checkedCount === rowChecks.length;
                    checkAll.indeterminate = checkedCount > 0 && checkedCount < rowChecks.length;
                }
            };

            checkAll?.addEventListener('change', (e) => {
                rowChecks.forEach((el) => {
                    el.checked = e.target.checked;
                });
                syncBulkState();
            });

            rowChecks.forEach((el) => el.addEventListener('change', syncBulkState));
        </script>

        <%- include('partials/admin-footer') %>
