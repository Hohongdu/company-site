<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>관리자 - 상품 목록</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h4 mb-0">상품 목록</h1>
                <div class="text-muted small">총 <%= products.length %>개</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary btn-sm" href="/admin">대시보드</a>
                <a class="btn btn-primary btn-sm" href="/admin/products/new">상품 등록</a>
                <a class="btn btn-outline-primary btn-sm" href="/admin/products/import">엑셀 업로드</a>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;">ID</th>
                            <th>상품명</th>
                            <th style="width:140px;">카테고리</th>
                            <th style="width:120px;">가격</th>
                            <th style="width:180px;">관리</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!products.length) { %>
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">상품이 없습니다.</td>
                            </tr>
                            <% } %>

                                <% products.forEach(p=> { %>
                                    <tr>
                                        <td>
                                            <%= p.id %>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">
                                                <%= p.name %>
                                            </div>
                                            <div class="text-muted small">
                                                코드: <%= p.code || '-' %> / 규격: <%= p.spec || '-' %>
                                            </div>
                                        </td>
                                        <td>
                                            <%= p.category_name || '-' %>
                                        </td>
                                        <td>
                                            <%= Number(p.price || 0).toLocaleString() %>원
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a class="btn btn-outline-dark btn-sm"
                                                    href="/admin/products/<%= p.id %>/edit">수정</a>

                                                <form action="/admin/products/<%= p.id %>/delete" method="post"
                                                    onsubmit="return confirm('정말 삭제할까요?');">
                                                    <button class="btn btn-outline-danger btn-sm"
                                                        type="submit">삭제</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>