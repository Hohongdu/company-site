<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>관리자 대시보드</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">관리자 대시보드</h1>
                <div class="text-muted small">
                    <strong>
                        <%= user?.name %>
                    </strong> 님 (관리자)
                </div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="/shop">상품몰</a>
                <a class="btn btn-outline-dark" href="/">회사 페이지</a>
                <a class="btn btn-outline-dark w-100" href="/admin/products">상품 목록</a>

            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">카테고리 관리</h5>
                        <p class="card-text text-muted small">카테고리 추가/삭제</p>
                        <a class="btn btn-primary w-100" href="/admin/categories">이동</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">상품 등록</h5>
                        <p class="card-text text-muted small">상품을 직접 등록</p>
                        <a class="btn btn-primary w-100" href="/admin/products/new">이동</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">엑셀 업로드</h5>
                        <p class="card-text text-muted small">엑셀로 상품 일괄 반영</p>
                        <a class="btn btn-primary w-100" href="/admin/products/import">이동</a>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-end">
            <a class="btn btn-outline-danger" href="/auth/logout">로그아웃</a>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>