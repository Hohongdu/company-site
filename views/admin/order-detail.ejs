<%- include('partials/admin-header', { title: '주문 상세' , subtitle: '주문과 결제 상세 내역을 확인합니다.' , active: 'orders' , backHref: '/admin/orders' }) %>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="admin-card card h-100">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">주문 정보</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">주문번호</span>
                    <span class="fw-semibold"><%= order.order_number %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">상태</span>
                    <%
                    const statusMap = {PENDING:'warning',PAID:'success',PROCESSING:'info',SHIPPED:'primary',DELIVERED:'success',CANCELED:'secondary',FAILED:'danger',CANCEL_REQUESTED:'warning'};
                    const statusLabel = {PENDING:'대기',PAID:'결제완료',PROCESSING:'처리중',SHIPPED:'배송중',DELIVERED:'배송완료',CANCELED:'취소됨',FAILED:'실패',CANCEL_REQUESTED:'취소요청'};
                    %>
                    <span class="badge bg-<%= statusMap[order.status] || 'secondary' %>">
                        <%= statusLabel[order.status] || order.status %>
                    </span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">주문자</span>
                    <span><%= order.user_name || order.guest_name || '비회원' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">연락처</span>
                    <span><%= order.user_email || order.guest_email || order.guest_phone || '-' %></span>
                </div>
                <% if (order.shipping_name || order.shipping_address) { %>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">배송 수령인</span>
                    <span><%= order.shipping_name || '-' %> <%= order.shipping_phone || '' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">배송지</span>
                    <span class="text-end" style="max-width:200px"><%= order.shipping_address || '-' %></span>
                </div>
                <% } %>
                <% if (order.coupon_code) { %>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">쿠폰</span>
                    <span class="text-success"><%= order.coupon_code %> (-<%= Number(order.discount_amount||0).toLocaleString() %>원)</span>
                </div>
                <% } %>
                <div class="d-flex justify-content-between mb-3">
                    <span class="admin-muted">총 금액</span>
                    <span class="fw-semibold"><%= Number(order.total_amount || 0).toLocaleString() %>원</span>
                </div>
                <hr>
                <div class="fw-semibold small mb-2">주문 상태 변경</div>
                <form action="/admin/orders/<%= order.order_number %>/status" method="post" class="d-flex gap-2">
                    <select name="status" class="form-select form-select-sm">
                        <% ['PENDING','PAID','PROCESSING','SHIPPED','DELIVERED','CANCELED'].forEach(s => { %>
                            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= statusLabel[s] || s %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap">변경</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="admin-card card h-100">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">결제 정보</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">결제수단</span>
                    <span><%= payment?.provider || '-' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">결제상태</span>
                    <span><%= payment?.status || '미결제' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="admin-muted">TID</span>
                    <span class="text-break"><%= payment?.tid || '-' %></span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="admin-muted">승인시각</span>
                    <span><%= payment?.approved_at ? new Date(payment.approved_at).toLocaleString() : '-' %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="admin-card card mt-3">
    <div class="card-body">
        <h5 class="fw-semibold mb-3">주문 상품</h5>
        <div class="table-responsive">
            <table class="table table-dark align-middle mb-0">
                <thead>
                    <tr>
                        <th>상품</th>
                        <th>규격</th>
                        <th class="text-end">단가</th>
                        <th class="text-end">수량</th>
                        <th class="text-end">금액</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!items || items.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">주문 상품이 없습니다.</td>
                        </tr>
                        <% } else { %>
                            <% items.forEach(it => { %>
                                <tr>
                                    <td class="fw-semibold"><%= it.product_name %></td>
                                    <td class="admin-muted small"><%= it.product_spec || '-' %></td>
                                    <td class="text-end"><%= Number(it.unit_price || 0).toLocaleString() %>원</td>
                                    <td class="text-end"><%= it.quantity %></td>
                                    <td class="text-end"><%= Number(it.total_price || 0).toLocaleString() %>원</td>
                                </tr>
                                <% }) %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/admin-footer') %>
