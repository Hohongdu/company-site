<%- include('../layouts/admin-top', { title: '주문 상세' , active: 'orders', backUrl: '/admin/orders' }) %>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">주문 정보</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">주문번호</span>
                    <span class="fw-semibold"><%= order.order_number %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">상태</span>
                    <span class="badge bg-<%= order.status === 'PAID' ? 'success' : order.status === 'PENDING' ? 'warning' : 'secondary' %>">
                        <%= order.status %>
                    </span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">주문자</span>
                    <span><%= order.user_name || order.guest_name || '비회원' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">연락처</span>
                    <span><%= order.user_email || order.guest_email || order.guest_phone || '-' %></span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">총 금액</span>
                    <span class="fw-semibold"><%= Number(order.total_amount || 0).toLocaleString() %>원</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">결제 정보</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">결제수단</span>
                    <span><%= payment?.provider || '-' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">결제상태</span>
                    <span><%= payment?.status || '미결제' %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">TID</span>
                    <span class="text-break"><%= payment?.tid || '-' %></span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">승인시각</span>
                    <span><%= payment?.approved_at ? new Date(payment.approved_at).toLocaleString() : '-' %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="fw-semibold mb-3">주문 상품</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>상품</th>
                        <th>규격</th>
                        <th class="text-end">단가</th>
                        <th class="text-end">수량</th>
                        <th class="text-end">금액</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!items || items.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">주문 상품이 없습니다.</td>
                        </tr>
                        <% } else { %>
                            <% items.forEach(it => { %>
                                <tr>
                                    <td class="fw-semibold"><%= it.product_name %></td>
                                    <td class="text-muted small"><%= it.product_spec || '-' %></td>
                                    <td class="text-end"><%= Number(it.unit_price || 0).toLocaleString() %>원</td>
                                    <td class="text-end"><%= it.quantity %></td>
                                    <td class="text-end"><%= Number(it.total_price || 0).toLocaleString() %>원</td>
                                </tr>
                                <% }) %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layouts/admin-bottom') %>
