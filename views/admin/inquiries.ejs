<%- include('partials/admin-header', { title: '문의 관리' , subtitle: '고객 문의 내역을 확인합니다.' , active: 'inquiries' }) %>

<div class="admin-card card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>제목</th>
                        <th>문의자</th>
                        <th>주문번호</th>
                        <th>등록일</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!inquiries || inquiries.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">문의 내역이 없습니다.</td>
                        </tr>
                        <% } else { %>
                            <% inquiries.forEach(inquiry => { %>
                                <tr>
                                    <td>
                                        <span class="badge bg-<%= inquiry.status === 'NEW' ? 'warning' : inquiry.status === 'ANSWERED' ? 'success' : 'secondary' %>">
                                            <%= inquiry.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold"><%= inquiry.title %></div>
                                        <div class="admin-inquiry-preview small"><%= inquiry.content %></div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold"><%= inquiry.user_name || inquiry.guest_name || '비회원' %></div>
                                        <div class="admin-muted small">
                                            <%= inquiry.user_email || inquiry.guest_email || inquiry.guest_phone || '-' %>
                                        </div>
                                    </td>
                                    <td class="admin-muted small"><%= inquiry.order_number || '-' %></td>
                                    <td class="admin-muted small">
                                        <%= inquiry.created_at ? new Date(inquiry.created_at).toLocaleString() : '-' %>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#inquiry-detail-<%= inquiry.id %>">
                                            상세
                                        </button>
                                    </td>
                                </tr>
                                <tr class="collapse" id="inquiry-detail-<%= inquiry.id %>">
                                    <td colspan="6" class="bg-light">
                                        <div class="p-3">
                                            <div class="d-flex flex-wrap gap-3 mb-2">
                                                <div>
                                                    <div class="admin-muted small">문의 상태</div>
                                                    <div class="fw-semibold"><%= inquiry.status %></div>
                                                </div>
                                                <div>
                                                    <div class="admin-muted small">주문번호</div>
                                                    <div class="fw-semibold"><%= inquiry.order_number || '-' %></div>
                                                </div>
                                                <div>
                                                    <div class="admin-muted small">연락처</div>
                                                    <div class="fw-semibold">
                                                        <%= inquiry.user_email || inquiry.guest_email || inquiry.guest_phone || '-' %>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="admin-muted small">등록일</div>
                                                    <div class="fw-semibold">
                                                        <%= inquiry.created_at ? new Date(inquiry.created_at).toLocaleString() : '-' %>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="admin-muted small mb-1">문의 내용</div>
                                                <div class="admin-inquiry-content"><%= inquiry.content %></div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="admin-muted small mb-1">답변 상태</div>
                                                <div class="fw-semibold">
                                                    <%= inquiry.answer_content ? '답변 완료' : '답변 대기' %>
                                                </div>
                                                <% if (inquiry.answered_at) { %>
                                                    <div class="admin-muted small">
                                                        답변일: <%= new Date(inquiry.answered_at).toLocaleString() %>
                                                    </div>
                                                <% } %>
                                                <div class="admin-muted small">
                                                    알림: <%= inquiry.notification_channel || 'NONE' %>
                                                    <%= inquiry.notification_status ? `(${inquiry.notification_status})` : '' %>
                                                </div>
                                                <% if (inquiry.notification_error) { %>
                                                    <div class="text-danger small">알림 오류: <%= inquiry.notification_error %></div>
                                                <% } %>
                                            </div>
                                            <% if (inquiry.answer_content) { %>
                                                <div class="mb-3">
                                                    <div class="admin-muted small mb-1">답변 내용</div>
                                                    <div class="admin-inquiry-content"><%= inquiry.answer_content %></div>
                                                </div>
                                            <% } %>
                                            <form class="admin-reply-form" action="/admin/inquiries/<%= inquiry.id %>/reply" method="post" enctype="multipart/form-data">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <div class="mb-2">
                                                    <label class="admin-muted small mb-1">답변 작성</label>
                                                    <textarea class="form-control" name="answerContent" rows="4" required><%= inquiry.answer_content || '' %></textarea>
                                                </div>

                                                <div class="mb-2">
                                                    <label class="admin-muted small mb-1">첨부 파일 (선택)</label>
                                                    <input type="file" class="form-control" name="attachmentFile">
                                                    <div class="text-muted small mt-1">파일 없이도 답변 이메일 전송이 가능합니다.</div>
                                                </div>
                                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="sendEmail" id="sendEmail-<%= inquiry.id %>"
                                                            <%= inquiry.user_email || inquiry.guest_email ? '' : 'disabled' %>>
                                                        <label class="form-check-label" for="sendEmail-<%= inquiry.id %>">
                                                            이메일로 답변 발송
                                                        </label>
                                                    </div>
                                                    <% if (!(inquiry.user_email || inquiry.guest_email)) { %>
                                                        <span class="text-muted small">이메일 정보가 없어 알림 발송 불가</span>
                                                    <% } %>
                                                    <button type="submit" class="btn btn-admin btn-sm ms-auto">답변 저장</button>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/admin-footer') %>
