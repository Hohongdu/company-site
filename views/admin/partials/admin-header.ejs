<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= typeof title !=='undefined' ? title : 'Admin' %> | Admin
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --admin-bg: #0b1220;
            --admin-panel: #0f1a2e;
            --admin-border: rgba(255, 255, 255, .08);
            --admin-text: rgba(255, 255, 255, .92);
            --admin-muted: rgba(255, 255, 255, .6);
            --admin-accent: #7c5cff;
        }

        body.admin-wrap {
            background: radial-gradient(1200px 800px at 20% 0%, #172a52 0%, var(--admin-bg) 60%);
            color: var(--admin-text);
            min-height: 100vh;
        }

        .admin-topbar {
            position: sticky;
            top: 0;
            z-index: 1020;
            background: rgba(15, 26, 46, .85);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--admin-border);
        }

        .brand-pill {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-weight: 700;
            letter-spacing: .3px;
        }

        .brand-pill .dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--admin-accent);
            box-shadow: 0 0 0 6px rgba(124, 92, 255, .18);
        }

        .admin-shell {
            display: flex;
            gap: 18px;
            padding: 18px 0;
        }

        .admin-sidebar {
            width: 250px;
            background: rgba(15, 26, 46, .9);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            overflow: hidden;
        }

        .admin-sidebar .side-head {
            padding: 14px 14px 10px;
            border-bottom: 1px solid var(--admin-border);
        }

        .admin-sidebar .nav-link {
            color: rgba(255, 255, 255, .74);
            border-radius: 10px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-sidebar .nav-link:hover {
            background: rgba(255, 255, 255, .06);
            color: rgba(255, 255, 255, .92);
        }

        .admin-sidebar .nav-link.active {
            background: rgba(124, 92, 255, .18);
            color: rgba(255, 255, 255, .95);
            border: 1px solid rgba(124, 92, 255, .35);
        }

        .admin-main {
            flex: 1;
            min-width: 0;
        }

        .admin-card {
            background: rgba(15, 26, 46, .9);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .25);
        }

        .admin-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--admin-border);
            color: var(--admin-text);
        }

        .admin-muted {
            color: var(--admin-muted);
        }

        .btn-admin {
            background: var(--admin-accent);
            border: none;
        }

        .btn-admin:hover {
            filter: brightness(.95);
        }

        .admin-badge {
            font-size: .75rem;
            padding: .35rem .6rem;
            border: 1px solid var(--admin-border);
            border-radius: 999px;
            color: var(--admin-muted);
        }

        @media (max-width: 992px) {
            .admin-shell {
                flex-direction: column;
            }

            .admin-sidebar {
                width: 100%;
            }
        }
    </style>
</head>

<body class="admin-wrap">
    <!-- TOP BAR -->
    <header class="admin-topbar">
        <div class="container py-3 d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-pill">
                    <span class="dot"></span>
                    <span>ADMIN CONSOLE</span>
                    <span class="admin-badge">v1</span>
                </div>
                <span class="admin-muted d-none d-md-inline">운영/관리 전용</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-building"></i> 회사로
                </a>
                <a href="/shop" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-bag"></i> 상품몰로
                </a>

                <div class="vr vr-light mx-2"></div>

                <% if (user) { %>
                    <span class="small admin-muted d-none d-md-inline">
                        <i class="bi bi-person-circle"></i>
                        <strong class="text-white">
                            <%= user.name %>
                        </strong>
                    </span>
                    <a href="/auth/logout" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-box-arrow-right"></i> 로그아웃
                    </a>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> 로그인
                        </a>
                        <% } %>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="admin-shell">
            <!-- SIDEBAR -->
            <aside class="admin-sidebar">
                <div class="side-head">
                    <div class="fw-semibold">관리 메뉴</div>
                    <div class="admin-muted small">빠르게 이동</div>
                </div>

                <nav class="p-2">
                    <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/admin">
                        <i class="bi bi-speedometer2"></i> 대시보드
                    </a>

                    <a class="nav-link <%= active === 'products' ? 'active' : '' %>" href="/admin/products">
                        <i class="bi bi-box-seam"></i> 상품 관리
                    </a>

                    <a class="nav-link <%= active === 'product_new' ? 'active' : '' %>" href="/admin/products/new">
                        <i class="bi bi-plus-circle"></i> 상품 등록
                    </a>

                    <a class="nav-link <%= active === 'import' ? 'active' : '' %>" href="/admin/products/import">
                        <i class="bi bi-file-earmark-spreadsheet"></i> 엑셀 업로드
                    </a>

                    <a class="nav-link <%= active === 'categories' ? 'active' : '' %>" href="/admin/categories">
                        <i class="bi bi-tags"></i> 카테고리
                    </a>
                </nav>
            </aside>

            <!-- MAIN -->
            <main class="admin-main">
                <div class="mb-3">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <h4 class="mb-1">
                                <%= typeof title !=='undefined' ? title : 'Admin' %>
                            </h4>
                            <% if (typeof subtitle !=='undefined' && subtitle) { %>
                                <div class="admin-muted">
                                    <%= subtitle %>
                                </div>
                                <% } %>
                        </div>

                        <% if (typeof backHref !=='undefined' && backHref) { %>
                            <a href="<%= backHref %>" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-arrow-left"></i> 이전으로
                            </a>
                            <% } %>
                    </div>
                </div>