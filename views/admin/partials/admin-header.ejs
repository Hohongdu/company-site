<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title : 'Admin' %> | 관리자</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">

<!-- ===== TOP BAR ===== -->
<header class="adm-topbar">
    <div class="adm-topbar__inner">
        <!-- 좌: 브랜드 + 햄버거 -->
        <div class="d-flex align-items-center gap-3">
            <button class="adm-hamburger d-lg-none" id="adminSidebarOpen" aria-label="메뉴 열기" type="button">
                <span></span><span></span><span></span>
            </button>
            <a class="adm-brand" href="/admin/dashboard">
                <span class="adm-brand-logo">ENERMADE</span>
                <span class="adm-brand-tag">ADMIN</span>
            </a>
        </div>

        <!-- 우: 빠른 링크 + 사용자 -->
        <div class="d-flex align-items-center gap-2">
            <a href="/" target="_blank" class="adm-toplink d-none d-md-inline-flex">
                <i class="bi bi-house me-1"></i>회사
            </a>
            <a href="/shop" target="_blank" class="adm-toplink d-none d-md-inline-flex">
                <i class="bi bi-shop me-1"></i>쇼핑몰
            </a>
            <div class="vr d-none d-md-block mx-1" style="height:20px;"></div>
            <% if (typeof user !== 'undefined' && user) { %>
                <span class="adm-username d-none d-sm-inline"><%= user.name %></span>
                <a href="/auth/logout" class="adm-toplink adm-toplink--danger">
                    <i class="bi bi-box-arrow-right me-1"></i>로그아웃
                </a>
            <% } else { %>
                <a href="/auth/login" class="adm-toplink">로그인</a>
            <% } %>
        </div>
    </div>
</header>

<!-- ===== LAYOUT SHELL ===== -->
<div class="adm-shell">

    <!-- SIDEBAR BACKDROP (mobile) -->
    <div class="adm-backdrop" id="adminSidebarBackdrop"></div>

    <!-- ===== SIDEBAR ===== -->
    <aside class="adm-sidebar" id="adminSidebar">
        <div class="adm-sidebar__header">
            <div class="adm-sidebar__brand">
                <span class="adm-brand-logo" style="font-size:16px;">ENERMADE</span>
                <span class="adm-brand-tag">관리자</span>
            </div>
            <button class="adm-sidebar-close d-lg-none" id="adminSidebarClose" aria-label="메뉴 닫기" type="button">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <% if (typeof user !== 'undefined' && user) { %>
        <div class="adm-sidebar__user">
            <div class="adm-sidebar__avatar"><%= user.name.charAt(0) %></div>
            <div>
                <div class="adm-sidebar__uname"><%= user.name %></div>
                <div class="adm-sidebar__urole">관리자</div>
            </div>
        </div>
        <% } %>

        <nav class="adm-nav" aria-label="관리자 메뉴">
            <div class="adm-nav__group">MAIN</div>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'dashboard') ? 'is-active' : '' %>"
               href="/admin/dashboard">
                <i class="bi bi-speedometer2"></i>
                <span>대시보드</span>
            </a>

            <div class="adm-nav__group">CATALOG</div>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'products') ? 'is-active' : '' %>"
               href="/admin/products">
                <i class="bi bi-box-seam"></i>
                <span>상품 관리</span>
            </a>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'product_new') ? 'is-active' : '' %>"
               href="/admin/products/new">
                <i class="bi bi-plus-square"></i>
                <span>새 상품 등록</span>
            </a>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'categories') ? 'is-active' : '' %>"
               href="/admin/categories">
                <i class="bi bi-tags"></i>
                <span>카테고리</span>
            </a>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'import') ? 'is-active' : '' %>"
               href="/admin/products/import">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>엑셀 업로드</span>
            </a>

            <div class="adm-nav__group">CUSTOMER</div>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'orders') ? 'is-active' : '' %>"
               href="/admin/orders">
                <i class="bi bi-receipt"></i>
                <span>주문 관리</span>
            </a>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'inquiries') ? 'is-active' : '' %>"
               href="/admin/inquiries">
                <i class="bi bi-chat-left-text"></i>
                <span>문의 관리</span>
            </a>
            <a class="adm-nav__link <%= (typeof active !== 'undefined' && active === 'notices') ? 'is-active' : '' %>"
               href="/admin/notices">
                <i class="bi bi-megaphone"></i>
                <span>공지 관리</span>
            </a>
        </nav>

        <div class="adm-sidebar__footer">
            <a href="/" target="_blank" class="adm-sidebar__footlink">
                <i class="bi bi-house"></i> 회사 홈
            </a>
            <a href="/shop" target="_blank" class="adm-sidebar__footlink">
                <i class="bi bi-shop"></i> 쇼핑몰
            </a>
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="adm-main">
        <div class="adm-page-header">
            <div>
                <h1 class="adm-page-title"><%= typeof title !== 'undefined' ? title : '' %></h1>
                <% if (typeof subtitle !== 'undefined' && subtitle) { %>
                    <p class="adm-page-subtitle"><%= subtitle %></p>
                <% } %>
            </div>
        </div>
        <div class="adm-content">
