<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title : 'Admin' %> | Admin</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/tokens.css" />
    <!-- main.css: CSS 변수(다크모드 토큰 포함) + 다크 위젯 CSS 제공 -->
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>

<body class="admin-wrap">

    <!-- ══ TOPBAR ══════════════════════════════════════════════ -->
    <header class="admin-topbar">
        <div class="container-fluid px-4 py-3 d-flex align-items-center justify-content-between gap-3">

            <!-- 브랜드 -->
            <a class="brand-pill text-decoration-none" href="/admin/dashboard">
                <span class="dot" style="background:#ea580c;"></span>
                <span style="font-family:'Sora',sans-serif;font-weight:700;font-size:15px;">
                    <span style="color:#0f172a;">ENER</span><span style="color:#ea580c;">MADE</span>
                </span>
                <span style="color:#94a3b8;font-size:11px;font-weight:600;letter-spacing:.04em;">ADMIN</span>
            </a>

            <!-- 우측 액션 -->
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-outline-secondary btn-sm d-none d-md-inline-flex" style="gap:5px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>사이트
                </a>
                <a href="/shop" class="btn btn-outline-secondary btn-sm d-none d-md-inline-flex" style="gap:5px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
                    </svg>상품몰
                </a>

                <div class="vr mx-1 d-none d-md-block"></div>

                <% if (user) { %>
                    <span class="small text-muted d-none d-lg-inline fw-semibold"><%= user.name %></span>
                    <a href="/auth/logout" class="btn btn-outline-warning btn-sm">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" style="display:inline;vertical-align:-2px;margin-right:3px;">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
                        </svg>로그아웃
                    </a>
                <% } else { %>
                    <a href="/auth/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>"
                       class="btn btn-outline-primary btn-sm">로그인</a>
                <% } %>

                <!-- 모바일 햄버거 -->
                <button class="admin-hamburger d-lg-none" id="adminSidebarOpen" aria-label="관리자 메뉴 열기">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <div class="container-fluid px-4">
        <div class="admin-shell">

            <!-- ══ SIDEBAR BACKDROP ══ -->
            <div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>

            <!-- ══ SIDEBAR ══════════════════════════════════════ -->
            <aside class="admin-sidebar" id="adminSidebar">

                <div class="sidebar-brand">
                    <a class="sidebar-home-link" href="/admin/dashboard">
                        <span class="brand-ener">ENER</span><span class="brand-made">MADE</span>
                        <span style="font-weight:400;color:#94a3b8;font-size:11px;margin-left:4px;">Admin</span>
                    </a>
                    <button class="admin-sidebar-close d-lg-none" id="adminSidebarClose" aria-label="관리자 메뉴 닫기">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>

                <nav class="sidebar-nav" aria-label="관리자 메뉴">

                    <!-- MAIN -->
                    <div class="sidebar-group-label">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>
                        </svg>
                        MAIN
                    </div>

                    <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" rx="1"/>
                                <rect x="14" y="3" width="7" height="7" rx="1"/>
                                <rect x="3" y="14" width="7" height="7" rx="1"/>
                                <rect x="14" y="14" width="7" height="7" rx="1"/>
                            </svg>
                            대시보드
                        </span>
                    </a>

                    <!-- CATALOG -->
                    <div class="sidebar-group-label" style="margin-top:8px;">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                        </svg>
                        CATALOG
                    </div>

                    <a class="nav-link <%= active === 'products' ? 'active' : '' %>" href="/admin/products">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                            상품 관리
                        </span>
                    </a>

                    <a class="nav-link <%= active === 'product_new' ? 'active' : '' %>" href="/admin/products/new">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
                            </svg>
                            상품 등록
                        </span>
                    </a>

                    <a class="nav-link <%= active === 'categories' ? 'active' : '' %>" href="/admin/categories">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
                                <line x1="7" y1="7" x2="7.01" y2="7"/>
                            </svg>
                            카테고리
                        </span>
                    </a>

                    <a class="nav-link <%= active === 'import' ? 'active' : '' %>" href="/admin/products/import">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                            </svg>
                            대량 등록
                        </span>
                    </a>

                    <!-- CUSTOMER -->
                    <div class="sidebar-group-label" style="margin-top:8px;">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                        CUSTOMER
                    </div>

                    <a class="nav-link <%= active === 'orders' ? 'active' : '' %>" href="/admin/orders">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
                                <rect x="9" y="3" width="6" height="4" rx="2"/>
                                <line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>
                            </svg>
                            주문 관리
                        </span>
                    </a>

                    <a class="nav-link <%= active === 'inquiries' ? 'active' : '' %>" href="/admin/inquiries">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                            </svg>
                            문의 관리
                        </span>
                    </a>

                    <a class="nav-link <%= active === 'notices' ? 'active' : '' %>" href="/admin/notices">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                <path d="M13.73 21a2 2 0 01-3.46 0"/>
                            </svg>
                            공지 관리
                        </span>
                    </a>

                    <!-- ANALYTICS -->
                    <div class="sidebar-group-label" style="margin-top:8px;">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                            <line x1="6" y1="20" x2="6" y2="14"/>
                        </svg>
                        ANALYTICS
                    </div>

                    <a class="nav-link <%= active === 'search-stats' ? 'active' : '' %>" href="/admin/search-stats">
                        <span class="left">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                            검색 통계
                        </span>
                    </a>

                </nav>
            </aside>

            <!-- ══ MAIN CONTENT ════════════════════════════════ -->
            <main class="admin-main">
                <%# Figma generated page partial — if exists %>
                <%# HIGH-9: figmaPagePartialName 화이트리스트 검증으로 path traversal 방지
                    허용 패턴: 영숫자, 하이픈, 언더스코어만 허용 (. / \ 등 경로 문자 차단) %>
                <% if (typeof figmaPageHasExports !== 'undefined' && figmaPageHasExports &&
                       typeof figmaPagePartialName !== 'undefined' && figmaPagePartialName &&
                       /^[a-zA-Z0-9_-]+$/.test(figmaPagePartialName)) { %>
                    <%- include('../../partials/generated/figma-pages/' + figmaPagePartialName) %>
                <% } %>

                <%# Back link — if backHref provided %>
                <% if (typeof backHref !== 'undefined' && backHref) { %>
                    <div class="mb-3">
                        <a href="<%= backHref %>" class="btn btn-outline-secondary btn-sm"
                           style="gap:5px;display:inline-flex;align-items:center;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <path d="M19 12H5M12 5l-7 7 7 7"/>
                            </svg>이전으로
                        </a>
                    </div>
                <% } %>
