<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= typeof title !=='undefined' ? title : 'Admin' %> | Admin
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css" />
</head>

<body class="admin-wrap">
    <!-- TOP BAR -->
    <header class="admin-topbar">
        <div class="container py-3 d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <a class="brand-pill text-decoration-none" href="/admin/dashboard">
                    <span class="dot"></span>
                    <span>관리자 콘솔</span>
                </a>
                <span class="admin-muted d-none d-md-inline">운영/관리 전용</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-outline-secondary btn-sm">
                    회사로
                </a>
                <a href="/shop" class="btn btn-outline-secondary btn-sm">
                    상품몰로
                </a>

                <div class="vr mx-2"></div>

                <% if (user) { %>
                    <span class="small admin-muted d-none d-md-inline">
                        <strong class="text-dark">
                            <%= user.name %>
                        </strong>
                    </span>
                    <a href="/auth/logout" class="btn btn-outline-warning btn-sm">
                        로그아웃
                    </a>
                    <% } else { %>
                        <a href="/auth/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>"
                            class="btn btn-outline-primary btn-sm">
                            로그인
                        </a>
                        <% } %>
                <button class="admin-hamburger d-lg-none" id="adminSidebarOpen" aria-label="관리 메뉴 열기">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="admin-shell">
            <!-- SIDEBAR -->
            <div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>
            <aside class="admin-sidebar" id="adminSidebar">
                <div class="sidebar-brand">
                    <button class="admin-sidebar-close d-lg-none" id="adminSidebarClose" aria-label="관리 메뉴 닫기">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </button>
                    <a class="sidebar-home-link" href="/admin/dashboard">관리자 콘솔</a>
                </div>

                <nav class="sidebar-nav" aria-label="관리자 메뉴">
                    <div class="sidebar-group-label">MAIN</div>

                    <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
                        <span class="left">대시보드</span>
                    </a>

                    <div class="sidebar-group-label">CATALOG</div>
                    <a class="nav-link <%= active === 'products' ? 'active' : '' %>" href="/admin/products">
                        <span class="left">상품 관리</span>
                    </a>

                    <a class="nav-link <%= active === 'product_new' ? 'active' : '' %>" href="/admin/products/new">
                        <span class="left">상품 등록</span>
                    </a>

                    <a class="nav-link <%= active === 'categories' ? 'active' : '' %>" href="/admin/categories">
                        <span class="left">카테고리</span>
                    </a>

                    <a class="nav-link <%= active === 'import' ? 'active' : '' %>" href="/admin/products/import">
                        <span class="left">엑셀 업로드</span>
                    </a>

                    <div class="sidebar-group-label">CUSTOMER</div>
                    <a class="nav-link <%= active === 'orders' ? 'active' : '' %>" href="/admin/orders">
                        <span class="left">주문 관리</span>
                    </a>

                    <a class="nav-link <%= active === 'inquiries' ? 'active' : '' %>" href="/admin/inquiries">
                        <span class="left">문의 관리</span>
                    </a>

                    <a class="nav-link <%= active === 'notices' ? 'active' : '' %>" href="/admin/notices">
                        <span class="left">공지 관리</span>
                    </a>
                </nav>
            </aside>

            <!-- MAIN -->
            <main class="admin-main">
                <% if (typeof backHref !=='undefined' && backHref) { %>
                    <div class="mb-3 d-flex justify-content-end">
                        <a href="<%= backHref %>" class="btn btn-outline-secondary btn-sm">
                            이전으로
                        </a>
                    </div>
                <% } %>
