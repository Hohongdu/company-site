<%- include('partials/admin-header', { title: '대시보드', subtitle: '운영 현황을 한눈에', active: 'dashboard', user }) %>

<%
const statsSafe = (typeof stats !== 'undefined' && stats) ? stats : {};
const chartSafe = (typeof chartData !== 'undefined' && chartData) ? chartData : {};
const totalProducts   = Number(statsSafe.totalProducts   || 0);
const totalOrders     = Number(statsSafe.totalOrders     || 0);
const totalInquiries  = Number(statsSafe.totalInquiries  || 0);
const pendingInquiries= Number(statsSafe.pendingInquiries|| 0);
const thisMonthRevenue= Number(statsSafe.thisMonthRevenue|| 0);

const chartPayload = {
    labels:    Array.isArray(chartSafe.labels)    ? chartSafe.labels    : [],
    orders:    Array.isArray(chartSafe.orders)    ? chartSafe.orders    : [],
    inquiries: Array.isArray(chartSafe.inquiries) ? chartSafe.inquiries : [],
    revenue:   Array.isArray(chartSafe.revenue)   ? chartSafe.revenue   : []
};
%>

<!-- ===== KPI 카드 ===== -->
<div class="kpi-row mb-4">
    <a class="kpi-card kpi-card--blue" href="/admin/products">
        <div class="kpi-card__icon"><i class="bi bi-box-seam"></i></div>
        <div class="kpi-card__body">
            <div class="kpi-card__value"><%= totalProducts.toLocaleString() %></div>
            <div class="kpi-card__label">총 상품</div>
        </div>
        <i class="bi bi-arrow-right-short kpi-card__arrow"></i>
    </a>
    <a class="kpi-card kpi-card--green" href="/admin/orders">
        <div class="kpi-card__icon"><i class="bi bi-receipt"></i></div>
        <div class="kpi-card__body">
            <div class="kpi-card__value"><%= totalOrders.toLocaleString() %></div>
            <div class="kpi-card__label">총 주문</div>
        </div>
        <i class="bi bi-arrow-right-short kpi-card__arrow"></i>
    </a>
    <a class="kpi-card kpi-card--orange" href="/admin/inquiries">
        <div class="kpi-card__icon"><i class="bi bi-chat-left-text"></i></div>
        <div class="kpi-card__body">
            <div class="kpi-card__value">
                <%= pendingInquiries.toLocaleString() %>
                <% if (pendingInquiries > 0) { %><span class="kpi-badge">미처리</span><% } %>
            </div>
            <div class="kpi-card__label">미처리 문의</div>
        </div>
        <i class="bi bi-arrow-right-short kpi-card__arrow"></i>
    </a>
    <div class="kpi-card kpi-card--purple">
        <div class="kpi-card__icon"><i class="bi bi-currency-won"></i></div>
        <div class="kpi-card__body">
            <div class="kpi-card__value"><%= thisMonthRevenue.toLocaleString() %>원</div>
            <div class="kpi-card__label">이달 매출</div>
        </div>
    </div>
</div>

<!-- ===== 차트 + 빠른 액션 ===== -->
<div class="dash-grid mb-4">
    <!-- 주문 추이 차트 -->
    <div class="dash-card">
        <div class="dash-card__head">
            <h6 class="dash-card__title"><i class="bi bi-graph-up me-2 text-primary"></i>최근 6개월 주문 추이</h6>
        </div>
        <canvas id="ordersTrendChart" class="dash-chart" style="height:140px;" role="img" aria-label="주문량 추이 차트"></canvas>
    </div>

    <!-- 매출 막대 차트 -->
    <div class="dash-card">
        <div class="dash-card__head">
            <h6 class="dash-card__title"><i class="bi bi-bar-chart me-2 text-success"></i>월별 매출 (원)</h6>
        </div>
        <canvas id="revenueBarsChart" class="dash-chart" style="height:140px;" role="img" aria-label="월별 매출 차트"></canvas>
    </div>

    <!-- 빠른 액션 -->
    <div class="dash-card">
        <div class="dash-card__head">
            <h6 class="dash-card__title"><i class="bi bi-lightning me-2 text-warning"></i>빠른 작업</h6>
        </div>
        <div class="d-flex flex-column gap-2 mt-1">
            <a href="/admin/products/new" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>새 상품 등록
            </a>
            <a href="/admin/products/import" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>엑셀 업로드
            </a>
            <a href="/admin/orders" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-receipt me-1"></i>주문 목록
            </a>
            <a href="/admin/inquiries" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-chat-left-text me-1"></i>문의 목록
            </a>
            <a href="/admin/notices" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-megaphone me-1"></i>공지 관리
            </a>
        </div>
    </div>
</div>

<!-- ===== 최근 데이터 테이블 ===== -->
<div class="dash-tables mb-4">
    <!-- 최근 주문 -->
    <div class="dash-card">
        <div class="dash-card__head">
            <h6 class="dash-card__title"><i class="bi bi-receipt me-2 text-success"></i>최근 주문</h6>
            <a class="btn btn-sm btn-outline-primary" href="/admin/orders">전체 보기</a>
        </div>
        <div class="table-responsive mt-2">
            <table class="table table-sm align-middle mb-0 adm-table">
                <thead>
                    <tr>
                        <th>주문번호</th>
                        <th>주문자</th>
                        <th>상태</th>
                        <th class="text-end">금액</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!recentOrders || recentOrders.length === 0) { %>
                        <tr><td colspan="4" class="text-center text-muted py-4">주문이 없습니다.</td></tr>
                    <% } else { %>
                        <% recentOrders.forEach(order => { %>
                        <tr>
                            <td>
                                <a class="text-decoration-none fw-semibold small" href="/admin/orders/<%= order.order_number %>">
                                    <%= order.order_number.slice(-8) %>...
                                </a>
                            </td>
                            <td class="text-muted small"><%= order.user_name || order.guest_name || '비회원' %></td>
                            <td>
                                <span class="adm-status-badge adm-status-badge--<%= (order.status || 'PENDING').toLowerCase() %>">
                                    <%= order.status || 'PENDING' %>
                                </span>
                            </td>
                            <td class="text-end fw-semibold small"><%= Number(order.total_amount || 0).toLocaleString() %>원</td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 최근 문의 -->
    <div class="dash-card">
        <div class="dash-card__head">
            <h6 class="dash-card__title"><i class="bi bi-chat-left-text me-2 text-warning"></i>최근 문의</h6>
            <a class="btn btn-sm btn-outline-primary" href="/admin/inquiries">전체 보기</a>
        </div>
        <div class="table-responsive mt-2">
            <table class="table table-sm align-middle mb-0 adm-table">
                <thead>
                    <tr>
                        <th>제목</th>
                        <th>문의자</th>
                        <th>상태</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!recentInquiries || recentInquiries.length === 0) { %>
                        <tr><td colspan="3" class="text-center text-muted py-4">문의가 없습니다.</td></tr>
                    <% } else { %>
                        <% recentInquiries.forEach(inq => { %>
                        <tr>
                            <td class="text-truncate" style="max-width:200px;">
                                <a class="text-decoration-none fw-semibold" href="/admin/inquiries">
                                    <%= inq.title %>
                                </a>
                            </td>
                            <td class="text-muted small"><%= inq.user_name || inq.guest_name || '비회원' %></td>
                            <td>
                                <% const statusMap = { NEW: 'warning', ANSWERED: 'success', CLOSED: 'secondary' }; %>
                                <span class="badge text-bg-<%= statusMap[inq.status] || 'secondary' %>">
                                    <%= inq.status === 'NEW' ? '미답변' : inq.status === 'ANSWERED' ? '답변완료' : inq.status %>
                                </span>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== 재고 부족 경고 ===== -->
<% if (typeof lowStockProducts !== 'undefined' && lowStockProducts && lowStockProducts.length > 0) { %>
<div class="dash-card dash-card--danger mb-4">
    <div class="dash-card__head">
        <h6 class="dash-card__title text-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>재고 부족 상품
            <span class="badge bg-danger ms-1"><%= lowStockProducts.length %></span>
        </h6>
        <a class="btn btn-sm btn-outline-danger" href="/admin/products">상품 관리</a>
    </div>
    <div class="table-responsive mt-2">
        <table class="table table-sm align-middle mb-0 adm-table">
            <thead>
                <tr>
                    <th>상품명</th>
                    <th>코드</th>
                    <th class="text-end">재고</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% lowStockProducts.forEach(p => { %>
                <tr>
                    <td class="fw-semibold"><%= p.name %></td>
                    <td class="text-muted small"><%= p.code || '-' %></td>
                    <td class="text-end">
                        <span class="badge bg-<%= p.stock_quantity === 0 ? 'danger' : 'warning' %>">
                            <%= p.stock_quantity %>개
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/admin/products/<%= p.id %>/edit">수정</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<!-- ===== 서버 상태 ===== -->
<% if (typeof sys !== 'undefined' && sys) { %>
<div class="dash-card">
    <div class="dash-card__head">
        <h6 class="dash-card__title"><i class="bi bi-hdd-rack me-2"></i>서버 상태</h6>
        <span class="text-muted small">실시간</span>
    </div>
    <div class="sys-stat-row mt-2">
        <div class="sys-stat">
            <span class="sys-stat__label">CPU</span>
            <div class="sys-stat__bar">
                <div class="sys-stat__fill" style="width:<%= sys.cpuRatioPct %>%;background:<%= sys.cpuRatioPct > 80 ? '#ef4444' : sys.cpuRatioPct > 50 ? '#f59e0b' : '#10b981' %>"></div>
            </div>
            <span class="sys-stat__val"><%= sys.cpuRatioPct %>%</span>
        </div>
        <div class="sys-stat">
            <span class="sys-stat__label">메모리</span>
            <div class="sys-stat__bar">
                <div class="sys-stat__fill" style="width:<%= sys.memUsedPct %>%;background:<%= sys.memUsedPct > 80 ? '#ef4444' : sys.memUsedPct > 60 ? '#f59e0b' : '#10b981' %>"></div>
            </div>
            <span class="sys-stat__val"><%= sys.memUsedPct %>%</span>
        </div>
        <div class="sys-stat">
            <span class="sys-stat__label">디스크</span>
            <div class="sys-stat__bar">
                <div class="sys-stat__fill" style="width:<%= sys.diskUsedPct %>%;background:<%= sys.diskUsedPct > 85 ? '#ef4444' : sys.diskUsedPct > 70 ? '#f59e0b' : '#10b981' %>"></div>
            </div>
            <span class="sys-stat__val"><%= sys.diskUsedPct %>%</span>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap mt-2">
        <span class="badge text-bg-<%= sys.cpuStatus.badge %>">CPU <%= sys.cpuStatus.text %></span>
        <span class="badge text-bg-<%= sys.memStatus.badge %>">메모리 <%= sys.memStatus.text %></span>
        <span class="badge text-bg-<%= sys.diskStatus.badge %>">디스크 <%= sys.diskStatus.text %></span>
        <span class="badge text-bg-<%= sys.nginxStatus.badge %>">Nginx <%= sys.nginxStatus.text %></span>
    </div>
</div>
<% } %>

<script>
(function () {
    const data = <%- JSON.stringify(chartPayload) %>;

    function drawLine(canvas, labels, values, color) {
        if (!canvas || !labels.length) return;
        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        const w = canvas.clientWidth || 400;
        const h = canvas.clientHeight || 140;
        canvas.width  = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.scale(dpr, dpr);

        const max = Math.max(...values, 1);
        const min = Math.min(...values, 0);
        const px = 16, py = 10;
        const dw = w - px * 2, dh = h - py * 2;

        ctx.clearRect(0, 0, w, h);

        // grid lines
        ctx.strokeStyle = 'rgba(0,0,0,0.05)';
        ctx.lineWidth = 1;
        for (let i = 0; i <= 4; i++) {
            const y = py + dh * (i / 4);
            ctx.beginPath(); ctx.moveTo(px, y); ctx.lineTo(w - px, y); ctx.stroke();
        }

        // gradient fill
        const grad = ctx.createLinearGradient(0, py, 0, h);
        grad.addColorStop(0, color.replace(')', ',0.18)').replace('rgb', 'rgba'));
        grad.addColorStop(1, color.replace(')', ',0)').replace('rgb', 'rgba'));

        ctx.beginPath();
        values.forEach((v, i) => {
            const x = px + (dw * i) / Math.max(values.length - 1, 1);
            const y = py + dh - ((v - min) / Math.max(max - min, 1)) * dh;
            if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        const lastX = px + dw, firstX = px;
        const lastY = py + dh - ((values[values.length-1] - min) / Math.max(max - min, 1)) * dh;
        const firstY = py + dh - ((values[0] - min) / Math.max(max - min, 1)) * dh;
        ctx.lineTo(lastX, h - py);
        ctx.lineTo(firstX, h - py);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();

        // line
        ctx.beginPath();
        values.forEach((v, i) => {
            const x = px + (dw * i) / Math.max(values.length - 1, 1);
            const y = py + dh - ((v - min) / Math.max(max - min, 1)) * dh;
            if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        ctx.lineWidth = 2.5;
        ctx.strokeStyle = color;
        ctx.stroke();

        // dots
        values.forEach((v, i) => {
            const x = px + (dw * i) / Math.max(values.length - 1, 1);
            const y = py + dh - ((v - min) / Math.max(max - min, 1)) * dh;
            ctx.beginPath();
            ctx.arc(x, y, 3.5, 0, Math.PI * 2);
            ctx.fillStyle = color;
            ctx.fill();
        });

        // labels
        ctx.fillStyle = '#94a3b8';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        labels.forEach((label, i) => {
            const x = px + (dw * i) / Math.max(labels.length - 1, 1);
            ctx.fillText(label, x, h - 2);
        });
    }

    function drawBars(canvas, labels, values, color) {
        if (!canvas || !labels.length) return;
        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        const w = canvas.clientWidth || 400;
        const h = canvas.clientHeight || 140;
        canvas.width  = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.scale(dpr, dpr);

        const max = Math.max(...values, 1);
        const px = 12, py = 10, labelH = 16;
        const dw = w - px * 2, dh = h - py - labelH;
        const barW = Math.max(8, (dw / values.length) * 0.55);

        ctx.clearRect(0, 0, w, h);

        values.forEach((v, i) => {
            const x = px + i * (dw / values.length) + (dw / values.length - barW) / 2;
            const barH = (v / max) * dh;
            const y = py + dh - barH;

            const grad = ctx.createLinearGradient(x, y, x, py + dh);
            grad.addColorStop(0, color);
            grad.addColorStop(1, color.replace(')', ',0.5)').replace('rgb', 'rgba'));

            ctx.beginPath();
            ctx.roundRect ? ctx.roundRect(x, y, barW, barH, 4) : ctx.rect(x, y, barW, barH);
            ctx.fillStyle = grad;
            ctx.fill();

            ctx.fillStyle = '#94a3b8';
            ctx.font = '11px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(labels[i], x + barW / 2, h - 2);
        });
    }

    function redraw() {
        drawLine(document.getElementById('ordersTrendChart'), data.labels, data.orders, 'rgb(37,99,235)');
        drawBars(document.getElementById('revenueBarsChart'), data.labels, data.revenue, 'rgb(16,185,129)');
    }

    redraw();
    window.addEventListener('resize', redraw);
})();
</script>

<%- include('partials/admin-footer') %>
