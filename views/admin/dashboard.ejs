<%- include('../layouts/admin-top', { title: '관리자 대시보드' , active: 'dashboard' }) %>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1">대시보드</h3>
            <div class="text-muted small">관리자 기능 요약</div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" href="/admin/products/new">+ 새 상품</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/products/import">엑셀 업로드</a>
        </div>
    </div>

    <% const statsSafe=(typeof stats !=='undefined' && stats) ? stats : {}; const
        totalProducts=Number(statsSafe.totalProducts || 0); const totalCategories=Number(statsSafe.totalCategories ||
        0); const totalUploads=Number(statsSafe.totalUploads || 0); %>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">상품 관리</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/products">상품 목록</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/products/new">상품 등록</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">카테고리</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/categories">카테고리 관리</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/categories/export">엑셀
                                Export</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">엑셀 업로드</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/products/import">업로드</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/uploads/export">업로드 히스토리
                                Export</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">바로가기</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-dark btn-sm w-100" href="/">회사</a>
                            <a class="btn btn-outline-dark btn-sm w-100" href="/shop">상품몰</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <hr class="my-4">

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-2">빠른 작업</h5>
                        <div class="d-grid gap-2 d-sm-flex">
                            <a class="btn btn-outline-primary" href="/admin/products/new">상품 등록</a>
                            <a class="btn btn-outline-primary" href="/admin/categories">카테고리 관리</a>
                            <a class="btn btn-outline-primary" href="/admin/products/import">엑셀 업로드</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-2">안정성 팁</h5>
                        <ul class="small text-muted mb-0">
                            <li>모바일 깨짐 방지: 버튼/텍스트는 flex-wrap 사용</li>
                            <li>유저명 길이: max-width + ellipsis 처리</li>
                            <li>테이블은 table-responsive로 감싸기</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../layouts/admin-bottom') %>