<%- include('partials/admin-header', { title: '관리자 대시보드' , active: 'dashboard' }) %>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-1">대시보드</h3>
            <div class="text-muted small">관리자 전용 관리 페이지</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/">회사로</a>
            <a class="btn btn-outline-dark btn-sm" href="/shop">상품몰로</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small mb-1">상품 수</div>
                    <div class="fs-4 fw-bold">
                        <%= typeof totalProducts !=='undefined' ? totalProducts : '-' %>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small mb-1">카테고리 수</div>
                    <div class="fs-4 fw-bold">
                        <%= typeof totalCategories !=='undefined' ? totalCategories : '-' %>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small mb-1">최근 업로드</div>
                    <div class="fs-4 fw-bold">
                        <%= typeof lastUploadAt !=='undefined' && lastUploadAt ? lastUploadAt : '-' %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <strong>빠른 이동</strong>
            <span class="text-muted small">자주 쓰는 메뉴</span>
        </div>
        <div class="card-body d-flex flex-wrap gap-2">
            <a class="btn btn-dark btn-sm" href="/admin/products">상품 관리</a>
            <a class="btn btn-outline-dark btn-sm" href="/admin/products/new">상품 등록</a>
            <a class="btn btn-outline-dark btn-sm" href="/admin/products/import">엑셀 업로드</a>
            <a class="btn btn-outline-dark btn-sm" href="/admin/categories">카테고리</a>
        </div>
    </div>

    <%- include('partials/admin-footer') %>