<%- include('../layouts/admin-top', { title: '관리자 대시보드' , active: 'dashboard' }) %>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1">대시보드</h3>
            <div class="text-muted small">관리자 기능 요약</div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" href="/admin/products/new">+ 새 상품</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/products/import">엑셀 업로드</a>
        </div>
    </div>

    <% const statsSafe=(typeof stats !=='undefined' && stats) ? stats : {}; const
        totalProducts=Number(statsSafe.totalProducts || 0); const totalCategories=Number(statsSafe.totalCategories ||
        0); const totalUploads=Number(statsSafe.totalUploads || 0); %>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">상품 관리</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/products">상품 목록</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/products/new">상품 등록</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">카테고리</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/categories">카테고리 관리</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/categories/export">엑셀
                                Export</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">엑셀 업로드</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/products/import">업로드</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/uploads/export">업로드 히스토리
                                Export</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">바로가기</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-dark btn-sm w-100" href="/">회사</a>
                            <a class="btn btn-outline-dark btn-sm w-100" href="/shop">상품몰</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <hr class="my-4">

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-2">빠른 작업</h5>
                        <div class="d-grid gap-2 d-sm-flex">
                            <a class="btn btn-outline-primary" href="/admin/products/new">상품 등록</a>
                            <a class="btn btn-outline-primary" href="/admin/categories">카테고리 관리</a>
                            <a class="btn btn-outline-primary" href="/admin/products/import">엑셀 업로드</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-2">안정성 팁</h5>
                        <ul class="small text-muted mb-0">
                            <li>모바일 깨짐 방지: 버튼/텍스트는 flex-wrap 사용</li>
                            <li>유저명 길이: max-width + ellipsis 처리</li>
                            <li>테이블은 table-responsive로 감싸기</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <% if (typeof sys !=='undefined' && sys) { %>
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-muted small">서버 바쁨 정도</div>
                        <span class="badge text-bg-<%= sys.cpuStatus.badge %>">
                            <%= sys.cpuStatus.text %>
                        </span>
                    </div>
                    <div class="fs-5 fw-bold mt-1">
                        <%= sys.cpuRatioPct %>% (대략)
                    </div>
                    <div class="text-muted small">
                        기준: CPU <%= sys.cpuCores %>코어 대비 · (1분/5분/15분: <%= sys.load1.toFixed(2) %>/<%=
                                    sys.load5.toFixed(2) %>/<%= sys.load15.toFixed(2) %>)
                    </div>
                </div>
            </div>

            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-muted small">메모리 사용량</div>
                        <span class="badge text-bg-<%= sys.memStatus.badge %>">
                            <%= sys.memStatus.text %>
                        </span>
                    </div>
                    <div class="fs-5 fw-bold mt-1">
                        <%= sys.memUsedMB %>MB / <%= sys.memTotalMB %>MB (<%= sys.memUsedPct %>%)
                    </div>
                    <div class="text-muted small">여유: <%= sys.memFreeMB %>MB</div>
                </div>
            </div>


            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-muted small">저장공간 사용량</div>
                        <span class="badge text-bg-<%= sys.diskStatus.badge %>">
                            <%= sys.diskStatus.text %>
                        </span>
                    </div>
                    <div class="fs-5 fw-bold mt-1">
                        <%= sys.diskUsedPct %>% 사용 중
                    </div>
                    <div class="text-muted small">
                        총 <%= sys.diskTotal %> · 사용 <%= sys.diskUsed %> · 남음 <%= sys.diskAvail %>
                    </div>
                </div>
            </div>


            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-muted small">웹 서버 상태</div>
                        <span class="badge text-bg-<%= sys.nginxStatus.badge %>">
                            <%= sys.nginxStatus.text %>
                        </span>
                    </div>
                    <div class="fw-bold mt-1">
                        <%= sys.nginxHead %>
                    </div>
                    <div class="text-muted small">외부 접속(8080) 응답 확인</div>
                </div>
            </div>

            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">트래픽(대략)</div>
                    <div class="fw-semibold">오늘</div>
                    <div class="text-muted small" style="word-break:break-word;">
                        <%= sys.vnstatDaily || '데이터 없음' %>
                    </div>
                    <div class="fw-semibold mt-2">이번 달</div>
                    <div class="text-muted small" style="word-break:break-word;">
                        <%= sys.vnstatMonthly || '데이터 없음' %>
                    </div>
                </div>
            </div>
            </div>
            <% } %>


                <%- include('../layouts/admin-bottom') %>