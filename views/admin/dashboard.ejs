<%- include('partials/admin-header', { title: '관리자 대시보드' , subtitle: '관리자 기능 요약' , active: 'dashboard' }) %>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1">대시보드</h3>
            <div class="text-muted small">관리자 기능 요약</div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" href="/admin/products/new">+ 새 상품</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/products/import">엑셀 업로드</a>
        </div>
    </div>

    <% const statsSafe=(typeof stats !=='undefined' && stats) ? stats : {}; const
        totalProducts=Number(statsSafe.totalProducts || 0); const totalCategories=Number(statsSafe.totalCategories ||
        0); const totalUploads=Number(statsSafe.totalUploads || 0); %>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">총 상품</div>
                        <div class="fs-4 fw-bold"><%= totalProducts.toLocaleString() %></div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">총 카테고리</div>
                        <div class="fs-4 fw-bold"><%= totalCategories.toLocaleString() %></div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">총 주문</div>
                        <div class="fs-4 fw-bold"><%= Number(statsSafe.totalOrders || 0).toLocaleString() %></div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">총 문의</div>
                        <div class="fs-4 fw-bold"><%= Number(statsSafe.totalInquiries || 0).toLocaleString() %></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">상품 관리</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/products">상품 목록</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/products/new">상품 등록</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">카테고리</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/categories">카테고리 관리</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/categories/export">엑셀
                                Export</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">엑셀 업로드</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-sm w-100" href="/admin/products/import">업로드</a>
                            <a class="btn btn-outline-primary btn-sm w-100" href="/admin/uploads/export">업로드 히스토리
                                Export</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">바로가기</div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-dark btn-sm w-100" href="/">회사</a>
                            <a class="btn btn-outline-dark btn-sm w-100" href="/shop">상품몰</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="mb-0">최근 주문</h5>
                            <a class="btn btn-sm btn-outline-primary" href="/admin/orders">전체 보기</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>주문번호</th>
                                        <th>주문자</th>
                                        <th class="text-end">금액</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!recentOrders || recentOrders.length === 0) { %>
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3">주문이 없습니다.</td>
                                        </tr>
                                        <% } else { %>
                                            <% recentOrders.forEach(order => { %>
                                                <tr>
                                                    <td>
                                                        <a href="/admin/orders/<%= order.order_number %>"><%= order.order_number %></a>
                                                    </td>
                                                    <td><%= order.user_name || order.guest_name || '비회원' %></td>
                                                    <td class="text-end"><%= Number(order.total_amount || 0).toLocaleString() %>원</td>
                                                </tr>
                                                <% }) %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="mb-0">최근 문의</h5>
                            <a class="btn btn-sm btn-outline-primary" href="/admin/inquiries">전체 보기</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>제목</th>
                                        <th>문의자</th>
                                        <th>상태</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!recentInquiries || recentInquiries.length === 0) { %>
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3">문의가 없습니다.</td>
                                        </tr>
                                        <% } else { %>
                                            <% recentInquiries.forEach(inquiry => { %>
                                                <tr>
                                                    <td class="text-truncate" style="max-width:180px;"><%= inquiry.title %></td>
                                                    <td><%= inquiry.user_name || inquiry.guest_name || '비회원' %></td>
                                                    <td>
                                                        <span class="badge text-bg-<%= inquiry.status === 'NEW' ? 'warning' : inquiry.status === 'ANSWERED' ? 'success' : 'secondary' %>">
                                                            <%= inquiry.status %>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <hr class="my-4">

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-2">빠른 작업</h5>
                        <div class="d-grid gap-2 d-sm-flex">
                            <a class="btn btn-outline-primary" href="/admin/products/new">상품 등록</a>
                            <a class="btn btn-outline-primary" href="/admin/categories">카테고리 관리</a>
                            <a class="btn btn-outline-primary" href="/admin/products/import">엑셀 업로드</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <% if (typeof sys !=='undefined' && sys) { %>
            <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-muted small">서버 바쁨 정도</div>
                                <span class="badge text-bg-<%= sys.cpuStatus.badge %>">
                                    <%= sys.cpuStatus.text %>
                                </span>
                            </div>
                            <div class="fs-5 fw-bold mt-1">
                                <%= sys.cpuRatioPct %>% (대략)
                            </div>
                            <div class="text-muted small">
                                기준: CPU <%= sys.cpuCores %>코어 대비 · (1분/5분/15분: <%= sys.load1.toFixed(2) %>/<%=
                                        sys.load5.toFixed(2) %>/<%= sys.load15.toFixed(2) %>)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-muted small">메모리 사용량</div>
                                <span class="badge text-bg-<%= sys.memStatus.badge %>">
                                    <%= sys.memStatus.text %>
                                </span>
                            </div>
                            <div class="fs-5 fw-bold mt-1">
                                <%= sys.memUsedMB %>MB / <%= sys.memTotalMB %>MB (<%= sys.memUsedPct %>%)
                            </div>
                            <div class="text-muted small">여유: <%= sys.memFreeMB %>MB</div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-muted small">저장공간 사용량</div>
                                <span class="badge text-bg-<%= sys.diskStatus.badge %>">
                                    <%= sys.diskStatus.text %>
                                </span>
                            </div>
                            <div class="fs-5 fw-bold mt-1">
                                <%= sys.diskUsedPct %>% 사용 중
                            </div>
                            <div class="text-muted small">
                                총 <%= sys.diskTotal %> · 사용 <%= sys.diskUsed %> · 남음 <%= sys.diskAvail %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-muted small">웹 서버 상태</div>
                                <span class="badge text-bg-<%= sys.nginxStatus.badge %>">
                                    <%= sys.nginxStatus.text %>
                                </span>
                            </div>
                            <div class="fw-bold mt-1">
                                <%= sys.nginxHead %>
                            </div>
                            <div class="text-muted small">외부 접속(8080) 응답 확인</div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">트래픽(대략)</div>
                            <div class="fw-semibold">오늘</div>
                            <div class="text-muted small" style="word-break:break-word;">
                                <%= sys.vnstatDaily || '데이터 없음' %>
                            </div>
                            <div class="fw-semibold mt-2">이번 달</div>
                            <div class="text-muted small" style="word-break:break-word;">
                                <%= sys.vnstatMonthly || '데이터 없음' %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>


                <%- include('../layouts/admin-bottom') %>
