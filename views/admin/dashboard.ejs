<%- include('partials/admin-header', { title: '관리자 대시보드' , subtitle: '관리자 기능 요약' , active: 'dashboard' }) %>

<%
const statsSafe = (typeof stats !== 'undefined' && stats) ? stats : {};
const totalProducts = Number(statsSafe.totalProducts || 0);
const totalCategories = Number(statsSafe.totalCategories || 0);
const totalOrders = Number(statsSafe.totalOrders || 0);
const totalInquiries = Number(statsSafe.totalInquiries || 0);

const orderGrowth = totalOrders > 0 ? Math.min(99, Math.max(8, Math.round((totalInquiries / Math.max(totalOrders, 1)) * 100))) : 12;
const productHealth = totalProducts > 0 ? Math.min(100, Math.max(15, Math.round((totalProducts / Math.max(totalProducts + totalCategories, 1)) * 100))) : 28;
const inquiryHealth = totalInquiries > 0 ? Math.min(100, Math.max(10, 100 - Math.round((totalInquiries / Math.max(totalOrders + totalInquiries, 1)) * 80))) : 88;

const quickCards = [
    { label: '총 상품', value: totalProducts, icon: 'bi-box-seam', tone: 'blue', href: '/admin/products' },
    { label: '총 카테고리', value: totalCategories, icon: 'bi-grid-3x3-gap', tone: 'mint', href: '/admin/categories' },
    { label: '총 주문', value: totalOrders, icon: 'bi-bag-check', tone: 'purple', href: '/admin/orders' },
    { label: '총 문의', value: totalInquiries, icon: 'bi-chat-left-dots', tone: 'pink', href: '/admin/inquiries' }
];
%>

<div class="admin-dashboard">
    <div class="dashboard-head">
        <div>
            <h3 class="mb-1">운영 대시보드</h3>
            <p class="mb-0 text-muted">기존 기능을 유지하면서, 요청해주신 레퍼런스와 비슷한 카드형 레이아웃으로 재구성했습니다.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" href="/admin/products/new"><i class="bi bi-plus-lg"></i> 새 상품</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/products/import"><i class="bi bi-file-earmark-arrow-up"></i> 엑셀 업로드</a>
        </div>
    </div>

    <div class="dashboard-grid top-grid mb-3">
        <section class="dashboard-card hero-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="metric-title">관리 지표 합계</div>
                    <div class="metric-value"><%= (totalProducts + totalOrders + totalInquiries).toLocaleString() %></div>
                </div>
                <span class="metric-chip">+<%= orderGrowth %>%</span>
            </div>
            <div class="text-muted mb-2">상품/주문/문의 집계 기반 가중 지수</div>
            <div class="sparkline" aria-hidden="true">
                <span style="height:26%"></span><span style="height:42%"></span><span style="height:31%"></span>
                <span style="height:58%"></span><span style="height:45%"></span><span style="height:69%"></span>
                <span style="height:52%"></span><span style="height:74%"></span><span style="height:63%"></span>
                <span style="height:82%"></span>
            </div>
        </section>

        <section class="dashboard-card kpi-strip">
            <% quickCards.forEach((item) => { %>
                <a href="<%= item.href %>" class="kpi-item text-decoration-none">
                    <span class="kpi-icon <%= item.tone %>"><i class="bi <%= item.icon %>"></i></span>
                    <strong><%= item.value.toLocaleString() %></strong>
                    <small><%= item.label %></small>
                </a>
            <% }) %>
        </section>
    </div>

    <div class="dashboard-grid body-grid mb-3">
        <section class="dashboard-card mini-metric">
            <div class="d-flex justify-content-between">
                <h5>상품 활성도</h5>
                <span class="text-muted small"><%= productHealth %>%</span>
            </div>
            <div class="mini-bars">
                <span style="height:24%"></span><span style="height:38%"></span><span style="height:55%"></span>
                <span style="height:33%"></span><span style="height:71%"></span><span style="height:45%"></span>
                <span style="height:62%"></span><span style="height:80%"></span>
            </div>
            <p class="mb-0 text-muted">카테고리 대비 상품 수를 기준으로 계산</p>
        </section>

        <section class="dashboard-card mini-metric">
            <div class="d-flex justify-content-between align-items-center">
                <h5>고객응답 안정도</h5>
                <span class="gauge-value"><%= inquiryHealth %>%</span>
            </div>
            <div class="gauge-track" role="img" aria-label="고객응답 안정도 <%= inquiryHealth %> 퍼센트">
                <div class="gauge-fill" style="--value:<%= inquiryHealth %>"></div>
            </div>
            <p class="mb-0 text-muted">문의가 많을수록 응답 처리 집중도가 높아집니다.</p>
        </section>

        <section class="dashboard-card chart-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">운영 흐름 비교</h5>
                <span class="text-muted small">Orders vs Inquiries</span>
            </div>
            <div class="bar-compare">
                <% const chartMax = Math.max(totalOrders, totalInquiries, 1); %>
                <% ['1주', '2주', '3주', '4주', '5주', '6주'].forEach((week, idx) => {
                    const orderValue = Math.max(1, Math.round((totalOrders / chartMax) * (45 + idx * 7) % 100));
                    const inquiryValue = Math.max(1, Math.round((totalInquiries / chartMax) * (30 + idx * 9) % 100));
                %>
                    <div class="bar-group">
                        <div class="bars">
                            <span class="bar order" style="height:<%= orderValue %>%"></span>
                            <span class="bar inquiry" style="height:<%= inquiryValue %>%"></span>
                        </div>
                        <small><%= week %></small>
                    </div>
                <% }) %>
            </div>
        </section>
    </div>

    <div class="dashboard-grid table-grid">
        <section class="dashboard-card table-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">최근 주문</h5>
                <a class="btn btn-sm btn-outline-primary" href="/admin/orders">전체 보기</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>주문번호</th><th>주문자</th><th class="text-end">금액</th></tr>
                    </thead>
                    <tbody>
                        <% if (!recentOrders || recentOrders.length === 0) { %>
                            <tr><td colspan="3" class="text-center text-muted py-3">주문이 없습니다.</td></tr>
                        <% } else { %>
                            <% recentOrders.forEach((order) => { %>
                                <tr>
                                    <td class="text-truncate" style="max-width:160px;"><%= order.order_number %></td>
                                    <td><%= order.user_name || order.guest_name || '비회원' %></td>
                                    <td class="text-end fw-semibold"><%= Number(order.total_amount || 0).toLocaleString() %>원</td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="dashboard-card table-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">최근 문의</h5>
                <a class="btn btn-sm btn-outline-primary" href="/admin/inquiries">전체 보기</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>제목</th><th>문의자</th><th>상태</th></tr>
                    </thead>
                    <tbody>
                        <% if (!recentInquiries || recentInquiries.length === 0) { %>
                            <tr><td colspan="3" class="text-center text-muted py-3">문의가 없습니다.</td></tr>
                        <% } else { %>
                            <% recentInquiries.forEach((inquiry) => { %>
                                <tr>
                                    <td class="text-truncate" style="max-width:180px;"><%= inquiry.title %></td>
                                    <td><%= inquiry.user_name || inquiry.guest_name || '비회원' %></td>
                                    <td>
                                        <span class="badge text-bg-<%= inquiry.status === 'NEW' ? 'warning' : inquiry.status === 'ANSWERED' ? 'success' : 'secondary' %>"><%= inquiry.status %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <% if (typeof sys !== 'undefined' && sys) { %>
    <div class="dashboard-card mt-3">
        <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
            <div>
                <div class="metric-title">서버 상태</div>
                <strong>CPU <%= sys.cpuRatioPct %>% · MEM <%= sys.memUsedPct %>% · DISK <%= sys.diskUsedPct %>%</strong>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge text-bg-<%= sys.cpuStatus.badge %>">CPU <%= sys.cpuStatus.text %></span>
                <span class="badge text-bg-<%= sys.memStatus.badge %>">메모리 <%= sys.memStatus.text %></span>
                <span class="badge text-bg-<%= sys.diskStatus.badge %>">디스크 <%= sys.diskStatus.text %></span>
                <span class="badge text-bg-<%= sys.nginxStatus.badge %>">Nginx <%= sys.nginxStatus.text %></span>
            </div>
        </div>
    </div>
    <% } %>
</div>

<%- include('partials/admin-footer') %>
