<%- include('../layouts/admin-top', { title: '주문 관리' , active: 'orders' }) %>

<div class="card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>주문번호</th>
                        <th>주문자</th>
                        <th>상태</th>
                        <th>결제</th>
                        <th class="text-end">금액</th>
                        <th>주문일</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!orders || orders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">주문 내역이 없습니다.</td>
                        </tr>
                        <% } else { %>
                            <% orders.forEach(order=> { %>
                                <tr>
                                    <td class="fw-semibold"><%= order.order_number %></td>
                                    <td>
                                        <div class="fw-semibold">
                                            <%= order.user_name || order.guest_name || '비회원' %>
                                        </div>
                                        <div class="text-muted small">
                                            <%= order.user_email || order.guest_email || order.guest_phone || '-' %>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= order.status === 'PAID' ? 'success' : order.status === 'PENDING' ? 'warning' : 'secondary' %>">
                                            <%= order.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small"><%= order.payment_provider || '-' %></div>
                                        <div class="text-muted small"><%= order.payment_status || '미결제' %></div>
                                    </td>
                                    <td class="text-end fw-semibold">
                                        <%= Number(order.total_amount || 0).toLocaleString() %>원
                                    </td>
                                    <td class="text-muted small">
                                        <%= order.created_at ? new Date(order.created_at).toLocaleString() : '-' %>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary"
                                            href="/admin/orders/<%= order.order_number %>">상세</a>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layouts/admin-bottom') %>
