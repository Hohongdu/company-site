<%- include('partials/admin-header', { title: '주문 관리', subtitle: '최근 주문과 결제 상태를 확인합니다.', active: 'orders' }) %>

<div class="admin-card card mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 admin-orders-table">
                <thead>
                    <tr>
                        <th style="width:54px;">#</th>
                        <th>주문자</th>
                        <th>상태</th>
                        <th class="d-none d-md-table-cell">결제</th>
                        <th class="text-end">금액</th>
                        <th class="d-none d-sm-table-cell">주문일</th>
                        <th style="width:80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!orders || orders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">주문 내역이 없습니다.</td>
                        </tr>
                    <% } else { %>
                        <% orders.forEach((order, idx) => { %>
                            <tr>
                                <td class="text-muted small fw-semibold"><%= orders.length - idx %></td>
                                <td>
                                    <div class="fw-semibold" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        <%= order.user_name || order.guest_name || '비회원' %>
                                    </div>
                                    <div class="text-muted small" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        <%= order.user_email || order.guest_email || order.guest_phone || '-' %>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-<%= order.status === 'PAID' ? 'success' : order.status === 'PENDING' ? 'warning text-dark' : 'secondary' %> px-2 py-1">
                                        <%= order.status === 'PAID' ? '결제완료' : order.status === 'PENDING' ? '대기중' : order.status === 'CANCELED' ? '취소' : order.status %>
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <div class="small"><%= order.payment_provider || '-' %></div>
                                    <div class="text-muted small"><%= order.payment_status || '미결제' %></div>
                                </td>
                                <td class="text-end fw-semibold" style="white-space:nowrap;">
                                    <%= Number(order.total_amount || 0).toLocaleString() %>원
                                </td>
                                <td class="text-muted small d-none d-sm-table-cell" style="white-space:nowrap;">
                                    <%= order.created_at ? new Date(order.created_at).toLocaleDateString('ko-KR') : '-' %>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                        href="/admin/orders/<%= order.order_number %>">상세</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/admin-footer') %>
