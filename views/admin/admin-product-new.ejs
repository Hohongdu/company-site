<%- include('partials/admin-header', { title: '상품 등록' , subtitle: '새 상품을 추가합니다. (spec 사용 가능)' , active: 'product_new' ,
    backHref: '/admin/products' }) %>

    <div class="admin-card card">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <div class="fw-semibold"><i class="bi bi-plus-circle"></i> 새 상품 등록</div>
            <a href="/admin/products" class="btn btn-outline-light btn-sm">
                <i class="bi bi-list"></i> 상품 목록
            </a>
        </div>

        <div class="card-body">
            <form action="/admin/products/new" method="post" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label admin-muted">상품 코드(code)</label>
                    <input type="text" name="code" class="form-control" placeholder="예) MAT-001">
                </div>
                <div class="col-md-3">
                    <button type="button" id="checkCodeBtn" class="btn btn-outline-dark w-100">
                        중복 체크
                    </button>
                </div>
                <div class="col-md-3">
                    <button type="button" id="checkCodeBtn" class="btn btn-outline-dark w-100">
                        중복 체크
                    </button>
                </div>

                <div class="col-md-8">
                    <label class="form-label admin-muted">상품명(name) <span class="text-warning">*</span></label>
                    <input type="text" name="name" class="form-control" required placeholder="예) 특수소재 A">
                </div>

                <div class="col-md-4">
                    <label class="form-label admin-muted">가격(price) <span class="text-warning">*</span></label>
                    <input type="number" name="price" class="form-control" required min="1" step="1"
                        placeholder="예) 12000">
                </div>

                <div class="col-md-8">
                    <label class="form-label admin-muted">카테고리(category)</label>
                    <select name="category_id" class="form-select">
                        <option value="">카테고리 없음</option>
                        <% (categories || []).forEach(function(c){ %>
                            <option value="<%= c.id %>">
                                <%= c.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label admin-muted">규격/스펙(spec)</label>
                    <input type="text" name="spec" class="form-control" placeholder="예) 1000x2000 / t=3.0mm">
                </div>

                <div class="col-12">
                    <label class="form-label admin-muted">이미지 URL(image)</label>
                    <input type="text" name="image" class="form-control"
                        placeholder="예) /images/sample.png 또는 https://...">
                </div>

                <div class="col-12">
                    <label class="form-label admin-muted">설명(description)</label>
                    <textarea name="description" rows="4" class="form-control" placeholder="상품 설명을 입력하세요"></textarea>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-admin">
                        <i class="bi bi-check2-circle"></i> 등록하기
                    </button>
                    <a href="/admin/products" class="btn btn-outline-light">
                        취소
                    </a>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/admin-footer') %>