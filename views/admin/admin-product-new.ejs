<%- include('partials/admin-header', { title: '상품 등록' , subtitle: '새 상품을 추가합니다. (spec 사용 가능)' , active: 'product_new' ,
    backHref: '/admin/products' }) %>

    <div class="admin-card card">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <div class="fw-semibold"><i class="bi bi-plus-circle"></i> 새 상품 등록</div>
            <a href="/admin/products" class="btn btn-outline-light btn-sm">
                <i class="bi bi-list"></i> 상품 목록
            </a>
        </div>

        <div class="card-body">
            <form action="/admin/products/new" method="post" class="row g-3">
                <!-- code 입력 줄 예시 -->
                <div class="admin-field">
                    <label class="admin-label">상품 코드(code) *</label>

                    <div class="code-row">
                        <input type="text" name="code" id="codeInput" class="admin-input" placeholder="예: MAT-001"
                            required />

                        <button type="button" id="checkCodeBtn" class="admin-btn admin-btn-outline">
                            중복 체크
                        </button>

                        <span id="codeCheckMsg" class="code-msg"></span>
                    </div>

                    <div class="admin-help">코드는 중복되면 저장이 안 됩니다.</div>
                    <input type="hidden" id="codeChecked" value="0">
                </div>



                <div class="col-md-8">
                    <label class="form-label admin-muted">상품명(name) <span class="text-warning">*</span></label>
                    <input type="text" name="name" class="form-control" required placeholder="예) 특수소재 A">
                </div>

                <div class="col-md-4">
                    <label class="form-label admin-muted">가격(price) <span class="text-warning">*</span></label>
                    <input type="number" name="price" class="form-control" required min="1" step="1"
                        placeholder="예) 12000">
                </div>

                <div class="col-md-8">
                    <label class="form-label admin-muted">카테고리(category)</label>
                    <select name="category_id" class="form-select">
                        <option value="">카테고리 없음</option>
                        <% (categories || []).forEach(function(c){ %>
                            <option value="<%= c.id %>">
                                <%= c.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label admin-muted">규격/스펙(spec)</label>
                    <input type="text" name="spec" class="form-control" placeholder="예) 1000x2000 / t=3.0mm">
                </div>

                <div class="col-12">
                    <label class="form-label admin-muted">이미지 URL(image)</label>
                    <input type="text" name="image" class="form-control"
                        placeholder="예) /images/sample.png 또는 https://...">
                </div>

                <div class="col-12">
                    <label class="form-label admin-muted">설명(description)</label>
                    <textarea name="description" rows="4" class="form-control" placeholder="상품 설명을 입력하세요"></textarea>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-admin">
                        <i class="bi bi-check2-circle"></i> 등록하기
                    </button>
                    <a href="/admin/products" class="btn btn-outline-light">
                        취소
                    </a>
                </div>
            </form>
        </div>
    </div>
    <script>
        const codeInput = document.getElementById('codeInput');
        const checkBtn = document.getElementById('checkCodeBtn');
        const msgEl = document.getElementById('codeCheckMsg');
        const checkedEl = document.getElementById('codeChecked');

        function setMsg(text, type) {
            msgEl.textContent = text;
            msgEl.className = 'code-msg ' + (type || 'info');
        }

        codeInput.addEventListener('input', () => {
            checkedEl.value = '0';
            setMsg('코드 변경됨 → 중복 체크 다시 해주세요.', 'info');
        });

        checkBtn.addEventListener('click', async () => {
            const code = (codeInput.value || '').trim();
            if (!code) {
                checkedEl.value = '0';
                return setMsg('코드를 입력하세요.', 'bad');
            }

            setMsg('확인 중...', 'info');

            try {
                const res = await fetch(`/admin/api/products/check-code?code=${encodeURIComponent(code)}`);
                const data = await res.json();

                if (!res.ok || !data.ok) {
                    checkedEl.value = '0';
                    return setMsg(data.message || '중복 체크 실패', 'bad');
                }

                checkedEl.value = '1';
                setMsg(data.message || '사용 가능한 코드입니다.', 'ok');
            } catch (e) {
                checkedEl.value = '0';
                setMsg('네트워크 오류로 실패했습니다.', 'bad');
            }
        });

        document.querySelector('form')?.addEventListener('submit', (e) => {
            if (checkedEl.value !== '1') {
                e.preventDefault();
                alert('상품 코드 중복 체크를 먼저 해주세요.');
            }
        });
    </script>



    <%- include('partials/admin-footer') %>