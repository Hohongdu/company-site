<%- include('../layouts/admin-top', { title: '상품 등록' , active: 'products' , backUrl: '/admin/products' }) %>

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">상품 등록</h3>
            <div class="text-muted small">새 상품을 추가합니다. (spec 사용 가능)</div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-secondary" href="/admin/products">상품 목록</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- ✅ 폼은 딱 1개만 -->
            <form id="productNewForm" action="/admin/products/new" method="post" enctype="multipart/form-data"
                class="row g-3">
                <!-- ✅ CSRF (제출되는 폼에 반드시 포함) -->
                <input type="hidden" name="_csrf" value="<%= csrfToken || ''%>">

                <div class="col-12">
                    <label class="form-label small text-muted">상품 코드(code) *</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <input id="codeInput" class="form-control" name="code" placeholder="예: MAT-001" required
                            style="max-width:360px;">
                        <button type="button" id="checkCodeBtn" class="btn btn-outline-primary">중복 체크</button>
                        <span id="codeCheckMsg" class="small"></span>
                    </div>
                    <div class="form-text">코드는 중복되면 저장이 안 됩니다.</div>
                    <input type="hidden" id="codeChecked" value="0">
                </div>

                <div class="col-12 col-lg-8">
                    <label class="form-label small text-muted">상품명(name) *</label>
                    <input class="form-control" name="name" placeholder="예) 특수소재 A" required>
                </div>

                <div class="col-12 col-lg-4">
                    <label class="form-label small text-muted">가격(price) *</label>
                    <input class="form-control" name="price" type="number" min="1" placeholder="예) 12000" required>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label small text-muted">카테고리(category)</label>
                    <select class="form-select" name="category_id">
                        <option value="">카테고리 없음</option>
                        <% (categories || []).forEach(function(c){ %>
                            <option value="<%= c.id %>">
                                <%= c.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label small text-muted">규격/스펙(spec)</label>
                    <input class="form-control" name="spec" placeholder="예) 1000x2000 / t=3.0mm">
                </div>

                <div class="col-12">
                    <label class="form-label small text-muted">이미지 업로드</label>
                    <input class="form-control" type="file" name="imageFile" accept="image/*">
                    <div class="form-text">또는 이미지 URL 입력(선택)</div>
                    <input class="form-control mt-2" name="image" placeholder="https://... 또는 /uploads/...">
                </div>

                <div class="col-12">
                    <label class="form-label small text-muted">설명(description)</label>
                    <textarea class="form-control" name="description" rows="4" placeholder="상품 설명을 입력하세요"></textarea>
                </div>

                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit">등록</button>
                    <a class="btn btn-outline-secondary" href="/admin/products">취소</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        const codeInput = document.getElementById('codeInput');
        const checkBtn = document.getElementById('checkCodeBtn');
        const msgEl = document.getElementById('codeCheckMsg');
        const checkedEl = document.getElementById('codeChecked');

        function setMsg(text, type) {
            msgEl.textContent = text;
            msgEl.className = 'small';
            if (type === 'ok') msgEl.classList.add('text-success');
            else if (type === 'bad') msgEl.classList.add('text-danger');
            else msgEl.classList.add('text-muted');
        }

        codeInput.addEventListener('input', () => {
            checkedEl.value = '0';
            setMsg('코드 변경됨 → 중복 체크 다시 해주세요.', 'info');
        });

        checkBtn.addEventListener('click', async () => {
            const code = (codeInput.value || '').trim();
            if (!code) { checkedEl.value = '0'; return setMsg('코드를 입력하세요.', 'bad'); }

            setMsg('확인 중...', 'info');
            try {
                const res = await fetch(`/admin/api/products/check-code?code=${encodeURIComponent(code)}`);
                const data = await res.json();

                if (!res.ok || !data.ok) {
                    checkedEl.value = '0';
                    return setMsg(data.message || '중복 체크 실패', 'bad');
                }

                checkedEl.value = '1';
                return setMsg(data.message || '사용 가능한 코드입니다.', 'ok');
            } catch (e) {
                checkedEl.value = '0';
                return setMsg('네트워크 오류', 'bad');
            }
        });

        document.getElementById('productNewForm')?.addEventListener('submit', (e) => {
            if (checkedEl.value !== '1') {
                e.preventDefault();
                alert('상품 코드 중복 체크를 먼저 해주세요.');
            }
        });
    </script>

    <%- include('../layouts/admin-bottom') %>