<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>상품 등록 - 우리 회사</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/header-company') %>

        <main class="py-5">
            <div class="container" style="max-width: 720px;">
                <h1 class="h3 mb-4">상품 등록</h1>

                <form method="POST" action="/admin/products/new">
                    <div class="mb-3">
                        <label class="form-label">상품명</label>
                        <input type="text" name="name" class="form-control" placeholder="상품명을 입력하세요" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">가격 (원)</label>
                        <input type="number" name="price" class="form-control" placeholder="예: 19000" min="1" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">이미지 URL (선택)</label>
                        <input type="text" name="image" class="form-control"
                            placeholder="https://... 형식의 이미지 주소 (없으면 비워두세요)">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">상품 설명</label>
                        <textarea name="description" class="form-control" rows="4"
                            placeholder="상품에 대한 설명을 입력하세요"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        상품 등록
                    </button>
                    <a href="/shop/products" class="btn btn-secondary ms-2">
                        목록으로 돌아가기
                    </a>
                </form>
            </div>
        </main>

        <%- include('../partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>