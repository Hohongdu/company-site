<%- include('partials/admin-header', { title: '세금계산서 관리', subtitle: '세금계산서 발행 요청 목록입니다.', active: 'orders' }) %>

<% if (locals.notice) { %>
  <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="닫기"></button>
  </div>
<% } %>

<div class="admin-card card mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:54px;">#</th>
                        <th>주문번호</th>
                        <th>사업자명</th>
                        <th>사업자번호</th>
                        <th>대표자</th>
                        <th>이메일</th>
                        <th>금액</th>
                        <th>상태</th>
                        <th class="d-none d-sm-table-cell">요청일</th>
                        <th style="width:180px;">처리</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!requests || requests.length === 0) { %>
                        <tr>
                            <td colspan="10" class="text-center text-muted py-5">세금계산서 발행 요청이 없습니다.</td>
                        </tr>
                    <% } else { %>
                        <% requests.forEach(function(req, idx) { %>
                            <tr>
                                <td class="text-muted small fw-semibold"><%= requests.length - idx %></td>
                                <td>
                                    <a href="/admin/orders/<%= req.order_number %>" class="text-decoration-none fw-semibold small">
                                        <%= req.order_number %>
                                    </a>
                                </td>
                                <td class="fw-semibold"><%= req.business_name %></td>
                                <td class="small text-muted font-monospace"><%= req.business_reg_no %></td>
                                <td class="small"><%= req.rep_name %></td>
                                <td class="small text-muted" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                    <%= req.contact_email %>
                                </td>
                                <td class="text-end fw-semibold small" style="white-space:nowrap;">
                                    <%= Number(req.total_amount || 0).toLocaleString() %>원
                                </td>
                                <td>
                                    <%
                                    var badgeClass = 'secondary';
                                    var statusLabel = req.status;
                                    if (req.status === 'REQUESTED') { badgeClass = 'warning text-dark'; statusLabel = '요청'; }
                                    else if (req.status === 'PROCESSING') { badgeClass = 'info text-dark'; statusLabel = '처리중'; }
                                    else if (req.status === 'ISSUED') { badgeClass = 'success'; statusLabel = '발행완료'; }
                                    else if (req.status === 'REJECTED') { badgeClass = 'danger'; statusLabel = '거절'; }
                                    %>
                                    <span class="badge rounded-pill bg-<%= badgeClass %> px-2 py-1"><%= statusLabel %></span>
                                </td>
                                <td class="text-muted small d-none d-sm-table-cell" style="white-space:nowrap;">
                                    <%= req.requested_at ? new Date(req.requested_at).toLocaleDateString('ko-KR') : '-' %>
                                </td>
                                <td>
                                    <form action="/admin/tax-invoices/<%= req.id %>/status" method="post"
                                          class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <select name="status" class="form-select form-select-sm" style="width:110px;">
                                            <option value="REQUESTED" <%= req.status === 'REQUESTED' ? 'selected' : '' %>>요청</option>
                                            <option value="PROCESSING" <%= req.status === 'PROCESSING' ? 'selected' : '' %>>처리중</option>
                                            <option value="ISSUED" <%= req.status === 'ISSUED' ? 'selected' : '' %>>발행완료</option>
                                            <option value="REJECTED" <%= req.status === 'REJECTED' ? 'selected' : '' %>>거절</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary">저장</button>
                                    </form>
                                    <% if (req.admin_note) { %>
                                        <div class="text-muted small mt-1" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                             title="<%= req.admin_note %>">
                                            메모: <%= req.admin_note %>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/admin-footer') %>
