<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <title>카테고리 관리</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container py-4">
        <h1 class="h4 mb-3">카테고리 관리</h1>

        <div class="card mb-3">
            <div class="card-body">
                <form class="row g-2" action="/admin/categories" method="post">
                    <div class="col-md-4">
                        <input class="form-control" name="name" placeholder="카테고리 이름" required>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" name="slug" placeholder="slug(선택, 비우면 자동 생성)">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100">추가</button>
                    </div>
                    <div class="col-md-2">
                        <a class="btn btn-outline-secondary w-100" href="/shop/products">상품몰</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;">ID</th>
                            <th>이름</th>
                            <th>Slug</th>
                            <th style="width:140px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!categories || categories.length===0) { %>
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">카테고리가 없습니다.</td>
                            </tr>
                            <% } %>

                                <% categories.forEach(c=> { %>
                                    <tr>
                                        <td>
                                            <%= c.id %>
                                        </td>
                                        <td>
                                            <%= c.name %>
                                        </td>
                                        <td><code><%= c.slug %></code></td>
                                        <td class="text-end">
                                            <form action="/admin/categories/<%= c.id %>/delete" method="post"
                                                class="d-inline" onsubmit="return confirm('삭제할까요?');">
                                                <button class="btn btn-sm btn-outline-danger">삭제</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</body>

</html>