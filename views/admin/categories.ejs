<%- include('partials/admin-header', { title: '카테고리 관리' , subtitle: '카테고리 등록/수정/삭제' , active: 'categories' }) %>

    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-head__title">카테고리 관리</h1>
            <p class="adm-page-head__sub">카테고리 등록/수정/삭제</p>
        </div>
    </div>

    <% const list=(typeof categories !=='undefined' && categories) ? categories : []; %>

        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="mb-3">카테고리 추가</h5>

                        <form action="/admin/categories" method="post" class="d-grid gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div>
                                <label class="form-label small text-muted">이름</label>
                                <input class="form-control" name="name" placeholder="예) 보안키, HSM, 부자재" required>
                            </div>

                            <div>
                                <label class="form-label small text-muted">Slug(선택)</label>
                                <input class="form-control" name="slug" placeholder="예) hsm / 자동생성 가능">
                                <div class="form-text">비우면 이름 기반으로 자동 생성됩니다.</div>
                            </div>

                            <button class="btn btn-primary" type="submit">추가</button>
                        </form>

                        <div class="small text-muted mt-3">
                            * 사용 중인 카테고리는 삭제가 제한될 수 있어요.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                            <h5 class="mb-0">목록</h5>
                            <a class="btn btn-outline-secondary btn-sm" href="/admin/categories/export">엑셀 Export</a>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <!-- 합계: 50+120+100+140+80=490px < col-lg-7 내 가용 ~510px → 내부 스크롤 제거 -->
                                    <tr class="text-muted small">
                                        <th style="min-width:50px;">ID</th>
                                        <th style="min-width:120px;">이름</th>
                                        <th style="min-width:100px;">Slug</th>
                                        <th style="min-width:140px;">생성일</th>
                                        <th style="min-width:80px;">관리</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (list.length===0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">카테고리가 없습니다.</td>
                                        </tr>
                                        <% } %>

                                            <% list.forEach((c)=> { %>
                                                <tr>
                                                    <td>
                                                        <%= c.id %>
                                                    </td>
                                                    <td class="fw-semibold">
                                                        <%= c.name %>
                                                    </td>
                                                    <td class="text-muted">
                                                        <%= c.slug %>
                                                    </td>
                                                    <td class="text-muted">
                                                        <%= c.created_at ? String(c.created_at).slice(0,
                                                            19).replace('T', ' ' ) : '-' %>
                                                    </td>
                                                    <td>
                                                        <form action="/admin/categories/<%= c.id %>/delete"
                                                            method="post" onsubmit="return confirm('삭제할까요?');">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                type="submit">삭제</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    <%- include('partials/admin-footer') %>
