<%- include('partials/admin-header', { title: '카테고리 관리' , active: 'categories' }) %>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-1">카테고리 관리</h3>
            <div class="text-muted small">카테고리 추가/삭제 및 slug 확인</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/admin">대시보드</a>
            <a class="btn btn-outline-dark btn-sm" href="/shop/products">상품몰 보기</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-5">
            <div class="card">
                <div class="card-header">
                    <strong>카테고리 추가</strong>
                </div>
                <div class="card-body">
                    <form action="/admin/categories" method="post" class="vstack gap-2">
                        <div>
                            <label class="form-label">카테고리 이름</label>
                            <input class="form-control" name="name" placeholder="예: 특수소재" required>
                        </div>

                        <div>
                            <label class="form-label">slug (선택)</label>
                            <input class="form-control" name="slug" placeholder="예: special-material (비우면 자동 생성)">
                            <div class="form-text">비워도 됨. 한글도 허용되도록 처리해둔 slugify 로직을 쓰면 자동으로 변환됨.</div>
                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-dark" type="submit">추가</button>
                            <a class="btn btn-outline-secondary" href="/admin">이전(대시보드)</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <strong>카테고리 목록</strong>
                    <span class="text-muted small">
                        <%= categories ? categories.length : 0 %>개
                    </span>
                </div>
                <div class="card-body">
                    <% if (!categories || categories.length===0) { %>
                        <div class="text-muted">카테고리가 없습니다.</div>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:80px;">ID</th>
                                            <th>이름</th>
                                            <th>slug</th>
                                            <th style="width:140px;" class="text-end">관리</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% categories.forEach(c=> { %>
                                            <tr>
                                                <td>
                                                    <%= c.id %>
                                                </td>
                                                <td class="fw-semibold">
                                                    <%= c.name %>
                                                </td>
                                                <td class="text-muted">
                                                    <%= c.slug %>
                                                </td>
                                                <td class="text-end">
                                                    <form action="/admin/categories/<%= c.id %>/delete" method="post"
                                                        class="d-inline"
                                                        onsubmit="return confirm('삭제할까요? (해당 카테고리를 사용하는 상품이 있으면 삭제가 막힙니다)');">
                                                        <button class="btn btn-outline-danger btn-sm"
                                                            type="submit">삭제</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/admin-footer') %>