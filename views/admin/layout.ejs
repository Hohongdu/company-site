<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>
        <%= title || 'Admin' %>
    </title>

    <!-- Bootstrap (이미 프로젝트에 쓰고 있다면 그대로) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="admin-body">
    <div class="admin-shell">
        <link rel="stylesheet" href="/css/admin.css">

        <%- include('../partials/admin/sidebar', { currentPath, user }) %>

            <div class="admin-main">
                <%- include('../partials/admin/topbar', { title, subtitle, user }) %>

                    <div class="admin-content">
                        <%- body %>
                    </div>
            </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= title || 'Admin' %>
    </title>

    <!-- Bootstrap (이미 프로젝트에 있으면 생략 가능) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Admin 전용 CSS -->
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="admin-body">
    <div class="admin-shell">

        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <div class="fw-bold">ADMIN</div>
                <div class="small text-muted">관리자 콘솔</div>
            </div>

            <nav class="admin-nav">
                <a class="admin-nav-item <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">홈</a>
                <a class="admin-nav-item <%= currentPath.startsWith('/admin/dashboard') ? 'active' : '' %>"
                    href="/admin/dashboard">대시보드</a>
                <a class="admin-nav-item <%= currentPath.startsWith('/admin/products') ? 'active' : '' %>"
                    href="/admin/products">상품관리</a>
                <a class="admin-nav-item <%= currentPath.startsWith('/admin/products/import') ? 'active' : '' %>"
                    href="/admin/products/import">엑셀업로드</a>
                <a class="admin-nav-item <%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>"
                    href="/admin/categories">카테고리</a>

                <hr class="my-3 opacity-25">

                <!-- 외부 이동 -->
                <a class="admin-nav-item" href="/" target="_blank">회사로 가기</a>
                <a class="admin-nav-item" href="/shop" target="_blank">상품몰로 가기</a>
            </nav>
        </aside>

        <!-- Main -->
        <main class="admin-main">

            <!-- Topbar -->
            <header class="admin-topbar">
                <div>
                    <div class="admin-title">
                        <%= title || 'Admin' %>
                    </div>
                </div>

                <div class="admin-top-actions d-flex gap-2 align-items-center">
                    <a class="btn btn-sm btn-outline-secondary" href="/" target="_blank">회사</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/shop" target="_blank">상품몰</a>

                    <% if (user) { %>
                        <span class="small text-muted ms-2"><strong>
                                <%= user.name %>
                            </strong> 님</span>
                        <a class="btn btn-sm btn-outline-danger" href="/auth/logout">로그아웃</a>
                        <% } %>
                </div>
            </header>

            <!-- Content -->
            <section class="admin-content">
                <%- body %>
            </section>

            <footer class="admin-footer small text-muted">
                © Admin Console
            </footer>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
