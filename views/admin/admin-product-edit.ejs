<%- include('partials/admin-header', { title: '상품 수정' , subtitle: '등록된 상품 정보를 변경합니다.' , active: 'products' , backHref: '/admin/products' }) %>

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1">상품 수정</h3>
            <div class="text-muted small">등록된 상품 정보를 수정합니다.</div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/products" class="btn btn-sm btn-outline-secondary">상품 목록</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- ✅ 수정 폼 -->
            <form action="/admin/products/<%= product.id %>/edit" method="post" class="row g-3">
                <!-- ✅ CSRF -->
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="col-md-4">
                    <label class="form-label small text-muted">상품 코드(code)</label>
                    <input type="text" name="code" class="form-control" value="<%= product.code || '' %>">
                </div>

                <div class="col-md-8">
                    <label class="form-label small text-muted">상품명(name) <span class="text-warning">*</span></label>
                    <input type="text" name="name" class="form-control" required value="<%= product.name || '' %>">
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted">가격(price) <span class="text-warning">*</span></label>
                    <input type="number" name="price" class="form-control" required min="1" step="1"
                        value="<%= product.price || 0 %>">
                </div>

                <div class="col-md-8">
                    <label class="form-label small text-muted">카테고리(category)</label>
                    <select name="category_id" class="form-select">
                        <option value="">카테고리 없음</option>
                        <% (categories || []).forEach(function(c){ %>
                            <option value="<%= c.id %>" <%=(product.category_id===c.id ? 'selected' : '' ) %>>
                                <%= c.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label small text-muted">규격/스펙(spec)</label>
                    <input type="text" name="spec" class="form-control" value="<%= product.spec || '' %>">
                </div>

                <div class="col-12">
                    <label class="form-label small text-muted">이미지 URL(image)</label>
                    <input type="text" name="image" class="form-control" value="<%= product.image || '' %>">

                    <% if (product.image) { %>
                        <div class="mt-2 text-muted small">미리보기</div>
                        <img src="<%= product.image %>" alt="preview"
                            style="max-height:140px; border-radius:12px; border:1px solid rgba(15, 23, 42, 0.12);">
                        <% } %>
                </div>

                <div class="col-12">
                    <label class="form-label small text-muted">설명(description)</label>
                    <textarea name="description" rows="4"
                        class="form-control"><%= product.description || '' %></textarea>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">저장하기</button>
                    <a href="/admin/products" class="btn btn-outline-secondary">취소</a>

                    <!-- ✅ 삭제 버튼은 아래 별도 폼의 submit로 연결 -->
                    <button type="submit" class="btn btn-outline-danger ms-auto" form="deleteForm"
                        onclick="return confirm('정말 삭제할까요? 장바구니 항목도 같이 정리됩니다.');">
                        삭제
                    </button>
                </div>
            </form>

            <!-- ✅ 삭제 폼(중첩 제거) -->
            <form id="deleteForm" action="/admin/products/<%= product.id %>/delete" method="post" class="d-none">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            </form>
        </div>
    </div>

    <%- include('partials/admin-footer') %>
