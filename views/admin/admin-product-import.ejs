<%- include('./partials/admin-header', { title: '엑셀 업로드' , subtitle: '엑셀로 상품을 대량 반영하고, 업로드 기록을 관리합니다.' ,
    active: 'import' , backHref: '/admin' }) %>

    <div class="admin-card card mb-3">
        <div class="card-header py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="fw-semibold">
                <i class="bi bi-file-earmark-spreadsheet"></i> 업로드 반영
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="/admin/products" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-seam"></i> 상품 관리
                </a>
                <a href="/admin/categories" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-tags"></i> 카테고리
                </a>
                <a href="/admin/products/export" class="btn btn-outline-light btn-sm">
                    엑셀 다운로드
                </a>

            </div>
        </div>

        <div class="card-body">
            <form action="/admin/products/import" method="post" enctype="multipart/form-data" class="row g-3">
                <div class="col-12">
                    <label class="form-label admin-muted">엑셀 파일 선택</label>

                    <!-- 모바일/웹 모두 잘 보이게 -->
                    <input class="form-control" type="file" name="file" accept=".xlsx,.xls" required>
                    <div class="admin-muted small mt-2">
                        권장 헤더: <code>code</code>, <code>name</code>, <code>category_slug</code> 또는
                        <code>category_name</code>,
                        <code>price</code>, <code>spec</code>, <code>image</code>, <code>description</code>
                    </div>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <button class="btn btn-admin">
                        <i class="bi bi-upload"></i> 업로드 반영
                    </button>

                    <a href="/admin" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left"></i> 이전으로
                    </a>

                    <a href="/shop/products" class="btn btn-outline-light ms-auto">
                        <i class="bi bi-bag"></i> 상품몰 확인
                    </a>

                </div>
            </form>
        </div>
    </div>

    <div class="admin-card card">
        <div class="card-header py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="fw-semibold">
                <i class="bi bi-clock-history"></i> 업로드 히스토리
            </div>
            <span class="admin-muted small">최근 업로드 기록</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr class="small">
                            <th class="ps-3">ID</th>
                            <th>파일명</th>
                            <th class="text-nowrap">상태</th>
                            <th class="text-nowrap">성공/실패</th>
                            <th class="text-nowrap">업로드 시각</th>
                            <th class="text-end pe-3">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!uploads || uploads.length===0) { %>
                            <tr>
                                <td colspan="6" class="text-center admin-muted py-4">
                                    업로드 기록이 없습니다.
                                </td>
                            </tr>
                            <% } else { %>
                                <% uploads.forEach(function(u){ %>
                                    <tr>
                                        <td class="ps-3">
                                            <%= u.id %>
                                        </td>
                                        <td style="max-width: 360px;">
                                            <div class="text-truncate" title="<%= u.original_name || '' %>">
                                                <%= u.original_name || '(unknown)' %>
                                            </div>
                                            <div class="admin-muted small">
                                                <%= u.stored_name ? u.stored_name : '' %>
                                            </div>
                                        </td>

                                        <td class="text-nowrap">
                                            <% if (u.status==='SUCCESS' ) { %>
                                                <span class="badge bg-success">SUCCESS</span>
                                                <% } else if (u.status==='PARTIAL' ) { %>
                                                    <span class="badge bg-warning text-dark">PARTIAL</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger">FAILED</span>
                                                        <% } %>
                                        </td>

                                        <td class="text-nowrap">
                                            <span class="badge bg-secondary">OK <%= u.success_count || 0 %></span>
                                            <span class="badge bg-secondary">FAIL <%= u.fail_count || 0 %></span>
                                        </td>

                                        <td class="text-nowrap admin-muted">
                                            <%= u.created_at ? u.created_at : '' %>
                                        </td>

                                        <td class="text-end pe-3">
                                            <div class="d-flex justify-content-end flex-wrap gap-2">
                                                <!-- “파일 불러오기” = 해당 업로드 상세 결과 보기 -->
                                                <a class="btn btn-outline-light btn-sm"
                                                    href="/admin/uploads/<%= u.id %>">
                                                    <i class="bi bi-folder2-open"></i> 불러오기
                                                </a>

                                                <!-- 업로드 결과(실패 목록)만 바로 보기 -->
                                                <a class="btn btn-outline-warning btn-sm"
                                                    href="/admin/uploads/<%= u.id %>/fails">
                                                    <i class="bi bi-exclamation-triangle"></i> 실패보기
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('./partials/admin-footer') %>