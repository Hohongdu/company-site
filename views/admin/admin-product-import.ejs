<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>상품 엑셀 업로드 - 우리 회사</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/header') %>

        <main class="py-5">
            <div class="container" style="max-width: 600px;">
                <h1 class="h3 mb-4">상품 엑셀 업로드</h1>

                <p class="mb-3">
                    엑셀 파일의 첫 번째 시트에 아래 형식으로 데이터를 넣어 주세요.<br>
                    <code>code, name, category_slug, price, spec, image, description</code>
                </p>

                <form method="POST" action="/admin/products/import" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">엑셀 파일 선택</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx,.xls">
                    </div>
                    <button type="submit" class="btn btn-primary">업로드 & 반영</button>
                </form>
            </div>
        </main>

        <%- include('../partials/footer') %>
</body>

</html>