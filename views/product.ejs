<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <title>우리 회사 - 상품 목록</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- 네비게이션 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">우리 회사</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">홈</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/about">회사 소개</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/products">상품</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/contact">문의하기</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- 메인 영역 -->
    <main class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">상품 목록</h1>
                <!-- 나중에 관리자용 "상품 추가" 버튼 등으로 활용 가능 -->
                <button class="btn btn-outline-primary btn-sm" disabled>상품 추가 (준비중)</button>
            </div>

            <!-- 상품 카드 리스트 -->
            <div class="row g-4">
                <% if (products && products.length> 0) { %>
                    <% products.forEach(item=> { %>
                        <div class="col-md-4">
                            <div class="card h-100">
                                <% if (item.image) { %>
                                    <img src="<%= item.image %>" class="card-img-top" alt="<%= item.name %>">
                                    <% } else { %>
                                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white"
                                            style="height: 180px;">
                                            이미지 준비중
                                        </div>
                                        <% } %>
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title">
                                                    <%= item.name %>
                                                </h5>
                                                <p class="card-text text-muted mb-2">
                                                    <%= item.description %>
                                                </p>
                                                <p class="fw-bold mb-3">
                                                    <%= item.price.toLocaleString() %>원
                                                </p>

                                                <!-- 나중에 상세 페이지 / 장바구니 / 구매 API 연결 -->
                                                <div class="mt-auto d-flex gap-2">
                                                    <a href="/products/<%= item.id %>"
                                                        class="btn btn-sm btn-outline-secondary">상세 보기</a>
                                                    <button class="btn btn-sm btn-primary" disabled>구매 (API
                                                        준비중)</button>
                                                </div>
                                            </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        등록된 상품이 없습니다. 나중에 관리자 페이지에서 상품을 추가하세요.
                                    </div>
                                </div>
                                <% } %>
            </div>
        </div>
    </main>

    <!-- 푸터 -->
    <footer class="bg-dark text-white py-3 mt-5">
        <div class="container text-center small">
            © <span id="year"></span> 우리 회사. All rights reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>