<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>404 | 페이지를 찾을 수 없습니다</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body style="background:var(--c-bg);min-height:100vh;display:flex;flex-direction:column;">
  <header style="padding:1.25rem 0;border-bottom:1px solid var(--c-border);background:var(--c-surface);">
    <div class="container">
      <a href="/" style="font-size:1.05rem;font-weight:900;letter-spacing:.1em;color:var(--c-dark);text-decoration:none;text-transform:uppercase;">ENERMADE</a>
    </div>
  </header>

  <main style="flex:1;display:flex;align-items:center;justify-content:center;padding:5rem 1rem;">
    <div style="text-align:center;max-width:480px;">
      <div style="font-size:6rem;font-weight:900;letter-spacing:-.05em;color:var(--c-border-2);line-height:1;margin-bottom:1.5rem;">404</div>
      <h1 style="font-size:1.5rem;font-weight:900;letter-spacing:-.02em;color:var(--c-ink);margin-bottom:.75rem;">페이지를 찾을 수 없습니다</h1>
      <p style="color:var(--c-muted);font-size:.9375rem;line-height:1.75;margin-bottom:2rem;">
        <%= typeof message !== 'undefined' ? message : '요청하신 페이지가 존재하지 않거나, 주소가 잘못되었을 수 있습니다.' %>
      </p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/" class="btn btn-dark">홈으로 돌아가기</a>
        <button onclick="history.back()" class="btn btn-outline-dark">이전 페이지</button>
      </div>
    </div>
  </main>

  <footer style="padding:1.25rem 0;border-top:1px solid var(--c-border);">
    <div class="container text-center" style="font-size:.8125rem;color:var(--c-muted);">
      © <%= new Date().getFullYear() %> ENERMADE. All rights reserved.
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
