<%- include('layouts/company-top', { title: '페이지를 찾을 수 없습니다', active: '' }) %>

<section style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:80px 0;">
  <div style="text-align:center;max-width:480px;margin:0 auto;padding:0 24px;">
    <div style="font-size:96px;font-weight:900;color:var(--c-accent,#ea580c);line-height:1;margin-bottom:16px;font-family:var(--font-head,'Sora',sans-serif);">404</div>
    <h1 style="font-size:22px;font-weight:700;color:var(--c-text,#0f172a);margin-bottom:12px;">페이지를 찾을 수 없습니다</h1>
    <p style="font-size:15px;color:var(--c-muted,#64748b);margin-bottom:36px;line-height:1.7;">
      <%= typeof message !== 'undefined' ? message : '요청하신 페이지가 존재하지 않거나, 주소가 잘못되었을 수 있습니다.' %>
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="/" class="btn btn-primary" style="padding:10px 28px;">홈으로</a>
      <button onclick="history.back()" class="btn btn-outline-secondary" style="padding:10px 28px;">이전 페이지</button>
    </div>
  </div>
</section>

<%- include('layouts/company-bottom') %>
