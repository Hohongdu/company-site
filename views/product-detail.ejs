<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>
        <%= product.name %> - 상품 상세
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header') %>

        <main class="py-5">
            <div class="container">
                <a href="/products" class="btn btn-link mb-3">&laquo; 상품 목록으로 돌아가기</a>

                <div class="row g-4">
                    <!-- 이미지 영역 -->
                    <div class="col-md-5">
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>">
                            <% } else { %>
                                <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white"
                                    style="height: 300px;">
                                    이미지 준비중
                                </div>
                                <% } %>
                    </div>

                    <!-- 정보 영역 -->
                    <div class="col-md-7">
                        <h1 class="mb-3">
                            <%= product.name %>
                        </h1>
                        <p class="lead text-muted mb-3">
                            <%= product.description %>
                        </p>
                        <p class="fs-4 fw-bold mb-4">
                            <%= product.price.toLocaleString() %>원
                        </p>

                        <!-- 나중에 옵션 / 수량 / 장바구니 / 결제 버튼 등 연결 -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" disabled>바로 구매 (결제 API 준비중)</button>
                            <button class="btn btn-outline-secondary" disabled>장바구니 (준비중)</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>