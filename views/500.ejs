<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>500 | 서버 오류가 발생했습니다</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header-company') %>

        <main class="py-5">
            <div class="container text-center">
                <h1 class="display-6 mb-3">500 – 서버 오류가 발생했습니다</h1>

                <p class="text-muted mb-4">
                    <%= typeof message !=='undefined' ? message : '잠시 후 다시 시도해 주세요. 문제가 계속되면 관리자에게 문의해 주세요.' %>
                </p>

                <div class="d-flex justify-content-center gap-2">
                    <a href="/" class="btn btn-primary">홈으로</a>
                    <button onclick="location.reload()" class="btn btn-outline-secondary">
                        새로고침
                    </button>
                </div>

                <% if (typeof errorId !=='undefined' && errorId) { %>
                    <div class="mt-4 small text-muted">
                        오류 코드: <strong>
                            <%= errorId %>
                        </strong>
                    </div>
                    <% } %>
            </div>
        </main>

        <%- include('partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>