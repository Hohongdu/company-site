<%
const pageTitle = typeof title === 'string' ? title : '제품몰';
const q = typeof query === 'string' ? query : '';
const category = typeof currentCategory === 'string' ? currentCategory : 'all';
const atCatalog = currentPath.startsWith('/shop/products');
const count = Number(cartCount || 0);
const brand = (typeof company !== 'undefined' && company?.name) || 'ENERMADE';
const navLinks = [
  { href: '/shop', label: '제품몰 홈', current: currentPath === '/shop' || currentPath === '/shop/' },
  { href: '/shop/products', label: '전체 상품', current: atCatalog },
  { href: '/shop/inquiries', label: '견적 문의', current: currentPath === '/shop/inquiries' },
  { href: '/shop/orders/guest', label: '주문 조회', current: currentPath === '/shop/orders/guest' },
];
%>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= pageTitle %> | <%= brand %> 제품몰</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/shop.css">
  <link rel="stylesheet" href="/css/app-ui.css">
  <link rel="stylesheet" href="/css/shop-catalog.css">
  <link rel="icon" href="data:,">
</head>
<body class="app-wrap shop-store">
<a class="shop-skip" href="#app-main">본문으로 건너뛰기</a>
<header class="shop-header">
  <div class="shop-shell shop-header__main">
    <a class="shop-brand" href="/shop">
      <span class="shop-brand__name"><%= brand %></span>
      <span data-i18n-auto>제품몰</span>
    </a>

    <form class="shop-header__search" action="/shop/products" method="get" role="search" aria-label="제품 검색">
      <% if (atCatalog && category !== 'all') { %><input type="hidden" name="category" value="<%= category %>"><% } %>
      <input type="search" name="q" value="<%= q %>" aria-label="제품명, 제품코드 또는 규격" placeholder="제품명, 제품코드 또는 규격" enterkeyhint="search"
             data-i18n-placeholder data-i18n-placeholder-ko="제품명, 제품코드 또는 규격">
      <button type="submit" data-i18n-auto>검색</button>
    </form>

    <div class="shop-header__tools">
      <a href="<%= user ? '/shop/account' : '/auth/login' %>" data-i18n-auto><%= user ? '내 계정' : '로그인' %></a>
      <a class="app-header__btn shop-cart-link" href="/shop/cart" <% if (currentPath === '/shop/cart') { %>aria-current="page"<% } %>>
        <span data-i18n-auto>장바구니</span><span class="app-header-badge shop-cart-badge" aria-live="polite"><%= count || '' %></span>
      </a>
      <div class="shop-language" id="shopLanguageSlot"></div>
    </div>
  </div>
  <div class="shop-header__nav">
    <nav class="shop-shell shop-header__links" aria-label="제품몰 메뉴">
      <% for (const link of navLinks) { %>
        <a href="<%= link.href %>" <% if (link.current) { %>aria-current="page"<% } %> data-i18n-auto><%= link.label %></a>
      <% } %>
      <a class="shop-header__links__company" href="/" data-i18n-auto>회사 사이트</a>
    </nav>
  </div>
</header>
<main class="app-main" id="app-main" tabindex="-1">
