<% const pageTitle = (typeof title !== 'undefined' && title) ? title : 'SHOP'; %>
<% const activeKey = (typeof active !== 'undefined' && active) ? active : ''; %>
<% const q = (typeof query !== 'undefined' && query) ? query : ''; %>
<% const isHome = activeKey === 'home' || currentPath === '/shop' || currentPath === '/shop/'; %>
<% const isProducts = activeKey === 'products' || currentPath.indexOf('/shop/products') === 0; %>
<%/* 각각 독립 활성화 처리 - 하나만 눌러도 다 활성화되는 버그 수정 */%>
<% const isLookup = activeKey === 'lookup' || currentPath.indexOf('/shop/lookup') === 0 || currentPath.indexOf('/shop/orders/guest') === 0 || currentPath.indexOf('/shop/inquiries/guest') === 0; %>
<% const isOrderLookup = activeKey === 'order_lookup' || currentPath.indexOf('/shop/orders/guest') === 0; %>
<% const isInquiryLookup = activeKey === 'inquiry_lookup' || currentPath.indexOf('/shop/inquiries/guest') === 0; %>
<% const isInquiry = activeKey === 'inquiry' || (currentPath === '/shop/inquiries' || currentPath === '/shop/inquiries/'); %>
<% const isCart = activeKey === 'cart' || currentPath.indexOf('/shop/cart') === 0; %>
<% const isAccount = activeKey === 'account' || currentPath.indexOf('/shop/account') === 0; %>
<% const isWishlist = activeKey === 'wishlist' || currentPath.indexOf('/shop/wishlist') === 0; %>
<% const safeCartCount = Number(cartCount || 0); %>
<!doctype html>
<html lang="ko" data-theme="">
<script>(function(){var t=localStorage.getItem('site_theme');if(t){document.documentElement.setAttribute('data-theme',t);}else if(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches){document.documentElement.setAttribute('data-theme','dark');}})()</script>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> | ENERMADE Shop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/shop.css" />
</head>
<body class="shop-wrap">

<!-- 다크 모드 토글 (fixed 좌측 상단) -->
<button class="dark-mode-btn" id="darkModeToggle" aria-label="다크 모드 전환" title="다크 모드">
  <svg class="dm-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  <svg class="dm-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
</button>

<header class="shop-header">
  <div class="container shop-header__inner">
    <!-- Brand -->
    <a class="shop-brand" href="/shop">
      <span class="shop-brand__logo">ENERMADE</span>
      <span class="shop-brand__sub">SHOP</span>
    </a>

    <!-- Desktop nav -->
    <nav class="shop-nav" aria-label="쇼핑 내비게이션">
      <a href="/shop" class="<%= isHome ? 'is-active' : '' %>" data-i18n-auto>홈</a>
      <a href="/shop/products" class="<%= isProducts ? 'is-active' : '' %>" data-i18n-auto>전체 상품</a>
      <a href="/shop/lookup" class="<%= isLookup ? 'is-active' : '' %>" data-i18n-auto>조회</a>
      <a href="/shop/inquiries" class="<%= isInquiry ? 'is-active' : '' %>" data-i18n-auto>문의하기</a>
    </nav>

    <!-- Desktop tools -->
    <div class="shop-tools">
      <!-- Search -->
      <form class="shop-search" action="/shop/products" method="get">
        <svg class="shop-search__icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input type="search" name="q" placeholder="상품 검색" value="<%= q %>">
      </form>

      <!-- Wishlist -->
      <a class="shop-tool-btn <%= isWishlist ? 'is-active' : '' %>" href="<%= user ? '/shop/wishlist' : '/auth/login' %>" aria-label="찜한 상품">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        찜
      </a>

      <!-- Cart -->
      <a class="shop-tool-btn <%= isCart ? 'is-active' : '' %>" href="/shop/cart" aria-label="장바구니">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2"/>
          <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        장바구니
        <% if (safeCartCount > 0) { %>
          <span class="shop-cart-badge"><%= safeCartCount %></span>
        <% } %>
      </a>

      <div class="shop-divider"></div>

      <% if (user) { %>
        <!-- 회사 홈페이지 이동 버튼 -->
        <a class="shop-auth-btn outline" href="/" aria-label="회사 홈페이지" title="회사 홈페이지">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-2px;margin-right:3px;">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <polyline points="9,22 9,12 15,12 15,22" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          회사
        </a>
        <% if (user.is_admin) { %>
          <!-- 관리자 전용 대시보드 버튼 -->
          <a class="shop-auth-btn filled" href="/admin/dashboard" aria-label="관리자 대시보드" title="관리자 대시보드"
             style="background:#ea580c;border-color:#ea580c;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-2px;margin-right:3px;">
              <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
              <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
              <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
              <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
            </svg>
            관리자
          </a>
        <% } %>
        <a class="shop-tool-btn <%= isAccount ? 'is-active' : '' %>" href="/shop/account">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M20 21a8 8 0 00-16 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
          </svg>
          <%= user.name %>
        </a>
        <a class="shop-auth-btn outline" href="/auth/logout">로그아웃</a>
      <% } else { %>
        <a class="shop-auth-btn outline" href="/" title="회사 홈페이지">회사</a>
        <a class="shop-auth-btn outline" href="/auth/login">로그인</a>
        <a class="shop-auth-btn filled" href="/auth/register">회원가입</a>
      <% } %>
    </div>

    <!-- Mobile toggle -->
    <button class="shop-mobile-toggle" id="shopMobileToggle" aria-label="메뉴 열기">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</header>

<!-- Shop 모바일 슬라이드 드로어 -->
<div class="shop-mob-backdrop" id="shopMobBackdrop"></div>
<div class="shop-mob-drawer" id="shopMobDrawer">
  <!-- 헤더: 로고 왼쪽, X 오른쪽 -->
  <div class="shop-mob-drawer__head">
    <a class="shop-mob-drawer__brand" href="/shop">
      <span>ENERMADE</span> <small>SHOP</small>
    </a>
    <button class="shop-mob-drawer__close" id="shopMobClose" type="button" aria-label="닫기">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- 검색 -->
  <form class="shop-mob-search" action="/shop/products" method="get">
    <input type="search" name="q" placeholder="상품 검색" value="<%= q %>">
    <button class="btn btn-primary btn-sm" type="submit">검색</button>
  </form>

  <!-- 상단: 인증 버튼 -->
  <div class="shop-mob-auth">
    <% if (user) { %>
      <div class="shop-mob-user">
        <div class="shop-mob-avatar"><%= user.name.charAt(0) %></div>
        <div>
          <div class="shop-mob-user__name"><%= user.name %></div>
          <div class="shop-mob-user__email"><%= user.email %></div>
        </div>
      </div>
      <div class="shop-mob-btns">
        <a href="/" class="shop-mob-btn-outline">회사 홈</a>
        <% if (user.is_admin) { %>
          <a href="/admin/dashboard" class="shop-mob-btn-admin">관리자</a>
        <% } %>
        <a href="/auth/logout" class="shop-mob-btn-dark">로그아웃</a>
      </div>
    <% } else { %>
      <div class="shop-mob-btns">
        <a href="/" class="shop-mob-btn-outline">회사 홈</a>
        <a href="/auth/login" class="shop-mob-btn-outline">로그인</a>
        <a href="/auth/register" class="shop-mob-btn-primary">회원가입</a>
      </div>
    <% } %>
  </div>

  <!-- 메뉴 링크 -->
  <nav class="shop-mob-nav">
    <a href="/shop" class="shop-mob-link <%= isHome ? 'is-active' : '' %>" data-i18n-auto>홈</a>
    <a href="/shop/products" class="shop-mob-link <%= isProducts ? 'is-active' : '' %>" data-i18n-auto>전체 상품</a>
    <a href="/shop/cart" class="shop-mob-link <%= isCart ? 'is-active' : '' %>"><span data-i18n-auto>장바구니</span><% if (safeCartCount > 0) { %> <span class="shop-mob-badge"><%= safeCartCount %></span><% } %></a>
    <a href="/shop/lookup" class="shop-mob-link <%= isLookup ? 'is-active' : '' %>" data-i18n-auto>조회</a>
    <a href="/shop/inquiries" class="shop-mob-link <%= isInquiry ? 'is-active' : '' %>" data-i18n-auto>문의하기</a>
    <% if (user) { %>
      <a href="/shop/account" class="shop-mob-link <%= isAccount ? 'is-active' : '' %>" data-i18n-auto>내 정보</a>
      <a href="/shop/wishlist" class="shop-mob-link <%= isWishlist ? 'is-active' : '' %>" data-i18n-auto>찜한 상품</a>
    <% } %>
  </nav>
</div>

<main class="shop-main">
