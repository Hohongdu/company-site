<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'SHOP' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; const q=(typeof query !=='undefined' && query) ? query : '' ; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %> | Shop
        </title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/shop.css" />

        <style>
            .ellipsis {
                max-width: 140px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .shop-navbtn {
                white-space: nowrap;
            }

            .shop-search {
                max-width: 520px;
            }

            @media (max-width: 768px) {
                .shop-search {
                    max-width: none;
                }
            }
        </style>
    </head>

    <body class="shop-wrap bg-light">
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
            <div class="container py-2">

                <!-- 왼쪽: 로고 -->
                <a class="navbar-brand fw-bold m-0" href="/shop">SHOP</a>

                <!-- 모바일: 로그인/회원가입 or 이름/로그아웃 + 햄버거 -->
                <div class="ms-auto d-flex align-items-center gap-2 d-lg-none">
                    <% if (user) { %>
                        <a class="btn btn-outline-secondary btn-sm shop-navbtn" href="/auth/logout" data-i18n
                            data-i18n-ko="로그아웃">로그아웃</a>
                        <% } else { %>
                            <a class="btn btn-outline-secondary btn-sm shop-navbtn" href="/auth/login" data-i18n
                                data-i18n-ko="로그인">로그인</a>
                            <a class="btn btn-primary btn-sm shop-navbtn" href="/auth/register" data-i18n
                                data-i18n-ko="회원가입"
                               >회원가입</a>
                            <% } %>

                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#shopNav">
                                    <span class="navbar-toggler-icon"></span>
                                </button>
                </div>

                <!-- 데스크탑: 가운데 검색 + 오른쪽 버튼 묶음 -->
                <div class="collapse navbar-collapse" id="shopNav">

                    <!-- 가운데: 검색 (데스크탑에서 가운데처럼 보이게 ms-lg-4 + me-lg-auto) -->
                    <form class="d-flex gap-2 ms-lg-4 me-lg-auto my-2 my-lg-0 shop-search" action="/shop/products"
                        method="get">
                        <input class="form-control" name="q" placeholder="상품 검색 (코드/이름/규격)" value="<%= q %>"
                            data-i18n-placeholder data-i18n-placeholder-ko="상품 검색 (코드/이름/규격)"
                           
                           >
                        <button class="btn btn-outline-primary shop-navbtn" type="submit" data-i18n data-i18n-ko="검색"
                           >검색</button>
                    </form>

                    <!-- 오른쪽: 버튼들 한 묶음(간격 일정) -->
                    <div class="d-none d-lg-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm shop-navbtn dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="언어 변경">
                                🌐
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button class="dropdown-item" type="button" data-lang-switch="ko">한국어</button></li>
                                <li><button class="dropdown-item" type="button" data-lang-switch="en">English</button>
                                </li>
                                <li><button class="dropdown-item" type="button" data-lang-switch="zh">中文</button></li>
                                <li><button class="dropdown-item" type="button" data-lang-switch="ja">日本語</button></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle shop-navbtn" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" data-i18n data-i18n-ko="메뉴"
                               >
                                메뉴
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/" data-i18n data-i18n-ko="회사"
                                       >회사</a></li>
                                <li><a class="dropdown-item" href="/shop/products" data-i18n data-i18n-ko="상품보기"
                                       >상품보기</a></li>
                                <li><a class="dropdown-item" href="/shop/inquiries" data-i18n data-i18n-ko="문의하기"
                                       >문의하기</a></li>
                                <li><a class="dropdown-item" href="/shop/inquiries/guest" data-i18n data-i18n-ko="문의조회"
                                       
                                       >문의조회</a></li>
                                <li><a class="dropdown-item" href="/shop/orders/guest" data-i18n data-i18n-ko="주문조회"
                                       >주문조회</a>
                                </li>
                                <% if (user) { %>
                                    <li><a class="dropdown-item" href="/shop/wishlist" data-i18n data-i18n-ko="위시리스트"
                                           >위시리스트</a>
                                    </li>
                                    <% } %>
                                        <% if (user && user.is_admin) { %>
                                            <li><a class="dropdown-item" href="/admin/dashboard" data-i18n
                                                    data-i18n-ko="관리자"
                                                   >관리자</a></li>
                                            <% } %>
                            </ul>
                        </div>

                        <a class="btn btn-sm shop-navbtn <%= activeKey==='cart' ? 'btn-dark' : 'btn-outline-dark' %>"
                            href="/shop/cart" data-i18n data-i18n-ko="장바구니"
                           >
                            장바구니
                            <% if (cartCount> 0) { %>
                                <span class="badge bg-danger ms-1">
                                    <%= cartCount %>
                                </span>
                                <% } %>
                        </a>

                        <% if (user) { %>
                            <a class="btn btn-outline-secondary btn-sm shop-navbtn <%= activeKey==='account' ? 'btn-secondary text-white' : '' %>"
                                href="/shop/account" data-i18n data-i18n-ko="내 정보"
                               >내 정보</a>
                            <% } %>

                                <% if (user && user.is_admin) { %>
                                    <a class="btn btn-outline-dark btn-sm shop-navbtn" href="/admin/dashboard" data-i18n
                                        data-i18n-ko="관리자"
                                       >관리자</a>
                                    <% } %>

                                        <div class="vr mx-2"></div>

                                        <% if (user) { %>
                                            <span class="small text-muted ellipsis">
                                                <strong>
                                                    <%= user.name %>
                                                </strong>
                                            </span>
                                            <a class="btn btn-outline-secondary btn-sm shop-navbtn" href="/auth/logout"
                                                data-i18n data-i18n-ko="로그아웃"
                                               >로그아웃</a>
                                            <% } else { %>
                                                <a class="btn btn-outline-secondary btn-sm shop-navbtn"
                                                    href="/auth/login" data-i18n data-i18n-ko="로그인"
                                                   >로그인</a>
                                                <a class="btn btn-primary btn-sm shop-navbtn" href="/auth/register"
                                                    data-i18n data-i18n-ko="회원가입"
                                                   >회원가입</a>
                                                <% } %>
                    </div>

                    <!-- 모바일 메뉴(햄버거 펼쳤을 때): 긴 버튼(d-grid) -->
                    <div class="d-lg-none mt-2">
                        <div class="d-grid gap-2">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary shop-navbtn dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="언어 변경">
                                    🌐
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button class="dropdown-item" type="button" data-lang-switch="ko">한국어</button>
                                    </li>
                                    <li><button class="dropdown-item" type="button"
                                            data-lang-switch="en">English</button></li>
                                    <li><button class="dropdown-item" type="button" data-lang-switch="zh">中文</button>
                                    </li>
                                    <li><button class="dropdown-item" type="button" data-lang-switch="ja">日本語</button>
                                    </li>
                                </ul>
                            </div>
                            <a class="btn <%= activeKey==='cart' ? 'btn-dark' : 'btn-outline-dark' %>" href="/shop/cart"
                                data-i18n data-i18n-ko="장바구니">
                                장바구니 <% if (cartCount> 0) { %><span class="badge bg-danger ms-1">
                                        <%= cartCount %>
                                    </span>
                                    <% } %>
                            </a>
                            <% if (user) { %>
                                <a class="btn btn-outline-secondary" href="/shop/account" data-i18n data-i18n-ko="내 정보"
                                   >내 정보</a>
                                <% } %>
                                    <details class="mt-2">
                                        <summary class="btn btn-outline-secondary w-100" data-i18n data-i18n-ko="기타 메뉴"
                                           >기타 메뉴
                                        </summary>
                                        <div class="d-grid gap-2 mt-2">
                                            <a class="btn btn-outline-secondary" href="/" data-i18n data-i18n-ko="회사"
                                               >회사</a>
                                            <a class="btn btn-outline-secondary" href="/shop/products" data-i18n
                                                data-i18n-ko="상품보기"
                                               >상품보기</a>
                                            <a class="btn btn-outline-secondary" href="/shop/inquiries" data-i18n
                                                data-i18n-ko="문의하기"
                                               >문의하기</a>
                                            <a class="btn btn-outline-secondary" href="/shop/inquiries/guest" data-i18n
                                                data-i18n-ko="문의조회"
                                               >문의조회</a>
                                            <a class="btn btn-outline-secondary" href="/shop/orders/guest" data-i18n
                                                data-i18n-ko="주문조회"
                                               >주문조회</a>
                                            <% if (user) { %>
                                                <a class="btn btn-outline-secondary" href="/shop/wishlist" data-i18n
                                                    data-i18n-ko="위시리스트"
                                                   >위시리스트</a>
                                                <% } %>
                                                    <% if (user && user.is_admin) { %>
                                                        <a class="btn btn-outline-dark" href="/admin/dashboard"
                                                            data-i18n data-i18n-ko="관리자"
                                                           >관리자</a>
                                                        <% } %>
                                        </div>
                                    </details>
                        </div>
                    </div>

                </div>
            </div>
        </nav>

        <main class="container py-4" data-auto-i18n>
