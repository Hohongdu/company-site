<% const pageTitle = (typeof title !== 'undefined' && title) ? title : 'SHOP'; %>
<% const activeKey = (typeof active !== 'undefined' && active) ? active : ''; %>
<% const q = (typeof query !== 'undefined' && query) ? query : ''; %>
<% const isHome = activeKey === 'home' || currentPath === '/shop' || currentPath === '/shop/'; %>
<% const isProducts = activeKey === 'products' || currentPath.indexOf('/shop/products') === 0; %>
<% const isSupport = activeKey === 'inquiry' || activeKey === 'order_lookup' || currentPath.indexOf('/shop/inquiries') === 0 || currentPath.indexOf('/shop/orders') === 0; %>
<% const isCart = activeKey === 'cart' || currentPath.indexOf('/shop/cart') === 0; %>
<% const isAccount = activeKey === 'account' || currentPath.indexOf('/shop/account') === 0; %>
<% const isWishlist = activeKey === 'wishlist' || currentPath.indexOf('/shop/wishlist') === 0; %>
<% const safeCartCount = Number(cartCount || 0); %>
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= pageTitle %> | Shop</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/css/shop.css" />
</head>
<body class="shop-wrap">
    <header class="shop-site-header sticky-top">
        <div class="container shop-site-header__inner">
            <a class="shop-brand" href="/shop">
                <span class="shop-brand-logo">cafe24</span>
                <span class="shop-brand-sub">Store | 디자인</span>
            </a>

            <button class="navbar-toggler shop-nav-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#shopMobileNav" aria-controls="shopMobileNav" aria-expanded="false" aria-label="모바일 메뉴">
                <span class="navbar-toggler-icon"></span>
            </button>

            <nav class="shop-main-nav d-none d-lg-flex" aria-label="쇼핑 내비게이션">
                <a class="<%= isProducts ? 'is-active' : '' %>" href="/shop/products">카테고리</a>
                <a class="<%= isHome ? 'is-active' : '' %>" href="/shop">기획전</a>
                <a href="/shop/products">스토리</a>
                <a class="<%= isSupport ? 'is-active' : '' %>" href="/shop/orders/guest">실시간</a>
                <a href="/shop/products">베스트</a>
                <a href="/shop/inquiries">디자인나눔</a>
                <a class="<%= isSupport ? 'is-active' : '' %>" href="/shop/inquiries/guest">고객지원</a>
            </nav>

            <div class="shop-header-tools d-none d-lg-flex">
                <form class="shop-header-search" action="/shop/products" method="get">
                    <input class="form-control form-control-sm" type="search" name="q" placeholder="상품 검색" value="<%= q %>">
                </form>

                <a class="shop-tool-link <%= isWishlist ? 'is-active' : '' %>" href="<%= user ? '/shop/wishlist' : '/auth/login' %>">찜</a>

                <a class="shop-tool-link <%= isCart ? 'is-active' : '' %>" href="/shop/cart">
                    장바구니
                    <% if (safeCartCount > 0) { %>
                        <span class="shop-cart-badge"><%= safeCartCount %></span>
                    <% } %>
                </a>

                <% if (user) { %>
                    <a class="shop-tool-link <%= isAccount ? 'is-active' : '' %>" href="/shop/account"><%= user.name %></a>
                    <a class="shop-auth-link" href="/auth/logout">로그아웃</a>
                <% } else { %>
                    <a class="shop-auth-link" href="/auth/login">로그인</a>
                    <a class="shop-cta-btn" href="/auth/register">무료시작</a>
                <% } %>
            </div>
        </div>

        <div class="collapse shop-mobile-nav d-lg-none" id="shopMobileNav">
            <div class="container py-3">
                <form class="shop-mobile-search" action="/shop/products" method="get">
                    <input class="form-control" type="search" name="q" placeholder="상품 검색" value="<%= q %>">
                    <button class="btn btn-dark" type="submit">검색</button>
                </form>

                <div class="shop-mobile-nav-grid">
                    <a class="<%= isHome ? 'is-active' : '' %>" href="/shop">기획전</a>
                    <a class="<%= isProducts ? 'is-active' : '' %>" href="/shop/products">카테고리</a>
                    <a class="<%= isSupport ? 'is-active' : '' %>" href="/shop/orders/guest">주문조회</a>
                    <a class="<%= isSupport ? 'is-active' : '' %>" href="/shop/inquiries/guest">문의조회</a>
                    <a class="<%= isSupport ? 'is-active' : '' %>" href="/shop/inquiries">문의하기</a>
                    <a class="<%= isCart ? 'is-active' : '' %>" href="/shop/cart">장바구니<% if (safeCartCount > 0) { %> (<%= safeCartCount %>)<% } %></a>
                    <% if (user) { %>
                        <a class="<%= isAccount ? 'is-active' : '' %>" href="/shop/account">내정보</a>
                        <a class="<%= isWishlist ? 'is-active' : '' %>" href="/shop/wishlist">찜한상품</a>
                        <a href="/auth/logout">로그아웃</a>
                    <% } else { %>
                        <a href="/auth/login">로그인</a>
                        <a href="/auth/register">회원가입</a>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <main class="<%= isHome ? 'shop-main shop-main-home' : 'container py-4 shop-main' %>">
