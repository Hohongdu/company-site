<% const pageTitle = (typeof title !== 'undefined' && title) ? title + ' | ENERMADE Shop' : 'ENERMADE Shop'; %>
<% const activeKey = (typeof active !== 'undefined' && active) ? active : ''; %>
<% const q = (typeof query !== 'undefined' && query) ? query : ''; %>
<% const isHome = activeKey === 'home' || currentPath === '/shop' || currentPath === '/shop/'; %>
<% const isProducts = activeKey === 'products' || currentPath.indexOf('/shop/products') === 0; %>
<% const isCart = activeKey === 'cart' || currentPath === '/shop/cart'; %>
<% const isAccount = activeKey === 'account' || currentPath.indexOf('/shop/account') === 0; %>
<% const isWishlist = activeKey === 'wishlist'; %>
<% const isInquiry = activeKey === 'inquiry' || currentPath.indexOf('/shop/inquiries') === 0; %>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/shop.css">
</head>
<body class="shop-wrap">

<!-- ── Shop Header ── -->
<header class="shop-header">
  <div class="container">
    <div class="shop-header-inner">
      <!-- Logo -->
      <a href="/shop" class="shop-logo">
        <div class="shop-logo-mark">EN</div>
        <span class="shop-logo-name">ERMADE</span>
        <span class="shop-logo-sep">/</span>
        <span class="shop-logo-sub">Shop</span>
      </a>

      <!-- Desktop nav -->
      <nav class="shop-nav-links">
        <a href="/shop" class="<%= isHome ? 'active' : '' %>">홈</a>
        <a href="/shop/products" class="<%= isProducts ? 'active' : '' %>">전체상품</a>
        <a href="/shop/inquiries" class="<%= isInquiry ? 'active' : '' %>">문의하기</a>
        <a href="/" style="color:inherit;">회사홈</a>
      </nav>

      <!-- Tools -->
      <div class="shop-tools">
        <!-- Desktop search -->
        <form class="shop-search-form" action="/shop/products" method="get">
          <input class="shop-search-input" type="text" name="q" value="<%= q %>" placeholder="상품 검색...">
          <button class="shop-search-btn" type="submit">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </button>
        </form>

        <!-- Wishlist -->
        <% if (user) { %>
          <a href="/shop/wishlist" class="shop-tool-btn <%= isWishlist ? 'active' : '' %>" title="찜 목록">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          </a>
        <% } %>

        <!-- Account -->
        <% if (user) { %>
          <a href="/shop/account" class="shop-tool-btn <%= isAccount ? 'active' : '' %>" title="마이페이지">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          </a>
        <% } else { %>
          <a href="/auth/login" class="shop-cta-btn">로그인</a>
          <a href="/auth/register" class="shop-cta-btn" style="background:transparent;border:1.5px solid var(--c-border);color:var(--c-text);">회원가입</a>
        <% } %>

        <!-- Cart -->
        <a href="/shop/cart" class="shop-tool-btn <%= isCart ? 'active' : '' %>" title="장바구니">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/></svg>
          <% if (cartCount > 0) { %><span class="shop-cart-badge"><%= cartCount %></span><% } %>
        </a>

        <!-- Mobile toggle -->
        <button class="shop-nav-toggle" id="shopNavToggle" aria-label="메뉴">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile nav -->
<div class="shop-mobile-nav" id="shopMobileNav">
  <div class="container">
    <form class="shop-mobile-search" action="/shop/products" method="get">
      <input class="shop-search-input" type="text" name="q" value="<%= q %>" placeholder="상품 검색...">
      <button class="btn btn-primary btn-sm" type="submit">검색</button>
    </form>
    <div class="shop-mobile-grid">
      <a href="/shop" class="<%= isHome ? 'active' : '' %>"><span class="icon">🏠</span>홈</a>
      <a href="/shop/products" class="<%= isProducts ? 'active' : '' %>"><span class="icon">📦</span>상품</a>
      <a href="/shop/cart" class="<%= isCart ? 'active' : '' %>">
        <span class="icon">🛒</span>장바구니<% if (cartCount > 0) { %>&nbsp;<%= cartCount %><% } %>
      </a>
      <% if (user) { %>
        <a href="/shop/account" class="<%= isAccount ? 'active' : '' %>"><span class="icon">👤</span>마이페이지</a>
        <a href="/shop/wishlist" class="<%= isWishlist ? 'active' : '' %>"><span class="icon">❤️</span>찜 목록</a>
      <% } else { %>
        <a href="/auth/login"><span class="icon">🔑</span>로그인</a>
        <a href="/auth/register"><span class="icon">✏️</span>회원가입</a>
      <% } %>
      <a href="/shop/inquiries" class="<%= isInquiry ? 'active' : '' %>"><span class="icon">💬</span>문의하기</a>
    </div>
  </div>
</div>

<!-- Page main -->
<div class="shop-main <%= isHome ? 'shop-main-home' : '' %>">
  <div class="container">
