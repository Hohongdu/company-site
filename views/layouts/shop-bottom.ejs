<script>
(function() {
  const toggle = document.getElementById('shopNavToggle');
  const mobileNav = document.getElementById('shopMobileNav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', function() {
      const open = mobileNav.classList.toggle('open');
      document.body.style.overflow = open ? 'hidden' : '';
    });
  }
})();
