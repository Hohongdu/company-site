  .app-biz-grid > div { display: flex; gap: 8px; min-width: 0; }
  .app-biz-grid dt { flex: 0 0 84px; color: #888; font-weight: 500; }
  .app-biz-grid dd { margin: 0; flex: 1; word-break: keep-all; }
  .app-biz-legal { display: flex; gap: 8px; align-items: center; padding: 8px 0; }
