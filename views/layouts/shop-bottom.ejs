<!-- ─────────────────────────────────────────────
   앱 공통 JS — 바텀시트 열기/닫기
   페이지별 시트는 각 페이지 인라인 스크립트에서 초기화
   ───────────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  /* 바텀시트 공개 API — 페이지에서 window.AppSheet.open/close 로 호출 가능 */
  window.AppSheet = {
    open: function (sheetId, overlayId) {
      var sheet   = document.getElementById(sheetId);
      var overlay = document.getElementById(overlayId);
      if (sheet)   sheet.classList.add('is-open');
      if (overlay) overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    },
    close: function (sheetId, overlayId) {
      var sheet   = document.getElementById(sheetId);
      var overlay = document.getElementById(overlayId);
      if (sheet)   sheet.classList.remove('is-open');
      if (overlay) overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  };

  /* 바텀시트 — data 속성 기반 자동 바인딩
     [data-sheet-open="sheetId"]  클릭 시 열기
     [data-sheet-close]            클릭 시 닫기
     [data-sheet-overlay]          오버레이 클릭 시 닫기                */
  document.addEventListener('click', function (e) {
    /* 열기 */
    var openTarget = e.target.closest('[data-sheet-open]');
    if (openTarget) {
      var sid = openTarget.getAttribute('data-sheet-open');
      var oid = openTarget.getAttribute('data-sheet-overlay') || 'appSheetOverlay';
      window.AppSheet.open(sid, oid);
      return;
    }
    /* 닫기 버튼 */
    var closeTarget = e.target.closest('[data-sheet-close]');
    if (closeTarget) {
      var sheet = closeTarget.closest('.app-sheet');
      if (sheet) {
        sheet.classList.remove('is-open');
        document.querySelectorAll('.app-sheet-overlay.is-open').forEach(function (o) {
          o.classList.remove('is-open');
        });
        document.body.style.overflow = '';
      }
      return;
    }
    /* 오버레이 클릭 닫기 */
    if (e.target.classList.contains('app-sheet-overlay')) {
      e.target.classList.remove('is-open');
      document.querySelectorAll('.app-sheet.is-open').forEach(function (s) {
        s.classList.remove('is-open');
      });
      document.body.style.overflow = '';
    }
  });

  /* 수량 조절 공통 핸들러 (+/-버튼)
     data-qty-target="inputId" 를 가진 버튼 */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-qty-inc],[data-qty-dec]');
    if (!btn) return;
    var targetId = btn.getAttribute('data-qty-inc') || btn.getAttribute('data-qty-dec');
    var input = targetId
      ? document.getElementById(targetId)
      : btn.closest('.app-qty, .app-cart-qty')?.querySelector('input');
    if (!input) return;
    var val = parseInt(input.value) || 1;
    var min = parseInt(input.min) || 1;
    if (btn.hasAttribute('data-qty-inc')) input.value = val + 1;
    if (btn.hasAttribute('data-qty-dec')) input.value = Math.max(min, val - 1);
    /* 커스텀 이벤트 발생 — 장바구니 실시간 합계 업데이트에 활용 */
    input.dispatchEvent(new Event('change', { bubbles: true }));
  });

})();
</script>

</body>
</html>
