<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>window.__SITE_USER_IS_ADMIN = <%- (user && user.is_admin) ? 'true' : 'false' %>;</script>
<script src="/js/main.js"></script>
<script src="/js/company.js"></script>
<script>
(function () {
  /* Navbar scroll shadow */
  const nav = document.getElementById('mainNav');
  if (nav) {
    window.addEventListener('scroll', function () {
      nav.classList.toggle('scrolled', window.scrollY > 8);
    }, { passive: true });
  }

  /* Mobile slide drawer */
  const ham      = document.getElementById('navHamburger');
  const drawer   = document.getElementById('mobDrawer');
  const backdrop = document.getElementById('mobDrawerBackdrop');
  const closeBtn = document.getElementById('mobDrawerClose');

  function openDrawer() {
    if (!drawer) return;
    drawer.inert = false;
    drawer.classList.add('open');
    drawer.scrollTop = 0;
    backdrop && backdrop.classList.add('open');
    ham && ham.classList.add('open');
    ham && ham.setAttribute('aria-label', '메뉴 닫기');
    ham && ham.setAttribute('aria-expanded', 'true');
    closeBtn?.focus({ preventScroll: true });
  }
  function closeDrawer(restoreFocus = false) {
    if (!drawer?.classList.contains('open')) return;
    drawer.classList.remove('open');
    drawer.inert = true;
    backdrop && backdrop.classList.remove('open');
    ham && ham.classList.remove('open');
    ham && ham.setAttribute('aria-label', '메뉴 열기');
    ham && ham.setAttribute('aria-expanded', 'false');
    if (restoreFocus) ham?.focus({ preventScroll: true });
  }

  ham      && ham.addEventListener('click', function () {
    drawer && drawer.classList.contains('open') ? closeDrawer(true) : openDrawer();
  });
  closeBtn?.addEventListener('click', () => closeDrawer(true));
  backdrop?.addEventListener('click', () => closeDrawer(true));
  drawer?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const controls = drawer.querySelectorAll('a[href], button:not([disabled])');
    const first = controls[0];
    const last = controls[controls.length - 1];
    if (document.activeElement !== (event.shiftKey ? first : last)) return;
    event.preventDefault();
    (event.shiftKey ? last : first).focus();
  });

  // 웹 전환시 사이드바 닫기
  window.addEventListener('resize', function () {
    if (window.innerWidth >= 992) closeDrawer();
  });

  /* Login overlay */
  const overlay = document.getElementById('loginOverlay');
  const loginCloseBtn = document.getElementById('loginClose');
  if (!overlay) return;

  let loginTrigger;
  function openLogin(trigger) {
    loginTrigger = drawer?.contains(trigger) ? ham : trigger;
    closeDrawer();
    overlay.classList.add('open');
    overlay.querySelector('input[name="email"]')?.focus({ preventScroll: true });
  }
  function closeLogin() {
    if (!overlay.classList.contains('open')) return;
    overlay.classList.remove('open');
    loginTrigger?.focus({ preventScroll: true });
  }

  document.querySelectorAll('.js-open-login').forEach(function (el) {
    el.addEventListener('click', function (e) { e.preventDefault(); openLogin(el); });
  });
  if (loginCloseBtn) loginCloseBtn.addEventListener('click', closeLogin);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeLogin(); });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (overlay.classList.contains('open')) closeLogin();
    else closeDrawer(true);
  });

})();
</script>
</body>
</html>
