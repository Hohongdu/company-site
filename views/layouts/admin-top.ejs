<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'ADMIN' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %> | Admin
        </title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/styles/tokens.css" />
        <!-- main.css: CSS 변수(다크모드 토큰 포함) + 다크 위젯 CSS 제공 -->
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/css/admin.css" />

        <style>
            .ellipsis {
                max-width: 140px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .navbtn {
                white-space: nowrap;
            }
        </style>
    </head>

    <body class="admin-wrap bg-light">
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
            <div class="container py-2">

                <!-- 왼쪽: 로고 -->
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-primary">ADMIN</span>
                    <a class="navbar-brand fw-bold m-0" href="/admin/dashboard">Console</a>
                </div>

                <!-- 모바일 로그인/로그아웃 + 햄버거 (아이콘으로 텍스트 깨짐 방지) -->
                <div class="ms-auto d-flex align-items-center gap-2 d-lg-none">
                    <% if (user) { %>
                        <a class="btn btn-outline-secondary btn-sm" href="/auth/logout" title="로그아웃" aria-label="로그아웃">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-2px;">
                              <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    <% } else { %>
                        <a class="btn btn-outline-secondary btn-sm" href="/auth/login" title="로그인" aria-label="로그인">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-2px;">
                              <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    <% } %>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="adminNav">

                    <!-- 데스크탑: 우측 버튼 모음 -->
                    <div class="ms-lg-auto d-none d-lg-flex align-items-center gap-2">

                        <a class="btn btn-sm navbtn <%= activeKey==='dashboard' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/admin/dashboard">대시보드</a>
                            <a class="btn btn-sm navbtn <%= activeKey==='products' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/admin/products">상품</a>
                            <a class="btn btn-sm navbtn <%= activeKey==='categories' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/admin/categories">카테고리</a>
                            <a class="btn btn-sm navbtn <%= activeKey==='import' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/admin/products/import">대량 등록</a>
                                <a class="btn btn-sm navbtn <%= activeKey==='orders' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/orders">주문</a>
                                <a class="btn btn-sm navbtn <%= activeKey==='inquiries' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/inquiries">문의</a>

                                <a class="btn btn-sm btn-outline-secondary navbtn" href="/">사이트</a>
                                <a class="btn btn-sm btn-outline-secondary navbtn" href="/shop">상품몰</a>

                                    <% if (typeof backUrl !=='undefined' && backUrl) { %>
                                        <a class="btn btn-sm btn-outline-secondary navbtn"
                                            href="<%= backUrl %>">이전</a>
                                        <% } %>

                                            <div class="vr mx-2"></div>

                                            <% if (user) { %>
                                                <span class="small text-muted ellipsis">
                                                    <strong>
                                                        <%= user.name %>
                                                    </strong>
                                                </span>
                                                <a class="btn btn-outline-secondary btn-sm navbtn"
                                                    href="/auth/logout">로그아웃</a>
                                                <% } else { %>
                                                    <a class="btn btn-outline-secondary btn-sm navbtn"
                                                        href="/auth/login">로그인</a>
                                                        <% } %>
                    </div>

                    <!-- 모바일 전체 버튼 목록 -->
                    <div class="d-lg-none mt-2">
                        <div class="d-grid gap-2">
                            <a class="btn <%= activeKey==='dashboard' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/admin/dashboard">대시보드</a>
                                <a class="btn <%= activeKey==='products' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/products">상품</a>
                                <a class="btn <%= activeKey==='categories' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/categories">카테고리</a>
                                <a class="btn <%= activeKey==='import' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/products/import">대량 등록</a>
                                    <a class="btn <%= activeKey==='orders' ? 'btn-primary' : 'btn-outline-primary' %>"
                                        href="/admin/orders">주문</a>
                                    <a class="btn <%= activeKey==='inquiries' ? 'btn-primary' : 'btn-outline-primary' %>"
                                        href="/admin/inquiries">문의</a>

                                    <a class="btn btn-outline-secondary" href="/">사이트</a>
                                    <a class="btn btn-outline-secondary" href="/shop">상품몰</a>

                                        <% if (typeof backUrl !=='undefined' && backUrl) { %>
                                            <a class="btn btn-outline-secondary" href="<%= backUrl %>">이전</a>
                                            <% } %>
                        </div>
                    </div>

                </div>
            </div>
        </nav>

        <main class="container py-4">
