<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'ADMIN' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %> | Admin
        </title>

        <!-- Bootstrap CDN (가장 안정적) -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        <!-- Admin 전용 CSS -->
        <link rel="stylesheet" href="/css/admin.css" />
    </head>

    <body class="admin-wrap bg-light">
        <header class="border-bottom bg-white sticky-top">
            <div class="container py-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <span class="badge text-bg-primary">ADMIN</span>
                        <a class="text-decoration-none fw-bold text-dark" href="/admin">Console</a>
                    </div>

                    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap justify-content-end">
                        <button class="btn btn-outline-dark btn-sm d-md-none" type="button" data-bs-toggle="collapse"
                            data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false"
                            aria-label="관리자 메뉴 열기">
                            ☰
                        </button>
                        <!-- 상단 빠른 이동 -->
                        <a class="btn btn-outline-secondary btn-sm" href="/">회사</a>
                        <a class="btn btn-outline-primary btn-sm" href="/shop">상품몰</a>

                        <!-- 유저명: 길어도 깨지지 않게 -->
                        <% if (user) { %>
                            <span class="small text-muted d-none d-sm-inline-block"
                                style="max-width:180px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                <strong>
                                    <%= user.name %>
                                </strong> 님
                            </span>
                            <a class="btn btn-outline-dark btn-sm" href="/auth/logout">로그아웃</a>
                            <% } else { %>
                                <a class="btn btn-outline-dark btn-sm"
                                    href="/auth/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>">로그인</a>
                                <% } %>
                    </div>
                </div>

                <!-- 관리자 메뉴 -->
                <nav class="collapse d-md-block mt-2" id="adminNav">
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm <%= activeKey==='dashboard' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/admin/dashboard">대시보드</a>
                        <a class="btn btn-sm <%= activeKey==='products' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/admin/products">상품</a>
                        <a class="btn btn-sm <%= activeKey==='categories' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/admin/categories">카테고리</a>
                        <a class="btn btn-sm <%= activeKey==='import' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/admin/products/import">엑셀 업로드</a>

                        <div class="ms-auto d-flex gap-2 flex-wrap">
                            <% if (typeof backUrl !=='undefined' && backUrl) { %>
                                <a class="btn btn-sm btn-outline-secondary" href="<%= backUrl %>">← 이전으로</a>
                                <% } %>
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <main class="container py-4">
