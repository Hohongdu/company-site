                                <a class="btn btn-sm navbtn <%= activeKey==='orders' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/orders">二쇰Ц</a>
                                <a class="btn btn-sm navbtn <%= activeKey==='inquiries' ? 'btn-primary' : 'btn-outline-primary' %>"
                                    href="/admin/inquiries">臾몄쓽</a>

                                <a class="btn btn-sm btn-outline-secondary navbtn" href="/">?뚯궗</a>
                                <a class="btn btn-sm btn-outline-secondary navbtn" href="/shop">?곹뭹紐?/a>

                                    <% if (typeof backUrl !=='undefined' && backUrl) { %>
                                        <a class="btn btn-sm btn-outline-secondary navbtn"
                                            href="<%= backUrl %>">???댁쟾</a>
                                        <% } %>

                                            <div class="vr mx-2"></div>

                                            <% if (user) { %>
                                                <span class="small text-muted ellipsis">
                                                    <strong>
                                                        <%= user.name %>
                                                    </strong>
                                                </span>
                                                <a class="btn btn-outline-secondary btn-sm navbtn"
                                                    href="/auth/logout">濡쒓렇?꾩썐</a>
                                                <% } else { %>
                                                    <a class="btn btn-outline-secondary btn-sm navbtn"
                                                        href="/auth/login">濡쒓렇??/a>
                                                        <% } %>
                    </div>

