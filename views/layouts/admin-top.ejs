<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'ADMIN' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %> | Admin
        </title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/styles/tokens.css" />

        <link rel="stylesheet" href="/css/admin.css" />

        <style>
            .ellipsis {
                max-width: 140px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .navbtn {
                white-space: nowrap;
            }
        </style>
    </head>

    <body class="admin-wrap bg-light">
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
            <div class="container py-2">

                <!-- ?쇱そ: 濡쒓퀬 -->
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-primary">ADMIN</span>
                    <a class="navbar-brand fw-bold m-0" href="/admin/dashboard">Console</a>
                </div>

                <!-- 紐⑤컮?? ?대쫫/濡쒓렇?꾩썐(or 濡쒓렇?? + ?꾨쾭嫄?-->
                <div class="ms-auto d-flex align-items-center gap-2 d-lg-none">
                    <% if (user) { %>
                        <a class="btn btn-outline-secondary btn-sm navbtn" href="/auth/logout">濡쒓렇?꾩썐</a>
                        <% } else { %>
                            <a class="btn btn-outline-secondary btn-sm navbtn" href="/auth/login">濡쒓렇??/a>
                                <% } %>

                                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#adminNav">
                                        <span class="navbar-toggler-icon"></span>
                                    </button>
                </div>

                <div class="collapse navbar-collapse" id="adminNav">

                    <!-- ?곗뒪?ы깙: ?ㅻⅨ履?踰꾪듉 臾띠쓬 -->
                    <div class="ms-lg-auto d-none d-lg-flex align-items-center gap-2">

                        <a class="btn btn-sm navbtn <%= activeKey==='dashboard' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/admin/dashboard">??쒕낫??/a>
                            <a class="btn btn-sm navbtn <%= activeKey==='products' ? 'btn-primary' : 'btn-outline-primary' %>"
