<% const pageTitle=(typeof title !=='undefined' && title) ? title : '우리 회사' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %>
        </title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/css/style.css" />

        <style>
            .ellipsis {
                max-width: 140px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .navbtn {
                white-space: nowrap;
            }
        </style>
    </head>

    <body class="bg-white">
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
            <div class="container py-2">

                <!-- 왼쪽: 로고 -->
                <a class="navbar-brand fw-bold m-0" href="/">우리 회사</a>

                <!-- 모바일: 이름/로그아웃 or 로그인/회원가입 + 햄버거 -->
                <div class="ms-auto d-flex align-items-center gap-2 d-lg-none">
                    <% if (user) { %>
                        <a class="btn btn-outline-secondary btn-sm navbtn" href="/auth/logout">로그아웃</a>
                        <% } else { %>
                            <a class="btn btn-outline-secondary btn-sm navbtn" href="/auth/login">로그인</a>
                            <a class="btn btn-primary btn-sm navbtn" href="/auth/register">회원가입</a>
                            <% } %>

                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#companyNav">
                                    <span class="navbar-toggler-icon"></span>
                                </button>
                </div>

                <div class="collapse navbar-collapse" id="companyNav">

                    <!-- 데스크탑: 오른쪽 버튼 묶음 -->
                    <div class="ms-lg-auto d-none d-lg-flex align-items-center gap-2">
                        <a class="btn btn-sm navbtn <%= activeKey==='home' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/">홈</a>
                        <a class="btn btn-sm navbtn <%= activeKey==='about' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/about">회사 소개</a>
                        <a class="btn btn-sm navbtn <%= activeKey==='contact' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/contact">문의하기</a>

                        <a class="btn btn-sm btn-outline-dark navbtn" href="/shop">상품몰</a>

                        <% if (user && user.is_admin) { %>
                            <a class="btn btn-sm btn-outline-dark navbtn" href="/admin/dashboard">관리자</a>
                            <% } %>

                                <div class="vr mx-2"></div>

                                <% if (user) { %>
                                    <span class="small text-muted ellipsis">
                                        <strong>
                                            <%= user.name %>
                                        </strong>
                                    </span>
                                    <a class="btn btn-outline-secondary btn-sm navbtn" href="/auth/logout">로그아웃</a>
                                    <% } else { %>
                                        <a class="btn btn-outline-secondary btn-sm navbtn" href="/auth/login">로그인</a>
                                        <a class="btn btn-primary btn-sm navbtn" href="/auth/register">회원가입</a>
                                        <% } %>
                    </div>

                    <!-- 모바일: 긴 버튼 메뉴 -->
                    <div class="d-lg-none mt-2">
                        <div class="d-grid gap-2">
                            <a class="btn <%= activeKey==='home' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/">홈</a>
                            <a class="btn <%= activeKey==='about' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/about">회사 소개</a>
                            <a class="btn <%= activeKey==='contact' ? 'btn-primary' : 'btn-outline-primary' %>"
                                href="/contact">문의하기</a>

                            <a class="btn btn-outline-dark" href="/shop">상품몰</a>

                            <% if (user && user.is_admin) { %>
                                <a class="btn btn-outline-dark" href="/admin/dashboard">관리자</a>
                                <% } %>
                        </div>
                    </div>

                </div>
            </div>
        </nav>

        <main>