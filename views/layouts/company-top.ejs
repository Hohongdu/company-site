<% const pageTitle=(typeof title !=='undefined' && title) ? title+' | ENERMADE' : 'ENERMADE'; %>
<% const activeKey=(typeof active !=='undefined' && active) ? active : ''; %>
<% const returnTo=(typeof currentUrl !=='undefined' && currentUrl) ? currentUrl : (typeof currentPath !=='undefined' ? currentPath : '/'); %>
<% const csrfTokenValue=(typeof csrfToken !=='undefined' && csrfToken) ? csrfToken : ''; %>
<% const isLoggedIn=!!user; %>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="ENERMADE — 20년 이상의 기술력을 바탕으로 고성능 세라믹 소재를 생산하는 전문 제조기업입니다.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/company.css">
</head>
<body>

<!-- ── Navigation ── -->
<nav class="site-nav" id="siteNav">
  <div class="container">
    <div class="nav-inner">
      <!-- Logo -->
      <a href="/" class="nav-logo">
        <div class="nav-logo-mark">EN</div>
        <span class="nav-logo-text">ERMADE</span>
      </a>

      <!-- Desktop Links -->
      <nav class="nav-links">
        <a href="/" class="<%= activeKey==='home' ? 'active' : '' %>">홈</a>
        <a href="/about" class="<%= activeKey==='about' ? 'active' : '' %>">회사소개</a>
        <a href="/history" class="<%= activeKey==='history' ? 'active' : '' %>">연혁</a>
        <a href="/notices" class="<%= activeKey==='notices' ? 'active' : '' %>">공지사항</a>
        <a href="/contact" class="<%= activeKey==='contact' ? 'active' : '' %>">문의하기</a>
        <a href="/shop">쇼핑몰</a>
      </nav>

      <!-- Actions -->
      <div class="nav-actions">
        <% if (isLoggedIn) { %>
          <span class="nav-user-btn" style="cursor:default;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <%= user.name || user.email %>
          </span>
          <% if (user.is_admin) { %>
            <a href="/admin" class="nav-user-btn">관리자</a>
          <% } %>
          <a href="/auth/logout" class="btn btn-sm btn-outline">로그아웃</a>
        <% } else { %>
          <a href="/auth/login?return=<%= encodeURIComponent(returnTo) %>" class="btn btn-sm btn-outline">로그인</a>
          <a href="/auth/register" class="btn btn-sm btn-primary">회원가입</a>
        <% } %>
        <!-- Cart -->
        <a href="/shop/cart" class="nav-cart-btn" title="장바구니">
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/></svg>
          <% if (cartCount > 0) { %>
            <span class="nav-cart-badge"><%= cartCount %></span>
          <% } %>
        </a>
        <!-- Mobile toggle -->
        <button class="nav-toggle" id="navToggle" aria-label="메뉴">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-nav" id="mobileNav">
  <a href="/" class="mobile-nav-link <%= activeKey==='home' ? 'active' : '' %>">홈</a>
  <a href="/about" class="mobile-nav-link <%= activeKey==='about' ? 'active' : '' %>">회사소개</a>
  <a href="/history" class="mobile-nav-link <%= activeKey==='history' ? 'active' : '' %>">연혁</a>
  <a href="/notices" class="mobile-nav-link <%= activeKey==='notices' ? 'active' : '' %>">공지사항</a>
  <a href="/contact" class="mobile-nav-link <%= activeKey==='contact' ? 'active' : '' %>">문의하기</a>
  <a href="/shop" class="mobile-nav-link">쇼핑몰</a>
  <div class="mobile-nav-actions">
    <% if (isLoggedIn) { %>
      <a href="/auth/logout" class="btn btn-sm btn-outline w-100">로그아웃</a>
    <% } else { %>
      <a href="/auth/login" class="btn btn-sm btn-outline" style="flex:1;">로그인</a>
      <a href="/auth/register" class="btn btn-sm btn-primary" style="flex:1;">회원가입</a>
    <% } %>
  </div>
</div>

<!-- Page content begins -->
<main>
