<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'CERAMIC PRO' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; const returnTo=(typeof currentUrl !=='undefined' && currentUrl) ?
    currentUrl : (typeof currentPath !=='undefined' ? currentPath : '/' ); const isLoggedIn=!!user; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %>
        </title>

        <!-- Bootstrap is kept for forms + existing pages, but this layout is mostly custom CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/css/company.css" />
    </head>

    <body>
        <header class="site-header">
            <div class="container-wide">
                <div class="header-inner">
                    <!-- Mobile: hamburger -->
                    <button class="hamburger" id="btnDrawerOpen" aria-label="메뉴 열기">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" />
                        </svg>
                    </button>

                    <!-- Brand -->
                    <a class="brand" href="/">
                        ENERMADE
                    </a>

                    <!-- Desktop center nav -->
                    <nav class="nav-center" aria-label="주요 메뉴">
                        <a href="/" class="<%= activeKey==='home' ? 'active' : '' %>">홈</a>
                        <a href="/shop" class="<%= activeKey==='products' ? 'active' : '' %>">제품</a>
                        <a href="/contact" class="<%= activeKey==='contact' ? 'active' : '' %>">문의</a>
                    </nav>

                    <!-- Actions -->
                    <div class="header-actions">
                        <!-- Mobile quick icon: cart -->
                        <a class="icon-btn d-inline-flex d-lg-none position-relative" href="/shop/cart"
                            aria-label="장바구니">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M6 7h15l-2 10H8L6 7Z" stroke="currentColor" stroke-width="2"
                                    stroke-linejoin="round" />
                                <path d="M6 7 5 4H2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                <circle cx="9" cy="20" r="1.5" fill="currentColor" />
                                <circle cx="18" cy="20" r="1.5" fill="currentColor" />
                            </svg>
                            <% if (cartCount && cartCount> 0) { %><span class="badge-dot" aria-hidden="true"></span>
                                <% } %>
                        </a>

                        <!-- User -->
                        <% if (isLoggedIn) { %>
                            <a class="icon-btn" href="/shop" aria-label="내 계정">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M20 21a8 8 0 0 0-16 0" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" />
                                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2" />
                                </svg>
                            </a>
                            <% } else { %>
                                <a class="icon-btn js-open-login"
                                    href="/auth/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>"
                                    aria-label="로그인">

                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M20 21a8 8 0 0 0-16 0" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" />
                                        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2" />
                                    </svg>
                                </a>
                                <% } %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Mobile Drawer -->
        <div class="drawer-backdrop" id="drawerBackdrop"></div>
        <aside class="drawer" id="drawer" aria-label="모바일 메뉴">
            <div class="drawer-top">
                <% if (!isLoggedIn) { %>
                    <div class="msg">
                        <span>로그인이 필요합니다.</span>
                        <a href="#" class="js-open-login">로그인</a>
                    </div>
                    <% } else { %>
                        <div class="msg">
                            <span>
                                <%= user.name %>님
                            </span>
                            <a href="/auth/logout">로그아웃</a>
                        </div>
                        <% } %>
                            <button class="drawer-close" id="btnDrawerClose" aria-label="메뉴 닫기">×</button>
            </div>
            <div class="drawer-list">
                <a class="drawer-item" href="/">홈</a>
                <a class="drawer-item" href="/shop">제품</a>
                <a class="drawer-item" href="/contact">문의</a>
            </div>
        </aside>

        <!-- Login Modal -->
        <div class="modal-backdrop2" id="loginBackdrop"></div>
        <div class="modal2" id="loginModal" role="dialog" aria-modal="true" aria-label="로그인">
            <div class="hd">
                <div class="title">로그인</div>
                <button class="x" id="btnLoginClose" aria-label="닫기">×</button>
            </div>
            <div class="bd">
                <form class="form2" method="post" action="/auth/login">
                    <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                    <div class="stack">
                        <input type="email" name="email" placeholder="이메일" autocomplete="email" required />
                        <input type="password" name="password" placeholder="비밀번호" autocomplete="current-password"
                            required />
                    </div>

                    <label class="keep">
                        <input type="checkbox" checked />
                        로그인상태유지
                    </label>

                    <div class="actions">
                        <button class="btn-login" type="submit">로그인</button>
                        <a class="btn-secondary text-center" href="/shop/orders/guest">비회원 주문배송 조회</a>
                    </div>

                    <div class="row">
                        <a href="/auth/register">회원가입</a>
                        <a href="/auth/login">아이디 · 비밀번호 찾기</a>
                    </div>
                </form>
            </div>
        </div>

        <main>
