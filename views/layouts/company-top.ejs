<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'CERAMIC PRO' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; const returnTo=(typeof currentUrl !=='undefined' && currentUrl) ?
    currentUrl : (typeof currentPath !=='undefined' ? currentPath : '/' ); const csrfTokenValue=(typeof csrfToken
    !=='undefined' && csrfToken) ? csrfToken : '' ; const isLoggedIn=!!user; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %>
        </title>

        <!-- Bootstrap is kept for forms + existing pages, but this layout is mostly custom CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/css/company.css" />
    </head>

    <body>
        <header class="site-header">
            <div class="container-wide">
                <div class="header-inner">
                    <!-- Mobile: hamburger -->
                    <button class="hamburger" id="btnDrawerOpen" aria-label="메뉴 열기">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" />
                        </svg>
                    </button>

                    <!-- Brand -->
                    <a class="brand" href="/">
                        ENERMADE
                    </a>

                    <!-- Desktop center nav -->
                    <nav class="nav-center" aria-label="주요 메뉴">
                        <a href="/" class="<%= activeKey==='home' ? 'active' : '' %>" data-i18n
                            data-i18n-ko="홈" data-i18n-en="Home" data-i18n-zh="首页" data-i18n-ja="ホーム">홈</a>
                        <a href="/about" class="<%= activeKey==='about' ? 'active' : '' %>" data-i18n
                            data-i18n-ko="회사 소개" data-i18n-en="About" data-i18n-zh="公司介绍" data-i18n-ja="会社紹介">회사 소개</a>
                        <a href="/history" class="<%= activeKey==='history' ? 'active' : '' %>" data-i18n
                            data-i18n-ko="연혁" data-i18n-en="History" data-i18n-zh="沿革" data-i18n-ja="沿革">연혁</a>
                        <a href="/notices" class="<%= activeKey==='notices' ? 'active' : '' %>" data-i18n
                            data-i18n-ko="공지" data-i18n-en="Notices" data-i18n-zh="公告" data-i18n-ja="お知らせ">공지</a>
                        <a href="/contact" class="<%= activeKey==='contact' ? 'active' : '' %>" data-i18n
                            data-i18n-ko="문의" data-i18n-en="Contact" data-i18n-zh="咨询" data-i18n-ja="お問い合わせ">문의</a>
                    </nav>

                    <!-- Actions -->
                    <div class="header-actions">
                        <div class="dropdown">
                            <button class="icon-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false" aria-label="언어 변경">
                                🌐
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button class="dropdown-item" type="button" data-lang-switch="ko">한국어</button></li>
                                <li><button class="dropdown-item" type="button" data-lang-switch="en">English</button></li>
                                <li><button class="dropdown-item" type="button" data-lang-switch="zh">中文</button></li>
                                <li><button class="dropdown-item" type="button" data-lang-switch="ja">日本語</button></li>
                            </ul>
                        </div>
                        <!-- User -->
                        <a class="icon-btn" href="/shop" aria-label="제품">
                            🛒
                        </a>
                        <% if (isLoggedIn) { %>
                            <a class="icon-btn" href="/account" aria-label="내 계정">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M20 21a8 8 0 0 0-16 0" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" />
                                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2" />
                                </svg>
                            </a>
                            <% if (user && user.is_admin) { %>
                                <a class="icon-btn" href="/admin/dashboard" aria-label="관리자">
                                    🛠️
                                </a>
                                <% } %>
                            <% } else { %>
                                <a class="icon-btn js-open-login"
                                    href="/auth/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>"
                                    aria-label="로그인">

                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M20 21a8 8 0 0 0-16 0" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" />
                                        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2" />
                                    </svg>
                                </a>
                                <% } %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Mobile Drawer -->
        <div class="drawer-backdrop" id="drawerBackdrop"></div>
        <aside class="drawer" id="drawer" aria-label="모바일 메뉴">
            <div class="drawer-top">
                <% if (!isLoggedIn) { %>
                    <div class="msg">
                        <span data-i18n data-i18n-ko="로그인이 필요합니다." data-i18n-en="Login is required."
                            data-i18n-zh="需要登录。" data-i18n-ja="ログインが必要です。">로그인이 필요합니다.</span>
                        <a href="#" class="js-open-login" data-i18n data-i18n-ko="로그인" data-i18n-en="Login"
                            data-i18n-zh="登录" data-i18n-ja="ログイン">로그인</a>
                    </div>
                    <% } else { %>
                        <div class="msg">
                            <span>
                                <%= user.name %>님
                            </span>
                            <a href="/auth/logout">로그아웃</a>
                        </div>
                        <% } %>
                            <button class="drawer-close" id="btnDrawerClose" aria-label="메뉴 닫기">×</button>
            </div>
            <div class="drawer-list">
                <a class="drawer-item" href="/" data-i18n data-i18n-ko="홈" data-i18n-en="Home" data-i18n-zh="首页"
                    data-i18n-ja="ホーム">홈</a>
                <a class="drawer-item" href="/about" data-i18n data-i18n-ko="회사 소개" data-i18n-en="About"
                    data-i18n-zh="公司介绍" data-i18n-ja="会社紹介">회사 소개</a>
                <a class="drawer-item" href="/history" data-i18n data-i18n-ko="연혁" data-i18n-en="History"
                    data-i18n-zh="沿革" data-i18n-ja="沿革">연혁</a>
                <a class="drawer-item" href="/notices" data-i18n data-i18n-ko="공지" data-i18n-en="Notices"
                    data-i18n-zh="公告" data-i18n-ja="お知らせ">공지</a>
                <a class="drawer-item" href="/contact" data-i18n data-i18n-ko="문의" data-i18n-en="Contact"
                    data-i18n-zh="咨询" data-i18n-ja="お問い合わせ">문의</a>
            </div>
        </aside>

        <!-- Login Modal -->
        <div class="modal-backdrop2" id="loginBackdrop"></div>
        <div class="modal2" id="loginModal" role="dialog" aria-modal="true" aria-label="로그인">
            <div class="hd">
                <div class="title" data-i18n data-i18n-ko="로그인" data-i18n-en="Login" data-i18n-zh="登录"
                    data-i18n-ja="ログイン">로그인</div>
                <button class="x" id="btnLoginClose" aria-label="닫기">×</button>
            </div>
            <div class="bd">
                <p class="subtitle" data-i18n data-i18n-ko="계정으로 로그인하고 맞춤 서비스를 이용하세요."
                    data-i18n-en="Sign in to access personalized services."
                    data-i18n-zh="登录以使用个性化服务。" data-i18n-ja="ログインしてパーソナライズされたサービスをご利用ください。">
                    계정으로 로그인하고 맞춤 서비스를 이용하세요.
                </p>
                <form class="form2 login-form" method="post" action="/auth/login">
                    <input type="hidden" name="_csrf" value="<%= csrfTokenValue %>">
                    <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                    <div class="stack">
                        <input type="email" name="email" placeholder="이메일" autocomplete="email" required
                            data-i18n-placeholder data-i18n-placeholder-ko="이메일"
                            data-i18n-placeholder-en="Email" data-i18n-placeholder-zh="邮箱"
                            data-i18n-placeholder-ja="メール" />
                        <input type="password" name="password" placeholder="비밀번호" autocomplete="current-password"
                            data-i18n-placeholder data-i18n-placeholder-ko="비밀번호"
                            data-i18n-placeholder-en="Password" data-i18n-placeholder-zh="密码"
                            data-i18n-placeholder-ja="パスワード" required />
                    </div>

                    <div class="meta">
                        <label class="keep">
                            <input type="checkbox" checked />
                            <span data-i18n data-i18n-ko="로그인상태유지" data-i18n-en="Keep me logged in"
                                data-i18n-zh="保持登录" data-i18n-ja="ログイン状態を保持">로그인상태유지</span>
                        </label>
                        <a class="forgot" href="/auth/forgot" data-i18n data-i18n-ko="아이디 · 비밀번호 찾기"
                            data-i18n-en="Find ID/Password" data-i18n-zh="找回账号/密码"
                            data-i18n-ja="ID・パスワード検索">아이디 · 비밀번호 찾기</a>
                    </div>

                    <div class="actions">
                        <button class="btn-login" type="submit" data-i18n data-i18n-ko="로그인" data-i18n-en="Login"
                            data-i18n-zh="登录" data-i18n-ja="ログイン">로그인</button>
                        <a class="btn-secondary text-center" href="/shop/orders/guest" data-i18n
                            data-i18n-ko="비회원 주문배송 조회" data-i18n-en="Guest Order Lookup"
                            data-i18n-zh="访客订单查询" data-i18n-ja="ゲスト注文確認">비회원 주문배송 조회</a>
                    </div>

                    <div class="row">
                        <span class="note" data-i18n data-i18n-ko="아직 계정이 없으신가요?"
                            data-i18n-en="New here?" data-i18n-zh="还没有账号？"
                            data-i18n-ja="アカウントをお持ちでない方">아직 계정이 없으신가요?</span>
                        <a href="/auth/register" data-i18n data-i18n-ko="회원가입" data-i18n-en="Sign Up"
                            data-i18n-zh="注册" data-i18n-ja="会員登録">회원가입</a>
                    </div>
                </form>
            </div>
        </div>

        <main>
