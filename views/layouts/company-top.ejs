<% const pageTitle=(typeof title !=='undefined' && title) ? title : '우리 회사' ; const activeKey=(typeof active
    !=='undefined' && active) ? active : '' ; %>
    <!doctype html>
    <html lang="ko">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            <%= pageTitle %>
        </title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/css/style.css" />
    </head>

    <body class="bg-white">
        <header class="border-bottom bg-white sticky-top">
            <div class="container py-2">
                <div class="d-flex align-items-center">
                    <a class="navbar-brand fw-bold text-dark text-decoration-none" href="/">우리 회사</a>

                    <nav class="ms-3 d-none d-md-flex gap-2">
                        <a class="btn btn-sm <%= activeKey==='home' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/">홈</a>
                        <a class="btn btn-sm <%= activeKey==='about' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/about">회사 소개</a>
                        <a class="btn btn-sm <%= activeKey==='contact' ? 'btn-primary' : 'btn-outline-primary' %>"
                            href="/contact">문의하기</a>
                        <a class="btn btn-sm btn-outline-dark" href="/shop">상품몰</a>
                    </nav>

                    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap justify-content-end">
                        <% if (user) { %>
                            <span class="small text-muted d-none d-sm-inline-block"
                                style="max-width:160px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                <strong>
                                    <%= user.name %>
                                </strong> 님
                            </span>
                            <% if (user.is_admin) { %>
                                <a class="btn btn-sm btn-outline-dark" href="/admin">관리자</a>
                                <% } %>
                            <a class="btn btn-sm btn-outline-secondary" href="/auth/logout">로그아웃</a>
                            <% } else { %>
                                <a class="btn btn-sm btn-outline-secondary"
                                    href="/auth/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>">로그인</a>
                                <a class="btn btn-sm btn-primary" href="/auth/register">회원가입</a>
                                <% } %>

                                    <!-- 모바일 햄버거 -->
                                    <button class="btn btn-sm btn-outline-dark d-md-none" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#companyNav">
                                        ☰
                                    </button>
                    </div>
                </div>

                <div class="collapse d-md-none mt-2" id="companyNav">
                    <div class="d-grid gap-2">
                        <a class="btn btn-outline-primary btn-sm" href="/">홈</a>
                        <a class="btn btn-outline-primary btn-sm" href="/about">회사 소개</a>
                        <a class="btn btn-outline-primary btn-sm" href="/contact">문의하기</a>
                        <a class="btn btn-outline-dark btn-sm" href="/shop">상품몰</a>
                        <% if (user && user.is_admin) { %>
                            <a class="btn btn-outline-dark btn-sm" href="/admin">관리자</a>
                            <% } %>
                    </div>
                </div>
            </div>
        </header>

        <main>
