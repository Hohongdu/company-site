<% const pageTitle=(typeof title !=='undefined' && title) ? title : (typeof company !== 'undefined' ? company.name : 'ENERMADE'); %>
<% const activeKey=(typeof active !=='undefined' && active) ? active : ''; %>
<% const returnTo=(typeof currentUrl !=='undefined' && currentUrl) ? currentUrl : (typeof currentPath !=='undefined' ? currentPath : '/'); %>
<% const csrfTokenValue=(typeof csrfToken !=='undefined' && csrfToken) ? csrfToken : ''; %>
<% const isLoggedIn=!!user; %>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="고객 맞춤형 세라믹 솔루션 전문기업 <%= (typeof company !== 'undefined' && company) ? company.name : 'ENERMADE' %>" />
  <title><%= pageTitle %> | <%= (typeof company !== 'undefined' && company) ? company.name : 'ENERMADE' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/company.css" />
  <!-- favicon 없음으로 인한 404 콘솔 오류 방지 -->
  <link rel="icon" href="data:,">
</head>
<body class="company-site">

<a class="site-skip" href="#company-main">본문으로 건너뛰기</a>

<!-- ===== NAVBAR ===== -->
<nav class="site-nav" id="mainNav" aria-label="주 메뉴">
  <div class="container">
    <div class="site-nav__inner">
      <a class="site-nav__brand" href="/">ENER<span>MADE</span></a>

      <!-- Desktop menu -->
      <ul class="site-nav__menu">
        <li><a href="/" class="<%= activeKey==='home'    ? 'is-active' : '' %>" data-i18n-auto data-i18n-header>홈</a></li>
        <li><a href="/about" class="<%= activeKey==='about'   ? 'is-active' : '' %>" data-i18n-auto data-i18n-header>회사 소개</a></li>
        <li><a href="/history" class="<%= activeKey==='history' ? 'is-active' : '' %>" data-i18n-auto data-i18n-header>연혁</a></li>

        <li class="site-nav__has-drop">
          <div class="site-nav__drop-trigger<%= activeKey === 'business' ? ' is-active' : '' %>">
            <a href="/business" <% if (activeKey === 'business') { %>aria-current="page"<% } %> data-i18n-auto data-i18n-header>사업 영역</a>
            <button class="site-nav__drop-toggle" type="button" aria-label="사업 영역 하위 메뉴"
                    aria-expanded="false" aria-controls="businessNavMenu" hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <div class="site-nav__drop" id="businessNavMenu" hidden>
            <ul class="site-nav__drop-list">
              <li><a href="/business#ceramic">
                <span class="site-nav__drop-title" data-i18n-auto>세라믹 가공</span>
                <span class="site-nav__drop-description" data-i18n-auto>알루미나·지르코니아 정밀 가공</span>
              </a></li>
              <li><a href="/business#precision">
                <span class="site-nav__drop-title" data-i18n-auto>정밀 부품</span>
                <span class="site-nav__drop-description" data-i18n-auto>산업용 부품 설계·가공·검사</span>
              </a></li>
              <li><a href="/business#materials">
                <span class="site-nav__drop-title" data-i18n-auto>특수 소재</span>
                <span class="site-nav__drop-description" data-i18n-auto>고온·고압 환경용 세라믹</span>
              </a></li>
              <li><a href="/business#custom">
                <span class="site-nav__drop-title" data-i18n-auto>맞춤 제작</span>
                <span class="site-nav__drop-description" data-i18n-auto>도면 검토부터 시제품·양산까지</span>
              </a></li>
            </ul>
          </div>
        </li>

        <!-- 연구 개발 — 드롭다운 없이 직접 링크 -->
        <li><a href="/research" class="<%= activeKey==='research' ? 'is-active' : '' %>" data-i18n-auto data-i18n-header>연구 개발</a></li>

        <li><a href="/notices" class="<%= activeKey==='notices' ? 'is-active' : '' %>" data-i18n-auto data-i18n-header>공지사항</a></li>
      </ul>

      <!-- Desktop actions -->
      <div class="site-nav__actions">
        <!-- 쇼핑몰 바로가기 (항상 표시) -->
        <a class="nav-icon-btn nav-shop-btn" href="/shop">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2"/>
            <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span data-i18n-auto data-i18n-header>제품몰</span>
          <% if (cartCount > 0) { %>
            <span class="nav-cart-badge"><%= cartCount > 99 ? '99+' : cartCount %></span>
          <% } %>
        </a>
        <% if (isLoggedIn) { %>
          <a class="nav-icon-btn" href="/account" aria-label="내 계정">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 21a8 8 0 00-16 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
            </svg>
          </a>
          <% if (user && user.is_admin) { %>
            <a class="nav-icon-btn" href="/admin/dashboard" aria-label="관리자">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
                <rect x="14" y="3" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
                <rect x="3" y="14" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
                <rect x="14" y="14" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
              </svg>
            </a>
          <% } %>
        <% } else { %>
          <button class="site-nav__login js-open-login" type="button" data-i18n-auto data-i18n-header>로그인</button>
        <% } %>
        <a class="btn btn-primary site-nav__quote" href="/contact"
           <% if (activeKey === 'contact') { %>aria-current="page"<% } %> data-i18n-auto data-i18n-header>견적 문의</a>
      </div>

      <div class="site-nav__language" id="companyLanguageSlot"></div>

      <!-- Mobile hamburger -->
      <button class="site-nav__hamburger" id="navHamburger" type="button" aria-label="메뉴 열기"
              aria-expanded="false" aria-controls="mobDrawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Slide Drawer (왼쪽→오른쪽) -->
<div class="mob-drawer-backdrop" id="mobDrawerBackdrop"></div>
<div class="mob-drawer" id="mobDrawer" role="dialog" aria-modal="true" aria-label="메뉴" inert>
  <!-- Header: 로고 왼쪽, X 오른쪽 -->
  <div class="mob-drawer__head">
    <a class="mob-drawer__brand" href="/">ENER<span>MADE</span></a>
    <button class="mob-drawer__close" id="mobDrawerClose" aria-label="닫기" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- 상단: 로그인/회원가입 or 사용자 정보 -->
  <div class="mob-drawer__auth">
    <% if (isLoggedIn) { %>
      <div class="mob-drawer__user">
        <div class="mob-drawer__avatar"><%= user.name.charAt(0) %></div>
        <div>
          <div class="mob-drawer__user-name"><%= user.name %></div>
          <div class="mob-drawer__user-email"><%= user.email %></div>
        </div>
      </div>
      <div class="mob-drawer__auth-btns">
        <a class="mob-drawer__btn-outline" href="/account" data-i18n-auto>내 계정</a>
        <% if (user && user.is_admin) { %>
          <a class="mob-drawer__btn-admin" href="/admin/dashboard" data-i18n-auto>관리자</a>
        <% } %>
        <a class="mob-drawer__btn-dark" href="/auth/logout" data-i18n-auto>로그아웃</a>
      </div>
    <% } else { %>
      <div class="mob-drawer__auth-btns">
        <button class="mob-drawer__btn-primary flex-fill js-open-login" type="button" data-i18n-auto>로그인</button>
        <a class="mob-drawer__btn-outline flex-fill" href="/auth/register" data-i18n-auto>회원가입</a>
      </div>
    <% } %>
  </div>

  <!-- 메뉴 목록 -->
  <nav class="mob-drawer__nav">
    <a href="/" class="mob-drawer__link <%= activeKey==='home'    ? 'is-active' : '' %>" data-i18n-auto>홈</a>
    <a href="/about" class="mob-drawer__link <%= activeKey==='about'   ? 'is-active' : '' %>" data-i18n-auto>회사 소개</a>
    <a href="/history" class="mob-drawer__link <%= activeKey==='history' ? 'is-active' : '' %>" data-i18n-auto>연혁</a>
    <a href="/business" class="mob-drawer__link <%= activeKey==='business' ? 'is-active' : '' %>" data-i18n-auto>사업 영역</a>
    <a href="/research" class="mob-drawer__link <%= activeKey==='research' ? 'is-active' : '' %>" data-i18n-auto>연구 개발</a>
    <a href="/notices" class="mob-drawer__link <%= activeKey==='notices' ? 'is-active' : '' %>" data-i18n-auto>공지사항</a>
    <a href="/shop" class="mob-drawer__link" data-i18n-auto>쇼핑몰</a>
    <a href="/contact" class="mob-drawer__link mob-drawer__quote<%= activeKey === 'contact' ? ' is-active' : '' %>" data-i18n-auto>견적 문의</a>
  </nav>
</div>

<!-- ===== LOGIN OVERLAY ===== -->
<div class="login-overlay" id="loginOverlay">
  <div class="login-box" role="dialog" aria-modal="true" aria-label="로그인">
    <div class="login-box__head">
      <h2 data-i18n-auto>로그인</h2>
      <button class="login-box__close" id="loginClose" aria-label="닫기" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="login-box__body">
      <p class="login-box__sub" data-i18n-auto>계정으로 로그인하여 더 많은 서비스를 이용하세요</p>
      <form method="post" action="/auth/login">
        <input type="hidden" name="_csrf" value="<%= csrfTokenValue %>">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <div class="mb-3">
          <label class="form-label" for="modal-email" data-i18n-auto>이메일</label>
          <input class="form-control" type="email" id="modal-email" name="email" placeholder="example@company.com" autocomplete="email" required>
        </div>
        <div class="mb-2">
          <label class="form-label" for="modal-pw" data-i18n-auto>비밀번호</label>
          <input class="form-control" type="password" id="modal-pw" name="password" placeholder="비밀번호를 입력하세요" autocomplete="current-password" required>
        </div>
        <div class="d-flex justify-content-end mb-3">
          <a href="/auth/forgot" class="txt-accent" style="font-size:13px;font-weight:600;" data-i18n-auto>비밀번호 찾기</a>
        </div>
        <button class="btn btn-dark w-100 mb-2" type="submit" data-i18n-auto>로그인</button>
        <a class="btn btn-outline-secondary w-100 btn-sm" href="/shop/orders/guest" data-i18n-auto>비회원 주문 조회</a>
      </form>
      <hr class="my-3">
      <p style="text-align:center;font-size:13px;color:var(--c-muted);margin:0;">
        아직 회원이 아니신가요? <a href="/auth/register" style="font-weight:700;color:var(--c-accent);" data-i18n-auto>회원가입</a> →
      </p>
    </div>
  </div>
</div>

<main id="company-main" tabindex="-1">
