<% const pageTitle=(typeof title !=='undefined' && title) ? title : 'ENERMADE'; %>
<% const activeKey=(typeof active !=='undefined' && active) ? active : ''; %>
<% const returnTo=(typeof currentUrl !=='undefined' && currentUrl) ? currentUrl : (typeof currentPath !=='undefined' ? currentPath : '/'); %>
<% const csrfTokenValue=(typeof csrfToken !=='undefined' && csrfToken) ? csrfToken : ''; %>
<% const isLoggedIn=!!user; %>
<!doctype html>
<html lang="ko" data-theme="">
<script>(function(){var t=localStorage.getItem('site_theme');if(t){document.documentElement.setAttribute('data-theme',t);}else if(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches){document.documentElement.setAttribute('data-theme','dark');}})()</script>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="고객 맞춤형 세라믹 솔루션 전문기업 ENERMADE" />
  <title><%= pageTitle %> | ENERMADE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/company.css" />
</head>
<body>

<!-- 다크 모드 토글 (fixed 좌측 상단) -->
<button class="dark-mode-btn" id="darkModeToggle" aria-label="다크 모드 전환" title="다크 모드">
  <!-- Moon icon -->
  <svg class="dm-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  <!-- Sun icon -->
  <svg class="dm-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
</button>

<!-- ===== NAVBAR ===== -->
<nav class="site-nav" id="mainNav">
  <div class="container">
    <div class="site-nav__inner">
      <a class="site-nav__brand" href="/">ENER<span>MADE</span></a>

      <!-- Desktop menu -->
      <ul class="site-nav__menu">
        <li><a href="/" class="<%= activeKey==='home'    ? 'is-active' : '' %>" data-i18n-auto>홈</a></li>
        <li><a href="/about" class="<%= activeKey==='about'   ? 'is-active' : '' %>" data-i18n-auto>회사 소개</a></li>
        <li><a href="/history" class="<%= activeKey==='history' ? 'is-active' : '' %>" data-i18n-auto>연혁</a></li>
        <li><a href="/notices" class="<%= activeKey==='notices' ? 'is-active' : '' %>" data-i18n-auto>공지사항</a></li>
        <li><a href="/contact" class="<%= activeKey==='contact' ? 'is-active' : '' %>" data-i18n-auto>문의</a></li>
      </ul>

      <!-- Desktop actions -->
      <div class="site-nav__actions">
        <a class="nav-icon-btn" href="/shop" aria-label="쇼핑몰">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2"/>
            <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
        <% if (isLoggedIn) { %>
          <a class="nav-icon-btn" href="/account" aria-label="내 계정">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 21a8 8 0 00-16 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
            </svg>
          </a>
          <% if (user && user.is_admin) { %>
            <a class="nav-icon-btn" href="/admin/dashboard" aria-label="관리자">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
                <rect x="14" y="3" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
                <rect x="3" y="14" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
                <rect x="14" y="14" width="7" height="7" stroke="currentColor" stroke-width="2" rx="1"/>
              </svg>
            </a>
          <% } %>
        <% } else { %>
          <button class="btn btn-primary btn-sm js-open-login" type="button">로그인</button>
        <% } %>
      </div>

      <!-- Mobile hamburger -->
      <button class="site-nav__hamburger" id="navHamburger" aria-label="메뉴 열기" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Slide Drawer (왼쪽→오른쪽) -->
<div class="mob-drawer-backdrop" id="mobDrawerBackdrop"></div>
<div class="mob-drawer" id="mobDrawer" role="dialog" aria-modal="true" aria-label="메뉴">
  <!-- Header: 로고 왼쪽, X 오른쪽 -->
  <div class="mob-drawer__head">
    <a class="mob-drawer__brand" href="/">ENER<span>MADE</span></a>
    <button class="mob-drawer__close" id="mobDrawerClose" aria-label="닫기" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- 상단: 로그인/회원가입 or 사용자 정보 -->
  <div class="mob-drawer__auth">
    <% if (isLoggedIn) { %>
      <div class="mob-drawer__user">
        <div class="mob-drawer__avatar"><%= user.name.charAt(0) %></div>
        <div>
          <div class="mob-drawer__user-name"><%= user.name %></div>
          <div class="mob-drawer__user-email"><%= user.email %></div>
        </div>
      </div>
      <div class="mob-drawer__auth-btns">
        <a class="mob-drawer__btn-outline" href="/account">내 계정</a>
        <% if (user && user.is_admin) { %>
          <a class="mob-drawer__btn-admin" href="/admin/dashboard">관리자</a>
        <% } %>
        <a class="mob-drawer__btn-dark" href="/auth/logout">로그아웃</a>
      </div>
    <% } else { %>
      <div class="mob-drawer__auth-btns">
        <button class="mob-drawer__btn-primary flex-fill js-open-login" type="button">로그인</button>
        <a class="mob-drawer__btn-outline flex-fill" href="/auth/register">회원가입</a>
      </div>
    <% } %>
  </div>

  <!-- 메뉴 목록 -->
  <nav class="mob-drawer__nav">
    <a href="/" class="mob-drawer__link <%= activeKey==='home'    ? 'is-active' : '' %>" data-i18n-auto>홈</a>
    <a href="/about" class="mob-drawer__link <%= activeKey==='about'   ? 'is-active' : '' %>" data-i18n-auto>회사 소개</a>
    <a href="/history" class="mob-drawer__link <%= activeKey==='history' ? 'is-active' : '' %>" data-i18n-auto>연혁</a>
    <a href="/notices" class="mob-drawer__link <%= activeKey==='notices' ? 'is-active' : '' %>" data-i18n-auto>공지사항</a>
    <a href="/contact" class="mob-drawer__link <%= activeKey==='contact' ? 'is-active' : '' %>" data-i18n-auto>문의</a>
    <a href="/shop" class="mob-drawer__link" data-i18n-auto>쇼핑몰</a>
  </nav>
</div>

<!-- ===== LOGIN OVERLAY ===== -->
<div class="login-overlay" id="loginOverlay">
  <div class="login-box" role="dialog" aria-modal="true" aria-label="로그인">
    <div class="login-box__head">
      <h2>로그인</h2>
      <button class="login-box__close" id="loginClose" aria-label="닫기" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="login-box__body">
      <p class="login-box__sub">계정으로 로그인하여 더 많은 서비스를 이용하세요</p>
      <form method="post" action="/auth/login">
        <input type="hidden" name="_csrf" value="<%= csrfTokenValue %>">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <div class="mb-3">
          <label class="form-label" for="modal-email">이메일</label>
          <input class="form-control" type="email" id="modal-email" name="email" placeholder="example@company.com" autocomplete="email" required>
        </div>
        <div class="mb-2">
          <label class="form-label" for="modal-pw">비밀번호</label>
          <input class="form-control" type="password" id="modal-pw" name="password" placeholder="비밀번호를 입력하세요" autocomplete="current-password" required>
        </div>
        <div class="d-flex justify-content-end mb-3">
          <a href="/auth/forgot" class="txt-accent" style="font-size:13px;font-weight:600;">비밀번호 찾기</a>
        </div>
        <button class="btn btn-dark w-100 mb-2" type="submit">로그인</button>
        <a class="btn btn-outline-secondary w-100 btn-sm" href="/shop/orders/guest">비회원 주문 조회</a>
      </form>
      <hr class="my-3">
      <p style="text-align:center;font-size:13px;color:var(--c-muted);margin:0;">
        아직 회원이 아니신가요? <a href="/auth/register" style="font-weight:700;color:var(--c-accent);">회원가입 →</a>
      </p>
    </div>
  </div>
</div>

<main>
