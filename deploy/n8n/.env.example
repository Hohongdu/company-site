# 기본 보안
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# 웹훅 URL(외부 접근 도메인이 있으면 변경)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# 타임존
GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul

# 선택: 워크플로우 암호화 키(고정 권장)
N8N_ENCRYPTION_KEY=replace_with_long_random_key
